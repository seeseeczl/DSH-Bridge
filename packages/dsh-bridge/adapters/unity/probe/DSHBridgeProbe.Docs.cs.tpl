        // 真实页面结构：<div class="signature"><div class="signature-CS sig-block">...
        static readonly Regex DocsSignatureRegex = new Regex(
            "<div[^>]*class=\"[^\"]*signature-CS[^\"]*\"[^>]*>([\\s\\S]*?)</div>",
            RegexOptions.IgnoreCase);
        static readonly Regex DocsH2Regex = new Regex("(?is)<h2[^>]*>.*?</h2>");
        static readonly Regex DocsDescriptionHeadingRegex = new Regex("(?is)<h[23][^>]*>\\s*Description\\s*</h[23]>");
        static readonly Regex DocsSectionEndRegex = new Regex("(?is)<h[23]|<hr\\s+class=\"section\"");
        static readonly Regex DocsPreRegex = new Regex("(?is)<pre[^>]*>([\\s\\S]*?)</pre>");
        static readonly Regex DocsTitleRegex = new Regex("(?is)<title[^>]*>(.*?)</title>");
        static readonly Regex DocsScriptStyleRegex = new Regex("(?is)<(script|style)[^>]*>.*?</\\1>");
        static readonly Regex DocsBrRegex = new Regex("(?i)<br\\s*/?>");
        static readonly Regex DocsBlockEndRegex = new Regex("(?i)</(p|div|li|tr|h[1-6]|pre|table|ul|ol|section)>");
        static readonly Regex DocsAnyTagRegex = new Regex("(?is)<[^>]+>");
        static readonly Regex DocsEntityRegex = new Regex("&(#[xX][0-9a-fA-F]+|#[0-9]+|[a-zA-Z][a-zA-Z0-9]+);");
        static readonly Regex DocsInlineSpaceRegex = new Regex("[ \\t\\u00A0]+");
        static readonly Regex DocsBlankLinesRegex = new Regex("\\n{3,}");
        static readonly Regex DocsMultiSpaceRegex = new Regex("\\s{2,}");

        static Dictionary<string, object> DocsGet(Dictionary<string, object> args)
        {
            var symbolRaw = GetString(args, "symbol");
            if (symbolRaw == null || symbolRaw.Trim().Length == 0)
                throw new KnownError("invalid_argument", "缺少 symbol");
            var symbol = symbolRaw.Trim();
            // 参数校验优先于环境探测：离线/缺文档时也能得到确定性的参数错误。
            if (symbol.Length > 200)
                throw new KnownError("invalid_argument", "symbol 过长（上限 200 字符）");
            if (!DocsIsSafeDocId(symbol))
                throw new KnownError(
                    "invalid_argument",
                    "symbol 含非法字符（只允许字母、数字、. _ -，且不得包含 .. 或路径分隔符）: " + symbol,
                    "文档页 id 来自 docdata/index.json，不接受任意路径输入");
            var includeRaw = ToBoolOr(args, "includeRaw", false);

            var root = DocsResolveRoot(args);
            var entries = DocsLoadIndex(root.Root);
            var suggestions = new List<string>();
            var entry = DocsFindPage(entries, symbol, suggestions);
            if (entry == null)
            {
                throw new KnownError(
                    "doc_not_found",
                    "找不到文档页: " + symbol,
                    suggestions.Count == 0
                        ? "文档索引中没有相近页面；请先用 unity.docs.search 检索"
                        : "相近文档页：" + string.Join("；", suggestions.ToArray()));
            }
            // 索引里的 id 可能被篡改：构建路径前二次校验（加载时已过滤，这里是双保险）。
            if (!DocsIsSafeDocId(entry.Id))
                throw new KnownError("doc_not_found", "文档 id 非法，已拒绝: " + entry.Id, "索引条目包含路径符号，已跳过");
            var pagePath = Path.Combine(root.Root, entry.Id + ".html");
            DocsEnsureInside(root.Root, pagePath);
            if (!File.Exists(pagePath))
            {
                DocsAppendPageSuggestions(entries, symbol, suggestions, 5);
                throw new KnownError(
                    "doc_not_found",
                    "文档页文件缺失: " + entry.Id + ".html",
                    suggestions.Count == 0
                        ? "索引存在但页面文件缺失；Documentation 安装可能不完整"
                        : "可尝试：" + string.Join("；", suggestions.ToArray()));
            }

            long pageLength = 0;
            try
            {
                var pageInfo = new FileInfo(pagePath);
                pageLength = pageInfo.Length;
            }
            catch (Exception) { }
            if (pageLength > DocsMaxPageBytes)
                throw new KnownError("docs_unavailable", "文档页面异常过大，已拒绝读取", "bytes=" + pageLength + " page=" + pagePath);

            string html;
            try { html = File.ReadAllText(pagePath, Encoding.UTF8); }
            catch (Exception e)
            {
                throw new KnownError("docs_unavailable", "读取文档页面失败: " + pagePath,
                    e.GetType().Name + ": " + e.Message);
            }

            bool signaturesTruncated;
            var signatures = DocsExtractSignatures(html, 20, out signaturesTruncated);
            var description = DocsExtractDescription(html);
            bool descriptionTruncated;
            description = DocsTruncate(description, DocsMaxBodyChars, out descriptionTruncated);
            bool examplesTruncated;
            var codeExamples = DocsExtractCodeExamples(html, 10, out examplesTruncated);
            var title = entry.Title;
            if (string.IsNullOrEmpty(title)) title = DocsExtractTitle(html) ?? entry.Id;

            var d = new Dictionary<string, object>();
            d["available"] = true;
            d["source"] = "local-docs";
            d["language"] = root.Language;
            d["documentationRoot"] = root.Root;
            d["id"] = entry.Id;
            d["page"] = entry.Id + ".html";
            d["title"] = title;
            d["signatures"] = signatures;
            d["description"] = description;
            d["codeExamples"] = codeExamples;
            d["url"] = pagePath;
            d["truncated"] = descriptionTruncated || signaturesTruncated || examplesTruncated;
            d["descriptionTruncated"] = descriptionTruncated;
            d["signaturesTruncated"] = signaturesTruncated;
            d["codeExamplesTruncated"] = examplesTruncated;
            if (includeRaw)
            {
                bool rawTruncated;
                d["rawHtml"] = DocsTruncate(html, DocsMaxRawChars, out rawTruncated);
                d["rawTruncated"] = rawTruncated;
            }
            return d;
        }

        /// <summary>按 id 精确 → 忽略大小写 → 后缀（成员页）→ title 精确的顺序解析页面。</summary>
        static DocsIndexEntry DocsFindPage(List<DocsIndexEntry> entries, string symbol, List<string> suggestions)
        {
            var exact = new List<DocsIndexEntry>();
            var near = new List<DocsIndexEntry>();
            var suffixDash = "-" + symbol;
            var suffixDot = "." + symbol;
            foreach (var entry in entries)
            {
                if (string.Equals(entry.Id, symbol, StringComparison.Ordinal)) { exact.Add(entry); continue; }
                if (string.Equals(entry.Id, symbol, StringComparison.OrdinalIgnoreCase)) { near.Add(entry); continue; }
                if (entry.Id.EndsWith(suffixDash, StringComparison.OrdinalIgnoreCase)
                    || entry.Id.EndsWith(suffixDot, StringComparison.OrdinalIgnoreCase))
                {
                    near.Add(entry);
                    continue;
                }
                if (string.Equals(entry.Title, symbol, StringComparison.OrdinalIgnoreCase)) near.Add(entry);
            }
            if (exact.Count == 1) return exact[0];
            var pool = exact.Count > 0 ? exact : near;
            if (pool.Count == 1) return pool[0];

            if (pool.Count > 1)
            {
                // 多个候选时优先 title 完全相等的唯一项（例如 symbol 传类短名）。
                DocsIndexEntry titled = null;
                var titledCount = 0;
                foreach (var entry in pool)
                {
                    if (!string.Equals(entry.Title, symbol, StringComparison.OrdinalIgnoreCase)) continue;
                    titled = entry;
                    titledCount++;
                }
                if (titledCount == 1) return titled;
                foreach (var entry in pool)
                {
                    if (suggestions.Count >= 6) break;
                    suggestions.Add(DocsFormatPageHint(entry));
                }
            }
            if (suggestions.Count == 0) DocsAppendPageSuggestions(entries, symbol, suggestions, 5);
            return null;
        }

        static string DocsFormatPageHint(DocsIndexEntry entry)
        {
            if (string.IsNullOrEmpty(entry.Title) || string.Equals(entry.Title, entry.Id, StringComparison.Ordinal))
                return entry.Id;
            return entry.Id + "（" + entry.Title + "）";
        }

        /// <summary>错误路径建议：先按 id/title 子串命中，再按编辑距离兜底（拼写错误也能给出候选）。</summary>
        static void DocsAppendPageSuggestions(List<DocsIndexEntry> entries, string symbol, List<string> suggestions, int max)
        {
            if (entries == null || string.IsNullOrEmpty(symbol)) return;
            foreach (var entry in entries)
            {
                if (suggestions.Count >= max) return;
                if (entry.Id.IndexOf(symbol, StringComparison.OrdinalIgnoreCase) < 0
                    && entry.Title.IndexOf(symbol, StringComparison.OrdinalIgnoreCase) < 0)
                    continue;
                var hint = DocsFormatPageHint(entry);
                if (!suggestions.Contains(hint)) suggestions.Add(hint);
            }
            if (suggestions.Count >= max) return;
            // 编辑距离兜底只扫「长度接近」的候选，避免把 7MB 索引里的长成员页都算一遍。
            var near = new List<DocsNearPage>();
            foreach (var entry in entries)
            {
                var target = DocsPageShortName(entry.Id);
                var lengthGap = Math.Abs(target.Length - symbol.Length);
                if (lengthGap > 3) continue;
                var distance = DocsEditDistance(symbol, target);
                if (distance > 3) continue;
                var candidate = new DocsNearPage();
                candidate.Entry = entry;
                candidate.Distance = distance;
                candidate.Target = target;
                // 公共前缀越长越像「同一名字的拼写错误」，用它压过一堆距离相同但无关的短名。
                candidate.PrefixLength = DocsCommonPrefixLength(symbol, target);
                near.Add(candidate);
                if (near.Count >= 200) break;
            }
            near.Sort(delegate (DocsNearPage left, DocsNearPage right)
            {
                if (left.Distance != right.Distance) return left.Distance.CompareTo(right.Distance);
                if (left.PrefixLength != right.PrefixLength) return right.PrefixLength.CompareTo(left.PrefixLength);
                var byLength = left.Target.Length.CompareTo(right.Target.Length);
                if (byLength != 0) return byLength;
                // 同短名下，页面 id 越短越可能是「本尊」（Rigidbody 优于 Collision-rigidbody）。
                var byIdLength = left.Entry.Id.Length.CompareTo(right.Entry.Id.Length);
                if (byIdLength != 0) return byIdLength;
                return string.CompareOrdinal(left.Entry.Id, right.Entry.Id);
            });
            foreach (var candidate in near)
            {
                if (suggestions.Count >= max) break;
                var hint = DocsFormatPageHint(candidate.Entry);
                if (!suggestions.Contains(hint)) suggestions.Add(hint);
            }
        }

        /// <summary>页面 id 的短名（成员页取最后一个 . 或 - 之后的部分），用于编辑距离近似。</summary>
        static string DocsPageShortName(string id)
        {
            if (string.IsNullOrEmpty(id)) return string.Empty;
            var dot = id.LastIndexOf('.');
            var dash = id.LastIndexOf('-');
            var cut = Math.Max(dot, dash);
            return cut >= 0 && cut + 1 < id.Length ? id.Substring(cut + 1) : id;
        }

        /// <summary>Levenshtein 编辑距离（忽略大小写；长度 > 64 时截断，仅用于错误建议）。</summary>
        static int DocsEditDistance(string left, string right)
        {
            if (string.IsNullOrEmpty(left)) return right == null ? 0 : right.Length;
            if (string.IsNullOrEmpty(right)) return left.Length;
            if (left.Length > 64) left = left.Substring(0, 64);
            if (right.Length > 64) right = right.Substring(0, 64);
            var previous = new int[right.Length + 1];
            var current = new int[right.Length + 1];
            for (var j = 0; j <= right.Length; j++) previous[j] = j;
            for (var i = 1; i <= left.Length; i++)
            {
                current[0] = i;
                for (var j = 1; j <= right.Length; j++)
                {
                    var cost = char.ToLowerInvariant(left[i - 1]) == char.ToLowerInvariant(right[j - 1]) ? 0 : 1;
                    var deletion = previous[j] + 1;
                    var insertion = current[j - 1] + 1;
                    var substitution = previous[j - 1] + cost;
                    current[j] = Math.Min(deletion, Math.Min(insertion, substitution));
                }
                var swap = previous;
                previous = current;
                current = swap;
            }
            return previous[right.Length];
        }

        sealed class DocsNearPage
        {
            public DocsIndexEntry Entry;
            public int Distance;
            public string Target;
            public int PrefixLength;
        }

        /// <summary>忽略大小写的公共前缀长度（用于拼写错误建议排序）。</summary>
        static int DocsCommonPrefixLength(string left, string right)
        {
            if (string.IsNullOrEmpty(left) || string.IsNullOrEmpty(right)) return 0;
            var limit = Math.Min(left.Length, right.Length);
            var count = 0;
            while (count < limit
                && char.ToLowerInvariant(left[count]) == char.ToLowerInvariant(right[count]))
                count++;
            return count;
        }

        // ------------------------------------------------------------------
        // HTML → 纯文本 / 签名 / Description / 代码示例
        // ------------------------------------------------------------------

        /// <summary>提取所有 signature-CS 声明块；去掉 "Declaration" 标题，压成单行。</summary>
        static List<object> DocsExtractSignatures(string html, int max, out bool truncated)
        {
            truncated = false;
            var list = new List<object>();
            if (string.IsNullOrEmpty(html)) return list;
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var match = DocsSignatureRegex.Match(html);
            while (match.Success)
            {
                var body = DocsH2Regex.Replace(match.Groups[1].Value, " ");
                var text = DocsStripTagsCompact(body);
                if (text.StartsWith("Declaration", StringComparison.OrdinalIgnoreCase))
                    text = text.Substring("Declaration".Length).Trim();
                if (text.Length > 0 && seen.Add(text))
                {
                    if (list.Count >= max) { truncated = true; break; }
                    bool itemTruncated;
                    var item = DocsTruncate(text, 2000, out itemTruncated);
                    if (itemTruncated) truncated = true;
                    list.Add(item);
                }
                match = match.NextMatch();
            }
            return list;
        }

        /// <summary>合并页面内所有 Description 段落（成员页每个重载各有一段）。</summary>
        static string DocsExtractDescription(string html)
        {
            if (string.IsNullOrEmpty(html)) return string.Empty;
            var texts = new List<string>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var match = DocsDescriptionHeadingRegex.Match(html);
            while (match.Success)
            {
                var rest = html.Substring(match.Index + match.Length);
                var end = DocsSectionEndRegex.Match(rest);
                var length = end.Success ? end.Index : Math.Min(rest.Length, 20000);
                if (length > 0)
                {
                    var text = DocsCleanDescriptionLines(DocsStripTags(rest.Substring(0, length)));
                    if (text.Length > 0 && seen.Add(text)) texts.Add(text);
                }
                match = match.NextMatch();
            }
            return string.Join("\n\n", texts.ToArray());
        }

        /// <summary>提取代码示例：&lt;pre class="codeExampleCS"&gt; 与 &lt;pre&gt;&lt;code&gt; 两种真实结构。</summary>
        static List<object> DocsExtractCodeExamples(string html, int max, out bool truncated)
        {
            truncated = false;
            var list = new List<object>();
            if (string.IsNullOrEmpty(html)) return list;
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var match = DocsPreRegex.Match(html);
            while (match.Success)
            {
                var tagEnd = match.Value.IndexOf('>');
                var openTag = tagEnd >= 0 ? match.Value.Substring(0, tagEnd + 1) : "<pre>";
                var openLower = openTag.ToLowerInvariant();
                var inner = match.Groups[1].Value;
                var looksLikeCode = openLower.IndexOf("codeexample", StringComparison.Ordinal) >= 0
                    || openLower.IndexOf("code", StringComparison.Ordinal) >= 0
                    || inner.IndexOf("<code", StringComparison.OrdinalIgnoreCase) >= 0;
                if (looksLikeCode)
                {
                    var text = DocsStripCodeTags(inner);
                    if (text.Length > 0 && seen.Add(text))
                    {
                        if (list.Count >= max) { truncated = true; break; }
                        bool itemTruncated;
                        var item = DocsTruncate(text, 4000, out itemTruncated);
                        if (itemTruncated) truncated = true;
                        list.Add(item);
                    }
                }
                match = match.NextMatch();
            }
            return list;
        }

        /// <summary>HTML → 纯文本：去 script/style、块级标签换行、去标签、实体解码、空白归一化。</summary>
        static string DocsStripTags(string html)
        {
            if (string.IsNullOrEmpty(html)) return string.Empty;
            var text = DocsScriptStyleRegex.Replace(html, " ");
            text = DocsBrRegex.Replace(text, "\n");
            text = DocsBlockEndRegex.Replace(text, "\n");
            text = DocsAnyTagRegex.Replace(text, string.Empty);
            text = DocsDecodeEntities(text);
            text = text.Replace("\r\n", "\n").Replace("\r", "\n");
            text = DocsInlineSpaceRegex.Replace(text, " ");
            text = DocsBlankLinesRegex.Replace(text, "\n\n");
            return text.Trim();
        }

        static string DocsStripTagsCompact(string html)
        {
            var text = DocsStripTags(html).Replace('\n', ' ');
            return DocsMultiSpaceRegex.Replace(text, " ").Trim();
        }

        /// <summary>Description 逐行清洗：去掉纯空白行与行首尾空白，保留段落换行。</summary>
        static string DocsCleanDescriptionLines(string text)
        {
            if (string.IsNullOrEmpty(text)) return string.Empty;
            var lines = text.Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
            var kept = new List<string>();
            foreach (var line in lines)
            {
                var trimmed = line.Trim();
                if (trimmed.Length > 0) kept.Add(trimmed);
            }
            return string.Join("\n", kept.ToArray());
        }

        /// <summary>代码示例专用：保留行首缩进（比 Description 的空白压缩更可读），只去标签与解码实体。</summary>
        static string DocsStripCodeTags(string html)
        {
            if (string.IsNullOrEmpty(html)) return string.Empty;
            var text = DocsBrRegex.Replace(html, "\n");
            text = DocsAnyTagRegex.Replace(text, string.Empty);
            text = DocsDecodeEntities(text);
            text = text.Replace("\r\n", "\n").Replace("\r", "\n");
            var lines = text.Split('\n');
            var kept = new List<string>();
            var blankRun = 0;
            foreach (var line in lines)
            {
                var withoutTrailing = line.TrimEnd();
                if (withoutTrailing.Trim().Length == 0)
                {
                    blankRun++;
                    if (blankRun > 2) continue;
                    kept.Add(string.Empty);
                }
                else
                {
                    blankRun = 0;
                    kept.Add(withoutTrailing);
                }
            }
            return string.Join("\n", kept.ToArray()).Trim();
        }

        /// <summary>常见 HTML 实体 + 十进制/十六进制数字实体解码（不依赖 System.Net.WebUtility）。</summary>
        static string DocsDecodeEntities(string text)
        {
            if (string.IsNullOrEmpty(text) || text.IndexOf('&') < 0) return text ?? string.Empty;
            return DocsEntityRegex.Replace(text, delegate (Match m)
            {
                var body = m.Groups[1].Value;
                if (body.Length > 1 && body[0] == '#')
                {
                    try
                    {
                        var hex = body[1] == 'x' || body[1] == 'X';
                        var code = hex
                            ? Convert.ToInt32(body.Substring(2), 16)
                            : Convert.ToInt32(body.Substring(1), 10);
                        if (code > 0 && code <= 0x10FFFF) return char.ConvertFromUtf32(code);
                    }
                    catch (Exception) { }
                    return m.Value;
                }
                switch (body)
                {
                    case "lt": return "<";
                    case "gt": return ">";
                    case "amp": return "&";
                    case "quot": return "\"";
                    case "apos": return "'";
                    case "nbsp": return " ";
                    case "hellip": return "…";
                    case "mdash": return "—";
                    case "ndash": return "–";
                    case "copy": return "©";
                    case "reg": return "®";
                    case "trade": return "™";
                    default: return m.Value;
                }
            });
        }

        static string DocsExtractTitle(string html)
        {
            if (string.IsNullOrEmpty(html)) return null;
            var match = DocsTitleRegex.Match(html);
            if (!match.Success) return null;
            var text = DocsStripTagsCompact(match.Groups[1].Value);
            var separator = text.IndexOf(" - ", StringComparison.Ordinal);
            if (separator > 0) text = text.Substring(0, separator).Trim();
            return text.Length == 0 ? null : text;
        }

        /// <summary>截断到 max 个 UTF-16 字符；截断时用 truncated 回传，不追加提示文本（保证长度上限可信）。</summary>
        static string DocsTruncate(string text, int max, out bool truncated)
        {
            if (text == null) { truncated = false; return string.Empty; }
            if (max <= 0) { truncated = false; return string.Empty; }
            if (text.Length <= max) { truncated = false; return text; }
            truncated = true;
            return text.Substring(0, max);
        }

        // ------------------------------------------------------------------
        // unity.reflect.signature
        // ------------------------------------------------------------------

        /// <summary>类型索引缓存：AppDomain 程序集数组变化（域内新加载程序集）时重建。</summary>
        static Type[] _docsLoadedTypesCache;
        static Assembly[] _docsLoadedAssembliesCache;

        static readonly Dictionary<Type, string> DocsTypeAliases = new Dictionary<Type, string>
        {
            { typeof(void), "void" },
            { typeof(bool), "bool" },
            { typeof(byte), "byte" },
            { typeof(sbyte), "sbyte" },
            { typeof(short), "short" },
            { typeof(ushort), "ushort" },
            { typeof(int), "int" },
            { typeof(uint), "uint" },
            { typeof(long), "long" },
            { typeof(ulong), "ulong" },
            { typeof(float), "float" },
            { typeof(double), "double" },
            { typeof(decimal), "decimal" },
            { typeof(char), "char" },
            { typeof(string), "string" },
            { typeof(object), "object" },
        };

        static Dictionary<string, object> DocsSignature(Dictionary<string, object> args)
        {
            var raw = GetString(args, "type");
            if (raw == null || raw.Trim().Length == 0)
                throw new KnownError("invalid_argument", "缺少 type");
            var typeName = raw.Trim();
            if (typeName.Length > 300)
                throw new KnownError("invalid_argument", "type 过长（上限 300 字符）");
            var includeNonPublic = ToBoolOr(args, "includeNonPublic", false);
            var includeInherited = ToBoolOr(args, "includeInherited", false);
            var limit = (int)DocsClampLong(ToLong(args, "limit", DocsDefaultSignatureLimit), 1, DocsMaxSignatureLimit);
            var memberFilter = GetString(args, "member");
            if (memberFilter != null)
            {
                memberFilter = memberFilter.Trim();
                if (memberFilter.Length == 0) memberFilter = null;
            }

            var matches = DocsFindTypes(typeName);
            if (matches.Count == 0)
            {
                var suggestions = DocsSuggestTypeNames(typeName, 5);
                throw new KnownError(
                    "type_not_found",
                    "找不到类型: " + typeName,
                    suggestions.Count == 0
                        ? "该类型名不存在；请用完整命名空间或检查程序集是否已加载"
                        : "相近类型：" + string.Join(", ", suggestions.ToArray()));
            }
            if (matches.Count > 1)
            {
                // 短名多命中：不猜，交回 candidates 让调用方用完整名重试。
                var candidates = new List<object>();
                for (var i = 0; i < matches.Count && i < 20; i++)
                {
                    var candidate = new Dictionary<string, object>();
                    candidate["fullName"] = matches[i].FullName ?? matches[i].Name;
                    candidate["assembly"] = DocsAssemblyName(matches[i]);
                    candidate["kind"] = DocsTypeKind(matches[i]);
                    candidates.Add(candidate);
                }
                var ambiguous = new Dictionary<string, object>();
                ambiguous["available"] = true;
                ambiguous["ambiguous"] = true;
                ambiguous["count"] = (long)matches.Count;
                ambiguous["candidates"] = candidates;
                ambiguous["truncated"] = matches.Count > candidates.Count;
                ambiguous["hint"] = "类型名不唯一，请使用完整类型名（含命名空间）后重试";
                return ambiguous;
            }

            var type = matches[0];
            long total;
            var rows = DocsCollectMembers(type, memberFilter, includeNonPublic, includeInherited, limit, out total);
            if (memberFilter != null && total == 0)
            {
                var suggestions = DocsSuggestMemberNames(type, memberFilter, includeNonPublic, includeInherited, 5);
                var hiddenHint = string.Empty;
                if (!includeNonPublic)
                {
                    long hiddenTotal;
                    DocsCollectMembers(type, memberFilter, true, includeInherited, 1, out hiddenTotal);
                    if (hiddenTotal > 0) hiddenHint = "；该成员可能是非公开成员，请设置 includeNonPublic: true";
                }
                throw new KnownError(
                    "member_not_found",
                    "找不到成员: " + type.Name + "." + memberFilter,
                    suggestions.Count == 0
                        ? ("该类型没有相近的成员名" + hiddenHint)
                        : ("相近成员：" + string.Join(", ", suggestions.ToArray()) + hiddenHint));
            }

            var typeInfo = new Dictionary<string, object>();
            typeInfo["fullName"] = type.FullName ?? type.Name;
            typeInfo["assembly"] = DocsAssemblyName(type);
            typeInfo["kind"] = DocsTypeKind(type);
            typeInfo["isGeneric"] = type.IsGenericType;

            var memberRows = new List<object>();
            foreach (var row in rows) memberRows.Add(row);

            var d = new Dictionary<string, object>();
            d["available"] = true;
            d["type"] = typeInfo;
            d["members"] = memberRows;
            d["count"] = total;
            d["returned"] = (long)memberRows.Count;
            d["limit"] = (long)limit;
            d["truncated"] = total > memberRows.Count;
            d["includeNonPublic"] = includeNonPublic;
            d["includeInherited"] = includeInherited;
            if (memberFilter != null) d["member"] = memberFilter;
            return d;
        }

        /// <summary>类型查找：Type.GetType → 全名精确 → 短名/后缀 → 忽略大小写兜底。</summary>
        static List<Type> DocsFindTypes(string name)
        {
            var results = new List<Type>();
            var direct = DocsTryGetType(name);
            if (direct != null)
            {
                results.Add(direct);
                return results;
            }

            var all = DocsLoadedTypes();
            var exact = new List<Type>();
            var suffix = new List<Type>();
            foreach (var type in all)
            {
                var fullName = type.FullName;
                if (fullName == null) continue;
                if (string.Equals(fullName, name, StringComparison.Ordinal)
                    || string.Equals(type.Name, name, StringComparison.Ordinal))
                {
                    exact.Add(type);
                    continue;
                }
                if (fullName.EndsWith("." + name, StringComparison.Ordinal)
                    || fullName.EndsWith("+" + name, StringComparison.Ordinal)
                    || string.Equals(DocsSimpleTypeName(type), name, StringComparison.Ordinal))
                    suffix.Add(type);
            }
            if (exact.Count > 0) return exact;
            if (suffix.Count > 0) return suffix;

            var ignoreCase = new List<Type>();
            foreach (var type in all)
            {
                var fullName = type.FullName;
                if (fullName == null) continue;
                if (string.Equals(fullName, name, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(type.Name, name, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(DocsSimpleTypeName(type), name, StringComparison.OrdinalIgnoreCase))
                {
                    ignoreCase.Add(type);
                }
            }
            return ignoreCase;
        }

        static Type DocsTryGetType(string name)
        {
            try
            {
                var type = Type.GetType(name, false);
                if (type != null) return type;
            }
            catch (Exception) { }
            foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
            {
                try
                {
                    var type = assembly.GetType(name, false);
                    if (type != null) return type;
                }
                catch (Exception) { }
            }
            return null;
        }

        /// <summary>已加载程序集内的全部类型（含工程程序集），带程序集数组变化检测的缓存。</summary>
        static Type[] DocsLoadedTypes()
        {
            var assemblies = AppDomain.CurrentDomain.GetAssemblies();
            if (_docsLoadedTypesCache != null && DocsSameAssemblies(_docsLoadedAssembliesCache, assemblies))
                return _docsLoadedTypesCache;
            var types = new List<Type>();
            foreach (var assembly in assemblies)
            {
                if (assembly == null) continue;
                try
                {
                    if (assembly.IsDynamic) continue;
                }
                catch (Exception) { continue; }
                try
                {
                    foreach (var type in assembly.GetTypes())
                    {
                        if (type != null) types.Add(type);
                    }
                }
                catch (ReflectionTypeLoadException loadError)
                {
                    if (loadError.Types != null)
                    {
                        foreach (var type in loadError.Types)
                        {
                            if (type != null) types.Add(type);
                        }
                    }
                }
                catch (Exception) { }
            }
            _docsLoadedTypesCache = types.ToArray();
            _docsLoadedAssembliesCache = assemblies;
            return _docsLoadedTypesCache;
        }

        static bool DocsSameAssemblies(Assembly[] left, Assembly[] right)
        {
            if (left == null || right == null || left.Length != right.Length) return false;
            for (var i = 0; i < left.Length; i++)
            {
                if (!ReferenceEquals(left[i], right[i])) return false;
            }
            return true;
        }

        /// <summary>近似类型名建议：前缀匹配优先，其次子串匹配；返回完整名。</summary>
        static List<string> DocsSuggestTypeNames(string name, int max)
        {
            var prefix = new List<string>();
            var contains = new List<string>();
            if (string.IsNullOrEmpty(name)) return prefix;
            var seen = new HashSet<string>(StringComparer.Ordinal);
            foreach (var type in DocsLoadedTypes())
            {
                var fullName = type.FullName;
                if (fullName == null) continue;
                var simpleName = DocsSimpleTypeName(type);
                if (fullName.StartsWith(name, StringComparison.OrdinalIgnoreCase)
                    || simpleName.StartsWith(name, StringComparison.OrdinalIgnoreCase))
                {
                    if (seen.Add(fullName)) prefix.Add(fullName);
                }
                else if (fullName.IndexOf(name, StringComparison.OrdinalIgnoreCase) >= 0
                    || simpleName.IndexOf(name, StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    if (seen.Add(fullName)) contains.Add(fullName);
                }
                if (prefix.Count >= max * 4) break;
            }
            prefix.Sort(StringComparer.Ordinal);
            contains.Sort(StringComparer.Ordinal);
            var results = new List<string>();
            foreach (var item in prefix)
            {
                if (results.Count >= max) break;
                results.Add(item);
            }
            foreach (var item in contains)
            {
                if (results.Count >= max) break;
                results.Add(item);
            }
            return results;
        }

        /// <summary>成员收集（含重载）；memberFilter 非空时只保留同名成员。</summary>
        static List<Dictionary<string, object>> DocsCollectMembers(
            Type type, string memberFilter, bool includeNonPublic, bool includeInherited, int limit, out long total)
        {
            var flags = BindingFlags.Public | BindingFlags.Instance | BindingFlags.Static;
            if (includeNonPublic) flags |= BindingFlags.NonPublic;
            if (!includeInherited) flags |= BindingFlags.DeclaredOnly;
            var rows = new List<Dictionary<string, object>>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var scanned = 0;

            if (memberFilter == null || string.Equals(memberFilter, type.Name, StringComparison.OrdinalIgnoreCase))
            {
                ConstructorInfo[] constructors;
                try { constructors = type.GetConstructors(flags | BindingFlags.Instance); }
                catch (Exception) { constructors = new ConstructorInfo[0]; }
                foreach (var constructor in constructors)
                {
                    if (!includeNonPublic && !constructor.IsPublic) continue;
                    var row = DocsConstructorRow(constructor, type);
                    if (row == null) continue;
                    if (!DocsMatchesMemberFilter(row, memberFilter)) continue;
                    if (seen.Add((string)row["signature"])) rows.Add(row);
                    if (++scanned >= DocsMaxMembersScan) break;
                }
            }

            MethodInfo[] methods;
            try { methods = type.GetMethods(flags); }
            catch (Exception) { methods = new MethodInfo[0]; }
            foreach (var method in methods)
            {
                if (method.IsSpecialName) continue;
                if (!DocsMatchesMemberFilter(method.Name, memberFilter)) continue;
                var row = DocsMethodRow(method);
                if (row == null) continue;
                if (seen.Add((string)row["signature"])) rows.Add(row);
                if (++scanned >= DocsMaxMembersScan) break;
            }

            PropertyInfo[] properties;
            try { properties = type.GetProperties(flags); }
            catch (Exception) { properties = new PropertyInfo[0]; }
            foreach (var property in properties)
            {
                if (!DocsMatchesMemberFilter(property.Name, memberFilter)) continue;
                var row = DocsPropertyRow(property);
                if (row == null) continue;
                if (seen.Add((string)row["signature"])) rows.Add(row);
                if (++scanned >= DocsMaxMembersScan) break;
            }

            FieldInfo[] fields;
            try { fields = type.GetFields(flags); }
            catch (Exception) { fields = new FieldInfo[0]; }
            foreach (var field in fields)
            {
                if (!DocsMatchesMemberFilter(field.Name, memberFilter)) continue;
                var row = DocsFieldRow(field);
                if (row == null) continue;
                if (seen.Add((string)row["signature"])) rows.Add(row);
                if (++scanned >= DocsMaxMembersScan) break;
            }

            EventInfo[] events;
            try { events = type.GetEvents(flags); }
            catch (Exception) { events = new EventInfo[0]; }
            foreach (var eventInfo in events)
            {
                if (!DocsMatchesMemberFilter(eventInfo.Name, memberFilter)) continue;
                var row = DocsEventRow(eventInfo);
                if (row == null) continue;
                if (seen.Add((string)row["signature"])) rows.Add(row);
                if (++scanned >= DocsMaxMembersScan) break;
            }

            total = rows.Count;
            rows.Sort(delegate (Dictionary<string, object> left, Dictionary<string, object> right)
            {
                var kindOrder = DocsMemberKindRank((string)left["kind"]).CompareTo(DocsMemberKindRank((string)right["kind"]));
                if (kindOrder != 0) return kindOrder;
                var nameOrder = string.CompareOrdinal((string)left["name"], (string)right["name"]);
                if (nameOrder != 0) return nameOrder;
                return string.CompareOrdinal((string)left["signature"], (string)right["signature"]);
            });
            if (rows.Count > limit) rows = rows.GetRange(0, limit);
            return rows;
        }

        static bool DocsMatchesMemberFilter(string memberName, string memberFilter)
        {
            if (string.IsNullOrEmpty(memberFilter)) return true;
            return string.Equals(memberName, memberFilter, StringComparison.OrdinalIgnoreCase);
        }

        static bool DocsMatchesMemberFilter(Dictionary<string, object> row, string memberFilter)
        {
            return DocsMatchesMemberFilter((string)row["name"], memberFilter);
        }

        static List<string> DocsSuggestMemberNames(
            Type type, string name, bool includeNonPublic, bool includeInherited, int max)
        {
            var prefix = new List<string>();
            var contains = new List<string>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            if (string.IsNullOrEmpty(name)) return prefix;
            var flags = BindingFlags.Public | BindingFlags.Instance | BindingFlags.Static;
            if (includeNonPublic) flags |= BindingFlags.NonPublic;
            if (!includeInherited) flags |= BindingFlags.DeclaredOnly;
            try
            {
                foreach (var member in type.GetMembers(flags))
                {
                    var memberName = member.Name;
                    if (string.IsNullOrEmpty(memberName)) continue;
                    if (memberName.StartsWith("get_", StringComparison.Ordinal)
                        || memberName.StartsWith("set_", StringComparison.Ordinal)
                        || memberName.StartsWith("add_", StringComparison.Ordinal)
                        || memberName.StartsWith("remove_", StringComparison.Ordinal)
                        || memberName == ".ctor")
                        continue;
                    if (!seen.Add(memberName)) continue;
                    if (memberName.StartsWith(name, StringComparison.OrdinalIgnoreCase)) prefix.Add(memberName);
                    else if (memberName.IndexOf(name, StringComparison.OrdinalIgnoreCase) >= 0) contains.Add(memberName);
                }
            }
            catch (Exception) { }
            prefix.Sort(StringComparer.Ordinal);
            contains.Sort(StringComparer.Ordinal);
            var results = new List<string>();
            foreach (var item in prefix)
            {
                if (results.Count >= max) break;
                results.Add(item);
            }
            foreach (var item in contains)
            {
                if (results.Count >= max) break;
                results.Add(item);
            }
            return results;
        }

        // ------------------------------------------------------------------
        // 成员签名格式化（C# 风格）
        // ------------------------------------------------------------------

        static Dictionary<string, object> DocsConstructorRow(ConstructorInfo constructor, Type type)
        {
            var parameters = constructor.GetParameters();
            var signature = new StringBuilder();
            signature.Append(DocsAccessOfMethod(constructor)).Append(' ').Append(DocsSimpleTypeName(type));
            signature.Append('(').Append(DocsParameterSignatureList(parameters)).Append(')');
            return DocsMemberRow("constructor", DocsSimpleTypeName(type), signature.ToString(), false,
                constructor.IsPublic, string.Empty, DocsParameterRows(parameters));
        }

        static Dictionary<string, object> DocsMethodRow(MethodInfo method)
        {
            var parameters = method.GetParameters();
            var builder = new StringBuilder();
            builder.Append(DocsAccessOfMethod(method));
            if (method.IsStatic) builder.Append(" static");
            if (method.IsAbstract) builder.Append(" abstract");
            else if (method.IsVirtual && method.GetBaseDefinition() != method) builder.Append(" override");
            else if (method.IsVirtual) builder.Append(" virtual");
            builder.Append(' ').Append(DocsTypeName(method.ReturnType)).Append(' ').Append(method.Name);
            if (method.IsGenericMethodDefinition)
            {
                builder.Append('<');
                var genericArguments = method.GetGenericArguments();
                for (var i = 0; i < genericArguments.Length; i++)
                {
                    if (i > 0) builder.Append(", ");
                    builder.Append(genericArguments[i].Name);
                }
                builder.Append('>');
            }
            builder.Append('(').Append(DocsParameterSignatureList(parameters)).Append(')');
            return DocsMemberRow("method", method.Name, builder.ToString(), method.IsStatic,
                method.IsPublic, DocsTypeName(method.ReturnType), DocsParameterRows(parameters));
        }

        static Dictionary<string, object> DocsPropertyRow(PropertyInfo property)
        {
            var getter = property.GetGetMethod(true);
            var setter = property.GetSetMethod(true);
            var getterAccess = getter != null ? DocsAccessOfMethod(getter) : null;
            var setterAccess = setter != null ? DocsAccessOfMethod(setter) : null;
            var access = DocsMoreVisibleAccess(getterAccess, setterAccess);
            var isStatic = (getter != null && getter.IsStatic) || (setter != null && setter.IsStatic);
            var isPublic = (getter != null && getter.IsPublic) || (setter != null && setter.IsPublic);
            var indexParameters = property.GetIndexParameters();
            var builder = new StringBuilder();
            builder.Append(access);
            if (isStatic) builder.Append(" static");
            builder.Append(' ').Append(DocsTypeName(property.PropertyType)).Append(' ').Append(property.Name);
            if (indexParameters.Length > 0)
                builder.Append('[').Append(DocsParameterSignatureList(indexParameters)).Append(']');
            if (getter != null && setter != null) builder.Append(" { get; set; }");
            else if (getter != null) builder.Append(" { get; }");
            else builder.Append(" { set; }");
            return DocsMemberRow("property", property.Name, builder.ToString(), isStatic, isPublic,
                DocsTypeName(property.PropertyType), DocsParameterRows(indexParameters));
        }

        static Dictionary<string, object> DocsFieldRow(FieldInfo field)
        {
            var builder = new StringBuilder();
            builder.Append(DocsAccessOfField(field));
            if (field.IsStatic) builder.Append(" static");
            if (field.IsLiteral) builder.Append(" const");
            else if (field.IsInitOnly) builder.Append(" readonly");
            builder.Append(' ').Append(DocsTypeName(field.FieldType)).Append(' ').Append(field.Name);
            return DocsMemberRow("field", field.Name, builder.ToString(), field.IsStatic, field.IsPublic,
                DocsTypeName(field.FieldType), new List<object>());
        }

        static Dictionary<string, object> DocsEventRow(EventInfo eventInfo)
        {
            var addMethod = eventInfo.GetAddMethod(true);
            var access = addMethod != null ? DocsAccessOfMethod(addMethod) : "private";
            var isStatic = addMethod != null && addMethod.IsStatic;
            var isPublic = addMethod != null && addMethod.IsPublic;
            var builder = new StringBuilder();
            builder.Append(access);
            if (isStatic) builder.Append(" static");
            builder.Append(" event ").Append(DocsTypeName(eventInfo.EventHandlerType)).Append(' ').Append(eventInfo.Name);
            return DocsMemberRow("event", eventInfo.Name, builder.ToString(), isStatic, isPublic,
                DocsTypeName(eventInfo.EventHandlerType), new List<object>());
        }

        static Dictionary<string, object> DocsMemberRow(
            string kind, string name, string signature, bool isStatic, bool isPublic, string returnType, List<object> parameters)
        {
            var row = new Dictionary<string, object>();
            row["kind"] = kind;
            row["name"] = name;
            row["signature"] = signature;
            row["isStatic"] = isStatic;
            row["isPublic"] = isPublic;
            row["returnType"] = returnType ?? string.Empty;
            row["parameters"] = parameters ?? new List<object>();
            return row;
        }

        static int DocsMemberKindRank(string kind)
        {
            switch (kind)
            {
                case "constructor": return 0;
                case "property": return 1;
                case "field": return 2;
                case "event": return 3;
                case "method": return 4;
                default: return 5;
            }
        }

        static List<object> DocsParameterRows(ParameterInfo[] parameters)
        {
            var rows = new List<object>();
            if (parameters == null) return rows;
            foreach (var parameter in parameters)
            {
                var row = new Dictionary<string, object>();
                row["name"] = parameter.Name ?? ("arg" + parameter.Position);
                row["type"] = DocsTypeName(parameter.ParameterType);
                row["isOptional"] = parameter.IsOptional;
                row["isOut"] = parameter.IsOut;
                if (parameter.ParameterType.IsByRef) row["isRef"] = !parameter.IsOut;
                if (DocsIsParamsParameter(parameter)) row["isParams"] = true;
                rows.Add(row);
            }
            return rows;
        }

        static string DocsParameterSignatureList(ParameterInfo[] parameters)
        {
            if (parameters == null || parameters.Length == 0) return string.Empty;
            var parts = new List<string>();
            foreach (var parameter in parameters)
            {
                var part = new StringBuilder();
                if (DocsIsParamsParameter(parameter)) part.Append("params ");
                else if (parameter.IsOut) part.Append("out ");
                else if (parameter.ParameterType.IsByRef) part.Append("ref ");
                part.Append(DocsTypeName(parameter.ParameterType)).Append(' ')
                    .Append(parameter.Name ?? ("arg" + parameter.Position));
                if (parameter.IsOptional) part.Append(" = default");
                parts.Add(part.ToString());
            }
            return string.Join(", ", parts.ToArray());
        }

        static bool DocsIsParamsParameter(ParameterInfo parameter)
        {
            try
            {
                return parameter.GetCustomAttributes(typeof(ParamArrayAttribute), false).Length > 0;
            }
            catch (Exception)
            {
                return false;
            }
        }

        /// <summary>C# 风格类型名：内建别名 + 泛型 + 数组 + Nullable。</summary>
        static string DocsTypeName(Type type)
        {
            if (type == null) return string.Empty;
            if (type.IsByRef) return DocsTypeName(type.GetElementType());
            if (type.IsPointer) return DocsTypeName(type.GetElementType()) + "*";
            if (type.IsArray)
            {
                var rank = type.GetArrayRank();
                var suffix = rank <= 1 ? "[]" : "[" + new string(',', rank - 1) + "]";
                return DocsTypeName(type.GetElementType()) + suffix;
            }
            if (type.IsGenericParameter) return type.Name;
            string alias;
            if (DocsTypeAliases.TryGetValue(type, out alias)) return alias;
            if (type.IsGenericType)
            {
                if (type.GetGenericTypeDefinition() == typeof(Nullable<>))
                    return DocsTypeName(type.GetGenericArguments()[0]) + "?";
                var name = type.Name;
                var tick = name.IndexOf('`');
                if (tick >= 0) name = name.Substring(0, tick);
                var arguments = type.GetGenericArguments();
                var parts = new List<string>();
                foreach (var argument in arguments) parts.Add(DocsTypeName(argument));
                return name + "<" + string.Join(", ", parts.ToArray()) + ">";
            }
            return type.Name;
        }

        static string DocsSimpleTypeName(Type type)
        {
            if (type == null) return string.Empty;
            var name = type.Name;
            var tick = name.IndexOf('`');
            return tick >= 0 ? name.Substring(0, tick) : name;
        }

        static string DocsTypeKind(Type type)
        {
            if (type == null) return "unknown";
            if (type.IsEnum) return "enum";
            if (type.IsInterface) return "interface";
            if (typeof(Delegate).IsAssignableFrom(type)) return "delegate";
            if (type.IsValueType) return "struct";
            return "class";
        }

        static string DocsAssemblyName(Type type)
        {
            try
            {
                var name = type.Assembly.GetName();
                return name != null && !string.IsNullOrEmpty(name.Name) ? name.Name : "unknown";
            }
            catch (Exception)
            {
                return "unknown";
            }
        }

        static string DocsAccessOfMethod(MethodBase method)
        {
            if (method == null) return "private";
            if (method.IsPublic) return "public";
            if (method.IsFamilyOrAssembly) return "protected internal";
            if (method.IsFamily) return "protected";
            if (method.IsAssembly) return "internal";
            if (method.IsFamilyAndAssembly) return "private protected";
            return "private";
        }

        static string DocsAccessOfField(FieldInfo field)
        {
            if (field == null) return "private";
            if (field.IsPublic) return "public";
            if (field.IsFamilyOrAssembly) return "protected internal";
            if (field.IsFamily) return "protected";
            if (field.IsAssembly) return "internal";
            if (field.IsFamilyAndAssembly) return "private protected";
            return "private";
        }

        static string DocsMoreVisibleAccess(string left, string right)
        {
            if (string.IsNullOrEmpty(left)) return string.IsNullOrEmpty(right) ? "private" : right;
            if (string.IsNullOrEmpty(right)) return left;
            return DocsAccessRank(left) >= DocsAccessRank(right) ? left : right;
        }

        static int DocsAccessRank(string access)
        {
            switch (access)
            {
                case "public": return 5;
                case "protected internal": return 4;
                case "protected": return 3;
                case "internal": return 2;
                case "private protected": return 1;
                default: return 0;
            }
        }

        static long DocsClampLong(long value, long min, long max)
        {
            if (value < min) return min;
            if (value > max) return max;
            return value;
        }

        static List<object> DocsToStringObjects(List<string> values)
        {
            var list = new List<object>();
            if (values == null) return list;
            foreach (var value in values) list.Add(value);
            return list;
        }
    }
}
#endif
