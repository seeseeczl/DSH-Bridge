        static Dictionary<string, object> DocsSearch(Dictionary<string, object> args)
        {
            var query = GetString(args, "query");
            if (query == null || query.Trim().Length == 0)
                throw new KnownError("invalid_argument", "缺少 query");
            query = query.Trim();
            if (query.Length > 200) query = query.Substring(0, 200);
            var limit = (int)DocsClampLong(ToLong(args, "limit", DocsDefaultSearchLimit), 1, DocsMaxSearchLimit);
            var root = DocsResolveRoot(args);
            var entries = DocsLoadIndex(root.Root);

            var hits = new List<DocsSearchHit>();
            foreach (var entry in entries)
            {
                var score = DocsSearchScore(query, entry.Id, entry.Title);
                if (score <= 0) continue;
                var hit = new DocsSearchHit();
                hit.Entry = entry;
                hit.Score = score;
                hits.Add(hit);
            }
            hits.Sort(delegate (DocsSearchHit a, DocsSearchHit b)
            {
                if (a.Score != b.Score) return b.Score.CompareTo(a.Score);
                var byTitle = string.Compare(a.Entry.Title, b.Entry.Title, StringComparison.OrdinalIgnoreCase);
                if (byTitle != 0) return byTitle;
                return string.CompareOrdinal(a.Entry.Id, b.Entry.Id);
            });

            var results = new List<object>();
            for (var i = 0; i < hits.Count && i < limit; i++)
            {
                var entry = hits[i].Entry;
                var row = new Dictionary<string, object>();
                row["id"] = entry.Id;
                row["title"] = entry.Title;
                row["page"] = entry.Id + ".html";
                row["kind"] = entry.Kind;
                results.Add(row);
            }

            var d = new Dictionary<string, object>();
            d["available"] = true;
            d["source"] = "local-docs";
            d["language"] = root.Language;
            d["documentationRoot"] = root.Root;
            d["availableLanguages"] = DocsToStringObjects(root.AvailableLanguages);
            d["count"] = (long)hits.Count;
            d["limit"] = (long)limit;
            d["truncated"] = hits.Count > limit;
            d["results"] = results;
            if (hits.Count == 0)
                d["hint"] = "本地文档索引中没有标题或 id 命中该 query；可换关键词，或先用较短的名字（如 Rigidbody）检索";
            return d;
        }

        /// <summary>标题/ id 模糊匹配 + 排序分（全部 token 必须命中其一）。</summary>
        static long DocsSearchScore(string query, string id, string title)
        {
            if (string.IsNullOrEmpty(query)) return 0;
            if (id == null) id = string.Empty;
            if (title == null) title = string.Empty;
            var tokens = query.Split(new char[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            if (tokens.Length == 0) return 0;
            foreach (var token in tokens)
            {
                if (id.IndexOf(token, StringComparison.OrdinalIgnoreCase) < 0
                    && title.IndexOf(token, StringComparison.OrdinalIgnoreCase) < 0)
                    return 0;
            }
            long score = 10;
            if (string.Equals(id, query, StringComparison.OrdinalIgnoreCase)) score = 100;
            else if (string.Equals(title, query, StringComparison.OrdinalIgnoreCase)) score = 90;
            else if (id.StartsWith(query, StringComparison.OrdinalIgnoreCase)) score = 80;
            else if (title.StartsWith(query, StringComparison.OrdinalIgnoreCase)) score = 70;
            else if (id.IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0) score = 50;
            else if (title.IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0) score = 40;
            // 同一命中层级下，短 id（更接近类型本身）优先。
            score -= Math.Min(9L, id.Length / 16);
            return score;
        }

