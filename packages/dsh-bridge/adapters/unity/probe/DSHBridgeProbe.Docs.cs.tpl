        static DocsRootInfo DocsResolveRoot(Dictionary<string, object> args)
        {
            var requested = DocsNormalizeLanguage(GetString(args, "language"));
            string contents = null;
            try { contents = EditorApplication.applicationContentsPath; }
            catch (Exception) { }
            if (string.IsNullOrEmpty(contents))
                throw new KnownError(
                    "docs_unavailable",
                    "无法定位编辑器安装目录（applicationContentsPath 为空）",
                    "本地文档可能未随引擎安装；可在引擎安装器里勾选 Documentation，或改用在线文档");
            contents = contents.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            var documentationDir = Path.Combine(contents, "Documentation");
            if (!Directory.Exists(documentationDir))
                throw new KnownError(
                    "docs_unavailable",
                    "编辑器未安装本地文档目录: " + documentationDir,
                    "部分安装器不附带 Documentation；请在安装器中补充安装，或改用在线文档");

            var available = DocsAvailableLanguages(documentationDir);
            if (available.Count == 0)
                throw new KnownError(
                    "docs_unavailable",
                    "Documentation 下没有任何含 ScriptReference 的语言目录",
                    "目录=" + documentationDir + "；文档安装可能不完整，可改用在线文档");

            string language = null;
            if (requested != null)
            {
                foreach (var item in available)
                {
                    if (string.Equals(item, requested, StringComparison.OrdinalIgnoreCase))
                    {
                        language = item;
                        break;
                    }
                }
                if (language == null)
                    throw new KnownError(
                        "docs_unavailable",
                        "本地文档不包含语言 " + requested,
                        "可用语言：" + string.Join(", ", available.ToArray()));
            }
            else
            {
                // 自动探测：Unity 默认 en；Tuanjie 通常只有 zh_CN。
                foreach (var item in available)
                {
                    if (string.Equals(item, "en", StringComparison.OrdinalIgnoreCase)) { language = item; break; }
                }
                if (language == null)
                {
                    foreach (var item in available)
                    {
                        if (string.Equals(item, "zh_CN", StringComparison.OrdinalIgnoreCase)) { language = item; break; }
                    }
                }
                if (language == null) language = available[0];
            }

            var root = Path.Combine(Path.Combine(documentationDir, language), "ScriptReference");
            if (!Directory.Exists(root))
                throw new KnownError(
                    "docs_unavailable",
                    "文档语言目录存在但缺少 ScriptReference: " + root,
                    "文档安装可能不完整；可用语言：" + string.Join(", ", available.ToArray()));

            var info = new DocsRootInfo();
            info.Contents = contents;
            info.DocumentationDir = documentationDir;
            info.Language = language;
            info.Root = root;
            info.AvailableLanguages = available;
            return info;
        }

        /// <summary>路径必须落在 root 内。越界抛 invalid_argument（不接受 ../ 或绝对路径逃逸）。</summary>
        static string DocsEnsureInside(string root, string path)
        {
            string fullRoot;
            string fullPath;
            try
            {
                fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                fullPath = Path.GetFullPath(path);
            }
            catch (Exception e)
            {
                throw new KnownError("invalid_argument", "文档路径无法解析，已拒绝", e.GetType().Name + ": " + e.Message);
            }
            if (!string.Equals(fullPath, fullRoot, StringComparison.Ordinal)
                && !fullPath.StartsWith(fullRoot + Path.DirectorySeparatorChar, StringComparison.Ordinal)
                && !fullPath.StartsWith(fullRoot + Path.AltDirectorySeparatorChar, StringComparison.Ordinal))
                throw new KnownError("invalid_argument", "文档路径越界，已拒绝: " + path, "documentationRoot=" + fullRoot);
            return fullPath;
        }

        /// <summary>文档 id 只允许字母数字与 . _ -（真实 Unity/Tuanjie 索引全部满足），阻断路径拼接。</summary>
        static bool DocsIsSafeDocId(string id)
        {
            if (string.IsNullOrEmpty(id) || id.Length > 200) return false;
            if (id == "." || id == "..") return false;
            if (id.IndexOf("..", StringComparison.Ordinal) >= 0) return false;
            for (var i = 0; i < id.Length; i++)
            {
                var c = id[i];
                if (c >= 'a' && c <= 'z') continue;
                if (c >= 'A' && c <= 'Z') continue;
                if (c >= '0' && c <= '9') continue;
                if (c == '.' || c == '_' || c == '-') continue;
                return false;
            }
            return true;
        }

        // ------------------------------------------------------------------
        // 文档索引：docdata/index.json（约 7MB）
        // 只做正则提取 ["id","title"] 对，不引入 MiniJson 全量解析（内存/耗时都不可接受）。
        // ------------------------------------------------------------------

        sealed class DocsIndexEntry
        {
            public string Id;
            public string Title;
            public string Kind;
        }

        sealed class DocsSearchHit
        {
            public DocsIndexEntry Entry;
            public long Score;
