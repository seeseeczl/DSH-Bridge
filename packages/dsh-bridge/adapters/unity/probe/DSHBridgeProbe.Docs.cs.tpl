        /// <summary>
        /// 归一化语言参数。返回 null 表示自动探测；非法字符直接拒绝（不允许路径式语言名）。
        /// 兼容 Tuanjie 的 zh_CN 与常见写法 zh-cn。
        /// </summary>
        static string DocsNormalizeLanguage(string raw)
        {
            if (raw == null) return null;
            var language = raw.Trim();
            if (language.Length == 0) return null;
            if (string.Equals(language, "auto", StringComparison.OrdinalIgnoreCase)) return null;
            if (language.Length > 32)
                throw new KnownError("invalid_argument", "language 过长: " + language);
            for (var i = 0; i < language.Length; i++)
            {
                var c = language[i];
                if (c >= 'a' && c <= 'z') continue;
                if (c >= 'A' && c <= 'Z') continue;
                if (c >= '0' && c <= '9') continue;
                if (c == '_' || c == '-') continue;
                // 语言名不允许路径分隔符 / 点 / 空格，避免被拼进路径后越界。
                throw new KnownError("invalid_argument", "language 含非法字符（只允许字母、数字、_、-）: " + language);
            }
            if (string.Equals(language, "zh-cn", StringComparison.OrdinalIgnoreCase)
                || string.Equals(language, "zh_cn", StringComparison.OrdinalIgnoreCase))
                return "zh_CN";
            if (string.Equals(language, "en-us", StringComparison.OrdinalIgnoreCase)
                || string.Equals(language, "en_us", StringComparison.OrdinalIgnoreCase))
                return "en";
            return language;
        }

        /// <summary>列出 Documentation 下真正含 ScriptReference 的语言目录（排序稳定）。</summary>
        static List<string> DocsAvailableLanguages(string documentationDir)
        {
            var languages = new List<string>();
            try
            {
                foreach (var dir in Directory.GetDirectories(documentationDir))
                {
                    var name = Path.GetFileName(dir);
                    if (string.IsNullOrEmpty(name)) continue;
                    if (Directory.Exists(Path.Combine(dir, "ScriptReference"))) languages.Add(name);
                }
            }
            catch (Exception) { }
            languages.Sort(StringComparer.Ordinal);
            return languages;
        }

