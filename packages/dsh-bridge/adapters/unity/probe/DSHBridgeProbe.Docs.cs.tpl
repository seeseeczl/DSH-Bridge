        // 真实格式：{"pages": \n[["Rigidbody", "Rigidbody"], ...]}
        static readonly Regex DocsIndexPairRegex = new Regex(
            @"\[\s*""((?:[^""\\]|\\.)+)""\s*,\s*""((?:[^""\\]|\\.)*)""",
            RegexOptions.Compiled);

        static List<DocsIndexEntry> _docsIndexEntries;
        static string _docsIndexCachePath;
        static long _docsIndexCacheStamp;

        /// <summary>读取并静态缓存索引；文件时间/大小变化时自动重载。</summary>
        static List<DocsIndexEntry> DocsLoadIndex(string root)
        {
            var indexPath = Path.Combine(Path.Combine(root, "docdata"), "index.json");
            DocsEnsureInside(root, indexPath);
            long length;
            long stamp;
            try
            {
                var info = new FileInfo(indexPath);
                if (!info.Exists)
                    throw new KnownError(
                        "docs_unavailable",
                        "本地文档索引缺失: " + indexPath,
                        "该语言文档没有 docdata/index.json；Documentation 安装可能不完整，可改用在线文档");
                length = info.Length;
                stamp = info.LastWriteTimeUtc.Ticks;
            }
            catch (KnownError) { throw; }
            catch (Exception e)
            {
                throw new KnownError("docs_unavailable", "无法读取本地文档索引: " + indexPath,
                    e.GetType().Name + ": " + e.Message);
            }
            if (length <= 0)
                throw new KnownError("docs_unavailable", "本地文档索引为空: " + indexPath, "index.json 是空文件，Documentation 安装可能不完整");
            if (length > DocsMaxIndexBytes)
                throw new KnownError("docs_unavailable", "本地文档索引异常过大，已拒绝读取", "bytes=" + length + " path=" + indexPath);
            var cacheStamp = stamp ^ length;
            if (_docsIndexEntries != null
                && string.Equals(_docsIndexCachePath, indexPath, StringComparison.Ordinal)
                && _docsIndexCacheStamp == cacheStamp)
                return _docsIndexEntries;

            string text;
            try { text = File.ReadAllText(indexPath, Encoding.UTF8); }
            catch (Exception e)
            {
                throw new KnownError("docs_unavailable", "读取本地文档索引失败: " + indexPath,
                    e.GetType().Name + ": " + e.Message);
            }

            var entries = new List<DocsIndexEntry>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            try
            {
                var match = DocsIndexPairRegex.Match(text);
                while (match.Success)
                {
                    var id = DocsUnescapeJson(match.Groups[1].Value).Trim();
                    var title = DocsUnescapeJson(match.Groups[2].Value).Trim();
                    // 不安全 id（含路径符号）直接丢弃：索引是文件内容，不能让它决定读取路径。
                    if (id.Length > 0 && DocsIsSafeDocId(id) && seen.Add(id))
                    {
                        var entry = new DocsIndexEntry();
                        entry.Id = id;
                        entry.Title = title.Length == 0 ? id : title;
                        entry.Kind = DocsDocKind(id);
                        entries.Add(entry);
                    }
                    match = match.NextMatch();
                }
            }
            catch (Exception e)
            {
                throw new KnownError("docs_unavailable", "解析本地文档索引失败: " + indexPath,
                    e.GetType().Name + ": " + e.Message);
            }
            if (entries.Count == 0)
                throw new KnownError(
                    "docs_unavailable",
                    "本地文档索引格式无法识别: " + indexPath,
                    "未提取到任何 [id, title] 对；文档版本可能与本探针不兼容，可改用在线文档");

            _docsIndexCachePath = indexPath;
            _docsIndexCacheStamp = cacheStamp;
            _docsIndexEntries = entries;
            return entries;
        }

        /// <summary>页面类别是启发式：成员页文件名带连字符（Rigidbody-angularDrag），其余算 page。</summary>
        static string DocsDocKind(string id)
        {
            if (!string.IsNullOrEmpty(id) && id.IndexOf('-') > 0) return "member";
            return "page";
        }

        /// <summary>JSON 字符串反转义（索引正则拿到的是原始转义文本）。</summary>
        static string DocsUnescapeJson(string value)
        {
            if (string.IsNullOrEmpty(value) || value.IndexOf('\\') < 0) return value ?? string.Empty;
            var sb = new StringBuilder(value.Length);
            for (var i = 0; i < value.Length; i++)
            {
                var c = value[i];
                if (c != '\\' || i + 1 >= value.Length) { sb.Append(c); continue; }
                var next = value[++i];
                switch (next)
                {
                    case '"': sb.Append('"'); break;
                    case '\\': sb.Append('\\'); break;
                    case '/': sb.Append('/'); break;
                    case 'b': sb.Append('\b'); break;
                    case 'f': sb.Append('\f'); break;
                    case 'n': sb.Append('\n'); break;
                    case 'r': sb.Append('\r'); break;
                    case 't': sb.Append('\t'); break;
                    case 'u':
                        {
                            int code;
                            if (i + 4 < value.Length
                                && int.TryParse(value.Substring(i + 1, 4), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out code))
                            {
                                sb.Append((char)code);
                                i += 4;
                            }
                            else
                            {
                                sb.Append("\\u");
                            }
                            break;
                        }
                    default: sb.Append(next); break;
                }
            }
            return sb.ToString();
        }

