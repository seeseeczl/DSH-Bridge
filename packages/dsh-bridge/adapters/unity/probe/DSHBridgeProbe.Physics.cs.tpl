            var gameObject = PhysicsGameObjectOf(target);
            var components = gameObject.GetComponents<Joint>();
            var joints = new List<Joint>(components);
            if (joints.Count == 0) throw new KnownError("not_found", "目标对象上没有关节组件: " + gameObject.name);
            return joints;
