        /// <summary>取 target 参数；缺失时退回整份 args（兼容扁平写法）。</summary>
        static Dictionary<string, object> PhysicsInnerTarget(Dictionary<string, object> args)
        {
            if (args == null) throw new KnownError("invalid_argument", "缺少参数");
            object nested;
            if (!args.TryGetValue("target", out nested)) return args;
            var dict = nested as Dictionary<string, object>;
            if (dict == null) throw new KnownError("invalid_argument", "target 必须是对象，形如 {\"handle\":\"h1\"} 或 {\"path\":\"Root/Child\"}");
            return dict;
        }

        /// <summary>按 target.handle / target.path 解析目标对象（handle 优先）。</summary>
        static object PhysicsResolveTargetSpec(Dictionary<string, object> spec)
        {
            var handle = GetString(spec, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                if (obj == null) throw new KnownError("handle_not_found", "句柄已失效或被回收: " + handle);
                return obj;
            }
            var path = GetString(spec, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var found = FindTransformByPath(path);
                if (found == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                return found.gameObject;
            }
            throw new KnownError("invalid_argument", "需要 target.handle 或 target.path");
        }

        static object PhysicsResolveTargetObject(Dictionary<string, object> args)
        {
            return PhysicsResolveTargetSpec(PhysicsInnerTarget(args));
