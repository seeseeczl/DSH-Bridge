        static bool PhysicsToBool(object raw, string what)
        {
            if (raw == null) throw new KnownError("invalid_argument", "缺少 " + what);
            if (raw is bool) return (bool)raw;
            var text = raw as string;
            if (text != null)
            {
                bool parsed;
                if (bool.TryParse(text, out parsed)) return parsed;
                throw new KnownError("invalid_argument", what + " 必须是布尔值");
            }
            try { return System.Convert.ToBoolean(raw, CultureInfo.InvariantCulture); }
            catch (Exception) { throw new KnownError("invalid_argument", what + " 必须是布尔值"); }
        }

        /// <summary>把 enum 类型 + 外部值（枚举名或数字）转成枚举实例；失败返回 invalid_argument。</summary>
        static object PhysicsParseEnum(Type enumType, object raw, string what)
        {
            if (enumType == null || !enumType.IsEnum) throw new KnownError("invalid_argument", what + " 不是枚举成员");
            if (raw == null) throw new KnownError("invalid_argument", "缺少 " + what);
            var text = raw as string;
            if (text != null)
            {
                try { return Enum.Parse(enumType, text, true); }
                catch (Exception) { throw new KnownError("invalid_argument", what + " 不是合法枚举名: " + text); }
            }
            long numeric;
            try { numeric = System.Convert.ToInt64(raw, CultureInfo.InvariantCulture); }
            catch (Exception) { throw new KnownError("invalid_argument", what + " 需要枚举名或数字"); }
            try { return Enum.ToObject(enumType, numeric); }
            catch (Exception) { throw new KnownError("invalid_argument", what + " 枚举值越界: " + numeric); }
        }

        static T PhysicsParseEnum<T>(object raw, string what) where T : struct
        {
            return (T)PhysicsParseEnum(typeof(T), raw, what);
        }

