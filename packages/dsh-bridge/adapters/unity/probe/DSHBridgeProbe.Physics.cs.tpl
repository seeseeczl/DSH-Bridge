        /// <summary>按候选成员名依次反射读取（属性优先于字段）；全部缺失返回 null。</summary>
        static object PhysicsReadFirst(object target, params string[] names)
        {
            if (target == null || names == null) return null;
            var type = target.GetType();
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance;
            for (var i = 0; i < names.Length; i++)
            {
                var name = names[i];
                if (string.IsNullOrEmpty(name)) continue;
                try
                {
                    for (var current = type; current != null; current = current.BaseType)
                    {
                        var property = current.GetProperty(name, flags);
                        if (property != null && property.CanRead && property.GetIndexParameters().Length == 0)
                            return property.GetValue(target, null);
                        var field = current.GetField(name, flags);
                        if (field != null) return field.GetValue(target);
                    }
                }
                catch (Exception)
                {
                    // 某个候选名在当前版本上不可读（例如被 [Obsolete] 包装）时继续试下一个。
                }
            }
            return null;
        }

        /// <summary>按候选成员名依次反射写入；返回实际命中的名字，全部缺失返回 null。</summary>
        static string PhysicsWriteFirst(object target, string[] names, object raw)
        {
            if (target == null || names == null) return null;
            var type = target.GetType();
            for (var i = 0; i < names.Length; i++)
            {
                var name = names[i];
                if (string.IsNullOrEmpty(name)) continue;
                try
                {
                    SetMember(target, type, name, raw, false);
                    return name;
                }
                catch (KnownError e)
                {
                    // 成员在当前版本不存在，或不可写：都视为「该候选名不适用」继续试下一个。
                    if (e.Code == "member_not_found" || e.Code == "readonly_member") continue;
                    throw;
                }
            }
            return null;
        }

        /// <summary>数字统一转 double（JSON 数值）；非数值原样返回。</summary>
        static object PhysicsNumber(object value)
        {
            if (value == null) return null;
            if (value is double) return value;
            if (value is float) return (double)(float)value;
            if (value is decimal) return (double)(decimal)value;
            if (value is long) return value;
            if (value is int) return (long)(int)value;
            if (value is short) return (long)(short)value;
            if (value is byte) return (long)(byte)value;
            return value;
        }

