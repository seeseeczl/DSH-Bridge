        /// <summary>
        /// FindObjectsOfType&lt;Joint&gt;(true)：优先 includeInactive 重载，缺失时退回无参重载。
        /// includeInactive 输出实际生效情况，避免「没查 inactive 却声称查了」（离线 stub 就是 false）。
        /// </summary>
        static Joint[] PhysicsFindJoints(out bool includeInactive)
        {
            includeInactive = false;
            try
            {
                var method = typeof(UnityEngine.Object).GetMethod(
                    "FindObjectsOfType", BindingFlags.Public | BindingFlags.Static, null, new Type[] { typeof(bool) }, null);
                if (method != null && method.IsGenericMethodDefinition)
                {
                    var generic = method.MakeGenericMethod(typeof(Joint));
                    var found = generic.Invoke(null, new object[] { true }) as Joint[];
                    if (found != null)
                    {
                        includeInactive = true;
                        return found;
                    }
                }
            }
            catch (Exception)
            {
                // 老版本/离线 stub 没有该重载：退回只查激活对象。
            }
            return UnityEngine.Object.FindObjectsOfType<Joint>();
        }

        static Dictionary<string, object> PhysicsJointDescriptor(Joint joint)
        {
            var d = new Dictionary<string, object>();
            d["handle"] = PutHandle(joint);
            d["type"] = joint.GetType().Name;
            var gameObject = joint.gameObject;
            d["path"] = gameObject != null && gameObject.transform != null ? ScenePathOf(gameObject.transform) : null;
            var connected = joint.connectedBody;
            d["connectedBody"] = connected != null ? DescribeRef(connected) : null;
            // Joint 在真实 Unity 里继承 Component（不像 Behaviour 那样有 enabled），
            // 所以按成员反射探测：取不到就返回 null，并用 enabledKnown=false 明示，绝不编造。
            var enabled = PhysicsReadFirst(joint, "enabled");
            d["enabled"] = enabled;
            d["enabledKnown"] = enabled != null;
            d["enableCollision"] = joint.enableCollision;
            return d;
        }

        static List<Joint> PhysicsSelectJoints(List<Joint> joints, Dictionary<string, object> args)
        {
            var index = ToLong(args, "index", -1);
            if (index < 0) return joints;
            if (index >= joints.Count)
                throw new KnownError("not_found", "index 越界: " + index.ToString(CultureInfo.InvariantCulture) + "（共 " + joints.Count + " 个关节）");
            var single = new List<Joint>();
            single.Add(joints[(int)index]);
            return single;
        }

        static Dictionary<string, object> PhysicsJoints(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) throw new KnownError("invalid_argument", "缺少 action（list/get/add/set/remove）");

            if (action == "list")
            {
                var limit = PhysicsCollectionLimit(args, 100);
                bool includeInactive;
                var all = PhysicsFindJoints(out includeInactive);
                var rows = new List<object>();
                for (var i = 0; i < all.Length && rows.Count < limit; i++) rows.Add(PhysicsJointDescriptor(all[i]));
                var result = new Dictionary<string, object>();
                result["joints"] = rows;
                result["count"] = (long)rows.Count;
                result["truncated"] = all.Length > rows.Count;
                result["includeInactive"] = includeInactive;
                return result;
            }

            if (action == "add")
            {
                var gameObject = PhysicsResolveGameObject(args);
                var typeName = GetString(args, "type");
                if (string.IsNullOrEmpty(typeName))
                    throw new KnownError("invalid_argument", "add 需要 type（hinge/fixed/spring/character/configurable）");
                var key = typeName.ToLowerInvariant();
                Joint joint;
                if (key == "hinge") joint = gameObject.AddComponent<HingeJoint>();
                else if (key == "fixed") joint = gameObject.AddComponent<FixedJoint>();
                else if (key == "spring") joint = gameObject.AddComponent<SpringJoint>();
                else if (key == "character") joint = gameObject.AddComponent<CharacterJoint>();
                else if (key == "configurable") joint = gameObject.AddComponent<ConfigurableJoint>();
                else throw new KnownError("invalid_argument", "未知关节类型: " + typeName + "（支持 hinge/fixed/spring/character/configurable）");
                if (joint == null) throw new KnownError("not_found", "添加关节失败: " + typeName);
                var applied = new List<object>();
                applied.Add("type");
                if (args.ContainsKey("connectedBody"))
                {
                    joint.connectedBody = PhysicsResolveRigidbodyRef(args["connectedBody"]);
                    applied.Add("connectedBody");
                }
                Undo.RegisterCreatedObjectUndo(joint, "DSH Add " + joint.GetType().Name);
                EditorUtility.SetDirty(joint);
                var result = new Dictionary<string, object>();
                var rows = new List<object>();
                rows.Add(PhysicsJointDescriptor(joint));
                result["joints"] = rows;
                result["count"] = 1L;
                result["truncated"] = false;
                result["applied"] = applied;
                return result;
            }

            var joints = PhysicsResolveJoints(args);
            var selected = PhysicsSelectJoints(joints, args);

            if (action == "get")
            {
                var rows = new List<object>();
                for (var i = 0; i < selected.Count; i++) rows.Add(PhysicsJointDescriptor(selected[i]));
                var result = new Dictionary<string, object>();
                result["joints"] = rows;
                result["count"] = (long)rows.Count;
                result["truncated"] = false;
                return result;
            }

            if (action == "set")
            {
                var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
                if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes 对象");
                var applied = new List<object>();
                var ignored = new List<object>();
                for (var i = 0; i < selected.Count; i++) Undo.RecordObject(selected[i], "DSH Set Joint");
                foreach (var pair in changes)
                {
                    var key = pair.Key;
                    if (key == "connectedBody")
                    {
                        for (var i = 0; i < selected.Count; i++) selected[i].connectedBody = PhysicsResolveRigidbodyRef(pair.Value);
                        applied.Add(key);
                        continue;
                    }
                    var written = PhysicsWriteFirst(selected[0], new string[] { key }, pair.Value);
                    if (written == null) { ignored.Add(key); continue; }
                    for (var i = 1; i < selected.Count; i++) PhysicsWriteFirst(selected[i], new string[] { written }, pair.Value);
                    applied.Add(key);
                }
                for (var i = 0; i < selected.Count; i++) EditorUtility.SetDirty(selected[i]);
                var result = new Dictionary<string, object>();
                var rows = new List<object>();
                for (var i = 0; i < selected.Count; i++) rows.Add(PhysicsJointDescriptor(selected[i]));
                result["joints"] = rows;
                result["count"] = (long)rows.Count;
                result["truncated"] = false;
                result["applied"] = applied;
                if (ignored.Count > 0) result["ignored"] = ignored;
                return result;
            }

            if (action == "remove")
            {
                if (joints.Count > 1 && selected.Count > 1)
                    throw new KnownError("invalid_argument", "目标有多个关节，remove 需要 index 指定要删除的关节");
                var removed = new List<object>();
                for (var i = 0; i < selected.Count; i++)
                {
                    removed.Add(PhysicsJointDescriptor(selected[i]));
                    Undo.DestroyObjectImmediate(selected[i]);
                }
                var result = new Dictionary<string, object>();
                result["joints"] = new List<object>();
                result["removed"] = removed;
                result["count"] = 0L;
                return result;
            }

            throw new KnownError("invalid_argument", "未知 action: " + action + "（list/get/add/set/remove）");
        }

