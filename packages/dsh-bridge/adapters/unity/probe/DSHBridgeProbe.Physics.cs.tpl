        static MethodInfo PhysicsStaticMethod(Type type, string name, Type[] signature)
        {
            if (type == null) return null;
            try { return type.GetMethod(name, BindingFlags.Public | BindingFlags.Static, null, signature, null); }
            catch (Exception) { return null; }
        }

        static Type PhysicsLayerMaskType()
        {
            try { return FindType("UnityEngine.LayerMask"); }
            catch (Exception) { return null; }
        }

        static string PhysicsLayerName(int index)
        {
            try
            {
                var type = PhysicsLayerMaskType();
                var method = PhysicsStaticMethod(type, "LayerToName", new Type[] { typeof(int) });
                if (method == null) return string.Empty;
                return System.Convert.ToString(method.Invoke(null, new object[] { index }), CultureInfo.InvariantCulture) ?? string.Empty;
            }
            catch (Exception) { return string.Empty; }
        }

        static int PhysicsLayerIndexByName(string name)
        {
            try
            {
                var type = PhysicsLayerMaskType();
                var method = PhysicsStaticMethod(type, "NameToLayer", new Type[] { typeof(string) });
                if (method == null) return -1;
                return System.Convert.ToInt32(method.Invoke(null, new object[] { name }), CultureInfo.InvariantCulture);
            }
            catch (Exception) { return -1; }
        }

        static int PhysicsLayerIndex(object raw, string what)
        {
            if (raw == null) throw new KnownError("invalid_argument", "缺少 " + what);
            var text = raw as string;
            if (text != null)
            {
                if (string.IsNullOrEmpty(text)) throw new KnownError("invalid_argument", what + " 不能为空字符串");
                var named = PhysicsLayerIndexByName(text);
                if (named < 0) throw new KnownError("invalid_argument", what + " 不是已知层名: " + text);
                return named;
            }
            var numeric = PhysicsToLong(raw, what, -1);
            if (numeric < 0 || numeric > 31) throw new KnownError("invalid_argument", what + " 必须在 0..31 之间: " + numeric.ToString(CultureInfo.InvariantCulture));
            return (int)numeric;
        }

        static List<object> PhysicsLayerRows()
        {
            var rows = new List<object>();
            for (var i = 0; i < 32; i++)
            {
                var row = new Dictionary<string, object>();
                row["index"] = (long)i;
                row["name"] = PhysicsLayerName(i);
                rows.Add(row);
            }
            return rows;
        }

        static Dictionary<string, object> PhysicsCollisionMatrix(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) action = "get";

            if (action == "get")
            {
                var limit = PhysicsCollectionLimit(args, PhysicsDefaultCollectionLimit);
                var getter = PhysicsStaticMethod(typeof(Physics), "GetIgnoreLayerCollision", new Type[] { typeof(int), typeof(int) });
                var allPairs = new List<object>();
                if (getter != null)
                {
                    // 32×32 对称矩阵只保留上三角对，最多 496 项；先全量求出再按 limit 截断，避免
                    // 「刚好等于 limit」时误报未截断。逐层 try-catch：单对失败不拖垮整个响应。
                    for (var a = 0; a < 32; a++)
                        for (var b = a + 1; b < 32; b++)
                        {
                            try
                            {
                                var ignored = (bool)getter.Invoke(null, new object[] { a, b });
                                if (!ignored) continue;
                                var pair = new List<object>();
                                pair.Add((long)a);
                                pair.Add((long)b);
                                allPairs.Add(pair);
                            }
                            catch (Exception) { }
                        }
                }
                var rows = new List<object>();
                for (var i = 0; i < allPairs.Count && rows.Count < limit; i++) rows.Add(allPairs[i]);
                var result = new Dictionary<string, object>();
                result["layers"] = PhysicsLayerRows();
                result["ignoredPairs"] = rows;
                result["count"] = (long)rows.Count;
                result["truncated"] = allPairs.Count > rows.Count;
                result["matrixAvailable"] = getter != null;
                if (getter == null)
                    result["hint"] = "当前引擎未暴露 Physics.GetIgnoreLayerCollision，ignoredPairs 未查询（返回空数组，不代表没有忽略对）";
                return result;
            }

            if (action == "set")
            {
                // 碰撞矩阵是工程级 Physics 设置，不是场景对象/资产，Unity 没有对应的 Undo 路径；
                // 这里不做假的 Undo 记录，调用方需要自行记录旧矩阵（get 可读回）。
                var layerA = PhysicsLayerIndex(args.ContainsKey("layerA") ? args["layerA"] : null, "layerA");
                var layerB = PhysicsLayerIndex(args.ContainsKey("layerB") ? args["layerB"] : null, "layerB");
                var ignore = args.ContainsKey("ignore") ? PhysicsToBool(args["ignore"], "ignore") : true;
                // 真实 API 名是 Physics.IgnoreLayerCollision（规格里写的 SetIgnoreLayerCollision 不是 Unity 成员）；
                // 两个名字都探测，兼容少数改名的引擎分支。
                var setter = PhysicsStaticMethod(typeof(Physics), "IgnoreLayerCollision", new Type[] { typeof(int), typeof(int), typeof(bool) });
                if (setter == null)
                    setter = PhysicsStaticMethod(typeof(Physics), "SetIgnoreLayerCollision", new Type[] { typeof(int), typeof(int), typeof(bool) });
                if (setter == null)
                    throw new KnownError("capability_unavailable", "当前引擎未暴露 Physics.IgnoreLayerCollision，无法修改碰撞矩阵",
                        "hint: 该 API 自 Unity 3 起存在；离线 stub 没有该成员，真机可用");
                try { setter.Invoke(null, new object[] { layerA, layerB, ignore }); }
                catch (TargetInvocationException e) { if (e.InnerException != null) throw e.InnerException; throw; }
                var applied = new Dictionary<string, object>();
                applied["layerA"] = (long)layerA;
                applied["layerB"] = (long)layerB;
                applied["ignore"] = ignore;
                var ignoredPairs = new List<object>();
                if (ignore)
                {
                    var pair = new List<object>();
                    pair.Add((long)layerA);
                    pair.Add((long)layerB);
                    ignoredPairs.Add(pair);
                }
                var result = new Dictionary<string, object>();
                result["layers"] = PhysicsLayerRows();
                result["ignoredPairs"] = ignoredPairs;
                result["count"] = (long)ignoredPairs.Count;
                result["truncated"] = false;
                result["matrixAvailable"] = true;
                result["applied"] = applied;
                return result;
            }

            throw new KnownError("invalid_argument", "未知 action: " + action + "（get/set）");
        }

        // ===== 物理材质（unity.physics.material）=====

        // 2022.3 是 UnityEngine.PhysicMaterial（PhysicsModule），Unity 6 改名 PhysicsMaterial。
        // 探针不直接引用类型（旧名在 Unity 6 上直接引用会编译错误），全部反射解析。
        static Type _physicsMaterialType;

        static Type PhysicsResolveTypeByName(string fullName)
        {
            try { var direct = Type.GetType(fullName + ", UnityEngine.PhysicsModule"); if (direct != null) return direct; } catch (Exception) { }
            try { var core = Type.GetType(fullName + ", UnityEngine"); if (core != null) return core; } catch (Exception) { }
            // 离线语义测试里探针与 stub 编译进同一个程序集；Collider 与材质类型同在 PhysicsModule
            // （真实 Unity）或同一个测试程序集（离线），所以从 Collider 所在程序集兜底。
            try
            {
                var collider = typeof(Collider);
                var fromColliderAssembly = collider.Assembly.GetType(fullName);
                if (fromColliderAssembly != null) return fromColliderAssembly;
            }
            catch (Exception) { }
            try { var unqualified = Type.GetType(fullName); if (unqualified != null) return unqualified; } catch (Exception) { }
            var assemblies = AppDomain.CurrentDomain.GetAssemblies();
            for (var i = 0; i < assemblies.Length; i++)
            {
                try
                {
                    var found = assemblies[i].GetType(fullName);
                    if (found != null) return found;
                }
                catch (Exception) { }
            }
            return null;
        }

        static Type PhysicsMaterialType()
        {
            if (_physicsMaterialType != null) return _physicsMaterialType;
            var physicsMaterial = PhysicsResolveTypeByName("UnityEngine.PhysicsMaterial");
            if (physicsMaterial != null) { _physicsMaterialType = physicsMaterial; return physicsMaterial; }
            var physicMaterial = PhysicsResolveTypeByName("UnityEngine.PhysicMaterial");
            if (physicMaterial != null) { _physicsMaterialType = physicMaterial; return physicMaterial; }
            throw new KnownError("capability_unavailable", "找不到物理材质类型（UnityEngine.PhysicsMaterial / UnityEngine.PhysicMaterial）",
                "hint: 物理材质属于内置 Physics 模块；Unity 6 起的类型名是 PhysicsMaterial，2022.3 是 PhysicMaterial");
        }

        /// <summary>
        /// 解析资产路径参数：只接受 Assets/ 下的工程相对路径，拒绝绝对路径与 ../。
        /// forWrite=true 时额外拒绝写入探针自身源码目录（读路径不受此限制）。
        /// </summary>
        static string PhysicsAssetPath(Dictionary<string, object> args, string key, bool requireAssetExtension, bool forWrite)
        {
            var raw = GetString(args, key);
            if (string.IsNullOrEmpty(raw)) throw new KnownError("invalid_argument", "缺少 " + key);
            var assetPath = ResolveAssetPath(raw, key);
            if (!assetPath.StartsWith("Assets/", StringComparison.Ordinal))
                throw new KnownError("invalid_argument", key + " 必须是 Assets/ 下的工程相对路径: " + assetPath);
            if (requireAssetExtension && !assetPath.EndsWith(".asset", StringComparison.OrdinalIgnoreCase))
                throw new KnownError("invalid_argument", key + " 必须是 .asset 资产: " + assetPath);
            if (forWrite) EnsureWritableAssetPath(assetPath, key);
            return assetPath;
        }

        static UnityEngine.Object PhysicsLoadMaterialByPath(string assetPath)
        {
            var materialType = PhysicsMaterialType();
            UnityEngine.Object loaded;
            try { loaded = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath); }
            catch (Exception e) { throw new KnownError("io_error", "读取物理材质资产失败: " + e.Message, e.GetType().Name); }
            if (loaded == null) return null;
            if (!materialType.IsInstanceOfType(loaded))
                throw new KnownError("not_found", "资产不是物理材质: " + assetPath + "（实际类型 " + loaded.GetType().Name + "）");
            return loaded;
        }

        static Dictionary<string, object> PhysicsMaterialDescriptor(UnityEngine.Object material, string assetPath)
        {
            var d = new Dictionary<string, object>();
            d["handle"] = PutHandle(material);
            d["path"] = string.IsNullOrEmpty(assetPath) ? null : assetPath;
            d["name"] = material != null ? material.name : null;
            d["type"] = material != null ? material.GetType().Name : null;
            d["dynamicFriction"] = PhysicsNumber(PhysicsReadFirst(material, "dynamicFriction"));
            d["staticFriction"] = PhysicsNumber(PhysicsReadFirst(material, "staticFriction"));
            d["bounciness"] = PhysicsNumber(PhysicsReadFirst(material, "bounciness"));
            d["frictionCombine"] = PhysicsEnumText(PhysicsReadFirst(material, "frictionCombine"));
            d["bounceCombine"] = PhysicsEnumText(PhysicsReadFirst(material, "bounceCombine"));
            return d;
        }

        /// <summary>解析材质目标：优先 target.handle（已加载对象），否则要求 path（资产路径）。</summary>
        static UnityEngine.Object PhysicsResolveMaterial(Dictionary<string, object> args, out string assetPath)
        {
            assetPath = null;
            object nested;
            if (args.TryGetValue("target", out nested))
            {
                var spec = nested as Dictionary<string, object>;
                if (spec == null) throw new KnownError("invalid_argument", "target 必须是对象（物理材质用 {\"handle\":\"h1\"}）");
                var handle = GetString(spec, "handle");
                if (!string.IsNullOrEmpty(handle))
                {
                    var obj = GetHandle(handle);
                    if (obj == null) throw new KnownError("handle_not_found", "句柄已失效或被回收: " + handle);
                    var material = obj as UnityEngine.Object;
                    if (material == null || !PhysicsMaterialType().IsInstanceOfType(material))
                        throw new KnownError("not_found", "句柄不是物理材质: " + handle);
                    var materialPath = AssetDatabase.GetAssetPath(material);
                    assetPath = string.IsNullOrEmpty(materialPath) ? null : materialPath;
                    return material;
                }
                var targetPath = GetString(spec, "path");
                if (string.IsNullOrEmpty(targetPath))
                    throw new KnownError("invalid_argument", "target 需要 handle（材质对象）或 path（资产路径）");
                assetPath = PhysicsAssetPath(spec, "path", false, false);
            }
            else
            {
                assetPath = PhysicsAssetPath(args, "path", false, false);
            }
            var loaded = PhysicsLoadMaterialByPath(assetPath);
            if (loaded == null) throw new KnownError("not_found", "找不到物理材质资产: " + assetPath);
            return loaded;
        }

        static Dictionary<string, object> PhysicsMaterialOp(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) throw new KnownError("invalid_argument", "缺少 action（list/get/create/set/assign）");

            if (action == "list")
            {
                var materialType = PhysicsMaterialType();
                var limit = PhysicsCollectionLimit(args, PhysicsDefaultCollectionLimit);
                string[] guids;
                try { guids = AssetDatabase.FindAssets("t:" + materialType.Name); }
                catch (Exception) { guids = new string[0]; }
                var rows = new List<object>();
                for (var i = 0; i < guids.Length && rows.Count < limit; i++)
                {
                    var assetPath = AssetDatabase.GUIDToAssetPath(guids[i]);
                    if (string.IsNullOrEmpty(assetPath)) continue;
                    var row = new Dictionary<string, object>();
                    row["path"] = assetPath;
                    row["name"] = Path.GetFileNameWithoutExtension(assetPath);
                    rows.Add(row);
                }
                var result = new Dictionary<string, object>();
                result["materials"] = rows;
                result["count"] = (long)rows.Count;
                result["truncated"] = guids.Length > rows.Count;
                return result;
            }

            if (action == "create")
            {
                var materialType = PhysicsMaterialType();
                var assetPath = PhysicsAssetPath(args, "path", true, true);
                var parent = Path.GetDirectoryName(assetPath);
                if (!string.IsNullOrEmpty(parent))
                {
                    parent = parent.Replace('\\', '/');
                    if (parent != "Assets" && parent.Length > 0 && !AssetDatabase.IsValidFolder(parent))
                        throw new KnownError("invalid_argument", "目标目录不存在: " + parent, "hint: 先用 unity.asset.create 创建目录");
                }
                if (AssetExists(assetPath))
                    throw new KnownError("already_exists", "目标资产已存在: " + assetPath, "hint: 物理材质不能覆盖创建；请换一个路径");
                UnityEngine.Object material;
                try { material = Activator.CreateInstance(materialType) as UnityEngine.Object; }
                catch (TargetInvocationException e) { if (e.InnerException != null) throw e.InnerException; throw; }
                catch (Exception e) { throw new KnownError("capability_unavailable", "创建物理材质失败: " + e.Message, e.GetType().Name); }
                if (material == null) throw new KnownError("capability_unavailable", "创建物理材质失败: 类型无法实例化: " + materialType.FullName);
                var name = GetString(args, "name");
                if (string.IsNullOrEmpty(name)) name = Path.GetFileNameWithoutExtension(assetPath);
                material.name = name;
                AssetDatabase.CreateAsset(material, assetPath);
                EditorUtility.SetDirty(material);
                PhysicsSaveAssets();
                var result = new Dictionary<string, object>();
                result["path"] = assetPath;
                result["name"] = name;
                result["created"] = true;
                result["material"] = PhysicsMaterialDescriptor(material, assetPath);
                return result;
            }

            if (action == "get")
            {
                string assetPath;
                var material = PhysicsResolveMaterial(args, out assetPath);
                var result = new Dictionary<string, object>();
                result["material"] = PhysicsMaterialDescriptor(material, assetPath);
                return result;
            }

            if (action == "set")
            {
                var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
                if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes 对象");
                string assetPath;
                var material = PhysicsResolveMaterial(args, out assetPath);
                if (!string.IsNullOrEmpty(assetPath)) EnsureWritableAssetPath(assetPath, "path");
                Undo.RecordObject(material, "DSH Set PhysicsMaterial");
                var applied = new List<object>();
                var ignored = new List<object>();
                foreach (var pair in changes)
                {
                    if (pair.Key == "name")
                    {
                        material.name = System.Convert.ToString(pair.Value, CultureInfo.InvariantCulture);
                        applied.Add("name");
                        continue;
                    }
                    var written = PhysicsWriteFirst(material, new string[] { pair.Key }, pair.Value);
                    if (written == null) ignored.Add(pair.Key); else applied.Add(pair.Key);
                }
                EditorUtility.SetDirty(material);
                PhysicsSaveAssets();
                var result = new Dictionary<string, object>();
                result["material"] = PhysicsMaterialDescriptor(material, assetPath);
                result["applied"] = applied;
                if (ignored.Count > 0) result["ignored"] = ignored;
                return result;
            }

            if (action == "assign")
            {
                if (!args.ContainsKey("path") && !args.ContainsKey("target"))
                    throw new KnownError("invalid_argument", "assign 需要 target（Collider/GameObject）与 path（物理材质资产）");
                if (!args.ContainsKey("path"))
                    throw new KnownError("invalid_argument", "assign 需要 path（物理材质资产路径）");
                var collider = PhysicsResolveCollider(args);
                var assetPath = PhysicsAssetPath(args, "path", true, false);
                var material = PhysicsLoadMaterialByPath(assetPath);
                if (material == null) throw new KnownError("not_found", "找不到物理材质资产: " + assetPath);
                Undo.RecordObject(collider, "DSH Assign PhysicsMaterial");
                SetMember(collider, collider.GetType(), "sharedMaterial", material, false);
                EditorUtility.SetDirty(collider);
                var result = new Dictionary<string, object>();
                result["applied"] = new List<object> { "sharedMaterial" };
                result["collider"] = DescribeRef(collider);
                result["material"] = PhysicsMaterialDescriptor(material, assetPath);
                return result;
            }

            throw new KnownError("invalid_argument", "未知 action: " + action + "（list/get/create/set/assign）");
        }

        // ===== 刚体（unity.physics.body）=====

        static Dictionary<string, object> PhysicsBodyView(Rigidbody body)
        {
            var d = new Dictionary<string, object>();
            var gameObject = body.gameObject;
            d["handle"] = PutHandle(body);
            d["name"] = body.name;
            d["path"] = gameObject != null && gameObject.transform != null ? ScenePathOf(gameObject.transform) : null;
            d["mass"] = (double)body.mass;
            // Unity 6：drag→linearDamping、angularDrag→angularDamping、velocity→linearVelocity。
            d["drag"] = PhysicsNumber(PhysicsReadFirst(body, "drag", "linearDamping"));
            d["angularDrag"] = PhysicsNumber(PhysicsReadFirst(body, "angularDrag", "angularDamping"));
            d["useGravity"] = body.useGravity;
            d["isKinematic"] = body.isKinematic;
            d["constraints"] = body.constraints.ToString();
            var velocity = PhysicsReadFirst(body, "velocity", "linearVelocity");
            d["velocity"] = velocity != null && velocity is Vector3 ? Vector3List((Vector3)velocity) : null;
            d["angularVelocity"] = Vector3List(body.angularVelocity);
            d["position"] = Vector3List(body.position);
            return d;
        }

        static Dictionary<string, object> PhysicsBody(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) action = "get";
            var body = PhysicsResolveRigidbody(args);
            if (action == "get")
            {
                var view = new Dictionary<string, object>();
                view["body"] = PhysicsBodyView(body);
                return view;
            }
            if (action != "set") throw new KnownError("invalid_argument", "未知 action: " + action + "（get/set）");
            var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
            if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes 对象");
            Undo.RecordObject(body, "DSH Set Rigidbody");
            var applied = new List<object>();
            var ignored = new List<object>();
            foreach (var pair in changes)
            {
                var key = pair.Key;
                if (key == "mass")
                {
                    var mass = PhysicsToDouble(pair.Value, "mass");
                    if (mass <= 0d) throw new KnownError("invalid_argument", "mass 必须大于 0: " + mass.ToString(CultureInfo.InvariantCulture));
                    body.mass = (float)mass;
                    applied.Add(key);
                }
                else if (key == "useGravity") { body.useGravity = PhysicsToBool(pair.Value, "useGravity"); applied.Add(key); }
                else if (key == "isKinematic") { body.isKinematic = PhysicsToBool(pair.Value, "isKinematic"); applied.Add(key); }
                else if (key == "constraints") { body.constraints = PhysicsParseEnum<RigidbodyConstraints>(pair.Value, "constraints"); applied.Add(key); }
                else if (key == "drag")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "drag", "linearDamping" }, PhysicsToFloat(pair.Value, "drag"));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "angularDrag")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "angularDrag", "angularDamping" }, PhysicsToFloat(pair.Value, "angularDrag"));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "velocity")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "velocity", "linearVelocity" }, CoerceValue(pair.Value, typeof(Vector3)));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "angularVelocity") { body.angularVelocity = (Vector3)CoerceValue(pair.Value, typeof(Vector3)); applied.Add(key); }
                else if (key == "position") { body.position = (Vector3)CoerceValue(pair.Value, typeof(Vector3)); applied.Add(key); }
                else ignored.Add(key);
            }
            EditorUtility.SetDirty(body);
            var result = new Dictionary<string, object>();
            result["body"] = PhysicsBodyView(body);
            result["applied"] = applied;
            if (ignored.Count > 0) result["ignored"] = ignored;
            return result;
        }

        // ===== 力（unity.physics.forces）=====

        static Dictionary<string, object> PhysicsForces(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action))
                throw new KnownError("invalid_argument", "缺少 action（force/impulse/velocityChange/torque/torqueImpulse/explosion）");
            var body = PhysicsResolveRigidbody(args);
            var isPlaying = EditorApplication.isPlaying;
            var applied = new List<object>();
            Undo.RecordObject(body, "DSH Physics Force");

            if (action == "explosion")
            {
                if (!args.ContainsKey("position")) throw new KnownError("invalid_argument", "explosion 需要 position（爆炸中心）");
                var position = (Vector3)CoerceValue(args["position"], typeof(Vector3));
                var radius = args.ContainsKey("radius") ? PhysicsToFloat(args["radius"], "radius") : 5f;
                if (radius <= 0f) throw new KnownError("invalid_argument", "radius 必须大于 0");
                var upwardsModifier = args.ContainsKey("upwardsModifier") ? PhysicsToFloat(args["upwardsModifier"], "upwardsModifier") : 0f;
                // 规范的参数表没有单独的 force 字段：用 vector 的模长当爆炸力（缺省 10）。
                var force = 10f;
                if (args.ContainsKey("vector"))
                {
                    var vector = (Vector3)CoerceValue(args["vector"], typeof(Vector3));
                    force = (float)Math.Sqrt((double)vector.x * vector.x + (double)vector.y * vector.y + (double)vector.z * vector.z);
                    if (force <= 0f) throw new KnownError("invalid_argument", "explosion 的 vector 模长必须大于 0");
                }
                body.AddExplosionForce(force, position, radius, upwardsModifier);
                applied.Add("explosion");
                applied.Add("position");
                applied.Add("radius");
                if (upwardsModifier != 0f) applied.Add("upwardsModifier");
            }
            else
            {
                if (!args.ContainsKey("vector")) throw new KnownError("invalid_argument", action + " 需要 vector");
                var vector = (Vector3)CoerceValue(args["vector"], typeof(Vector3));
                if (action == "force") { body.AddForce(vector, ForceMode.Force); applied.Add(action); }
                else if (action == "impulse") { body.AddForce(vector, ForceMode.Impulse); applied.Add(action); }
                else if (action == "velocityChange") { body.AddForce(vector, ForceMode.VelocityChange); applied.Add(action); }
                else if (action == "torque") { body.AddTorque(vector, ForceMode.Force); applied.Add(action); }
                else if (action == "torqueImpulse") { body.AddTorque(vector, ForceMode.Impulse); applied.Add(action); }
                else throw new KnownError("invalid_argument", "未知 action: " + action + "（force/impulse/velocityChange/torque/torqueImpulse/explosion）");
            }
            EditorUtility.SetDirty(body);
            var result = new Dictionary<string, object>();
            result["applied"] = applied;
            // Edit Mode 下物理世界不推进：力被记录但不会移动刚体，必须如实告知调用方。
            result["simulated"] = isPlaying;
            result["isPlaying"] = isPlaying;
            if (!isPlaying)
                result["hint"] = "Edit Mode 下物理世界不推进：力已记录但不会产生位移；进入 Play Mode 或调用 unity.physics.simulate 步进后才可见效";
            return result;
        }

        // ===== 模拟（unity.physics.simulate，危险能力）=====

        // Physics.simulationMode / Physics.Simulate 存在于 2022.2+，但主 stub 是共享文件（不能扩展），
        // 因此统一反射。缺失时 get 如实返回 modeAvailable:false，step 返回 capability_unavailable。
        static bool _physicsSimulationApiProbed;
        static PropertyInfo _physicsSimulationModeProperty;
        static PropertyInfo _physicsAutoSimulationProperty;
        static MethodInfo _physicsSimulateMethod;

        static void PhysicsProbeSimulationApi()
        {
            if (_physicsSimulationApiProbed) return;
            _physicsSimulationApiProbed = true;
            try { _physicsSimulationModeProperty = typeof(Physics).GetProperty("simulationMode", BindingFlags.Public | BindingFlags.Static); }
            catch (Exception) { _physicsSimulationModeProperty = null; }
            try { _physicsAutoSimulationProperty = typeof(Physics).GetProperty("autoSimulation", BindingFlags.Public | BindingFlags.Static); }
            catch (Exception) { _physicsAutoSimulationProperty = null; }
            try { _physicsSimulateMethod = PhysicsStaticMethod(typeof(Physics), "Simulate", new Type[] { typeof(float) }); }
            catch (Exception) { _physicsSimulateMethod = null; }
        }

        static string PhysicsSimulationModeText()
        {
            PhysicsProbeSimulationApi();
            try
            {
                if (_physicsSimulationModeProperty != null)
                    return PhysicsEnumText(_physicsSimulationModeProperty.GetValue(null, null)) ?? "unknown";
                if (_physicsAutoSimulationProperty != null)
                    return "autoSimulation:" + System.Convert.ToString(_physicsAutoSimulationProperty.GetValue(null, null), CultureInfo.InvariantCulture);
            }
            catch (Exception) { }
            return "unknown";
        }

        static Dictionary<string, object> PhysicsSimulationSnapshot(long steps, double deltaTime)
        {
            PhysicsProbeSimulationApi();
            var d = new Dictionary<string, object>();
            d["steps"] = steps;
            d["deltaTime"] = deltaTime;
            d["mode"] = PhysicsSimulationModeText();
            d["gravity"] = Vector3List(Physics.gravity);
            d["isPlaying"] = EditorApplication.isPlaying;
            var modeAvailable = _physicsSimulationModeProperty != null || _physicsAutoSimulationProperty != null;
            d["modeAvailable"] = modeAvailable;
            if (!modeAvailable)
                d["hint"] = "当前引擎/离线 stub 未暴露 Physics.simulationMode（需 2022.2+）或 Physics.autoSimulation";
            else if (_physicsSimulateMethod == null)
                d["hint"] = "当前引擎未暴露 Physics.Simulate，step 不可用";
            return d;
        }

        static Dictionary<string, object> PhysicsSimulate(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) action = "step";
            if (action == "get") return PhysicsSimulationSnapshot(0L, 0d);
            if (action != "step") throw new KnownError("invalid_argument", "未知 action: " + action + "（step/get）");

            var steps = PhysicsToLong(args.ContainsKey("steps") ? args["steps"] : null, "steps", 1L);
            if (steps < 1 || steps > PhysicsMaxSteps)
                throw new KnownError("invalid_argument", "steps 必须在 1.." + PhysicsMaxSteps.ToString(CultureInfo.InvariantCulture) + " 之间: " + steps.ToString(CultureInfo.InvariantCulture));
            var deltaTime = args.ContainsKey("deltaTime") ? PhysicsToDouble(args["deltaTime"], "deltaTime") : 0.02d;
            if (deltaTime <= 0d || deltaTime > 1d || double.IsNaN(deltaTime) || double.IsInfinity(deltaTime))
                throw new KnownError("invalid_argument", "deltaTime 必须在 (0, 1] 秒之间: " + deltaTime.ToString(CultureInfo.InvariantCulture));

            PhysicsProbeSimulationApi();
            if (_physicsSimulateMethod == null)
                throw new KnownError("capability_unavailable", "当前引擎没有 Physics.Simulate（需要 2022.2+ 的 Script 模拟模式）",
                    "hint: 该能力要求 Physics.simulationMode 存在；离线 stub 也没有该成员，真机 2022.2+ 可用");
            if (_physicsSimulationModeProperty == null && _physicsAutoSimulationProperty == null)
                throw new KnownError("capability_unavailable", "当前引擎没有 Physics.simulationMode / autoSimulation，无法切到手动步进",
                    "hint: 2022.2+ 用 simulationMode=Script；更老版本用 autoSimulation=false");

            // simulationMode 是引擎级开关，无法 Undo；能力本身是危险能力，由 DSH 侧默认关闭。
            var previousMode = PhysicsSimulationModeText();
            try
            {
                if (_physicsSimulationModeProperty != null)
                {
                    var scriptMode = Enum.Parse(_physicsSimulationModeProperty.PropertyType, "Script", true);
                    _physicsSimulationModeProperty.SetValue(null, scriptMode, null);
                }
                else
                {
                    _physicsAutoSimulationProperty.SetValue(null, false, null);
                }
                for (var i = 0; i < steps; i++) _physicsSimulateMethod.Invoke(null, new object[] { (float)deltaTime });
            }
            catch (TargetInvocationException e) { if (e.InnerException != null) throw e.InnerException; throw; }

            var result = PhysicsSimulationSnapshot(steps, deltaTime);
            result["previousMode"] = previousMode;
            result["hint"] = "已把物理模拟切到 Script 模式并步进 " + steps.ToString(CultureInfo.InvariantCulture) + " 步；物理不再随帧自动推进，需要恢复请把 Physics.simulationMode 改回 FixedUpdate";
            return result;
        }

        // ===== 2D 设置（unity.physics.2d.settings）=====

        static Dictionary<string, object> Physics2DSettings(Dictionary<string, object> args)
        {
            // Physics2D 的静态属性是工程级设置（Project Settings > Physics 2D），不属于场景对象/资产，
            // Unity 没有可用的 Undo 路径；因此这里如实不记录 Undo，而不是做无效的 Undo 调用。
            var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
            var applied = new List<object>();
            var ignored = new List<object>();
            if (changes != null)
            {
                var known = new HashSet<string>(StringComparer.Ordinal) {
                    "gravity", "velocityIterations", "positionIterations", "queriesHitTriggers",
                    "queriesStartInColliders", "simulationMode"
                };
                foreach (var key in changes.Keys)
                {
                    if (!known.Contains(key)) ignored.Add(key);
                }
                if (changes.ContainsKey("gravity"))
                {
                    Physics2D.gravity = (Vector2)CoerceValue(changes["gravity"], typeof(Vector2));
                    applied.Add("gravity");
                }
                if (changes.ContainsKey("velocityIterations"))
                {
                    var iterations = PhysicsToLong(changes["velocityIterations"], "velocityIterations", Physics2D.velocityIterations);
                    if (iterations < 1 || iterations > 255)
                        throw new KnownError("invalid_argument", "velocityIterations 必须在 1..255 之间: " + iterations.ToString(CultureInfo.InvariantCulture));
                    Physics2D.velocityIterations = (int)iterations;
                    applied.Add("velocityIterations");
                }
                if (changes.ContainsKey("positionIterations"))
                {
                    var iterations = PhysicsToLong(changes["positionIterations"], "positionIterations", Physics2D.positionIterations);
                    if (iterations < 1 || iterations > 255)
                        throw new KnownError("invalid_argument", "positionIterations 必须在 1..255 之间: " + iterations.ToString(CultureInfo.InvariantCulture));
                    Physics2D.positionIterations = (int)iterations;
                    applied.Add("positionIterations");
                }
                if (changes.ContainsKey("queriesHitTriggers"))
                {
                    Physics2D.queriesHitTriggers = PhysicsToBool(changes["queriesHitTriggers"], "queriesHitTriggers");
                    applied.Add("queriesHitTriggers");
                }
                if (changes.ContainsKey("queriesStartInColliders"))
                {
                    Physics2D.queriesStartInColliders = PhysicsToBool(changes["queriesStartInColliders"], "queriesStartInColliders");
                    applied.Add("queriesStartInColliders");
                }
                if (changes.ContainsKey("simulationMode"))
                {
                    Physics2D.simulationMode = PhysicsParseEnum<SimulationMode2D>(changes["simulationMode"], "simulationMode");
                    applied.Add("simulationMode");
                }
            }
            var result = new Dictionary<string, object>();
            result["gravity"] = PhysicsVector2List(Physics2D.gravity);
            result["velocityIterations"] = (long)Physics2D.velocityIterations;
            result["positionIterations"] = (long)Physics2D.positionIterations;
            result["queriesHitTriggers"] = Physics2D.queriesHitTriggers;
            result["queriesStartInColliders"] = Physics2D.queriesStartInColliders;
            result["simulationMode"] = Physics2D.simulationMode.ToString();
            if (changes != null)
            {
                result["applied"] = applied;
                if (ignored.Count > 0) result["ignored"] = ignored;
            }
            return result;
        }

        // ===== 2D 刚体（unity.physics.2d.body）=====

        static Dictionary<string, object> Physics2DBodyView(Rigidbody2D body)
        {
            var d = new Dictionary<string, object>();
            var gameObject = body.gameObject;
            d["handle"] = PutHandle(body);
            d["name"] = body.name;
            d["path"] = gameObject != null && gameObject.transform != null ? ScenePathOf(gameObject.transform) : null;
            d["mass"] = (double)body.mass;
            // Unity 6：drag→linearDamping、angularDrag→angularDamping、velocity→linearVelocity、
            // fixedAngle→freezeRotation（旧名在 6.x 仍可编译但已标记过时，反射兼容最稳）。
            d["drag"] = PhysicsNumber(PhysicsReadFirst(body, "drag", "linearDamping"));
            d["angularDrag"] = PhysicsNumber(PhysicsReadFirst(body, "angularDrag", "angularDamping"));
            d["gravityScale"] = (double)body.gravityScale;
            d["isKinematic"] = body.isKinematic;
            d["fixedAngle"] = PhysicsReadFirst(body, "fixedAngle", "freezeRotation");
            d["constraints"] = body.constraints.ToString();
            var velocity = PhysicsReadFirst(body, "velocity", "linearVelocity");
            d["velocity"] = velocity != null && velocity is Vector2 ? PhysicsVector2List((Vector2)velocity) : null;
            d["angularVelocity"] = (double)body.angularVelocity;
            d["bodyType"] = body.bodyType.ToString();
            return d;
        }

        static Dictionary<string, object> Physics2DBody(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) action = "get";
            var body = PhysicsResolveRigidbody2D(args);
            if (action == "get")
            {
                var view = new Dictionary<string, object>();
                view["body"] = Physics2DBodyView(body);
                return view;
            }
            if (action != "set") throw new KnownError("invalid_argument", "未知 action: " + action + "（get/set）");
            var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
            if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes 对象");
            Undo.RecordObject(body, "DSH Set Rigidbody2D");
            var applied = new List<object>();
            var ignored = new List<object>();
            foreach (var pair in changes)
            {
                var key = pair.Key;
                if (key == "mass")
                {
                    var mass = PhysicsToDouble(pair.Value, "mass");
                    if (mass <= 0d) throw new KnownError("invalid_argument", "mass 必须大于 0: " + mass.ToString(CultureInfo.InvariantCulture));
                    body.mass = (float)mass;
                    applied.Add(key);
                }
                else if (key == "gravityScale") { body.gravityScale = PhysicsToFloat(pair.Value, "gravityScale"); applied.Add(key); }
                else if (key == "isKinematic") { body.isKinematic = PhysicsToBool(pair.Value, "isKinematic"); applied.Add(key); }
                else if (key == "constraints") { body.constraints = PhysicsParseEnum<RigidbodyConstraints2D>(pair.Value, "constraints"); applied.Add(key); }
                else if (key == "bodyType") { body.bodyType = PhysicsParseEnum<RigidbodyType2D>(pair.Value, "bodyType"); applied.Add(key); }
                else if (key == "drag")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "drag", "linearDamping" }, PhysicsToFloat(pair.Value, "drag"));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "angularDrag")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "angularDrag", "angularDamping" }, PhysicsToFloat(pair.Value, "angularDrag"));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "velocity")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "velocity", "linearVelocity" }, CoerceValue(pair.Value, typeof(Vector2)));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else if (key == "angularVelocity") { body.angularVelocity = PhysicsToFloat(pair.Value, "angularVelocity"); applied.Add(key); }
                else if (key == "fixedAngle")
                {
                    var written = PhysicsWriteFirst(body, new string[] { "fixedAngle", "freezeRotation" }, PhysicsToBool(pair.Value, "fixedAngle"));
                    if (written == null) ignored.Add(key); else applied.Add(key);
                }
                else ignored.Add(key);
            }
            EditorUtility.SetDirty(body);
            var result = new Dictionary<string, object>();
            result["body"] = Physics2DBodyView(body);
            result["applied"] = applied;
            if (ignored.Count > 0) result["ignored"] = ignored;
            return result;
        }

        // ===== 2D 射线（unity.physics.2d.raycast）=====

        static Dictionary<string, object> Physics2DHitRow(RaycastHit2D hit)
        {
            var d = new Dictionary<string, object>();
            d["point"] = PhysicsVector2List(hit.point);
            d["normal"] = PhysicsVector2List(hit.normal);
            d["distance"] = (double)hit.distance;
            var collider = hit.collider;
            d["collider"] = collider != null ? collider.name : null;
            d["path"] = null;
            if (collider != null)
            {
                d["handle"] = PutHandle(collider);
                var transform = collider.transform;
                if (transform == null && collider.gameObject != null) transform = collider.gameObject.transform;
                if (transform != null) d["path"] = ScenePathOf(transform);
            }
            return d;
        }

        /// <summary>Overlap* 没有命中点/法线：只报告碰撞体引用与位置，不编造法线和距离。</summary>
        static Dictionary<string, object> Physics2DOverlapRow(Collider2D collider)
        {
            var d = new Dictionary<string, object>();
            d["point"] = null;
            d["normal"] = null;
            d["distance"] = 0d;
            d["collider"] = collider != null ? collider.name : null;
            d["path"] = null;
            if (collider != null)
            {
                d["handle"] = PutHandle(collider);
                var transform = collider.transform;
                if (transform == null && collider.gameObject != null) transform = collider.gameObject.transform;
                if (transform != null)
                {
                    var position = transform.position;
                    d["point"] = PhysicsVector2List(new Vector2(position.x, position.y));
                    d["path"] = ScenePathOf(transform);
                }
            }
            return d;
        }

        static bool Physics2DAppendHits(List<object> rows, RaycastHit2D[] hits)
        {
            if (hits == null) return false;
            var truncated = false;
            for (var i = 0; i < hits.Length; i++)
            {
                if (rows.Count >= PhysicsMaxRaycastHits) { truncated = true; break; }
                rows.Add(Physics2DHitRow(hits[i]));
            }
            return truncated;
        }

        static Dictionary<string, object> Physics2DRaycast(Dictionary<string, object> args)
        {
            var kind = GetString(args, "kind");
            if (string.IsNullOrEmpty(kind)) kind = "ray";
            if (!args.ContainsKey("origin")) throw new KnownError("invalid_argument", "缺少 origin（屏幕/世界坐标二元素数组）");
            var origin = (Vector2)CoerceValue(args["origin"], typeof(Vector2));
            var direction = args.ContainsKey("direction") ? (Vector2)CoerceValue(args["direction"], typeof(Vector2)) : new Vector2(0f, -1f);
            var distance = args.ContainsKey("distance") ? PhysicsToFloat(args["distance"], "distance") : 100f;
            if (distance <= 0f) throw new KnownError("invalid_argument", "distance 必须大于 0");
            var layerMask = args.ContainsKey("layerMask")
                ? (int)PhysicsToLong(args["layerMask"], "layerMask", Physics2D.DefaultRaycastLayers)
                : Physics2D.DefaultRaycastLayers;
            var all = ToBoolOr(args, "all", false);
            var rows = new List<object>();
            var truncated = false;

            if (kind == "ray")
            {
                if (all) truncated = Physics2DAppendHits(rows, Physics2D.RaycastAll(origin, direction, distance, layerMask));
                else
                {
                    var hit = Physics2D.Raycast(origin, direction, distance, layerMask);
                    if (hit) rows.Add(Physics2DHitRow(hit));
                }
            }
            else if (kind == "circle")
            {
                if (!args.ContainsKey("radius")) throw new KnownError("invalid_argument", "kind=circle 需要 radius");
                var radius = PhysicsToFloat(args["radius"], "radius");
                if (radius <= 0f) throw new KnownError("invalid_argument", "radius 必须大于 0");
                if (all) truncated = Physics2DAppendHits(rows, Physics2D.CircleCastAll(origin, radius, direction, distance, layerMask));
                else
                {
                    var hit = Physics2D.CircleCast(origin, radius, direction, distance, layerMask);
                    if (hit) rows.Add(Physics2DHitRow(hit));
                }
            }
            else if (kind == "box")
            {
                if (!args.ContainsKey("size")) throw new KnownError("invalid_argument", "kind=box 需要 size（二元素数组）");
                var size = (Vector2)CoerceValue(args["size"], typeof(Vector2));
                if (size.x <= 0f || size.y <= 0f) throw new KnownError("invalid_argument", "size 的两个分量都必须大于 0");
                var angle = args.ContainsKey("angle") ? PhysicsToFloat(args["angle"], "angle") : 0f;
                if (all) truncated = Physics2DAppendHits(rows, Physics2D.BoxCastAll(origin, size, angle, direction, distance, layerMask));
                else
                {
                    var hit = Physics2D.BoxCast(origin, size, angle, direction, distance, layerMask);
                    if (hit) rows.Add(Physics2DHitRow(hit));
                }
            }
            else if (kind == "overlap")
            {
                if (!args.ContainsKey("radius")) throw new KnownError("invalid_argument", "kind=overlap 需要 radius");
                var radius = PhysicsToFloat(args["radius"], "radius");
                if (radius <= 0f) throw new KnownError("invalid_argument", "radius 必须大于 0");
                if (all)
                {
                    var overlaps = Physics2D.OverlapCircleAll(origin, radius, layerMask);
                    if (overlaps != null)
                    {
                        for (var i = 0; i < overlaps.Length; i++)
                        {
                            if (rows.Count >= PhysicsMaxRaycastHits) { truncated = true; break; }
                            rows.Add(Physics2DOverlapRow(overlaps[i]));
                        }
                    }
                }
                else
                {
                    var overlap = Physics2D.OverlapCircle(origin, radius, layerMask);
                    if (overlap != null) rows.Add(Physics2DOverlapRow(overlap));
                }
            }
            else
            {
                throw new KnownError("invalid_argument", "未知 kind: " + kind + "（ray/circle/box/overlap）");
            }

            var result = new Dictionary<string, object>();
            result["hits"] = rows;
            result["count"] = (long)rows.Count;
            result["truncated"] = truncated;
            if (truncated) result["hint"] = "all 命中数超过上限 " + PhysicsMaxRaycastHits.ToString(CultureInfo.InvariantCulture) + "，已截断";
            return result;
        }
    }
}
#endif
