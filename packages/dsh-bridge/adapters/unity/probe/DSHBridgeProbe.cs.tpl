        static string PutHandle(object obj)
        {
            if (obj == null) return null;
            var key = "h" + (++_handleSeq).ToString(CultureInfo.InvariantCulture);
            _handles[key] = obj;
            _handleOrder.Add(key);
            while (_handleOrder.Count > HandleLimit)
            {
                var oldest = _handleOrder[0];
                _handleOrder.RemoveAt(0);
                _handles.Remove(oldest);
            }
            return key;
        }

        static object GetHandle(string key)
        {
            object value;
            return key != null && _handles.TryGetValue(key, out value) ? value : null;
        }

        static Dictionary<string, object> DescribeRef(object obj)
        {
            if (obj == null) return null;
            var d = new Dictionary<string, object>();
            var uo = obj as UnityEngine.Object;
            d["handle"] = PutHandle(obj);
            d["type"] = obj.GetType().Name;
            d["fullType"] = obj.GetType().FullName;
            if (uo != null)
            {
                d["name"] = uo.name;
                d["assetPath"] = AssetDatabase.GetAssetPath(uo);
                var go = uo as GameObject;
                if (go != null) d["scenePath"] = ScenePathOf(go.transform);
            }
            return d;
        }

        static string ScenePathOf(Transform t)
        {
            if (t == null) return null;
            var parts = new List<string>();
            while (t != null) { parts.Insert(0, t.name); t = t.parent; }
            return string.Join("/", parts.ToArray());
        }

        static Transform FindTransformByPath(string path)
        {
            if (string.IsNullOrEmpty(path)) return null;
            var parts = path.Split('/');
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) return null;
            Transform current = null;
            foreach (var root in scene.GetRootGameObjects())
            {
                if (root.name == parts[0]) { current = root.transform; break; }
            }
            if (current == null) return null;
            for (var i = 1; i < parts.Length && current != null; i++)
            {
                Transform next = null;
                for (var c = 0; c < current.childCount; c++)
                {
                    var child = current.GetChild(c);
                    if (child.name == parts[i]) { next = child; break; }
                }
                current = next;
            }
            return current;
        }

        static List<GameObject> AllSceneObjects(bool includeInactive)
        {
            var list = new List<GameObject>();
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) return list;
            foreach (var root in scene.GetRootGameObjects())
            {
                var stack = new Stack<Transform>();
                stack.Push(root.transform);
                while (stack.Count > 0)
                {
                    var t = stack.Pop();
                    if (includeInactive || t.gameObject.activeInHierarchy) list.Add(t.gameObject);
                    for (var i = 0; i < t.childCount; i++) stack.Push(t.GetChild(i));
                }
            }
            return list;
        }

        static Dictionary<string, object> ObjectFind(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            var name = GetString(args, "name");
            var component = GetString(args, "component");
            var tag = GetString(args, "tag");
            var limit = (int)Math.Max(1, Math.Min(500, ToLong(args, "limit", 50)));
            var includeInactive = ToBool(args, "includeInactive");

            var results = new List<object>();
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t != null) results.Add(DescribeRef(t.gameObject));
            }
            else
            {
                foreach (var go in AllSceneObjects(includeInactive))
                {
                    if (!string.IsNullOrEmpty(name) && go.name.IndexOf(name, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    if (!string.IsNullOrEmpty(tag) && !go.CompareTag(tag)) continue;
                    if (!string.IsNullOrEmpty(component))
                    {
                        var has = false;
                        foreach (var c in go.GetComponents<Component>())
                        {
                            if (c != null && c.GetType().Name == component) { has = true; break; }
                        }
                        if (!has) continue;
                    }
                    results.Add(DescribeRef(go));
                    if (results.Count >= limit) break;
                }
            }
            var d = new Dictionary<string, object>();
            d["count"] = (long)results.Count;
            d["objects"] = results;
            return d;
        }

        static object ResolveTarget(Dictionary<string, object> args, out Type staticType)
        {
            staticType = null;
            var handle = GetString(args, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                if (obj == null) throw new KnownError("handle_not_found", "句柄已失效或被回收: " + handle);
                return obj;
            }
            var path = GetString(args, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                return t.gameObject;
            }
            var assetPath = GetString(args, "asset");
            if (!string.IsNullOrEmpty(assetPath))
            {
                var obj = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath);
                if (obj == null) throw new KnownError("asset_not_found", "找不到资产: " + assetPath);
                return obj;
            }
            var typeName = GetString(args, "type");
            if (!string.IsNullOrEmpty(typeName))
            {
                staticType = FindType(typeName);
                if (staticType == null) throw new KnownError("type_not_found", "找不到类型: " + typeName);
                return null;
            }
            if (Selection.activeObject != null) return Selection.activeObject;
            throw new KnownError("invalid_argument", "需要 handle / path / asset / type 之一");
        }

        static object[] ConvertArgs(ParameterInfo[] parameters, List<object> raw)
        {
            var converted = new object[parameters.Length];
            for (var i = 0; i < parameters.Length; i++)
            {
                if (i < raw.Count) converted[i] = Coerce(raw[i], parameters[i].ParameterType);
                else if (parameters[i].HasDefaultValue) converted[i] = parameters[i].DefaultValue;
                else converted[i] = DefaultOf(parameters[i].ParameterType);
            }
            return converted;
        }

        static MethodInfo PickMethod(Type type, string name, int argc, BindingFlags flags)
        {
            var candidates = type.GetMethods(flags).Where(m => m.Name == name).ToList();
            if (candidates.Count == 0) return null;
            var exact = candidates.FirstOrDefault(m => m.GetParameters().Length == argc);
            if (exact != null) return exact;
            return candidates.FirstOrDefault(m => m.GetParameters().Length > argc && m.GetParameters().Skip(argc).All(p => p.HasDefaultValue))
                ?? candidates[0];
        }

        static Dictionary<string, object> ApiInvoke(Dictionary<string, object> args)
        {
            Type staticType;
            var target = ResolveTarget(args, out staticType);
            var member = GetString(args, "member");
            if (string.IsNullOrEmpty(member)) throw new KnownError("invalid_argument", "缺少 member");
            var kind = GetString(args, "kind") ?? "auto";
            var rawArgs = args.ContainsKey("args") ? args["args"] as List<object> : new List<object>();
            if (rawArgs == null) rawArgs = new List<object>();

            var type = staticType ?? target.GetType();
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.FlattenHierarchy
                | (staticType != null ? BindingFlags.Static : BindingFlags.Instance);

            object result = null;
            string usedKind = null;

            if (kind == "auto" || kind == "property")
            {
                var prop = type.GetProperty(member, flags);
                if (prop != null)
                {
                    if (args.ContainsKey("value")) prop.SetValue(staticType != null ? null : target, Coerce(args["value"], prop.PropertyType), null);
                    else if (prop.CanRead) result = prop.GetValue(staticType != null ? null : target, null);
                    usedKind = "property";
                }
            }
            if (usedKind == null && (kind == "auto" || kind == "field"))
            {
                var field = type.GetField(member, flags);
                if (field != null)
                {
                    if (args.ContainsKey("value")) field.SetValue(staticType != null ? null : target, Coerce(args["value"], field.FieldType));
                    else result = field.GetValue(staticType != null ? null : target);
                    usedKind = "field";
                }
            }
            if (usedKind == null && (kind == "auto" || kind == "method"))
            {
                var method = PickMethod(type, member, rawArgs.Count, flags);
                if (method != null)
                {
                    result = method.Invoke(staticType != null ? null : target, ConvertArgs(method.GetParameters(), rawArgs));
                    usedKind = "method";
                }
            }
            if (usedKind == null) throw new KnownError("member_not_found", "找不到成员: " + type.Name + "." + member);

            var d = new Dictionary<string, object>();
            d["kind"] = usedKind;
            d["type"] = type.Name;
            if (result != null && !(result is string) && !result.GetType().IsPrimitive && !(result is decimal))
            {
                var described = DescribeRef(result);
                if (described != null) { d["result"] = described; return d; }
            }
            d["result"] = Describe(result) ?? result;
            return d;
        }

        static Dictionary<string, object> ApiMembers(Dictionary<string, object> args)
        {
            Type staticType;
            var target = ResolveTarget(args, out staticType);
            var type = staticType ?? target.GetType();
            var filter = GetString(args, "filter");
            var limit = (int)Math.Max(1, Math.Min(300, ToLong(args, "limit", 80)));
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.FlattenHierarchy | BindingFlags.Instance | BindingFlags.Static;
            var rows = new List<object>();
            foreach (var m in type.GetMethods(flags))
            {
                if (m.IsSpecialName) continue;
                if (!string.IsNullOrEmpty(filter) && m.Name.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0) continue;
                rows.Add(m.Name + "(" + string.Join(", ", m.GetParameters().Select(p => p.ParameterType.Name + " " + p.Name).ToArray()) + ") : " + m.ReturnType.Name);
                if (rows.Count >= limit) break;
            }
            if (rows.Count < limit)
            {
                foreach (var p in type.GetProperties(flags))
                {
                    if (!string.IsNullOrEmpty(filter) && p.Name.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    rows.Add((p.CanRead ? "get " : "") + (p.CanWrite ? "set " : "") + p.PropertyType.Name + " " + p.Name);
                    if (rows.Count >= limit) break;
                }
            }
            var d = new Dictionary<string, object>();
            d["type"] = type.FullName;
            d["members"] = rows;
            d["truncated"] = (long)rows.Count >= limit ? 1L : 0L;
            return d;
        }

        static Dictionary<string, object> SearchContent(Dictionary<string, object> args)
        {
            var query = GetString(args, "query");
            if (string.IsNullOrEmpty(query)) throw new KnownError("invalid_argument", "缺少 query");
            var folders = GetStringList(args, "folders");
            var exts = GetStringList(args, "extensions");
            var limit = (int)Math.Max(1, Math.Min(200, ToLong(args, "limit", 40)));
            var guids = AssetDatabase.FindAssets("", folders.Count > 0 ? folders.ToArray() : null);
            var hits = new List<object>();
            var scanned = 0;
            foreach (var guid in guids)
            {
                var path = AssetDatabase.GUIDToAssetPath(guid);
                if (string.IsNullOrEmpty(path)) continue;
                if (exts.Count > 0 && !exts.Any(e => path.EndsWith(e, StringComparison.OrdinalIgnoreCase))) continue;
                if (!(path.EndsWith(".cs") || path.EndsWith(".shader") || path.EndsWith(".txt")
                    || path.EndsWith(".json") || path.EndsWith(".mat") || path.EndsWith(".asset")
                    || path.EndsWith(".hlsl") || path.EndsWith(".cginc"))) continue;
                scanned++;
                string[] lines;
                try { lines = System.IO.File.ReadAllLines(path); }
                catch { continue; }
                for (var i = 0; i < lines.Length; i++)
                {
                    if (lines[i].IndexOf(query, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    var d = new Dictionary<string, object>();
                    d["assetPath"] = path;
                    d["line"] = (long)(i + 1);
                    d["text"] = lines[i].Trim().Length > 300 ? lines[i].Trim().Substring(0, 300) : lines[i].Trim();
                    hits.Add(d);
                    if (hits.Count >= limit) break;
                }
                if (hits.Count >= limit) break;
            }
            var result = new Dictionary<string, object>();
            result["scanned"] = (long)scanned;
            result["hits"] = hits;
            return result;
        }

        static Dictionary<string, object> AssetRead(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var maxLines = (int)Math.Max(1, Math.Min(2000, ToLong(args, "lines", 400)));
            var offset = (int)Math.Max(0, ToLong(args, "offset", 0));
            string[] lines;
            try { lines = System.IO.File.ReadAllLines(path); }
            catch (Exception e) { throw new KnownError("read_failed", "读取失败: " + e.Message); }
            var slice = lines.Skip(offset).Take(maxLines).ToArray();
            var d = new Dictionary<string, object>();
            d["assetPath"] = path;
            d["totalLines"] = (long)lines.Length;
            d["offset"] = (long)offset;
            d["text"] = string.Join("\n", slice);
            return d;
        }

        static Dictionary<string, object> AssetCreate(Dictionary<string, object> args)
        {
            var kind = GetString(args, "kind") ?? "folder";
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var content = GetString(args, "content");
            var created = false;

            if (kind == "folder")
            {
                if (!AssetDatabase.IsValidFolder(path))
                {
                    var parent = System.IO.Path.GetDirectoryName(path).Replace('\\', '/');
                    var leaf = System.IO.Path.GetFileName(path);
                    AssetDatabase.CreateFolder(parent, leaf);
                }
                created = true;
            }
            else if (kind == "script")
            {
                var name = System.IO.Path.GetFileNameWithoutExtension(path);
                if (content == null) content = DefaultScript(name);
                WriteTextAsset(path, content);
                created = true;
            }
            else if (kind == "shader")
            {
                if (content == null) content = DefaultShader(System.IO.Path.GetFileNameWithoutExtension(path));
                WriteTextAsset(path, content);
                created = true;
            }
            else if (kind == "text")
            {
                WriteTextAsset(path, content ?? "");
                created = true;
            }
            else if (kind == "material")
            {
                var shaderName = GetString(args, "shader") ?? "Standard";
                var shader = Shader.Find(shaderName);
                if (shader == null) throw new KnownError("shader_not_found", "找不到 Shader: " + shaderName);
                var mat = new Material(shader);
                AssetDatabase.CreateAsset(mat, path);
                created = true;
            }
            else throw new KnownError("unsupported_kind", "不支持的 kind: " + kind);

            AssetDatabase.Refresh();
            var d = new Dictionary<string, object>();
            d["created"] = created;
            d["assetPath"] = path;
            d["kind"] = kind;
            return d;
        }

        static void WriteTextAsset(string path, string content)
        {
            var full = System.IO.Path.Combine(_projectRoot, path);
            var dir = System.IO.Path.GetDirectoryName(full);
            if (!string.IsNullOrEmpty(dir) && !System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
            System.IO.File.WriteAllText(full, content, new UTF8Encoding(false));
        }

        static string DefaultScript(string name)
        {
            return "using UnityEngine;\n\npublic class " + name + " : MonoBehaviour\n{\n    void Start()\n    {\n    }\n\n    void Update()\n    {\n    }\n}\n";
        }

        static string DefaultShader(string name)
        {
            return "Shader \"" + name + "\"\n{\n    Properties\n    {\n        _Color (\"Color\", Color) = (1,1,1,1)\n    }\n    SubShader\n    {\n        Tags { \"RenderType\"=\"Opaque\" }\n        Pass\n        {\n            CGPROGRAM\n            #pragma vertex vert\n            #pragma fragment frag\n            #include \"UnityCG.cginc\"\n            struct appdata { float4 vertex : POSITION; };\n            struct v2f { float4 pos : SV_POSITION; };\n            v2f vert (appdata v) { v2f o; o.pos = UnityObjectToClipPos(v.vertex); return o; }\n            fixed4 frag (v2f i) : SV_Target { return fixed4(1,1,1,1); }\n            ENDCG\n        }\n    }\n}\n";
        }

        static Dictionary<string, object> ImporterAccess(Dictionary<string, object> args, bool write)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var importer = AssetImporter.GetAtPath(path);
            if (importer == null) throw new KnownError("importer_not_found", "该资产没有导入器或路径无效: " + path);
            var d = new Dictionary<string, object>();
            d["importer"] = importer.GetType().Name;
            d["assetPath"] = path;

            var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
            if (write)
            {
                if (changes == null) throw new KnownError("invalid_argument", "缺少 changes");
                var flags = BindingFlags.Public | BindingFlags.Instance;
                var applied = new List<object>();
                foreach (var kv in changes)
                {
                    var prop = importer.GetType().GetProperty(kv.Key, flags);
                    if (prop == null || !prop.CanWrite) continue;
                    prop.SetValue(importer, Coerce(kv.Value, prop.PropertyType), null);
                    applied.Add(kv.Key);
                }
                importer.SaveAndReimport();
                d["applied"] = applied;
            }

            var snapshot = new Dictionary<string, object>();
            var type = importer.GetType();
            var keys = new[] { "textureType", "sRGBTexture", "mipmapEnabled", "maxTextureSize", "textureCompression", "wrapMode", "importMaterials", "animationType", "loadType", "compressionFormat" };
            foreach (var key in keys)
            {
                var prop = type.GetProperty(key, BindingFlags.Public | BindingFlags.Instance);
                if (prop != null && prop.CanRead) snapshot[key] = Describe(prop.GetValue(importer, null));
            }
            if (snapshot.Count == 0)
            {
                // 该导入器没有这些通用字段时，回退给出一份可读属性清单，便于调用方拼 changes。
                var readable = new List<object>();
                foreach (var prop in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
                {
                    if (!prop.CanRead) continue;
                    readable.Add(prop.Name + " : " + prop.PropertyType.Name);
                    if (readable.Count >= 40) break;
                }
                d["readableProperties"] = readable;
            }
            d["settings"] = snapshot;
            return d;
        }

        static Dictionary<string, object> SceneList(Dictionary<string, object> args)
        {
            var folders = GetStringList(args, "folders");
            var limit = (int)Math.Max(1, Math.Min(300, ToLong(args, "limit", 100)));
            var guids = AssetDatabase.FindAssets("t:Scene", folders.Count > 0 ? folders.ToArray() : null);
            var rows = new List<object>();
            for (var i = 0; i < guids.Length && i < limit; i++) rows.Add(AssetDatabase.GUIDToAssetPath(guids[i]));
            var d = new Dictionary<string, object>();
            d["total"] = (long)guids.Length;
            d["scenes"] = rows;
            d["active"] = UnityEngine.SceneManagement.SceneManager.GetActiveScene().path;
            return d;
        }

        static Dictionary<string, object> SceneOpen(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            if (EditorApplication.isPlaying) throw new KnownError("invalid_state", "Play Mode 下不能切换场景");
            var mode = GetString(args, "mode") ?? "single";
            var opened = UnityEditor.SceneManagement.EditorSceneManager.OpenScene(
                path, mode == "additive" ? UnityEditor.SceneManagement.OpenSceneMode.Additive : UnityEditor.SceneManagement.OpenSceneMode.Single);
            var d = new Dictionary<string, object>();
            d["opened"] = opened.path;
            d["sceneCount"] = (long)UnityEngine.SceneManagement.SceneManager.sceneCount;
            return d;
        }

        static Dictionary<string, object> SceneSave(Dictionary<string, object> args)
        {
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) throw new KnownError("invalid_state", "没有有效场景");
            var target = GetString(args, "path");
            if (string.IsNullOrEmpty(target) && string.IsNullOrEmpty(scene.path))
            {
                // 未保存过的新场景调 SaveScene 会弹出「另存为」模态框并阻塞编辑器，必须显式给 path。
                throw new KnownError("scene_not_saved", "当前场景尚未保存到磁盘；请用 path 参数指定目标路径后再保存");
            }
            var ok = string.IsNullOrEmpty(target)
                ? UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene)
                : UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene, target);
            var d = new Dictionary<string, object>();
            d["saved"] = ok;
            d["path"] = string.IsNullOrEmpty(target) ? scene.path : target;
            return d;
        }

        static Dictionary<string, object> SelectionSet(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            var assetPath = GetString(args, "asset");
            UnityEngine.Object target = null;
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                target = t.gameObject;
            }
            else if (!string.IsNullOrEmpty(assetPath))
            {
                target = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath);
                if (target == null) throw new KnownError("asset_not_found", "找不到资产: " + assetPath);
            }
            if (target == null) throw new KnownError("invalid_argument", "需要 path 或 asset");
            Selection.activeObject = target;
            EditorGUIUtility.PingObject(target);
            var d = new Dictionary<string, object>();
            d["selected"] = DescribeRef(target);
            return d;
        }

        // ===== P2 语义封装：场景对象 / 组件 / Prefab / 材质 / 资产 =====

        static GameObject ResolveGameObject(Dictionary<string, object> args, string key = "target")
        {
            Dictionary<string, object> inner = args;
            if (key != null && args.ContainsKey(key) && args[key] is Dictionary<string, object>)
                inner = args[key] as Dictionary<string, object>;
            var handle = GetString(inner, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                var go1 = obj as GameObject;
                if (go1 != null) return go1;
                var comp = obj as Component;
                if (comp != null) return comp.gameObject;
                throw new KnownError("invalid_handle", "句柄不是场景对象: " + handle);
            }
            var path = GetString(inner, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                return t.gameObject;
            }
            throw new KnownError("invalid_argument", "需要 handle 或 path");
        }

        static Component ResolveComponent(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var typeName = GetString(args, "componentType") ?? GetString(args, "type");
            if (string.IsNullOrEmpty(typeName)) throw new KnownError("invalid_argument", "缺少 componentType");
            var type = FindType(typeName);
            if (type == null) throw new KnownError("type_not_found", "找不到组件类型: " + typeName);
            var comp = go.GetComponent(type);
            if (comp == null) throw new KnownError("component_not_found", "对象上没有组件: " + typeName);
            return comp;
        }

        static object ParseVectorLike(Type target, object raw)
        {
            if (raw == null) return null;
            var dict = raw as Dictionary<string, object>;
            var list = raw as List<object>;
            float Get(string axis, int index)
            {
                if (dict != null && dict.ContainsKey(axis)) return (float)System.Convert.ToDouble(dict[axis], CultureInfo.InvariantCulture);
                if (list != null && list.Count > index) return (float)System.Convert.ToDouble(list[index], CultureInfo.InvariantCulture);
                return 0f;
            }
            if (target == typeof(Vector2)) return new Vector2(Get("x", 0), Get("y", 1));
            if (target == typeof(Vector3)) return new Vector3(Get("x", 0), Get("y", 1), Get("z", 2));
            if (target == typeof(Vector4)) return new Vector4(Get("x", 0), Get("y", 1), Get("z", 2), Get("w", 3));
            if (target == typeof(Quaternion))
            {
                if (dict != null && dict.ContainsKey("euler"))
                {
                    var e = dict["euler"] as List<object> ?? new List<object>();
                    return Quaternion.Euler(
                        e.Count > 0 ? (float)System.Convert.ToDouble(e[0], CultureInfo.InvariantCulture) : 0f,
                        e.Count > 1 ? (float)System.Convert.ToDouble(e[1], CultureInfo.InvariantCulture) : 0f,
                        e.Count > 2 ? (float)System.Convert.ToDouble(e[2], CultureInfo.InvariantCulture) : 0f);
                }
                return new Quaternion(Get("x", 0), Get("y", 1), Get("z", 2), Get("w", 3));
            }
            if (target == typeof(Color))
            {
                var s = raw as string;
                if (!string.IsNullOrEmpty(s) && s.StartsWith("#"))
                {
                    Color parsed;
                    if (ColorUtility.TryParseHtmlString(s, out parsed)) return parsed;
                }
                return new Color(Get("r", 0), Get("g", 1), Get("b", 2), dict != null && dict.ContainsKey("a") ? Get("a", 3) : 1f);
            }
            return null;
        }

        static object CoerceValue(object raw, Type target)
        {
            if (raw == null) return DefaultOf(target);
            if (target.IsInstanceOfType(raw)) return raw;
            var vec = ParseVectorLike(target, raw);
            if (vec != null) return vec;
            // 引用：{handle} / {asset}
            var dict = raw as Dictionary<string, object>;
            if (dict != null && (dict.ContainsKey("handle") || dict.ContainsKey("asset")))
            {
                var h = GetString(dict, "handle");
                if (!string.IsNullOrEmpty(h))
                {
                    var obj = GetHandle(h);
                    if (obj != null && target.IsInstanceOfType(obj)) return obj;
                }
                var asset = GetString(dict, "asset");
                if (!string.IsNullOrEmpty(asset))
                {
                    var loaded = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(asset);
                    if (loaded != null && target.IsInstanceOfType(loaded)) return loaded;
                }
            }
            if (target.IsEnum) return Enum.Parse(target, System.Convert.ToString(raw, CultureInfo.InvariantCulture), true);
            if (target == typeof(string)) return System.Convert.ToString(raw, CultureInfo.InvariantCulture);
            return Coerce(raw, target);
        }

        static object SetMember(object target, Type type, string member, object raw, bool isStatic)
        {
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.FlattenHierarchy
                | (isStatic ? BindingFlags.Static : BindingFlags.Instance);
            var prop = type.GetProperty(member, flags);
            if (prop != null)
            {
                if (!prop.CanWrite) throw new KnownError("readonly_member", "属性不可写: " + member);
                prop.SetValue(isStatic ? null : target, CoerceValue(raw, prop.PropertyType), null);
                return prop.GetValue(isStatic ? null : target, null);
            }
            var field = type.GetField(member, flags);
            if (field != null)
            {
                field.SetValue(isStatic ? null : target, CoerceValue(raw, field.FieldType));
                return field.GetValue(isStatic ? null : target);
            }
            throw new KnownError("member_not_found", "找不到可写成员: " + type.Name + "." + member);
        }

        static Dictionary<string, object> GameObjectCreate(Dictionary<string, object> args)
        {
            var name = GetString(args, "name") ?? "GameObject";
            var primitive = GetString(args, "primitive");
            GameObject go;
            if (!string.IsNullOrEmpty(primitive))
            {
                PrimitiveType prim;
                if (!Enum.TryParse(primitive, true, out prim)) throw new KnownError("invalid_argument", "未知 primitive: " + primitive);
                go = GameObject.CreatePrimitive(prim);
                go.name = name;
            }
            else go = new GameObject(name);

            var parentPath = GetString(args, "parentPath");
            var parentHandle = GetString(args, "parentHandle");
            if (!string.IsNullOrEmpty(parentPath) || !string.IsNullOrEmpty(parentHandle))
            {
                var parentArgs = new Dictionary<string, object>();
                if (!string.IsNullOrEmpty(parentPath)) parentArgs["path"] = parentPath;
                if (!string.IsNullOrEmpty(parentHandle)) parentArgs["handle"] = parentHandle;
                var parentGo = ResolveGameObject(parentArgs);
                go.transform.SetParent(parentGo.transform, false);
            }
            foreach (var compName in GetStringList(args, "components"))
            {
                var t = FindType(compName);
                if (t != null && go.GetComponent(t) == null) go.AddComponent(t);
            }
            Undo.RegisterCreatedObjectUndo(go, "DSH Create " + name);
            EditorUtility.SetDirty(go);
            return DescribeRef(go);
        }

        static Dictionary<string, object> GameObjectDelete(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var name = go.name;
            Undo.DestroyObjectImmediate(go);
            var d = new Dictionary<string, object>();
            d["deleted"] = name;
            return d;
        }

        static Dictionary<string, object> GameObjectRename(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var name = GetString(args, "name");
            if (string.IsNullOrEmpty(name)) throw new KnownError("invalid_argument", "缺少 name");
            Undo.RecordObject(go, "DSH Rename");
            go.name = name;
            EditorUtility.SetDirty(go);
            return DescribeRef(go);
        }

        static Dictionary<string, object> GameObjectDuplicate(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var copy = UnityEngine.Object.Instantiate(go, go.transform.parent);
            copy.name = go.name + "_Copy";
            Undo.RegisterCreatedObjectUndo(copy, "DSH Duplicate");
            return DescribeRef(copy);
        }

        static Dictionary<string, object> GameObjectSetActive(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var active = ToBool(args, "active");
            Undo.RecordObject(go, "DSH SetActive");
            go.SetActive(active);
            var d = new Dictionary<string, object>();
            d["name"] = go.name;
            d["active"] = go.activeSelf;
            return d;
        }

        static Dictionary<string, object> GameObjectSetParent(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var parentPath = GetString(args, "parentPath");
            var parentHandle = GetString(args, "parentHandle");
            var worldPositionStays = ToBool(args, "worldPositionStays");
            if (string.IsNullOrEmpty(parentPath) && string.IsNullOrEmpty(parentHandle))
            {
                go.transform.SetParent(null, worldPositionStays);
            }
            else
            {
                var parentArgs = new Dictionary<string, object>();
                if (!string.IsNullOrEmpty(parentPath)) parentArgs["path"] = parentPath;
                if (!string.IsNullOrEmpty(parentHandle)) parentArgs["handle"] = parentHandle;
                go.transform.SetParent(ResolveGameObject(parentArgs).transform, worldPositionStays);
            }
            return DescribeRef(go);
        }

        static Dictionary<string, object> GameObjectSetTransform(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var t = go.transform;
            Undo.RecordObject(t, "DSH Transform");
            if (args.ContainsKey("position")) t.position = (Vector3)CoerceValue(args["position"], typeof(Vector3));
            if (args.ContainsKey("localPosition")) t.localPosition = (Vector3)CoerceValue(args["localPosition"], typeof(Vector3));
            if (args.ContainsKey("rotation")) t.rotation = (Quaternion)CoerceValue(args["rotation"], typeof(Quaternion));
            if (args.ContainsKey("localRotation")) t.localRotation = (Quaternion)CoerceValue(args["localRotation"], typeof(Quaternion));
            if (args.ContainsKey("localScale")) t.localScale = (Vector3)CoerceValue(args["localScale"], typeof(Vector3));
            if (args.ContainsKey("eulerAngles")) t.eulerAngles = (Vector3)CoerceValue(args["eulerAngles"], typeof(Vector3));
            EditorUtility.SetDirty(go);
            var d = new Dictionary<string, object>();
            d["name"] = go.name;
            d["position"] = new List<object> { (double)t.position.x, (double)t.position.y, (double)t.position.z };
            d["localScale"] = new List<object> { (double)t.localScale.x, (double)t.localScale.y, (double)t.localScale.z };
            d["eulerAngles"] = new List<object> { (double)t.eulerAngles.x, (double)t.eulerAngles.y, (double)t.eulerAngles.z };
            return d;
        }

        static Dictionary<string, object> ComponentAdd(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var typeName = GetString(args, "componentType");
            if (string.IsNullOrEmpty(typeName)) throw new KnownError("invalid_argument", "缺少 componentType");
            var type = FindType(typeName);
            if (type == null) throw new KnownError("type_not_found", "找不到类型: " + typeName);
            var existing = go.GetComponent(type);
            if (existing != null) return DescribeRef(existing);
            var comp = go.AddComponent(type);
            Undo.RegisterCreatedObjectUndo(comp, "DSH AddComponent");
            return DescribeRef(comp);
        }

        static Dictionary<string, object> ComponentRemove(Dictionary<string, object> args)
        {
            var comp = ResolveComponent(args);
            var name = comp.GetType().Name;
            Undo.DestroyObjectImmediate(comp);
            var d = new Dictionary<string, object>();
            d["removed"] = name;
            return d;
        }

        static Dictionary<string, object> ComponentSet(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var typeName = GetString(args, "componentType");
            if (string.IsNullOrEmpty(typeName)) throw new KnownError("invalid_argument", "缺少 componentType");
            var type = FindType(typeName);
            if (type == null) throw new KnownError("type_not_found", "找不到类型: " + typeName);
            var comp = go.GetComponent(type);
            if (comp == null) throw new KnownError("component_not_found", "对象上没有组件: " + typeName);
            var values = args.ContainsKey("values") ? args["values"] as Dictionary<string, object> : null;
            if (values == null) throw new KnownError("invalid_argument", "缺少 values");
            Undo.RecordObject(comp, "DSH Set " + typeName);
            var applied = new Dictionary<string, object>();
            foreach (var kv in values) applied[kv.Key] = Describe(SetMember(comp, type, kv.Key, kv.Value, false)) ?? null;
            EditorUtility.SetDirty(comp);
            return applied;
        }

        static Dictionary<string, object> ComponentGet(Dictionary<string, object> args)
        {
            var comp = ResolveComponent(args);
            var d = new Dictionary<string, object>();
            d["type"] = comp.GetType().Name;
            d["handle"] = PutHandle(comp);
            d["name"] = comp.name;
            var values = args.ContainsKey("values") ? args["values"] as List<object> : null;
            if (values != null && values.Count > 0)
            {
                var read = new Dictionary<string, object>();
                foreach (var key in values)
                {
                    var member = key as string;
                    if (string.IsNullOrEmpty(member)) continue;
                    read[member] = Describe(ResolveMember(comp, comp.GetType(), member, false));
                }
                d["values"] = read;
            }
            return d;
        }

        static object ResolveMember(object target, Type type, string member, bool isStatic)
        {
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.FlattenHierarchy
                | (isStatic ? BindingFlags.Static : BindingFlags.Instance);
            var prop = type.GetProperty(member, flags);
            if (prop != null && prop.CanRead) return prop.GetValue(isStatic ? null : target, null);
            var field = type.GetField(member, flags);
            if (field != null) return field.GetValue(isStatic ? null : target);
            throw new KnownError("member_not_found", "找不到成员: " + type.Name + "." + member);
        }

        static Dictionary<string, object> PrefabCreate(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var prefab = PrefabUtility.SaveAsPrefabAssetAndConnect(go, path, InteractionMode.AutomatedAction);
            AssetDatabase.Refresh();
            return DescribeRef(prefab);
        }

        static Dictionary<string, object> PrefabInstantiate(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var prefab = AssetDatabase.LoadAssetAtPath<GameObject>(path);
            if (prefab == null) throw new KnownError("asset_not_found", "找不到 Prefab: " + path);
            var instance = (GameObject)PrefabUtility.InstantiatePrefab(prefab);
            var parentPath = GetString(args, "parentPath");
            if (!string.IsNullOrEmpty(parentPath))
            {
                var t = FindTransformByPath(parentPath);
                if (t != null) instance.transform.SetParent(t, false);
            }
            Undo.RegisterCreatedObjectUndo(instance, "DSH Instantiate");
            return DescribeRef(instance);
        }

        static Dictionary<string, object> PrefabOpen(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var stage = UnityEditor.SceneManagement.PrefabStageUtility.OpenPrefab(path);
            if (stage == null) throw new KnownError("prefab_open_failed", "无法打开 Prefab: " + path);
            var d = new Dictionary<string, object>();
            d["opened"] = stage.assetPath;
            d["root"] = DescribeRef(stage.prefabContentsRoot);
            return d;
        }

        static Dictionary<string, object> PrefabSave(Dictionary<string, object> args)
        {
            var stage = UnityEditor.SceneManagement.PrefabStageUtility.GetCurrentPrefabStage();
            if (stage == null) throw new KnownError("invalid_state", "当前不在 Prefab 编辑模式");
            PrefabUtility.SaveAsPrefabAsset(stage.prefabContentsRoot, stage.assetPath);
            stage.ClearDirtiness();
            AssetDatabase.Refresh();
            var d = new Dictionary<string, object>();
            d["saved"] = stage.assetPath;
            return d;
        }

        static Dictionary<string, object> PrefabClose(Dictionary<string, object> args)
        {
            var stage = UnityEditor.SceneManagement.PrefabStageUtility.GetCurrentPrefabStage();
            if (stage == null) return new Dictionary<string, object> { { "closed", false } };
            var path = stage.assetPath;
            UnityEditor.SceneManagement.StageUtility.GoToMainStage();
            var d = new Dictionary<string, object>();
            d["closed"] = true;
            d["path"] = path;
            return d;
        }

        static Material ResolveMaterial(Dictionary<string, object> args)
        {
            var handle = GetString(args, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var mat = GetHandle(handle) as Material;
                if (mat != null) return mat;
            }
            var asset = GetString(args, "asset") ?? GetString(args, "path");
            if (!string.IsNullOrEmpty(asset))
            {
                var mat = AssetDatabase.LoadAssetAtPath<Material>(asset);
                if (mat != null) return mat;
                throw new KnownError("asset_not_found", "找不到材质: " + asset);
            }
            throw new KnownError("invalid_argument", "需要 handle 或 asset");
        }

        static Dictionary<string, object> MaterialGet(Dictionary<string, object> args)
        {
            var mat = ResolveMaterial(args);
            var d = new Dictionary<string, object>();
            d["handle"] = PutHandle(mat);
            d["shader"] = mat.shader != null ? mat.shader.name : null;
            var props = new List<object>();
            if (mat.shader != null)
            {
                var count = mat.shader.GetPropertyCount();
                for (var i = 0; i < count && i < 80; i++)
                {
                    var name = mat.shader.GetPropertyName(i);
                    var type = mat.shader.GetPropertyType(i).ToString();
                    var row = new Dictionary<string, object>();
                    row["name"] = name;
                    row["type"] = type;
                    if (mat.HasProperty(name))
                    {
                        if (mat.HasProperty(name)) row["value"] = DescribeProperty(mat, name, type);
                    }
                    props.Add(row);
                }
            }
            d["properties"] = props;
            return d;
        }

        static object DescribeProperty(Material mat, string name, string type)
        {
            try
            {
                if (type == "Color") { var c = mat.GetColor(name); return new List<object> { (double)c.r, (double)c.g, (double)c.b, (double)c.a }; }
                if (type == "Float" || type == "Range" || type == "Int") return Describe(mat.GetFloat(name));
                if (type == "Vector") { var v = mat.GetVector(name); return new List<object> { (double)v.x, (double)v.y, (double)v.z, (double)v.w }; }
                if (type == "Texture") { var t = mat.GetTexture(name); return t == null ? null : DescribeRef(t); }
            }
            catch { }
            return null;
        }

        static Dictionary<string, object> MaterialSet(Dictionary<string, object> args)
        {
            var mat = ResolveMaterial(args);
            var values = args.ContainsKey("values") ? args["values"] as Dictionary<string, object> : null;
            if (values == null) throw new KnownError("invalid_argument", "缺少 values");
            Undo.RecordObject(mat, "DSH Material");
            var applied = new List<object>();
            foreach (var kv in values)
            {
                if (!mat.HasProperty(kv.Key)) continue;
                var type = mat.shader != null ? mat.shader.GetPropertyType(mat.shader.FindPropertyIndex(kv.Key)).ToString() : "";
                if (type == "Color") mat.SetColor(kv.Key, (Color)CoerceValue(kv.Value, typeof(Color)));
                else if (type == "Vector") mat.SetVector(kv.Key, (Vector4)CoerceValue(kv.Value, typeof(Vector4)));
                else if (type == "Texture") mat.SetTexture(kv.Key, (Texture)CoerceValue(kv.Value, typeof(Texture)));
                else mat.SetFloat(kv.Key, (float)System.Convert.ToDouble(kv.Value is Dictionary<string, object> ? 1 : kv.Value, CultureInfo.InvariantCulture));
                applied.Add(kv.Key);
            }
            EditorUtility.SetDirty(mat);
            var d = new Dictionary<string, object>();
            d["applied"] = applied;
            d["shader"] = mat.shader != null ? mat.shader.name : null;
            return d;
        }

        static Dictionary<string, object> AssetOp(Dictionary<string, object> args, string op)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var target = GetString(args, "target");
            string result = null;
            if (op == "rename")
            {
                if (string.IsNullOrEmpty(target)) throw new KnownError("invalid_argument", "缺少 target（新名称）");
                result = AssetDatabase.RenameAsset(path, target);
            }
            else if (op == "move")
            {
                if (string.IsNullOrEmpty(target)) throw new KnownError("invalid_argument", "缺少 target（目标目录）");
                result = AssetDatabase.MoveAsset(path, target);
            }
            else if (op == "delete")
            {
                var ok = AssetDatabase.DeleteAsset(path);
                result = ok ? "" : "delete_failed";
            }
            else if (op == "duplicate")
            {
                if (string.IsNullOrEmpty(target)) throw new KnownError("invalid_argument", "缺少 target（新路径）");
                var ok = AssetDatabase.CopyAsset(path, target);
                result = ok ? "" : "copy_failed";
            }
            AssetDatabase.Refresh();
            var d = new Dictionary<string, object>();
            d["operation"] = op;
            d["assetPath"] = path;
            d["error"] = string.IsNullOrEmpty(result) ? null : result;
            d["ok"] = string.IsNullOrEmpty(result);
            return d;
        }

        static Dictionary<string, object> EditorStatus()
        {
            var d = new Dictionary<string, object>();
            d["unityVersion"] = Application.unityVersion;
            d["projectPath"] = _projectRoot;
            d["productName"] = Application.productName;
            d["scene"] = SceneManager.GetActiveScene().name;
