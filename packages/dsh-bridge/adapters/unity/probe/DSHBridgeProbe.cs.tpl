        static DSHBridgeProbe()
        {
            // P2：**先订阅 Tick 再初始化**。静态构造函数里的异常会被 Unity 吞掉，
            // 探针从此静默失效（心跳不写、inbox 不再被扫描），而 EditorApplication.update
            // 是失败后唯一还能让探针自愈的入口。
            try { EditorApplication.update += Tick; }
            catch (Exception) { }
            try { Init(); }
            catch (Exception e) { ReportInitFailure(e); }
        }

        /// <summary>
        /// Init 失败必须可见且可自愈（P2）：写通道诊断（独立队列，不污染 code.execute 诊断）、
        /// 尝试补一条 init_failed 事件、并在控制台留错误；随后由 Tick 看门狗按节流间隔重试。
        /// </summary>
        static void ReportInitFailure(Exception e)
        {
            var errorType = e == null ? "unknown" : e.GetType().Name;
            var message = e == null ? "" : (e.Message ?? "");
            try { UnityEngine.Debug.LogError("[DSHBridge] init failed: " + errorType + ": " + message); }
            catch (Exception) { }
            AddChannelDiagnosticSafe("init-failed:" + errorType + ": " + message);
            try
            {
                PushEvent("init_failed", new Dictionary<string, object>
                {
                    { "errorType", errorType },
                    { "message", message.Length > 500 ? message.Substring(0, 500) : message },
                });
            }
            catch (Exception) { }
        }

        static void Init()
        {
            _projectRoot = Directory.GetParent(Application.dataPath).FullName;
            _rootDir = Path.Combine(_projectRoot, RootRelative);
            // AA-SEC-003：解析工程根的真实路径。工程根自身在符号链接下（/tmp/link、macOS 的 /var）时，
            // 字符串比较会把「真实在工程内」的路径误判成越界；以真实根为基准才能既挡外逃又不误伤。
            // 解析失败（P/Invoke 不可用等）时降级为字符串检查，避免整台机器不可用。
            _projectRootReal = CanonicalizeExistingPrefix(_projectRoot);
            if (string.IsNullOrEmpty(_projectRootReal))
            {
                _projectRootReal = _projectRoot;
                _realpathFallback = true;
            }

            var self = Process.GetCurrentProcess();
            _pid = self.Id;
            _startTicks = self.StartTime.ToUniversalTime().Ticks;
            _startedAt = self.StartTime.ToUniversalTime().ToString("o", CultureInfo.InvariantCulture);

            if (!_reflectEnabled.HasValue) _reflectEnabled = AuthorizedByArgv();
            LoadOrCreateIdentity();

            _instanceId = "unity:" + Sha1Short(_projectRoot);
            _inboxDir = Path.Combine(_rootDir, _bootId, "inbox");
            _outboxDir = Path.Combine(_rootDir, _bootId, "outbox");
            _eventsDir = Path.Combine(_rootDir, _bootId, "events");
            _doneDir = Path.Combine(_rootDir, _bootId, "done");
            _progressDir = Path.Combine(_rootDir, _bootId, "in-progress");
            // 目录创建失败必须显式上报：这里曾静默抛出并被静态构造函数的 catch 吞掉，
            // 结果心跳照常写、指向的目录却不存在，故障对调用方完全不可见（BUG-001）。
            // 现在改为抛出 → 静态构造函数上报诊断，Tick 看门狗每 30s 重试一次（P2 自愈）。
            if (!EnsureBootDirs())
            {
                UnityEngine.Debug.LogError("[DSHBridge] 通道目录创建失败，bootId=" + _bootId + "，调用将不可用");
                throw new KnownError("io_error", "通道目录创建失败，bootId=" + _bootId);
            }

            // P1-7：instance.json 的 eventSeq 只在心跳里每 2 秒落盘一次，域重载前最后一批
            // 事件可能已写进 events/ 却还没进心跳。直接沿用 instance.json 会让 probe_ready
            // 与旧事件同号覆盖（编译事件丢失窗口 0~2s），这里以 events/ 目录里的最大序号兜底。
            RecoverEventSeqFromChannel();

            // AA-OPT-010：清理本地历史运行留下的通道目录，避免 Library 随重启线性膨胀。
            SweepStaleBootDirs();

            // 先补写「上次被打断」的响应，再开始心跳，避免调用方在窗口期内看不到结论。
            RecoverInterruptedRequests();
            // 作业体系：把上次域重载遗留的 running/pending 作业标记为 interrupted。
            RecoverInterruptedJobs();

            WriteHeartbeat();
            // P1-4：instance.json 由 WriteAtomic 写出（0600 由 WriteAtomic 统一收紧），
            // 这里再显式收紧一次，保证启动窗口内第一个心跳落盘的文件也不会是 0644。
            TryFixPermissions(Path.Combine(_rootDir, "instance.json"), false);

            // Tick 已在静态构造函数里订阅；其余事件只订阅一次（Init 可能被看门狗重试）。
            SubscribeHandlers();

            _initCompleted = true;
            PushEvent("probe_ready", null);
            UnityEngine.Debug.Log("[DSHBridge] probe " + ProbeVersion + " ready, bootId=" + _bootId);
        }

        /// <summary>编译完成/播放模式/日志回调只订阅一次：Init 被看门狗重试时不能重复注册。</summary>
        static void SubscribeHandlers()
        {
            if (_handlersSubscribed) return;
            _handlersSubscribed = true;
            CompilationPipeline.compilationFinished += OnCompilationFinished;
            EditorApplication.playModeStateChanged += OnPlayModeChanged;
            Application.logMessageReceivedThreaded += OnLog;
        }

        /// <summary>
        /// bootId 目录名是否安全：16 位十六进制。
        ///
        /// 不能只检查长度：bootId 会被拼进 Path.Combine 当目录名，而 instance.json 是
        /// 磁盘上可被任意进程改写的文件。长度校验挡不住 `..` 之类的相对段，
        /// 这里按字符集收窄到 [0-9a-f]，与探针自己生成的 Guid("N") 前缀完全一致。
        /// </summary>
        static bool IsValidBootId(string bootId)
        {
            if (string.IsNullOrEmpty(bootId) || bootId.Length != 16) return false;
            for (var i = 0; i < bootId.Length; i++)
            {
                var c = bootId[i];
                var isHex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
                if (!isHex) return false;
            }
            return true;
        }

        /// <summary>
        /// 该 bootId 的通道目录是否已经是「齐全」状态。
        /// 只有 5 个子目录都在，才算可以复用——否则复用会得到一个写不进去的通道。
        /// </summary>
        static bool BootDirsComplete(string bootId)
        {
            if (!IsValidBootId(bootId)) return false;
            var baseDir = Path.Combine(_rootDir, bootId);
            foreach (var sub in new[] { "inbox", "outbox", "events", "done", "in-progress" })
            {
                if (!Directory.Exists(Path.Combine(baseDir, sub))) return false;
            }
            return true;
        }

        // 身份：域重载复用同一 pid+startTime 的 bootId；编辑器重启则换新。
        //
        // 复用必须同时校验通道目录仍然齐全（BUG-001）：instance.json 与磁盘目录是两份
        // 独立状态，只校验 pid/startTicks/bootId/nonce 会出现「身份对得上、目录却不存在」。
        // 一旦发生，之后每次域重载都走复用分支，故障被固化，心跳照常刷新，
        // 调用方却持续报 bridge mailbox missing。目录不齐全时换新 bootId，让心跳重新指向真实目录。
        static void LoadOrCreateIdentity()
        {
            var instanceFile = Path.Combine(_rootDir, "instance.json");
            try
            {
                if (File.Exists(instanceFile))
                {
                    // P2：instance.json 是磁盘上可被任意进程改写的文件，解析前先限制大小，
                    // 防止超大文件把启动/域重载路径变成主线程长时间阻塞（MiniJson 另有深度上限）。
                    var instanceLength = new FileInfo(instanceFile).Length;
                    if (instanceLength <= MaxIdentityBytes)
                    {
                        var existing = MiniJson.Parse(File.ReadAllText(instanceFile, Encoding.UTF8)) as Dictionary<string, object>;
                        if (existing != null
                            && ToLong(existing, "pid") == _pid
                            && ToLong(existing, "startTicks") == _startTicks
                            && GetString(existing, "bootId") != null
                            && GetString(existing, "nonce") != null)
                        {
                            var reused = GetString(existing, "bootId");
                            if (BootDirsComplete(reused))
                            {
                                _bootId = reused;
                                _nonce = GetString(existing, "nonce");
                                _eventSeq = ToLong(existing, "eventSeq");
                                return;
                            }
                            UnityEngine.Debug.LogWarning(
                                "[DSHBridge] bootId " + reused + " 的通道目录不完整，换用新的 bootId（原 instance.json 指向的目录不存在）");
                        }
                    }
                    else
                    {
                        UnityEngine.Debug.LogWarning(
                            "[DSHBridge] instance.json 超过 " + MaxIdentityBytes + " 字节，忽略并重建通道身份");
                    }
                }
            }
            catch { }
            _bootId = Guid.NewGuid().ToString("N").Substring(0, 16);
            _nonce = Guid.NewGuid().ToString("N");
            _eventSeq = 0;
        }

        /// <summary>
        /// 确保当前 bootId 的 5 个通道子目录存在；已存在时是空操作。
        ///
        /// 心跳每 2 秒调用一次，成本可忽略，但它把「instance.json 指向的目录必须存在」这个
        /// 不变量从「只在启动时成立一次」变成「每次心跳都重新保证」。任何原因
        /// （创建期异常、外部误删、清理竞争）导致目录丢失，都会在 2 秒内自愈，
        /// 而不是让调用方持续收到 bridge mailbox missing。
        /// </summary>
        static bool EnsureBootDirs()
        {
            try
            {
                Directory.CreateDirectory(_rootDir);
                Directory.CreateDirectory(_inboxDir);
                Directory.CreateDirectory(_outboxDir);
                Directory.CreateDirectory(_eventsDir);
                Directory.CreateDirectory(_doneDir);
                Directory.CreateDirectory(_progressDir);
                // P1-4：通道目录（含根目录）0700。心跳每 2s 都会走到这里，
                // 因此外部把目录重建/权限改宽后也能在一拍内自愈。
                TryFixPermissions(_rootDir, true);
                TryFixPermissions(_inboxDir, true);
                TryFixPermissions(_outboxDir, true);
                TryFixPermissions(_eventsDir, true);
                TryFixPermissions(_doneDir, true);
                TryFixPermissions(_progressDir, true);
                return true;
            }
            catch (Exception e)
            {
                UnityEngine.Debug.LogWarning("[DSHBridge] ensure boot dirs: " + e.Message);
                return false;
            }
        }

        // ===== 通道权限（AUD-CODE-001 P1-4）=====
        // 文档（security-data-governance / DETAIL）承诺通道根目录 0700、通道文件 0600，
        // 但目录/文件实际权限由进程 umask 决定（macOS 默认 022 → 目录 0755、文件 0644），
        // 同机其他用户因此可读 nonce、pid、工程路径与事件。这里在创建/写入后显式收紧；
        // 失败静默降级为「受 umask 影响」，不影响探针可用性。
        const uint ModeDirPrivate = 448;  // 0700（C# 没有八进制字面量）
        const uint ModeFilePrivate = 384; // 0600

        [System.Runtime.InteropServices.DllImport("libc", SetLastError = true, ExactSpelling = true)]
        static extern int chmod(string path, uint mode);

        /// <summary>
        /// 把通道目录/文件权限收紧为 0700/0600（macOS/Linux）。Windows 没有 POSIX 权限位，直接跳过。
        /// 只 P/Invoke libc 一个符号：不引入依赖、不启动外部进程，符合探针「零端口/零第三方」约束。
        /// 失败静默（路径消失、只读挂载、权限不足都退化为受 umask 影响）。
        /// 供 MonoCompiler 的 WriteAtomic 对本文件写出的文件调用（跨文件契约）。
        /// </summary>
        static void TryFixPermissions(string path, bool isDirectory)
        {
            if (_chmodUnavailable || string.IsNullOrEmpty(path)) return;
            if (Application.platform != RuntimePlatform.OSXEditor && Application.platform != RuntimePlatform.LinuxEditor) return;
            try { chmod(path, isDirectory ? ModeDirPrivate : ModeFilePrivate); }
            catch (DllNotFoundException) { _chmodUnavailable = true; }
            catch (EntryPointNotFoundException) { _chmodUnavailable = true; }
            catch (Exception) { }
        }

        /// <summary>
        /// AddChannelDiagnostic 定义在 MonoCompiler partial（跨文件契约），本文件只调用不定义。
        /// 包一层的原因：初始化早期/发布失败时通道本身可能不可用，诊断路径绝不能反过来抛异常
        /// （否则会把「一次失败」升级成「静态构造函数崩溃且没有任何诊断」）。
        /// </summary>
        static void AddChannelDiagnosticSafe(string message)
        {
            try { AddChannelDiagnostic(message); }
            catch (Exception) { }
        }

        /// <summary>
        /// P1-7：把事件序号恢复到 max(instance.json 里记录的 seq, events/ 目录里的最大 seq)。
        /// 心跳只每 2 秒落盘一次 eventSeq，域重载前最后一批事件可能已写入 events/ 但还没进心跳；
        /// 只沿用 instance.json 会让 probe_ready 与旧事件同号，写同一文件名从而覆盖旧事件。
        /// 事件文件名契约（DSH 侧 mailbox/maintenance 只解析 evt_ + 纯数字 + .json）：
        /// 形如 evt_0000000123.json；不符合契约的文件名一律忽略，不参与 max 计算。
        /// </summary>
        static void RecoverEventSeqFromChannel()
        {
            try
            {
                if (string.IsNullOrEmpty(_eventsDir) || !Directory.Exists(_eventsDir)) return;
                foreach (var file in Directory.GetFiles(_eventsDir, "evt_*.json"))
                {
                    var name = Path.GetFileName(file);
                    if (string.IsNullOrEmpty(name)) continue;
                    if (!name.StartsWith("evt_", StringComparison.Ordinal)) continue;
                    if (!name.EndsWith(".json", StringComparison.Ordinal)) continue;
                    // 去掉 "evt_" 前缀与 ".json" 后缀，剩余部分必须全是十进制数字。
                    var digits = name.Substring(4, name.Length - 4 - 5);
                    if (digits.Length == 0 || digits.Length > 18) continue;
                    var seq = 0L;
                    var valid = true;
                    for (var i = 0; i < digits.Length; i++)
                    {
                        var c = digits[i];
                        if (c < '0' || c > '9') { valid = false; break; }
                        seq = seq * 10 + (c - '0');
                    }
                    if (!valid) continue;
                    if (seq > _eventSeq) _eventSeq = seq;
                }
            }
            catch (Exception) { }
        }

        /// <summary>
        /// AA-OPT-010：清理本机历史运行留下的通道目录，避免 Library 随重启线性膨胀。
        /// 除当前通道目录外，只保留 mtime 最新的一个历史目录，其余在明确陈旧时删除。
        ///
        /// 安全约束（AUD-CODE-001 P2）：
        ///   1) 只删「明显陈旧」的目录——目录内最近一次写入超过 StaleBootDirMinAgeSeconds（10 分钟），
        ///      避免按目录 mtime 误删另一个仍在使用的通道（编辑器重启窗口、短暂多域窗口）。
        ///   2) 跳过符号链接目录：递归删除对符号链接可能跟随到工程外。
        ///   3) 当前 bootId 目录永不处理；保留最新一个历史目录作为排障现场；删除失败忽略，下次再试。
        /// </summary>
        static void SweepStaleBootDirs()
        {
            try
            {
                if (!Directory.Exists(_rootDir)) return;
                var dirs = new List<string>();
                foreach (var dir in Directory.GetDirectories(_rootDir))
                {
                    var name = Path.GetFileName(dir);
                    if (name == _bootId) continue;
                    if (!IsValidBootId(name)) continue;
                    dirs.Add(dir);
                }
                if (dirs.Count <= 1) return;
                dirs.Sort(delegate (string a, string b) { return Directory.GetLastWriteTimeUtc(b).CompareTo(Directory.GetLastWriteTimeUtc(a)); });
                for (var i = 1; i < dirs.Count; i++)
                {
                    if (!IsObviouslyStaleBootDir(dirs[i])) continue;
                    try { Directory.Delete(dirs[i], true); }
                    catch (Exception) { }
                }
            }
            catch (Exception) { }
        }

        /// <summary>
        /// 目录是否「明显陈旧」：非符号链接，且目录及其 5 个通道子目录里最近一次写入
        /// 已超过 StaleBootDirMinAgeSeconds。任何读取失败都返回 false（宁可不删，不能误删活跃通道）。
        /// 只看固定子目录、不做递归遍历：避免被植入的嵌套符号链接把遍历带出工程外。
        /// </summary>
        static bool IsObviouslyStaleBootDir(string dir)
        {
            try
            {
                var info = new DirectoryInfo(dir);
                if ((info.Attributes & FileAttributes.ReparsePoint) != 0) return false;
                var latest = info.LastWriteTimeUtc;
                foreach (var sub in new[] { "inbox", "outbox", "events", "done", "in-progress" })
                {
                    var subDir = Path.Combine(dir, sub);
                    if (!Directory.Exists(subDir)) continue;
                    var subInfo = new DirectoryInfo(subDir);
                    if ((subInfo.Attributes & FileAttributes.ReparsePoint) != 0) continue;
                    if (subInfo.LastWriteTimeUtc > latest) latest = subInfo.LastWriteTimeUtc;
                    foreach (var file in Directory.GetFiles(subDir, "*"))
                    {
                        var mtime = File.GetLastWriteTimeUtc(file);
                        if (mtime > latest) latest = mtime;
                    }
                }
                return (DateTime.UtcNow - latest).TotalSeconds > StaleBootDirMinAgeSeconds;
            }
            catch (Exception) { return false; }
        }

        static void Tick()
        {
            // P2：Init 失败后不再静默失效——Tick 是 Init 之后唯一还会被调用的入口，
            // 由它按 InitRetryInterval 节流重试 Init（成功即恢复正常通道），并上报失败原因。
            if (!_initCompleted)
            {
                TickInitRecovery();
                return;
            }
            var now = EditorApplication.timeSinceStartup;
            // P2：心跳/清扫/作业/测试/请求扫描各自独立 try/catch。旧实现共用一个 try，
            // 任何一段持续抛异常（例如作业列表损坏）都会让后面的 Poll 永不执行，
            // 表现为「探针在线但永远不处理请求」。
            if (now >= _nextHeartbeat)
            {
                _nextHeartbeat = now + HeartbeatInterval;
                try { WriteHeartbeat(); }
                catch (Exception e) { LogTickFailure("heartbeat", e); }
            }
            if (now >= _nextOutboxSweep)
            {
                _nextOutboxSweep = now + OutboxSweepInterval;
                try { SweepStaleOutbox(); }
                catch (Exception e) { LogTickFailure("outbox-sweep", e); }
                // done/ 与 outbox 共用同一节奏（60s）；独立 try/catch 保证一侧失败不影响另一侧。
                try { SweepDoneArchive(); }
                catch (Exception e) { LogTickFailure("done-sweep", e); }
            }
            try { JobTick(); }
            catch (Exception e) { LogTickFailure("job-tick", e); }
            try { PollTestJobs(); }
            catch (Exception e) { LogTickFailure("test-poll", e); }
            if (now < _nextScan) return;
            _nextScan = now + ScanInterval;
            try { Poll(); }
            catch (Exception e) { LogTickFailure("poll", e); }
        }

        static void TickInitRecovery()
        {
            try
            {
                var now = EditorApplication.timeSinceStartup;
                if (now < _nextInitRetry) return;
                _nextInitRetry = now + InitRetryInterval;
                Init();
                UnityEngine.Debug.Log("[DSHBridge] init recovered by watchdog, bootId=" + _bootId);
            }
            catch (Exception e) { ReportInitFailure(e); }
        }

        /// <summary>单段 Tick 失败：写通道诊断（有界队列），控制台日志按 10s 节流，避免刷屏。</summary>
        static void LogTickFailure(string stage, Exception e)
        {
            var message = e == null ? "unknown" : (e.GetType().Name + ": " + (e.Message ?? ""));
            AddChannelDiagnosticSafe("tick-" + stage + ": " + message);
            var now = EditorApplication.timeSinceStartup;
            if (now < _nextTickLog) return;
            _nextTickLog = now + 10;
            try { UnityEngine.Debug.LogWarning("[DSHBridge] tick " + stage + ": " + message); }
            catch (Exception) { }
        }

        /// <summary>一次扫描内最多丢弃多少个无效文件（防止单个坏批次长时间占用主线程）。</summary>
        const int MaxDiscardsPerScan = 8;

        /// <summary>
        /// 一次扫描最多执行多少个有效请求（P2-25）。
        ///
        /// 旧实现「消费一个就 break」把吞吐钉死在 10 req/s（ScanInterval=0.1s → 一帧一个），
        /// 并发调用时队头阻塞会直接把后续请求拖到调用方超时。这里允许一次扫描连续执行若干个，
        /// 并用 ScanBudgetMs 兜住主线程占用；单个请求本身的耗时无法中断，预算只决定
        /// 「是否再取下一个」，这是探针能给出的边界。
        /// </summary>
        const int MaxRequestsPerScan = 4;

        /// <summary>一次扫描的执行预算（毫秒）：已执行过请求且超出预算时不再取下一个。</summary>
        const double ScanBudgetMs = 50;

        /// <summary>
        /// inbox 待处理上限（P2-47）：与 DSH 侧 transport/mailbox.mjs 的 `MAX_INBOX_FILES`
        /// **同名同值**（64）。两侧各守一段：
        ///   - DSH 写请求前：积压 ≥ 上限即抛 `instance_busy`（可重试），请求根本不会落盘；
        ///   - 探针扫描前：超过上限的部分立即回写同名 `instance_busy` 并移出 inbox，
        ///     兜住「绕过 DSH 直接写 inbox」与「DSH 侧上限被改动/未生效」的情况。
        /// 用同一个错误码是为了让调用方的退避逻辑只认一个名字，不需要区分错误来源。
        /// </summary>
        const int MaxInboxBacklog = 64;

        /// <summary>
        /// 一次扫描最多回写多少个积压拒绝（P2-47）：拒绝本身只是写一个小 JSON + 归档，
        /// 但上限仍要设，否则外部一次性写满 inbox 时这一轮扫描会长时间占住主线程。
        /// 剩下的由下一轮扫描（每 0.1s）继续，最终仍会清空。
        /// </summary>
        const int MaxBacklogRejectsPerScan = 64;

        /// <summary>
        /// outbox 响应的保留时长。超过这个时长还没被调用方取走，说明该调用早已放弃
        /// （超时返回），留着只会无限累积、并把通道变成一个越来越大的伪造/误配对来源。
        ///
        /// 这里只管 outbox；done/（请求/响应的历史归档）由 SweepDoneArchive 按
        /// DoneRetentionMs（7 天）与 MaxDoneFiles（2000 条）回收，口径与治理文档一致。
        /// </summary>
        const double OutboxRetentionMs = 10 * 60 * 1000;

        /// <summary>清理节奏：每 60 秒最多扫一次，避免每帧做目录遍历。</summary>
        const double OutboxSweepInterval = 60;

        /// <summary>
        /// done/ 归档的保留时长（P2-26/P2-35/P2-56/P3-69/P3-110）。
        ///
        /// 与治理文档承诺的「请求/响应保留 7 天」一致。旧实现把 done/ 当成「永不删除的
        /// 排障现场」，实际是每次调用留下 1~2 个文件（请求 + 响应，含完整 args 原文）的
        /// 无界增长源；卸载后也没有任何进程会再清扫它。
        /// </summary>
        const double DoneRetentionMs = 7 * 24 * 60 * 60 * 1000;

        /// <summary>done/ 归档的条数上限：超出时按 mtime 删除最旧的，保留最近 2000 条排障现场。</summary>
        const int MaxDoneFiles = 2000;

        static double _nextOutboxSweep;

        /// <summary>HandleFile 的处理结果：决定 Poll 是否继续看下一个文件。</summary>
        enum HandleOutcome
        {
            /// <summary>已消费一个属于本实例的有效请求（可能被执行，也可能被拒绝），本次扫描到此为止。</summary>
            Consumed,
            /// <summary>无效文件（坏 JSON / 缺 id / 不属于本实例），已归档，可继续看下一个。</summary>
            Discarded,
            /// <summary>文件已不在（被其它进程取走或读取失败），本次扫描到此为止。</summary>
            Absent,
        }

        /// <summary>
        /// 回收 outbox 里超龄的响应文件（含无人消费的 `*.rejected.json`）。
        ///
        /// 与调用方侧的清扫（ASECLI AA-OPT-023）互补：调用方只能清它自己关心的前缀，
        /// 进程崩溃/被强杀后就不会再有下一次清扫，只有探针自己能保证通道不会无限膨胀。
        /// </summary>
        static void SweepStaleOutbox()
        {
            try
            {
                if (string.IsNullOrEmpty(_outboxDir) || !Directory.Exists(_outboxDir)) return;
                var nowMs = NowMs();
                var removed = 0;
                foreach (var file in Directory.GetFiles(_outboxDir, "*.json"))
                {
                    try
                    {
                        var age = nowMs - File.GetLastWriteTimeUtc(file).ToUniversalTime().Subtract(
                            new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds;
                        if (age <= OutboxRetentionMs) continue;
                        File.Delete(file);
                        removed += 1;
                    }
                    catch (Exception) { }
                }
                if (removed > 0) AddDiagnostic("outbox-swept:" + removed);
            }
            catch (Exception) { }
        }

        /// <summary>
        /// 回收 done/ 里超龄或超量的归档（P2-26/P2-35/P2-56/P3-69/P3-110）。
        ///
        /// done/ 里的文件是**已完成请求的原始请求体与响应体**（可能包含 code.execute 的源码、
        /// asset.read 的资产正文、完整 args），旧策略是「永不删除、只随整条 bootId 目录陈旧回收」，
        /// 结果是同一个编辑器会话内随调用次数线性增长，且卸载后无人清理。
        ///
        /// 回收口径与治理文档一致：超过 DoneRetentionMs（7 天）删除；数量超过 MaxDoneFiles 时
        /// 只删最旧的，保留最近 2000 条排障现场。按 mtime 升序删除，最新的一条永不因此丢失。
        /// </summary>
        static void SweepDoneArchive()
        {
            try
            {
                if (string.IsNullOrEmpty(_doneDir) || !Directory.Exists(_doneDir)) return;
                var files = Directory.GetFiles(_doneDir, "*");
                if (files.Length == 0) return;

                var nowMs = NowMs();
                var entries = new List<KeyValuePair<string, double>>(files.Length);
                for (var i = 0; i < files.Length; i++)
                {
                    try
                    {
                        var mtime = File.GetLastWriteTimeUtc(files[i]).ToUniversalTime().Subtract(
                            new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds;
                        entries.Add(new KeyValuePair<string, double>(files[i], mtime));
                    }
                    catch (Exception) { }
                }
                if (entries.Count == 0) return;
                entries.Sort(delegate (KeyValuePair<string, double> a, KeyValuePair<string, double> b)
                {
                    return a.Value.CompareTo(b.Value);
                });

                // 升序排序后：超龄的一定是前缀，超量的也一定是最旧的那些 —— 取两者较大值。
                var overAge = 0;
                for (var i = 0; i < entries.Count; i++)
                {
                    if (nowMs - entries[i].Value > DoneRetentionMs) overAge = i + 1;
                }
                var overCount = entries.Count - MaxDoneFiles;
                var toRemove = Math.Max(overAge, overCount);
                var removed = 0;
                for (var i = 0; i < toRemove && i < entries.Count; i++)
                {
                    try
                    {
                        File.Delete(entries[i].Key);
                        removed += 1;
                    }
                    catch (Exception) { }
                }
                if (removed > 0) AddDiagnostic("done-swept:" + removed);
            }
            catch (Exception) { }
        }

        /// <summary>
        /// 请求内容的摘要（原始文件字节的 SHA-256 前 16 个十六进制字符）。
        ///
        /// 用途：调用方校验「这条响应确实对应我写进去的那份请求」，防止同 id 的迟到响应
        /// 或残留响应被误当成本次结果。
        ///
        /// **能力边界**：它防的是「误配对」，不是「伪造」。能写 inbox 的进程同样能读 inbox，
        /// 也就能算出同样的 hash。文件邮箱协议本身无法提供身份认证——见 DETAIL 的信任边界一节。
        /// </summary>
        static string RequestHashOfBytes(byte[] raw)
        {
            try
            {
                using (var sha = System.Security.Cryptography.SHA256.Create())
                {
                    var bytes = sha.ComputeHash(raw ?? new byte[0]);
                    var builder = new StringBuilder();
                    for (var i = 0; i < 8; i++) builder.Append(bytes[i].ToString("x2"));
                    return builder.ToString();
                }
            }
            catch (Exception) { return null; }
        }

        static void Poll()
        {
            string[] files;
            try
            {
                files = Directory.GetFiles(_inboxDir, "*.json");
            }
            catch { return; }
            if (files.Length == 0) return;
            Array.Sort(files, StringComparer.Ordinal);

            // 积压快速失败（P2-47）：本轮扫描开始前先看队列长度，超过 MaxInboxBacklog
            // 的部分立即回写 instance_busy 并移出 inbox。
            //
            // 为什么必须在扫描**前**判断：探针是单槽串行执行器，一次扫描最多取
            // MaxRequestsPerScan 个；inbox 堆到几十个时，队尾请求在调用方的 timeout_ms
            // 内根本轮不到执行。让它们安静排队的结果是每个调用都变成「超时 + 目标是否
            // 已执行的未知状态」，而这恰恰是最容易诱发重复破坏性操作的状态。
            // 立刻回写一个可重试的结论，比让调用方超时更有信息量。
            var overflow = files.Length - MaxInboxBacklog;
            if (overflow > 0)
            {
                files = RejectBacklogFiles(files, overflow);
                if (files.Length == 0) return;
            }

            // 一次扫描可以连续执行多个有效请求（P2-25）：旧实现「消费一个就 break」把吞吐
            // 钉死在 10 req/s，并发调用时后面的请求要等 N 个扫描周期才出队，很容易撞上
            // 调用方默认 30s 超时。这里用 MaxRequestsPerScan + ScanBudgetMs 双重上限兜住
            // 主线程占用；单个请求本身的耗时不可中断，预算只决定「是否再取下一个」。
            //
            // 无效文件（半写 JSON、别的实例的残留）仍允许在本次扫描内连续丢弃——
            // 否则 inbox 里残留 N 个坏文件时，每个正常请求都要多等 N 个扫描周期。
            //
            // 旧的 `_scanning` 重入标志已删除：Poll 只由 Tick 在主线程调用，
            // 重入不可能发生，保留它属于死代码（AUD-CODE-001 P2）；异常由 Tick 的分段
            // try/catch 兜住，不会把「扫描中」状态永久卡住。
            var discarded = 0;
            var executed = 0;
            var budget = Stopwatch.StartNew();
            for (var i = 0; i < files.Length; i++)
            {
                if (discarded >= MaxDiscardsPerScan) break;
                if (executed >= MaxRequestsPerScan) break;
                if (executed > 0 && budget.ElapsedMilliseconds >= ScanBudgetMs) break;
                var outcome = HandleFile(files[i]);
                if (outcome == HandleOutcome.Absent) break;
                if (outcome == HandleOutcome.Consumed)
                {
                    executed += 1;
                    continue;
                }
                discarded += 1;
            }
        }

        /// <summary>
        /// 把超出 MaxInboxBacklog 的请求立刻拒绝（P2-47），返回本轮仍需正常处理的文件。
        ///
        /// 保留序号最小（最早写入）的 MaxInboxBacklog 个继续走正常路径：
        /// 它们是最可能被调用方仍等待着的请求，必须先被消化。
        /// 溢出部分逐个 <see cref="RejectBacklogFile"/>；本轮最多处理
        /// MaxBacklogRejectsPerScan 个，剩下的留在 inbox 交给下一轮（Poll 每 0.1s 一次），
        /// 绝不因为一次清理长时间占用主线程。
        /// </summary>
        static string[] RejectBacklogFiles(string[] files, int overflow)
        {
            var keepCount = files.Length - overflow;
            if (keepCount < 0) keepCount = 0;
            var keep = new string[keepCount];
            Array.Copy(files, keep, keepCount);
            var rejected = 0;
            for (var i = keepCount; i < files.Length; i++)
            {
                if (rejected >= MaxBacklogRejectsPerScan) break;
                var outcome = RejectBacklogFile(files[i]);
                if (outcome == HandleOutcome.Absent) continue;
                rejected += 1;
            }
            return keep;
        }

        /// <summary>
        /// 单个溢出请求的拒绝路径（P2-47）：写回 instance_busy + 从 inbox 移除。
        ///
        /// 两个动作缺一不可：
        ///   - 只写响应不移除 → 下一轮扫描会再次命中同一个文件并重复回写（且 id 已进 done，
        ///     变成重复投递）；
        ///   - 只移除不写响应 → 调用方只能等到 timeout，无法区分「目标忙」与「目标没在跑」。
        ///
        /// 复用 HandleFile 的读取上限与四元组校验：不属于本实例的请求绝不能被写响应
        /// （那会把「忙」伪造进别的会话的 outbox），只能归档丢弃。
        /// </summary>
        static HandleOutcome RejectBacklogFile(string path)
        {
            var fileName = Path.GetFileName(path);
            if (string.IsNullOrEmpty(fileName)) return HandleOutcome.Absent;
            var progressPath = Path.Combine(_progressDir, fileName);
            var donePath = Path.Combine(_doneDir, fileName);

            byte[] rawBytes;
            try
            {
                var info = new FileInfo(path);
                if (!info.Exists) return HandleOutcome.Absent;
                if (info.Length > MaxRequestBytes)
                {
                    AddChannelDiagnosticSafe("oversized-request:" + info.Length.ToString(CultureInfo.InvariantCulture));
                    Finish(path, donePath);
                    return HandleOutcome.Discarded;
                }
                rawBytes = File.ReadAllBytes(path);
            }
            catch { return HandleOutcome.Absent; }
            if (rawBytes.Length > MaxRequestBytes)
            {
                AddChannelDiagnosticSafe("oversized-request-race:" + rawBytes.Length.ToString(CultureInfo.InvariantCulture));
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }

            Dictionary<string, object> req = null;
            try { req = MiniJson.Parse(new UTF8Encoding(false).GetString(rawBytes)) as Dictionary<string, object>; }
            catch { }
            if (req == null)
            {
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }

            var id = GetString(req, "id");
            if (string.IsNullOrEmpty(id) || !IsSafeRequestId(id))
            {
                AddDiagnostic("backlog-unsafe-id");
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }
            if (GetString(req, "instanceId") != _instanceId
                || GetString(req, "bootId") != _bootId
                || GetString(req, "nonce") != _nonce)
            {
                // 不是本实例会话的请求：回写响应会污染别人（或可被伪造），只归档。
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }

            // 已经处理过的 id 绝不覆盖：outbox/done 里可能是一条真实结果。
            if (File.Exists(Path.Combine(_outboxDir, id + ".json")) || File.Exists(Path.Combine(_doneDir, id + ".json")))
            {
                AddChannelDiagnosticSafe("backlog-duplicate-dropped:" + id);
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }

            try
            {
                if (File.Exists(progressPath)) File.Delete(progressPath);
                File.Move(path, progressPath);
            }
            catch { return HandleOutcome.Absent; }

            AddChannelDiagnosticSafe("backlog-rejected:" + id);
            return RespondError(
                id,
                CreateResponseSkeleton(id, rawBytes),
                "instance_busy",
                "目标编辑器是单槽串行执行器，inbox 已积压超过 " + MaxInboxBacklog + " 个待处理请求，"
                    + "本请求未被取回执行（未产生任何副作用）。请退避后重试：不要并发堆请求，"
                    + "必要时把批量操作拆成串行调用。",
                progressPath,
                donePath);
        }

        /// <summary>
        /// 回收上一次执行遗留的 in-progress 请求：这些请求在 Execute 期间被域重载或进程退出打断，
        /// 调用方超时后无从判断「到底执行了没有」。这里补写一条 executionState="unknown" 的响应，
        /// 让「不确定」变成一个**可机器读取**的结论，而不是靠人读日志。
        ///
        /// 实现范围（与实现保持一致，AUD-CODE-001 P2）：**只处理当前 bootId 的 in-progress/**。
        /// 域重载时 pid/startTicks 不变 → bootId 复用，因此「域重载打断」这一主场景能被正确覆盖；
        /// 编辑器进程重启会换新 bootId，旧通道目录不再补写 unknown（调用方对旧实例已不可达），
        /// 由 SweepStaleBootDirs 按年龄回收。
        /// </summary>
        static void RecoverInterruptedRequests()
        {
            try
            {
                if (string.IsNullOrEmpty(_progressDir) || !Directory.Exists(_progressDir)) return;
                foreach (var file in Directory.GetFiles(_progressDir, "*.json"))
                {
                    var id = Path.GetFileNameWithoutExtension(file);
                    if (string.IsNullOrEmpty(id)) continue;

                    // P2：与 inbox 请求同样先限大小再读。in-progress 里的文件来自上一轮 inbox，
                    // 可能是被中途替换/追加的超大文件，不能无条件整文件读入。
                    string text = null;
                    try
                    {
                        if (new FileInfo(file).Length <= MaxRequestBytes) text = File.ReadAllText(file, Encoding.UTF8);
                    }
                    catch (Exception) { }
                    Dictionary<string, object> req = null;
                    try { req = text == null ? null : MiniJson.Parse(text) as Dictionary<string, object>; }
                    catch { }

                    if (req != null)
                    {
                        var resp = new Dictionary<string, object>();
                        resp["v"] = 1L;
                        resp["id"] = id;
                        resp["instanceId"] = _instanceId;
                        resp["bootId"] = _bootId;
                        // 用请求自带的 nonce：调用方按四元组配对，写错就取不到这条响应。
                        resp["nonce"] = GetString(req, "nonce") ?? _nonce;
                        resp["probeVersion"] = ProbeVersion;
                        resp["ok"] = false;
                        resp["executionState"] = "unknown";
                        resp["error"] = Error(
                            "interrupted",
                            "上一次执行被域重载或进程退出打断，无法确定是否已产生副作用；请先确认目标状态再决定是否重试",
                            null);
                        // 不能覆盖已有的真实响应：若上次 WriteAtomic 成功而归档失败，
                        // in-progress 会残留，此时补写 unknown 会抹掉已经拿到的结果。
                        var existingOutbox = Path.Combine(_outboxDir, id + ".json");
                        if (!File.Exists(existingOutbox))
                        {
                            // P2-30：补写 unknown 失败时**绝不能归档 in-progress**。
                            // 归档会让调用方的 isInProgress=false 且 outbox 里没有任何结论，
                            // 「可能已执行」的唯一证据被抹掉，调用方会按「未执行」安全重试，
                            // 破坏性操作（asset.delete / menu.execute / code.execute）就会重复执行。
                            // 保留 in-progress 文件，让本次和下次回收（以及 DSH 的 in_flight 判定）
                            // 仍然能看到它，并留下通道诊断供排障。
                            var published = false;
                            try
                            {
                                WriteAtomic(existingOutbox, MiniJson.Serialize(resp));
                                published = true;
                            }
                            catch { }
                            if (!published)
                            {
                                AddChannelDiagnosticSafe("recover-publish-failed:" + id);
                                continue;
                            }
                        }
                    }
                    Finish(file, Path.Combine(_doneDir, Path.GetFileName(file)));
                }
            }
            catch { }
        }

        /// <summary>
        /// 请求生命周期（AA-OPT-004）：inbox → in-progress → done。
        /// 原始请求在执行期间保留在 in-progress/，因此「执行中已超时」可被 DSH 观测到（in_flight），
        /// 而不是被误判成「什么都没发生」。
        ///
        /// 响应里的 executionState 让调用方机器判断「能不能安全重试」：
        ///   not-started = 校验/授权/过期等失败，未进入执行，可安全重试
        ///   executed    = 已进入 Execute() 并返回（无论成功失败），副作用可能已发生
        ///   unknown     = 执行中被域重载/进程退出打断（由下次启动的孤儿回收补写）
        /// </summary>
        /// <summary>
        /// 请求 id 会参与 outbox 文件名拼接（`Path.Combine(_outboxDir, id + ".json")`），
        /// 因此必须是单段安全文件名。否则 `id = "../instance"` 这类请求可以覆盖
        /// `Library/DSHBridge/instance.json` 等任意位置的文件（WriteAtomic 还会创建父目录）。
        /// </summary>
        static bool IsSafeRequestId(string id)
        {
            if (string.IsNullOrEmpty(id) || id.Length > 128) return false;
            for (var i = 0; i < id.Length; i++)
            {
                var ch = id[i];
                var allowed = (ch >= 'a' && ch <= 'z')
                    || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9')
                    || ch == '-' || ch == '_' || ch == '.';
                if (!allowed) return false;
            }
            // 禁止 ".."：单点（如 "v1.0"）合法，双点是路径穿越。
            return id.IndexOf("..", StringComparison.Ordinal) < 0;
        }

        static HandleOutcome HandleFile(string path)
        {
            var fileName = Path.GetFileName(path);
            if (string.IsNullOrEmpty(fileName)) return HandleOutcome.Absent;
            var progressPath = Path.Combine(_progressDir, fileName);
            var donePath = Path.Combine(_doneDir, fileName);

            // P2：先看大小再读文件。请求是外部写进来的，不设上限就等于把「读多少字节」
            // 交给对方决定；超限按无效请求归档（Discarded）+ 通道诊断，绝不整文件读入。
            try
            {
                var info = new FileInfo(path);
                if (info.Exists && info.Length > MaxRequestBytes)
                {
                    AddChannelDiagnosticSafe("oversized-request:" + info.Length.ToString(CultureInfo.InvariantCulture));
                    Finish(path, donePath);
                    return HandleOutcome.Discarded;
                }
            }
            catch { return HandleOutcome.Absent; }

            string text;
            byte[] rawBytes;
            try
            {
                // 保留原始字节：requestHash 声明的是「请求文件原始字节」的摘要。
                // 若用 ReadAllText 再重新编码，带 BOM 的文件会算出不同的值。
                rawBytes = File.ReadAllBytes(path);
                text = new UTF8Encoding(false).GetString(rawBytes);
                if (text.Length > 0 && text[0] == '\uFEFF') text = text.Substring(1);
            }
            catch { return HandleOutcome.Absent; }

            // TOCTOU 兜底：上面的 Length 检查和这里的读取之间文件可能被替换/追加，
            // 读到的字节仍要再过一次上限，超限同样只归档不解析。
            if (rawBytes.Length > MaxRequestBytes)
            {
                AddChannelDiagnosticSafe("oversized-request-race:" + rawBytes.Length.ToString(CultureInfo.InvariantCulture));
                Finish(path, donePath);
                return HandleOutcome.Discarded;
            }

            try
            {
                if (File.Exists(progressPath)) File.Delete(progressPath);
                File.Move(path, progressPath);
            }
            catch { return HandleOutcome.Absent; }

            Dictionary<string, object> req = null;
            try { req = MiniJson.Parse(text) as Dictionary<string, object>; }
            catch { }
            if (req == null)
            {
                // 半写/损坏的 JSON：直接归档，让队列继续推进。
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }

            var id = GetString(req, "id");
            if (string.IsNullOrEmpty(id))
            {
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }
            if (!IsSafeRequestId(id))
            {
                // 不能进 outbox：id 不可信意味着响应文件名也不可信。
                // 只归档（用真实文件名，安全）并留诊断，让调用方超时而不是接受一个越界写入。
                AddDiagnostic("unsafe-request-id");
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }

            // 四元组校验：拒绝不属于本实例会话的请求。
            var resp = CreateResponseSkeleton(id, rawBytes);

            var incomingInstance = GetString(req, "instanceId");
            var incomingBoot = GetString(req, "bootId");
            var incomingNonce = GetString(req, "nonce");
            if (incomingInstance != _instanceId || incomingBoot != _bootId || incomingNonce != _nonce)
            {
                return RespondError(id, resp, "pairing_mismatch", "请求不属于本实例会话", progressPath, donePath);
            }

            // 过期校验：DSH 已放弃的请求绝不能产生副作用（例如延迟切进 Play Mode）。
            var issuedAt = ToLong(req, "issuedAt");
            var deadlineMs = ToLong(req, "deadlineMs", 30000);
            var nowMs = NowMs();
            if (issuedAt > 0 && deadlineMs > 0 && nowMs > issuedAt + deadlineMs)
            {
                return RespondError(id, resp, "expired", "请求已超过 deadline，出于安全未执行", progressPath, donePath);
            }

            // 重复 id：同一 id 再次投递时不能静默覆盖已有响应/归档，也不能让人误以为执行了两次。
            var outboxPath = Path.Combine(_outboxDir, id + ".json");
            var archivedPath = Path.Combine(_doneDir, id + ".json");
            if (File.Exists(outboxPath) || File.Exists(archivedPath))
            {
                return RespondError(id, resp, "duplicate_id", "请求 id 已处理过；请为每次调用使用新的 id", progressPath, donePath);
            }

            var cap = GetString(req, "cap");
            // P2：args 必须是 JSON object。数组/字符串/数字直接以 invalid_argument 拒绝，
            // 不能静默降级成空字典——那会让「参数写错的请求」以默认参数执行（破坏性默认值
            // 例如 playmode.set 缺 playing、setActive 缺 active），语义完全不可预期。
            // JSON null 与缺省同义，按空对象处理。
            if (req.ContainsKey("args") && req["args"] != null && !(req["args"] is Dictionary<string, object>))
            {
                return RespondError(id, resp, "invalid_argument", "args 必须是 JSON object", progressPath, donePath);
            }
            var args = req.ContainsKey("args") ? req["args"] as Dictionary<string, object> : null;
            if (args == null) args = new Dictionary<string, object>();

            var sw = Stopwatch.StartNew();
            try
            {
                // 安全闸门（AA-OPT-001）：危险执行面只在 DSH 侧显式授权（且源码已注入快照）时放行。
                // 闸门在 Execute 之前：被拒绝的请求尚未进入执行，调用方可安全重试。
                EnsureCapabilityAllowed(cap);
                // 走到这里说明即将执行：从此点起副作用「可能已发生」，即使 Execute 抛异常也不再是 not-started。
                resp["executionState"] = "executed";
                resp["ok"] = true;
                resp["data"] = Execute(cap, args);
            }
            catch (Exception e)
            {
                resp["ok"] = false;
                resp["error"] = Error(CodeOf(e), e.Message, DetailOf(e));
                RecordRejection(id, cap, CodeOf(e), e.Message);
            }
            sw.Stop();
            resp["elapsedMs"] = sw.ElapsedMilliseconds;

            PublishResponse(id, resp, progressPath, donePath);
            return HandleOutcome.Consumed;
        }

        /// <summary>
        /// 响应骨架（P2-47 收口）：HandleFile 与积压拒绝共用，避免两条路径的字段漂移。
        ///
        /// 字段必须与 DSH 侧 takeResponse 的解析一致：`v` 参与协议版本校验（P3-78/P3-92），
        /// `id`/`instanceId`/`bootId`/`nonce` 参与四元组配对，`requestHash` 是归属证据。
        /// `executionState` 预填 "not-started"：此刻尚未进入执行，调用方可安全重试。
        /// </summary>
        static Dictionary<string, object> CreateResponseSkeleton(string id, byte[] rawBytes)
        {
            var resp = new Dictionary<string, object>();
            resp["v"] = 1L;
            resp["id"] = id;
            resp["instanceId"] = _instanceId;
            resp["bootId"] = _bootId;
            resp["nonce"] = _nonce;
            resp["probeVersion"] = ProbeVersion;
            resp["executionState"] = "not-started";
            // 归属证据：摘要基于**调用方写入的原始字节**，双方算的是同一串，不需要 JSON 规范化。
            resp["requestHash"] = RequestHashOfBytes(rawBytes);
            return resp;
        }

        /// <summary>
        /// 拒绝响应模板（P3-89）：把「填 error + 归档 + 消费」收敛成一次调用。
        ///
        /// HandleFile 里原先逐字复制了 4 份拒绝路径（pairing_mismatch / expired /
        /// duplicate_id / invalid_argument），任何一处漏改都会让拒绝响应的结构不一致，
        /// 而 DSH 侧 takeResponse 是按同一结构解析 error/elapsedMs 的。
        /// executionState 已由调用方预填为 "not-started"（未进入执行，可安全重试），
        /// 这里只补齐 ok / error / elapsedMs。
        /// 积压快速失败（P2-47）复用同一出口：instance_busy 也必须归档 + 消费，
        /// 否则请求会留在 inbox 里被反复处理。
        /// </summary>
        static HandleOutcome RespondError(
            string id, Dictionary<string, object> resp, string code, string message,
            string progressPath, string donePath)
        {
            resp["ok"] = false;
            resp["error"] = Error(code, message, null);
            resp["elapsedMs"] = 0L;
            PublishResponse(id, resp, progressPath, donePath);
            return HandleOutcome.Consumed;
        }

        static void PublishResponse(string id, Dictionary<string, object> resp, string progressPath, string donePath)
        {
            try
            {
                WriteAtomic(Path.Combine(_outboxDir, id + ".json"), MiniJson.Serialize(resp));
            }
            catch (Exception e)
            {
                // P1-6：写响应失败时**绝不能归档 progress**。归档会让调用方的 isInProgress=false，
                // 但它从未收到结论 → 可能按「未执行」安全重试，破坏性操作就会重复执行。
                // 保留 in-progress 语义：调用方看到 in_flight，超时后按 unknown 处理；
                // 下一次域重载/启动的 RecoverInterruptedRequests 会补写 executionState="unknown" 的响应。
                AddChannelDiagnosticSafe("publish-failed:" + id + ": " + e.GetType().Name + ": " + (e.Message ?? ""));
                return;
            }
            Finish(progressPath, donePath);
        }

        /// <summary>
        /// 归档已完成请求。目标已存在时改用 `.dupN` 后缀，**绝不删除历史归档**
        /// （旧实现会先删同名 done 文件，重复 id 时会抹掉上一次的痕迹）。
        /// </summary>
        static void Finish(string progressPath, string donePath)
        {
            try
            {
                if (!File.Exists(progressPath)) return;
                File.Move(progressPath, UniqueArchivePath(donePath));
            }
            catch { }
        }

        static string UniqueArchivePath(string donePath)
        {
            if (!File.Exists(donePath)) return donePath;
            var directory = Path.GetDirectoryName(donePath);
            var stem = Path.GetFileNameWithoutExtension(donePath);
            for (var i = 2; i <= 9999; i++)
            {
                var candidate = Path.Combine(
                    directory,
                    stem + ".dup" + i.ToString(CultureInfo.InvariantCulture) + ".json");
                if (!File.Exists(candidate)) return candidate;
            }
            return donePath;
        }

        /// <summary>
        /// 按能力判定授权：argv 整机旁路，或安装时注入的源码快照。
        /// 授权闸门本体（EnsureCapabilityAllowed / Granted / DangerousCapabilitiesForTest）
        /// 与路径边界一起放在 DSHBridgeProbe.Security.cs.tpl，按域拆分只影响可读性，partial 内互相可见。
        /// </summary>
        static bool ReflectAuthorized()
        {
            return _reflectEnabled.HasValue ? _reflectEnabled.Value : AuthorizedByArgv();
        }

        /// <summary>
        /// 不值得作为事件上报的「调用方错误」：请求本身不可用/已放弃，与安全边界和内部故障无关。
        /// 其余错误码（含 probe_error / io_error 这类内部失败）一律留事件——
        /// 旧实现只记录 8 个越权类错误码，导致探针内部失败在事件流里完全不可见（P3-101）。
        /// </summary>
        static readonly HashSet<string> _rejectionNoiseCodes = new HashSet<string>(StringComparer.Ordinal) {
            "expired", "duplicate_id", "invalid_argument", "pairing_mismatch"
        };

        /// <summary>越权尝试要留下事件，否则注入攻击在事件流里完全不可见（AA-OBS-001）。</summary>
        static void RecordRejection(string id, string cap, string code, string message)
        {
            if (!string.IsNullOrEmpty(code) && _rejectionNoiseCodes.Contains(code)) return;
            var payload = new Dictionary<string, object>
            {
                { "requestId", id ?? "" },
                { "capability", cap ?? "" },
                { "code", code },
                { "message", message != null && message.Length > 300 ? message.Substring(0, 300) : (message ?? "") },
            };
            PushEvent("request_rejected", payload);
            // 同时投递到 outbox，让 DSH 侧能在调用返回时就看到拒绝原因（AA-OBS-001）。
            try
            {
                var notice = new Dictionary<string, object>();
                notice["v"] = 1L;
                notice["id"] = (id ?? "") + ".rejected";
                notice["instanceId"] = _instanceId;
                notice["bootId"] = _bootId;
                notice["nonce"] = _nonce;
                notice["probeVersion"] = ProbeVersion;
                notice["ok"] = false;
                notice["rejected"] = payload;
                WriteAtomic(Path.Combine(_outboxDir, (id ?? "unknown") + ".rejected.json"), MiniJson.Serialize(notice));
            }
            catch { }
        }

        static Dictionary<string, object> Error(string code, string message, string detail)
        {
            var e = new Dictionary<string, object>();
            e["code"] = code;
            e["message"] = message ?? "";
            // 部分错误码需要携带机器可读细节（例如编译错误的逐条诊断、近似成员名），
            // 这些内容既不适合塞进 message，也不应丢弃。
            e["detail"] = detail ?? "";
            return e;
        }

        static string CodeOf(Exception e)
        {
            var known = e as KnownError;
            if (known != null) return known.Code;
            if (e is TargetInvocationException && e.InnerException != null) return CodeOf(e.InnerException);
            if (e is FileNotFoundException) return "not_found";
            if (e is ArgumentException) return "invalid_argument";
            // 跨文件契约：CodeOfExtended 定义在 MonoCompiler.cs.tpl，负责把
            // IOException/UnauthorizedAccess、Format/InvalidCast/Overflow、UnityException
            // 等「更像环境/输入问题而非探针 bug」的异常映射成稳定错误码，未识别返回 null。
            var extended = CodeOfExtended(e);
            if (extended != null) return extended;
            return "probe_error";
        }

        /// <summary>错误细节：KnownError 可携带结构化细节，其它异常退回异常类型名。</summary>
        static string DetailOf(Exception e)
        {
            var known = e as KnownError;
            if (known != null) return string.IsNullOrEmpty(known.Detail) ? e.GetType().Name : known.Detail;
            if (e is TargetInvocationException && e.InnerException != null) return DetailOf(e.InnerException);
            return e.GetType().Name;
        }

        class KnownError : Exception
        {
            public readonly string Code;
            public readonly string Detail;
            public KnownError(string code, string message) : base(message) { Code = code; Detail = null; }
            public KnownError(string code, string message, string detail) : base(message) { Code = code; Detail = detail; }
        }

        /// <summary>argv 里出现 -dshBridgeAuthorize 时，危险能力执行面（13 项）才解锁（对应插件配置 allowDangerous）。</summary>
        static bool AuthorizedByArgv()
        {
            try
            {
                var args = Environment.GetCommandLineArgs();
                for (var i = 0; i < args.Length; i++)
                {
                    if (args[i] == AuthorizeArg) return true;
                }
            }
            catch { }
            return false;
        }
    }
}
#endif
