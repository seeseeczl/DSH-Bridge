        }

        static Dictionary<string, object> PlaymodeSet(Dictionary<string, object> args)
        {
            var before = EditorApplication.isPlaying;
            var target = ToBool(args, "playing");
            if (target != before) EditorApplication.isPlaying = target;
            var d = new Dictionary<string, object>();
            d["before"] = before;
            d["requested"] = target;
            d["after"] = EditorApplication.isPlaying;
            // Play Mode 是异步切换：这里只报告「是否仍在切换中」，由调用方决定等待。
            d["pending"] = EditorApplication.isPlaying != target;
            return d;
        }

        static Dictionary<string, object> AssetRefresh(Dictionary<string, object> args)
        {
            var sw = Stopwatch.StartNew();
            var force = ToBool(args, "force");
            if (force) AssetDatabase.Refresh(ImportAssetOptions.ForceUpdate);
            else AssetDatabase.Refresh();
            sw.Stop();
            var d = new Dictionary<string, object>();
            d["refreshed"] = true;
            d["elapsedMs"] = sw.ElapsedMilliseconds;
            return d;
        }

        static Dictionary<string, object> ReflectInvoke(Dictionary<string, object> args)
        {
            var typeName = GetString(args, "type");
            var methodName = GetString(args, "method");
            if (string.IsNullOrEmpty(typeName) || string.IsNullOrEmpty(methodName))
                throw new KnownError("invalid_argument", "缺少 type 或 method");

            var type = FindType(typeName);
            if (type == null) throw new KnownError("type_not_found", "找不到类型: " + typeName);

            var rawArgs = args.ContainsKey("args") ? args["args"] as List<object> : new List<object>();
            if (rawArgs == null) rawArgs = new List<object>();

            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.FlattenHierarchy;
            var method = type.GetMethods(flags).FirstOrDefault(m => m.Name == methodName && m.GetParameters().Length == rawArgs.Count)
                         ?? type.GetMethods(flags).FirstOrDefault(m => m.Name == methodName);
            if (method == null) throw new KnownError("method_not_found", "找不到方法: " + typeName + "." + methodName);

            var parameters = method.GetParameters();
            var converted = new object[parameters.Length];
            for (var i = 0; i < parameters.Length; i++)
                converted[i] = i < rawArgs.Count ? Coerce(rawArgs[i], parameters[i].ParameterType) : DefaultOf(parameters[i].ParameterType);

            var result = method.Invoke(null, converted);
            var d = new Dictionary<string, object>();
            d["type"] = typeName;
            d["method"] = methodName;
            d["returnType"] = method.ReturnType.Name;
            d["result"] = Describe(result);
            return d;
        }

        static object DefaultOf(Type t) { return t.IsValueType ? Activator.CreateInstance(t) : null; }

        static object Coerce(object value, Type target)
        {
            if (value == null) return DefaultOf(target);
            if (target.IsInstanceOfType(value)) return value;
            if (target == typeof(string)) return Convert.ToString(value, CultureInfo.InvariantCulture);
            if (target == typeof(int)) return System.Convert.ToInt32(value, CultureInfo.InvariantCulture);
            if (target == typeof(long)) return System.Convert.ToInt64(value, CultureInfo.InvariantCulture);
            if (target == typeof(float)) return (float)System.Convert.ToDouble(value, CultureInfo.InvariantCulture);
            if (target == typeof(double)) return System.Convert.ToDouble(value, CultureInfo.InvariantCulture);
            if (target == typeof(bool)) return System.Convert.ToBoolean(value, CultureInfo.InvariantCulture);
            if (target.IsEnum) return Enum.Parse(target, System.Convert.ToString(value, CultureInfo.InvariantCulture), true);
            return value;
        }

        static object Describe(object value)
        {
            if (value == null) return null;
            var s = value as string;
            if (s != null) return s;
            if (value is bool || value is int || value is long || value is float || value is double || value is decimal) return value;
            var uo = value as UnityEngine.Object;
            if (uo != null)
            {
                var d = new Dictionary<string, object>();
                d["name"] = uo.name;
                d["type"] = uo.GetType().Name;
                d["path"] = AssetDatabase.GetAssetPath(uo);
                return d;
            }
            return value.ToString();
        }

        static readonly Dictionary<string, Type> _typeCache = new Dictionary<string, Type>();

        static Type FindType(string name)
        {
            if (string.IsNullOrEmpty(name)) return null;
            Type cached;
            if (_typeCache.TryGetValue(name, out cached)) return cached;

            var t = Type.GetType(name);
            var assemblies = AppDomain.CurrentDomain.GetAssemblies();
            if (t == null)
            {
                foreach (var asm in assemblies)
                {
                    try { t = asm.GetType(name); if (t != null) break; }
                    catch { }
                }
            }
            // 短名支持：先按常见命名空间补全，再退回全量类型名匹配（结果缓存）。
            if (t == null && name.IndexOf('.') < 0)
            {
                foreach (var asm in assemblies)
                {
                    Type[] types;
                    try { types = asm.GetTypes(); }
                    catch { continue; }
                    foreach (var candidate in types)
                    {
                        if (candidate.Name != name) continue;
                        t = candidate;
                        break;
                    }
                    if (t != null) break;
                }
            }
            _typeCache[name] = t;
            return t;
        }

        static void OnLog(string condition, string stackTrace, LogType type)
        {
            Dictionary<string, object> entry;
            lock (_log)
            {
                entry = new Dictionary<string, object>();
                entry["seq"] = (long)_log.Count;
                entry["level"] = LevelOf(type);
                entry["message"] = condition != null && condition.Length > 2000 ? condition.Substring(0, 2000) : condition;
                entry["time"] = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture);
                _log.Add(entry);
                if (_log.Count > LogCapacity) _log.RemoveAt(0);
            }
            if ((type == LogType.Error || type == LogType.Exception || type == LogType.Assert) && _eventsDir != null)
                PushEvent("log_error", new Dictionary<string, object> { { "level", LevelOf(type) }, { "message", entry["message"] } });
        }

        static string LevelOf(LogType type)
        {
            if (type == LogType.Error || type == LogType.Assert) return "error";
            if (type == LogType.Exception) return "exception";
            if (type == LogType.Warning) return "warning";
            return "info";
        }

        static void OnCompilationFinished(object result)
        {
            // 反射取 EditorUtility.scriptCompilationFailed，兼容老版本编译器；
            // 取不到时保持 ok=true，但把 known 标记为 false 让调用方知道状态未确认。
            var known = false;
            var failed = false;
            try
            {
                var prop = typeof(EditorUtility).GetProperty(
                    "scriptCompilationFailed", BindingFlags.Public | BindingFlags.Static);
                if (prop != null && prop.PropertyType == typeof(bool))
                {
                    failed = (bool)(prop.GetValue(null) ?? false);
                    known = true;
                }
            }
            catch { }
            PushEvent("compilation_finished", new Dictionary<string, object>
            {
                { "ok", !failed },
                { "failed", failed },
                { "stateKnown", known },
            });
        }

        static long NowMs()
        {
            return (long)(DateTime.UtcNow - new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds;
        }

        static void OnPlayModeChanged(PlayModeStateChange change)
        {
            PushEvent("playmode_changed",
                new Dictionary<string, object> { { "change", change.ToString() }, { "isPlaying", EditorApplication.isPlaying } });
        }

        static void PushEvent(string kind, Dictionary<string, object> data)
        {
            try
            {
                if (_eventsDir == null) return;
                _eventSeq += 1;
                var evt = new Dictionary<string, object>();
                evt["seq"] = _eventSeq;
                evt["kind"] = kind;
                evt["at"] = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture);
                evt["data"] = data ?? new Dictionary<string, object>();
                evt["probeVersion"] = ProbeVersion;
                var file = Path.Combine(_eventsDir, "evt_" + _eventSeq.ToString("D10") + ".json");
                WriteAtomic(file, MiniJson.Serialize(evt));
            }
            catch { }
        }

        static void WriteHeartbeat()
        {
            try
            {
                var info = new Dictionary<string, object>();
                info["v"] = 1L;
                info["instanceId"] = _instanceId;
                info["bootId"] = _bootId;
                info["nonce"] = _nonce;
                info["pid"] = _pid;
                info["startTicks"] = _startTicks;
                info["projectPath"] = _projectRoot;
                info["unityVersion"] = Application.unityVersion;
                info["engine"] = "unity";
                info["probeVersion"] = ProbeVersion;
                info["startedAt"] = _startedAt;
                info["lastSeenAt"] = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture);
                info["scene"] = SceneManager.GetActiveScene().name;
                info["isPlaying"] = EditorApplication.isPlaying;
                info["eventSeq"] = _eventSeq;
                info["capabilities"] = _capabilities.Cast<object>().ToList();
                Directory.CreateDirectory(_rootDir);
                WriteAtomic(Path.Combine(_rootDir, "instance.json"), MiniJson.Serialize(info));
            }
            catch (Exception e) { UnityEngine.Debug.LogWarning("[DSHBridge] heartbeat: " + e.Message); }
        }

        static void WriteAtomic(string path, string content)
        {
            var dir = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
            var tmp = path + "." + Guid.NewGuid().ToString("N").Substring(0, 8) + ".tmp";
            File.WriteAllText(tmp, content, new UTF8Encoding(false));
            if (File.Exists(path)) File.Delete(path);
            File.Move(tmp, path);
        }

        static string Sha1Short(string value)
        {
            using (var sha = System.Security.Cryptography.SHA1.Create())
            {
                var bytes = sha.ComputeHash(Encoding.UTF8.GetBytes(value));
                var sb = new StringBuilder();
                for (var i = 0; i < 6; i++) sb.Append(bytes[i].ToString("x2"));
                return sb.ToString();
            }
        }

        static string GetString(Dictionary<string, object> d, string key)
        {
            object value;
            if (d == null || !d.TryGetValue(key, out value) || value == null) return null;
            return value as string ?? System.Convert.ToString(value, CultureInfo.InvariantCulture);
        }

        static List<string> GetStringList(Dictionary<string, object> d, string key)
        {
            var outList = new List<string>();
            object value;
            if (d == null || !d.TryGetValue(key, out value)) return outList;
            var list = value as List<object>;
            if (list == null) return outList;
            foreach (var item in list)
            {
                var s = item as string;
                if (s != null) outList.Add(s);
            }
            return outList;
        }

        static long ToLong(Dictionary<string, object> d, string key, long fallback = 0)
        {
            object value;
            if (d == null || !d.TryGetValue(key, out value) || value == null) return fallback;
            try { return System.Convert.ToInt64(value, CultureInfo.InvariantCulture); }
            catch { return fallback; }
        }

        static bool ToBool(Dictionary<string, object> d, string key)
        {
            object value;
            if (d == null || !d.TryGetValue(key, out value) || value == null) return false;
            if (value is bool) return (bool)value;
            var s = value as string;
            if (s != null) return string.Equals(s, "true", StringComparison.OrdinalIgnoreCase) || s == "1";
            try { return System.Convert.ToBoolean(value, CultureInfo.InvariantCulture); }
            catch { return false; }
        }
    }

    // 极简 JSON：只覆盖本探针需要的对象/数组/标量，避免任何外部依赖。
    public static class MiniJson
    {
        public static object Parse(string json)
        {
            var index = 0;
            var value = ParseValue(json, ref index);
            SkipWhitespace(json, ref index);
            return value;
        }

        static void SkipWhitespace(string s, ref int i)
        {
            while (i < s.Length && char.IsWhiteSpace(s[i])) i++;
        }

        static object ParseValue(string s, ref int i)
        {
            SkipWhitespace(s, ref i);
            if (i >= s.Length) return null;
            var c = s[i];
            if (c == '{') return ParseObject(s, ref i);
            if (c == '[') return ParseArray(s, ref i);
            if (c == '"') return ParseString(s, ref i);
            if (c == 't') { Expect(s, ref i, "true"); return true; }
            if (c == 'f') { Expect(s, ref i, "false"); return false; }
            if (c == 'n') { Expect(s, ref i, "null"); return null; }
            return ParseNumber(s, ref i);
        }

        static void Expect(string s, ref int i, string token)
        {
            if (string.CompareOrdinal(s, i, token, 0, token.Length) != 0) throw new FormatException("bad token at " + i);
            i += token.Length;
        }

        static Dictionary<string, object> ParseObject(string s, ref int i)
        {
            var d = new Dictionary<string, object>();
            i++;
            SkipWhitespace(s, ref i);
            if (i < s.Length && s[i] == '}') { i++; return d; }
            while (i < s.Length)
            {
                SkipWhitespace(s, ref i);
                if (s[i] != '"') throw new FormatException("expected key at " + i);
                var key = ParseString(s, ref i);
                SkipWhitespace(s, ref i);
                if (s[i] != ':') throw new FormatException("expected ':' at " + i);
                i++;
                d[key] = ParseValue(s, ref i);
                SkipWhitespace(s, ref i);
                if (i < s.Length && s[i] == ',') { i++; continue; }
                if (i < s.Length && s[i] == '}') { i++; return d; }
                throw new FormatException("expected ',' or '}' at " + i);
            }
            return d;
        }

        static List<object> ParseArray(string s, ref int i)
        {
            var list = new List<object>();
            i++;
            SkipWhitespace(s, ref i);
            if (i < s.Length && s[i] == ']') { i++; return list; }
            while (i < s.Length)
            {
                list.Add(ParseValue(s, ref i));
                SkipWhitespace(s, ref i);
                if (i < s.Length && s[i] == ',') { i++; continue; }
                if (i < s.Length && s[i] == ']') { i++; return list; }
                throw new FormatException("expected ',' or ']' at " + i);
            }
            return list;
        }

        static string ParseString(string s, ref int i)
        {
            i++;
            var sb = new StringBuilder();
            while (i < s.Length)
            {
                var c = s[i++];
                if (c == '"') return sb.ToString();
