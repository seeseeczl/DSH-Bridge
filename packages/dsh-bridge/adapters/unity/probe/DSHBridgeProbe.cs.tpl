        /// 让「不确定」变成一个**可机器读取**的结论，而不是靠人读日志。
        /// </summary>
        static void RecoverInterruptedRequests()
        {
            try
            {
                if (string.IsNullOrEmpty(_progressDir) || !Directory.Exists(_progressDir)) return;
                foreach (var file in Directory.GetFiles(_progressDir, "*.json"))
                {
                    var id = Path.GetFileNameWithoutExtension(file);
                    if (string.IsNullOrEmpty(id)) continue;

                    string text = null;
                    try { text = File.ReadAllText(file, Encoding.UTF8); } catch { }
                    Dictionary<string, object> req = null;
                    try { req = text == null ? null : MiniJson.Parse(text) as Dictionary<string, object>; }
                    catch { }

                    if (req != null)
                    {
                        var resp = new Dictionary<string, object>();
                        resp["v"] = 1L;
                        resp["id"] = id;
                        resp["instanceId"] = _instanceId;
                        resp["bootId"] = _bootId;
                        // 用请求自带的 nonce：调用方按四元组配对，写错就取不到这条响应。
                        resp["nonce"] = GetString(req, "nonce") ?? _nonce;
                        resp["probeVersion"] = ProbeVersion;
                        resp["ok"] = false;
                        resp["executionState"] = "unknown";
                        resp["error"] = Error(
                            "interrupted",
                            "上一次执行被域重载或进程退出打断，无法确定是否已产生副作用；请先确认目标状态再决定是否重试",
                            null);
                        // 不能覆盖已有的真实响应：若上次 WriteAtomic 成功而归档失败，
                        // in-progress 会残留，此时补写 unknown 会抹掉已经拿到的结果。
                        var existingOutbox = Path.Combine(_outboxDir, id + ".json");
                        if (!File.Exists(existingOutbox))
                        {
                            try { WriteAtomic(existingOutbox, MiniJson.Serialize(resp)); } catch { }
                        }
                    }
                    Finish(file, Path.Combine(_doneDir, Path.GetFileName(file)));
                }
            }
            catch { }
        }

        /// <summary>
        /// 请求生命周期（AA-OPT-004）：inbox → in-progress → done。
        /// 原始请求在执行期间保留在 in-progress/，因此「执行中已超时」可被 DSH 观测到（in_flight），
        /// 而不是被误判成「什么都没发生」。
        ///
        /// 响应里的 executionState 让调用方机器判断「能不能安全重试」：
        ///   not-started = 校验/授权/过期等失败，未进入执行，可安全重试
        ///   executed    = 已进入 Execute() 并返回（无论成功失败），副作用可能已发生
        ///   unknown     = 执行中被域重载/进程退出打断（由下次启动的孤儿回收补写）
        /// </summary>
        /// <summary>
        /// 请求 id 会参与 outbox 文件名拼接（`Path.Combine(_outboxDir, id + ".json")`），
        /// 因此必须是单段安全文件名。否则 `id = "../instance"` 这类请求可以覆盖
        /// `Library/DSHBridge/instance.json` 等任意位置的文件（WriteAtomic 还会创建父目录）。
        /// </summary>
        static bool IsSafeRequestId(string id)
        {
            if (string.IsNullOrEmpty(id) || id.Length > 128) return false;
            for (var i = 0; i < id.Length; i++)
            {
                var ch = id[i];
                var allowed = (ch >= 'a' && ch <= 'z')
                    || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9')
                    || ch == '-' || ch == '_' || ch == '.';
                if (!allowed) return false;
            }
            // 禁止 ".."：单点（如 "v1.0"）合法，双点是路径穿越。
            return id.IndexOf("..", StringComparison.Ordinal) < 0;
        }

        static HandleOutcome HandleFile(string path)
        {
            string text;
            byte[] rawBytes;
            try
            {
                // 保留原始字节：requestHash 声明的是「请求文件原始字节」的摘要。
                // 若用 ReadAllText 再重新编码，带 BOM 的文件会算出不同的值。
                rawBytes = File.ReadAllBytes(path);
                text = new UTF8Encoding(false).GetString(rawBytes);
                if (text.Length > 0 && text[0] == '\uFEFF') text = text.Substring(1);
            }
            catch { return HandleOutcome.Absent; }

            var fileName = Path.GetFileName(path);
            var progressPath = Path.Combine(_progressDir, fileName);
            var donePath = Path.Combine(_doneDir, fileName);
            try
            {
                if (File.Exists(progressPath)) File.Delete(progressPath);
                File.Move(path, progressPath);
            }
            catch { return HandleOutcome.Absent; }

            Dictionary<string, object> req = null;
            try { req = MiniJson.Parse(text) as Dictionary<string, object>; }
            catch { }
            if (req == null)
            {
                // 半写/损坏的 JSON：直接归档，让队列继续推进。
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }

            var id = GetString(req, "id");
            if (string.IsNullOrEmpty(id))
            {
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }
            if (!IsSafeRequestId(id))
            {
                // 不能进 outbox：id 不可信意味着响应文件名也不可信。
                // 只归档（用真实文件名，安全）并留诊断，让调用方超时而不是接受一个越界写入。
                AddDiagnostic("unsafe-request-id");
                Finish(progressPath, donePath);
                return HandleOutcome.Discarded;
            }

            // 四元组校验：拒绝不属于本实例会话的请求。
            var resp = new Dictionary<string, object>();
            resp["v"] = 1L;
            resp["id"] = id;
            resp["instanceId"] = _instanceId;
            resp["bootId"] = _bootId;
            resp["nonce"] = _nonce;
            resp["probeVersion"] = ProbeVersion;
            resp["executionState"] = "not-started";
            // 归属证据：摘要基于**调用方写入的原始字节**，双方算的是同一串，不需要 JSON 规范化。
            resp["requestHash"] = RequestHashOfBytes(rawBytes);

            var incomingInstance = GetString(req, "instanceId");
            var incomingBoot = GetString(req, "bootId");
            var incomingNonce = GetString(req, "nonce");
            if (incomingInstance != _instanceId || incomingBoot != _bootId || incomingNonce != _nonce)
            {
                resp["ok"] = false;
                resp["error"] = Error("pairing_mismatch", "请求不属于本实例会话", null);
                PublishResponse(id, resp, progressPath, donePath);
                return HandleOutcome.Consumed;
            }

            // 过期校验：DSH 已放弃的请求绝不能产生副作用（例如延迟切进 Play Mode）。
            var issuedAt = ToLong(req, "issuedAt");
            var deadlineMs = ToLong(req, "deadlineMs", 30000);
            var nowMs = NowMs();
            if (issuedAt > 0 && deadlineMs > 0 && nowMs > issuedAt + deadlineMs)
            {
                resp["ok"] = false;
                resp["error"] = Error("expired", "请求已超过 deadline，出于安全未执行", null);
                resp["elapsedMs"] = 0L;
                PublishResponse(id, resp, progressPath, donePath);
                return HandleOutcome.Consumed;
            }

            // 重复 id：同一 id 再次投递时不能静默覆盖已有响应/归档，也不能让人误以为执行了两次。
            var outboxPath = Path.Combine(_outboxDir, id + ".json");
            var archivedPath = Path.Combine(_doneDir, id + ".json");
            if (File.Exists(outboxPath) || File.Exists(archivedPath))
            {
                resp["ok"] = false;
                resp["error"] = Error("duplicate_id", "请求 id 已处理过；请为每次调用使用新的 id", null);
                resp["elapsedMs"] = 0L;
                PublishResponse(id, resp, progressPath, donePath);
                return HandleOutcome.Consumed;
            }

            var cap = GetString(req, "cap");
            var args = req.ContainsKey("args") ? req["args"] as Dictionary<string, object> : null;
            if (args == null) args = new Dictionary<string, object>();

            var sw = Stopwatch.StartNew();
            try
            {
                // 安全闸门（AA-OPT-001）：危险执行面只在 DSH 侧显式授权（且源码已注入快照）时放行。
                // 闸门在 Execute 之前：被拒绝的请求尚未进入执行，调用方可安全重试。
                EnsureCapabilityAllowed(cap);
                // 走到这里说明即将执行：从此点起副作用「可能已发生」，即使 Execute 抛异常也不再是 not-started。
                resp["executionState"] = "executed";
                resp["ok"] = true;
                resp["data"] = Execute(cap, args);
            }
            catch (Exception e)
            {
                resp["ok"] = false;
                resp["error"] = Error(CodeOf(e), e.Message, DetailOf(e));
                RecordRejection(id, cap, CodeOf(e), e.Message);
            }
            sw.Stop();
            resp["elapsedMs"] = sw.ElapsedMilliseconds;

            PublishResponse(id, resp, progressPath, donePath);
            return HandleOutcome.Consumed;
        }

        static void PublishResponse(string id, Dictionary<string, object> resp, string progressPath, string donePath)
        {
            try { WriteAtomic(Path.Combine(_outboxDir, id + ".json"), MiniJson.Serialize(resp)); }
            catch { }
            Finish(progressPath, donePath);
        }

        /// <summary>
        /// 归档已完成请求。目标已存在时改用 `.dupN` 后缀，**绝不删除历史归档**
        /// （旧实现会先删同名 done 文件，重复 id 时会抹掉上一次的痕迹）。
        /// </summary>
        static void Finish(string progressPath, string donePath)
        {
            try
            {
                if (!File.Exists(progressPath)) return;
                File.Move(progressPath, UniqueArchivePath(donePath));
            }
            catch { }
        }

        static string UniqueArchivePath(string donePath)
        {
            if (!File.Exists(donePath)) return donePath;
            var directory = Path.GetDirectoryName(donePath);
            var stem = Path.GetFileNameWithoutExtension(donePath);
            for (var i = 2; i <= 9999; i++)
            {
                var candidate = Path.Combine(
                    directory,
                    stem + ".dup" + i.ToString(CultureInfo.InvariantCulture) + ".json");
                if (!File.Exists(candidate)) return candidate;
            }
            return donePath;
        }

        /// <summary>危险能力在探针侧默认关闭；只有授权快照或 argv 授权出现时才放行。</summary>
        static void EnsureCapabilityAllowed(string cap)
        {
            if (string.IsNullOrEmpty(cap)) throw new KnownError("invalid_argument", "缺少 cap");
            for (var i = 0; i < _deniedCapabilities.Length; i++)
            {
                if (_deniedCapabilities[i] != cap) continue;
                throw new KnownError("capability_denied", "能力 " + cap + " 被插件配置显式禁止（bridge.denied），任何授权都无法开启");
            }
            for (var i = 0; i < _blockedCapabilities.Length; i++)
            {
                if (_blockedCapabilities[i] != cap) continue;
                throw new KnownError("capability_denied", "能力 " + cap + " 在探针侧永久关闭（菜单执行等同任意编辑器操作）");
            }
            for (var i = 0; i < _reflectCapabilities.Length; i++)
            {
                if (_reflectCapabilities[i] != cap) continue;
                if (Granted(cap)) return;
                throw new KnownError(
                    "capability_denied",
                    "能力 " + cap + " 未授权；请在插件配置 bridge.allowDangerous 中加入该能力并重装探针（源码快照随之更新）");
            }
        }

        /// <summary>按能力判定授权：argv 整机旁路，或安装时注入的源码快照。</summary>
        static bool Granted(string cap)
        {
            if (ReflectAuthorized()) return true;
            for (var i = 0; i < _grantedCapabilities.Length; i++)
            {
                if (_grantedCapabilities[i] == cap) return true;
            }
            return false;
        }

        static bool ReflectAuthorized()
        {
            return _reflectEnabled.HasValue ? _reflectEnabled.Value : AuthorizedByArgv();
        }

        /// <summary>诊断用：本次安装在源码快照里实际授予了哪些能力。</summary>
        public static string[] GrantedCapabilitiesForTest()
        {
            return (string[])_grantedCapabilities.Clone();
        }

        /// <summary>越权尝试要留下事件，否则注入攻击在事件流里完全不可见（AA-OBS-001）。</summary>
        static void RecordRejection(string id, string cap, string code, string message)
        {
            if (code != "capability_denied" && code != "path_escape" && code != "member_not_public"
                && code != "member_denied" && code != "type_denied" && code != "editor_busy") return;
            var payload = new Dictionary<string, object>
            {
                { "requestId", id ?? "" },
                { "capability", cap ?? "" },
                { "code", code },
                { "message", message != null && message.Length > 300 ? message.Substring(0, 300) : (message ?? "") },
            };
            PushEvent("request_rejected", payload);
            // 同时投递到 outbox，让 DSH 侧能在调用返回时就看到拒绝原因（AA-OBS-001）。
            try
            {
                var notice = new Dictionary<string, object>();
                notice["v"] = 1L;
                notice["id"] = (id ?? "") + ".rejected";
                notice["instanceId"] = _instanceId;
                notice["bootId"] = _bootId;
                notice["nonce"] = _nonce;
                notice["probeVersion"] = ProbeVersion;
                notice["ok"] = false;
                notice["rejected"] = payload;
                WriteAtomic(Path.Combine(_outboxDir, (id ?? "unknown") + ".rejected.json"), MiniJson.Serialize(notice));
            }
            catch { }
        }

        static Dictionary<string, object> Error(string code, string message, string detail)
        {
            var e = new Dictionary<string, object>();
            e["code"] = code;
            e["message"] = message ?? "";
            // 部分错误码需要携带机器可读细节（例如编译错误的逐条诊断、近似成员名），
            // 这些内容既不适合塞进 message，也不应丢弃。
            e["detail"] = detail ?? "";
            return e;
        }

        static string CodeOf(Exception e)
        {
            var known = e as KnownError;
            if (known != null) return known.Code;
            if (e is TargetInvocationException && e.InnerException != null) return CodeOf(e.InnerException);
            if (e is FileNotFoundException) return "not_found";
            if (e is ArgumentException) return "invalid_argument";
            return "probe_error";
        }

        /// <summary>错误细节：KnownError 可携带结构化细节，其它异常退回异常类型名。</summary>
        static string DetailOf(Exception e)
        {
            var known = e as KnownError;
            if (known != null) return string.IsNullOrEmpty(known.Detail) ? e.GetType().Name : known.Detail;
            if (e is TargetInvocationException && e.InnerException != null) return DetailOf(e.InnerException);
            return e.GetType().Name;
        }

        class KnownError : Exception
        {
            public readonly string Code;
            public readonly string Detail;
            public KnownError(string code, string message) : base(message) { Code = code; Detail = null; }
            public KnownError(string code, string message, string detail) : base(message) { Code = code; Detail = detail; }
        }

        /// <summary>argv 里出现 -dshBridgeAuthorize 时，反射执行面才解锁（对应插件配置 allowDangerous）。</summary>
        static bool AuthorizedByArgv()
        {
            try
            {
                var args = Environment.GetCommandLineArgs();
                for (var i = 0; i < args.Length; i++)
                {
                    if (args[i] == AuthorizeArg) return true;
                }
            }
            catch { }
            return false;
        }

        /// <summary>探针在本地关闭/需授权的能力清单，供诊断与测试断言。</summary>
        public static string[] DangerousCapabilitiesForTest()
        {
            var list = new List<string>(_blockedCapabilities);
            list.AddRange(_reflectCapabilities);
            return list.ToArray();
        }

        // ===== 路径边界（AA-OPT-002 / AA-OPT-003）=====
        // 所有真实文件系统访问都必须经过这里：绝对路径与 ../ 逃逸一律拒绝。
        // Project 根用 FullName 参与比较，避免 /tmp 与 /private/tmp 之类的符号链接造成误判。
        static string ResolveProjectPath(string raw, string what)
        {
            if (string.IsNullOrEmpty(raw)) throw new KnownError("invalid_argument", "缺少 " + what);
            if (raw.IndexOf('\0') >= 0) throw new KnownError("path_escape", what + " 含非法字符");
            string full;
            try { full = Path.GetFullPath(Path.IsPathRooted(raw) ? raw : Path.Combine(_projectRoot, raw)); }
            catch (Exception e) { throw new KnownError("path_escape", what + " 无法解析: " + e.Message); }
            if (IsInsideProject(full)) return full;
            throw new KnownError("path_escape", what + " 落在工程之外，已拒绝：" + raw);
        }

        static bool IsInsideProject(string full)
        {
            var root = _projectRoot;
            if (string.IsNullOrEmpty(root)) return false;
            if (!root.EndsWith(Path.DirectorySeparatorChar.ToString(), StringComparison.Ordinal))
                root = root + Path.DirectorySeparatorChar;
            return full.StartsWith(root, StringComparison.Ordinal);
        }

        /// <summary>路径是否落在引擎安装目录（Contents）内：显式引用允许引用引擎自带的程序集。</summary>
        static bool IsInsideEngineContents(string full)
        {
            string contents;
            try { contents = EditorApplication.applicationContentsPath; }
            catch (Exception) { return false; }
            if (string.IsNullOrEmpty(contents) || string.IsNullOrEmpty(full)) return false;
            var root = contents;
            if (!root.EndsWith(Path.DirectorySeparatorChar.ToString(), StringComparison.Ordinal))
                root = root + Path.DirectorySeparatorChar;
            return full.StartsWith(root, StringComparison.Ordinal);
        }

        /// <summary>把工程内绝对路径还原成 Unity 用的相对路径（正斜杠）。</summary>
        static string ToProjectRelative(string full)
        {
            var root = _projectRoot;
            if (!root.EndsWith(Path.DirectorySeparatorChar.ToString(), StringComparison.Ordinal))
                root = root + Path.DirectorySeparatorChar;
            var rel = full.StartsWith(root, StringComparison.Ordinal) ? full.Substring(root.Length) : full;
            return rel.Replace('\\', '/');
        }

        /// <summary>AssetDatabase 系列 API 只接受工程内相对路径；越界在进入 Unity 之前就拒绝。</summary>
        static string ResolveAssetPath(string raw, string what)
        {
            var full = ResolveProjectPath(raw, what);
            return ToProjectRelative(full);
        }

        static void EnsureTextable(string full, string what)
        {
            var ext = Path.GetExtension(full) ?? string.Empty;
            if (!_textableExtensions.Contains(ext))
                throw new KnownError("invalid_argument", what + " 只允许文本类资产扩展名（" + ext + " 不受理）");
        }

        static object Execute(string cap, Dictionary<string, object> args)
        {
            if (cap == "unity.editor.status") return EditorStatus();
            if (cap == "unity.console.read") return ConsoleRead(args);
            if (cap == "unity.hierarchy.list") return HierarchyList(args);
            if (cap == "unity.asset.find") return AssetFind(args);
            if (cap == "unity.menu.execute") return MenuExecute(args);
            if (cap == "unity.playmode.set") return PlaymodeSet(args);
            if (cap == "unity.asset.refresh") return AssetRefresh(args);
            if (cap == "unity.reflect.invoke") return ReflectInvoke(args);
            if (cap == "unity.gameobject.create") return GameObjectCreate(args);
            if (cap == "unity.gameobject.delete") return GameObjectDelete(args);
            if (cap == "unity.gameobject.rename") return GameObjectRename(args);
            if (cap == "unity.gameobject.duplicate") return GameObjectDuplicate(args);
            if (cap == "unity.gameobject.setActive") return GameObjectSetActive(args);
            if (cap == "unity.gameobject.setParent") return GameObjectSetParent(args);
            if (cap == "unity.gameobject.setTransform") return GameObjectSetTransform(args);
            if (cap == "unity.component.add") return ComponentAdd(args);
            if (cap == "unity.component.remove") return ComponentRemove(args);
            if (cap == "unity.component.set") return ComponentSet(args);
            if (cap == "unity.component.get") return ComponentGet(args);
            if (cap == "unity.prefab.create") return PrefabCreate(args);
            if (cap == "unity.prefab.instantiate") return PrefabInstantiate(args);
            if (cap == "unity.prefab.open") return PrefabOpen(args);
            if (cap == "unity.prefab.save") return PrefabSave(args);
            if (cap == "unity.prefab.close") return PrefabClose(args);
            if (cap == "unity.material.get") return MaterialGet(args);
            if (cap == "unity.material.set") return MaterialSet(args);
            if (cap == "unity.asset.rename") return AssetOp(args, "rename");
            if (cap == "unity.asset.move") return AssetOp(args, "move");
            if (cap == "unity.asset.delete") return AssetOp(args, "delete");
            if (cap == "unity.asset.duplicate") return AssetOp(args, "duplicate");
            if (cap == "unity.object.find") return ObjectFind(args);
            if (cap == "unity.api.invoke") return ApiInvoke(args);
            if (cap == "unity.api.members") return ApiMembers(args);
            if (cap == "unity.api.batch") return ApiBatch(args);
            if (cap == "unity.code.execute") return CodeExecute(args);
            if (cap == "unity.search.content") return SearchContent(args);
            if (cap == "unity.asset.read") return AssetRead(args);
            if (cap == "unity.asset.create") return AssetCreate(args);
            if (cap == "unity.importer.get") return ImporterAccess(args, false);
            if (cap == "unity.importer.set") return ImporterAccess(args, true);
            if (cap == "unity.scene.list") return SceneList(args);
            if (cap == "unity.scene.open") return SceneOpen(args);
            if (cap == "unity.scene.save") return SceneSave(args);
            if (cap == "unity.selection.set") return SelectionSet(args);
            throw new KnownError("capability_unsupported", "未知能力: " + cap);
        }

        // ===== 通用执行面：对象发现 / 任意 API 调用 / 检索 / 资产与导入设置 =====

        static readonly Dictionary<string, object> _handles = new Dictionary<string, object>();
        // 队列而非 List：淘汰时 Dequeue 是 O(1)，List.RemoveAt(0) 需要移动全部元素。
        static readonly Queue<string> _handleOrder = new Queue<string>();
        static long _handleSeq = 0;
        const int HandleLimit = 4000;

        static string PutHandle(object obj)
        {
            if (obj == null) return null;
            var key = "h" + (++_handleSeq).ToString(CultureInfo.InvariantCulture);
            _handles[key] = obj;
            _handleOrder.Enqueue(key);
            while (_handleOrder.Count > HandleLimit)
            {
                var oldest = _handleOrder.Dequeue();
                _handles.Remove(oldest);
            }
            return key;
        }

        static object GetHandle(string key)
        {
            object value;
            return key != null && _handles.TryGetValue(key, out value) ? value : null;
        }

        static Dictionary<string, object> DescribeRef(object obj)
        {
            if (obj == null) return null;
            var d = new Dictionary<string, object>();
            var uo = obj as UnityEngine.Object;
            d["handle"] = PutHandle(obj);
            d["type"] = obj.GetType().Name;
            d["fullType"] = obj.GetType().FullName;
            if (uo != null)
            {
                d["name"] = uo.name;
                d["assetPath"] = AssetDatabase.GetAssetPath(uo);
                var go = uo as GameObject;
                if (go != null) d["scenePath"] = ScenePathOf(go.transform);
            }
            return d;
        }

        static string ScenePathOf(Transform t)
        {
            if (t == null) return null;
            var parts = new List<string>();
            while (t != null) { parts.Insert(0, t.name); t = t.parent; }
            return string.Join("/", parts.ToArray());
        }

        static Transform FindTransformByPath(string path)
        {
            if (string.IsNullOrEmpty(path)) return null;
            var parts = path.Split('/');
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) return null;
            Transform current = null;
            foreach (var root in scene.GetRootGameObjects())
            {
                if (root.name == parts[0]) { current = root.transform; break; }
            }
            if (current == null) return null;
            for (var i = 1; i < parts.Length && current != null; i++)
            {
                Transform next = null;
                for (var c = 0; c < current.childCount; c++)
                {
                    var child = current.GetChild(c);
                    if (child.name == parts[i]) { next = child; break; }
                }
                current = next;
            }
            return current;
        }

        static List<GameObject> AllSceneObjects(bool includeInactive)
        {
            var list = new List<GameObject>();
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) return list;
            foreach (var root in scene.GetRootGameObjects())
            {
                var stack = new Stack<Transform>();
                stack.Push(root.transform);
                while (stack.Count > 0)
                {
                    var t = stack.Pop();
                    if (includeInactive || t.gameObject.activeInHierarchy) list.Add(t.gameObject);
                    for (var i = 0; i < t.childCount; i++) stack.Push(t.GetChild(i));
                }
            }
            return list;
        }

        static Dictionary<string, object> ObjectFind(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            var name = GetString(args, "name");
            var component = GetString(args, "component");
            var tag = GetString(args, "tag");
            var limit = (int)Math.Max(1, Math.Min(500, ToLong(args, "limit", 50)));
            var includeInactive = ToBool(args, "includeInactive");

            var results = new List<object>();
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t != null) results.Add(DescribeRef(t.gameObject));
            }
            else
            {
                foreach (var go in AllSceneObjects(includeInactive))
                {
                    if (!string.IsNullOrEmpty(name) && go.name.IndexOf(name, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    if (!string.IsNullOrEmpty(tag) && !go.CompareTag(tag)) continue;
                    if (!string.IsNullOrEmpty(component))
                    {
                        var has = false;
                        foreach (var c in go.GetComponents<Component>())
                        {
                            if (c != null && c.GetType().Name == component) { has = true; break; }
                        }
                        if (!has) continue;
                    }
                    results.Add(DescribeRef(go));
                    if (results.Count >= limit) break;
                }
            }
            var d = new Dictionary<string, object>();
            d["count"] = (long)results.Count;
            d["objects"] = results;
            return d;
        }

        static object ResolveTarget(Dictionary<string, object> args, out Type staticType)
        {
            staticType = null;
            var handle = GetString(args, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                if (obj == null) throw new KnownError("handle_not_found", "句柄已失效或被回收: " + handle);
                return obj;
            }
            var path = GetString(args, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                return t.gameObject;
            }
            var assetPath = GetString(args, "asset");
            if (!string.IsNullOrEmpty(assetPath))
            {
                var obj = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath);
                if (obj == null) throw new KnownError("asset_not_found", "找不到资产: " + assetPath);
                return obj;
            }
            var typeName = GetString(args, "type");
            if (!string.IsNullOrEmpty(typeName))
            {
                staticType = FindType(typeName);
                if (staticType == null) throw new KnownError("type_not_found", "找不到类型: " + typeName);
                return null;
            }
            // 注意：Unity 对象可能 != null 却已销毁（伪 null），必须用隐式 bool 判断；
            // 且这里不能返回 null target + null type，否则下游 target.GetType() 必抛 NRE（AA-CODE-001）。
            if (Selection.activeObject) return Selection.activeObject;
            throw new KnownError("invalid_argument", "需要 handle / path / asset / type 之一（或先选中一个对象）");
        }

        static object[] ConvertArgs(ParameterInfo[] parameters, List<object> raw)
        {
            var converted = new object[parameters.Length];
            for (var i = 0; i < parameters.Length; i++)
            {
                if (i < raw.Count) converted[i] = Coerce(raw[i], parameters[i].ParameterType);
                else if (parameters[i].HasDefaultValue) converted[i] = parameters[i].DefaultValue;
                else converted[i] = DefaultOf(parameters[i].ParameterType);
            }
            return converted;
        }

        static MethodInfo PickMethod(Type type, string name, int argc, BindingFlags flags)
        {
            var candidates = type.GetMethods(flags).Where(m => m.Name == name).ToList();
            if (candidates.Count == 0) return null;
            var exact = candidates.FirstOrDefault(m => m.GetParameters().Length == argc);
            if (exact != null) return exact;
            return candidates.FirstOrDefault(m => m.GetParameters().Length > argc && m.GetParameters().Skip(argc).All(p => p.HasDefaultValue))
                ?? candidates[0];
        }

        static Dictionary<string, object> ApiInvoke(Dictionary<string, object> args)
        {
            Type staticType;
            var target = ResolveTarget(args, out staticType);
            var member = GetString(args, "member");
            if (string.IsNullOrEmpty(member)) throw new KnownError("invalid_argument", "缺少 member");
            var kind = GetString(args, "kind") ?? "auto";
            var rawArgs = args.ContainsKey("args") ? args["args"] as List<object> : new List<object>();
            if (rawArgs == null) rawArgs = new List<object>();

            var type = ResolveBoundType(target, staticType);
            // AA-OPT-001：只允许公开成员，且不得触碰硬拒绝清单里的成员。
            EnsureMemberAllowed(type, member, staticType != null);
            var flags = BindingFlags.Public | BindingFlags.FlattenHierarchy
                | (staticType != null ? BindingFlags.Static : BindingFlags.Instance);

            object result = null;
            string usedKind = null;

            if (kind == "auto" || kind == "property")
            {
                var prop = type.GetProperty(member, flags);
                if (prop != null)
                {
                    if (args.ContainsKey("value")) prop.SetValue(staticType != null ? null : target, Coerce(args["value"], prop.PropertyType), null);
                    else if (prop.CanRead) result = prop.GetValue(staticType != null ? null : target, null);
                    usedKind = "property";
                }
            }
            if (usedKind == null && (kind == "auto" || kind == "field"))
            {
                var field = type.GetField(member, flags);
                if (field != null)
                {
                    if (args.ContainsKey("value")) field.SetValue(staticType != null ? null : target, Coerce(args["value"], field.FieldType));
                    else result = field.GetValue(staticType != null ? null : target);
                    usedKind = "field";
                }
            }
            if (usedKind == null && (kind == "auto" || kind == "method"))
            {
                var method = PickMethod(type, member, rawArgs.Count, flags);
                if (method != null)
                {
                    EnsureMethodCallable(method);
                    result = method.Invoke(staticType != null ? null : target, ConvertArgs(method.GetParameters(), rawArgs));
                    usedKind = "method";
                }
            }
            if (usedKind == null) throw new KnownError("member_not_found", "找不到成员: " + type.Name + "." + member);

            var d = new Dictionary<string, object>();
            d["kind"] = usedKind;
            d["type"] = type.Name;
            if (result != null && !(result is string) && !result.GetType().IsPrimitive && !(result is decimal))
            {
                var described = DescribeRef(result);
                if (described != null) { d["result"] = described; return d; }
            }
            d["result"] = Describe(result) ?? result;
            return d;
        }

        /// <summary>
        /// AA-CODE-001：ResolveTarget 可能返回 (null, null)（例如选择为空）。
        /// 这里显式守卫，避免 `staticType ?? target.GetType()` 抛 NullReferenceException。
        /// </summary>
        static Type ResolveBoundType(object target, Type staticType)
        {
            if (staticType != null) return staticType;
            if (target == null) throw new KnownError("invalid_argument", "没有可操作的目标对象；请给出 type / handle / path / asset");
            return target.GetType();
        }

        static void EnsureTypeAllowed(Type type)
        {
            if (type == null) throw new KnownError("type_not_found", "类型为空");
            var name = type.FullName ?? type.Name;
            if (_deniedTypes.Contains(name) || _deniedTypes.Contains(type.Name))
                throw new KnownError("type_denied", "类型 " + name + " 在硬拒绝清单内（启动/资产库/进程控制类 API）");
        }

        static void EnsureMemberAllowed(Type type, string member, bool isStatic)
        {
            EnsureTypeAllowed(type);
            if (_deniedMembers.Contains(member))
                throw new KnownError("member_denied", "成员 " + member + " 在硬拒绝清单内");
            var flags = BindingFlags.Public | BindingFlags.FlattenHierarchy
                | (isStatic ? BindingFlags.Static : BindingFlags.Instance);
            var prop = type.GetProperty(member, flags);
            var field = type.GetField(member, flags);
            var method = prop != null || field != null ? null : type.GetMethods(flags).FirstOrDefault(m => m.Name == member);
            if (prop == null && field == null && method == null)
            {
                // 可能存在，但非公开：给出明确的拒绝原因而不是 member_not_found。
                var anyFlags = flags | BindingFlags.NonPublic;
                if (type.GetProperty(member, anyFlags) != null || type.GetField(member, anyFlags) != null
                    || type.GetMethods(anyFlags).Any(m => m.Name == member))
                    throw new KnownError("member_not_public", "成员 " + type.Name + "." + member + " 不是公开成员，已拒绝");
                throw new KnownError("member_not_found", "找不到成员: " + type.Name + "." + member);
            }
        }

        static void EnsureMethodCallable(MethodInfo method)
        {
            if (method.IsAbstract) throw new KnownError("member_not_public", "方法是抽象定义，不可调用: " + method.Name);
            if (method.IsGenericMethodDefinition) throw new KnownError("member_not_public", "泛型方法需要显式类型参数，已拒绝: " + method.Name);
        }

        static Dictionary<string, object> ApiMembers(Dictionary<string, object> args)
        {
            Type staticType;
            var target = ResolveTarget(args, out staticType);
            var type = ResolveBoundType(target, staticType);
            EnsureTypeAllowed(type);
            var filter = GetString(args, "filter");
            var limit = (int)Math.Max(1, Math.Min(300, ToLong(args, "limit", 80)));
            // 只列公开成员：非公开成员不可调用，列出来只会误导调用方。
            var flags = BindingFlags.Public | BindingFlags.FlattenHierarchy | BindingFlags.Instance | BindingFlags.Static;
            var rows = new List<object>();
            foreach (var m in type.GetMethods(flags))
            {
                if (m.IsSpecialName) continue;
                if (!string.IsNullOrEmpty(filter) && m.Name.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0) continue;
                rows.Add(m.Name + "(" + string.Join(", ", m.GetParameters().Select(p => p.ParameterType.Name + " " + p.Name).ToArray()) + ") : " + m.ReturnType.Name);
                if (rows.Count >= limit) break;
            }
            if (rows.Count < limit)
            {
                foreach (var p in type.GetProperties(flags))
                {
                    if (!string.IsNullOrEmpty(filter) && p.Name.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    rows.Add((p.CanRead ? "get " : "") + (p.CanWrite ? "set " : "") + p.PropertyType.Name + " " + p.Name);
                    if (rows.Count >= limit) break;
                }
            }
            var d = new Dictionary<string, object>();
            d["type"] = type.FullName;
            d["members"] = rows;
            d["truncated"] = (long)rows.Count >= limit ? 1L : 0L;
            return d;
        }

        static Dictionary<string, object> SearchContent(Dictionary<string, object> args)
        {
            var query = GetString(args, "query");
            if (string.IsNullOrEmpty(query)) throw new KnownError("invalid_argument", "缺少 query");
            var folders = GetStringList(args, "folders");
            // AA-OPT-002：folders 只能指向工程内资产目录。
            for (var i = 0; i < folders.Count; i++) folders[i] = ResolveAssetPath(folders[i], "folders");
            var exts = GetStringList(args, "extensions");
            var limit = (int)Math.Max(1, Math.Min(200, ToLong(args, "limit", 40)));
            var budgetMs = Math.Max(100L, Math.Min(60000L, ToLong(args, "budgetMs", SearchTimeBudgetMs)));
            var clock = Stopwatch.StartNew();
            var guids = AssetDatabase.FindAssets("", folders.Count > 0 ? folders.ToArray() : null);
            var hits = new List<object>();
            var scanned = 0;
            var truncated = false;
            foreach (var guid in guids)
            {
                // AA-LIMIT-001：没有预算的全库扫描会把编辑器主线程长时间占死，进而触发调用超时与重试风暴。
                if (clock.ElapsedMilliseconds > budgetMs || scanned >= SearchFileBudget)
                {
                    truncated = true;
                    break;
                }
                var path = AssetDatabase.GUIDToAssetPath(guid);
                if (string.IsNullOrEmpty(path)) continue;
                if (exts.Count > 0 && !exts.Any(e => path.EndsWith(e, StringComparison.OrdinalIgnoreCase))) continue;
                if (!(path.EndsWith(".cs") || path.EndsWith(".shader") || path.EndsWith(".txt")
                    || path.EndsWith(".json") || path.EndsWith(".mat") || path.EndsWith(".asset")
                    || path.EndsWith(".hlsl") || path.EndsWith(".cginc"))) continue;
                scanned++;
                string[] lines;
                try { lines = System.IO.File.ReadAllLines(ResolveProjectPath(path, "asset")); }
                catch { continue; }
                for (var i = 0; i < lines.Length; i++)
                {
                    if (lines[i].IndexOf(query, StringComparison.OrdinalIgnoreCase) < 0) continue;
                    var d = new Dictionary<string, object>();
                    d["assetPath"] = path;
                    d["line"] = (long)(i + 1);
                    d["text"] = lines[i].Trim().Length > 300 ? lines[i].Trim().Substring(0, 300) : lines[i].Trim();
                    hits.Add(d);
                    if (hits.Count >= limit) break;
                }
                if (hits.Count >= limit) break;
            }
            clock.Stop();
            var result = new Dictionary<string, object>();
            result["scanned"] = (long)scanned;
            result["hits"] = hits;
            result["budgetMs"] = budgetMs;
            result["elapsedMs"] = clock.ElapsedMilliseconds;
            result["truncated"] = truncated;
            return result;
        }

        static Dictionary<string, object> AssetRead(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            // AA-OPT-002：此前这里直接把 path 交给 File.ReadAllLines，等于"工程进程权限内的任意文件读取"。
            var full = ResolveProjectPath(path, "path");
            EnsureTextable(full, "path");
            var maxLines = (int)Math.Max(1, Math.Min(2000, ToLong(args, "lines", 400)));
            var offset = (int)Math.Max(0, ToLong(args, "offset", 0));
            string[] lines;
            try { lines = System.IO.File.ReadAllLines(full); }
            catch (Exception e) { throw new KnownError("read_failed", "读取失败: " + e.Message); }
            var slice = lines.Skip(offset).Take(maxLines).ToArray();
            var d = new Dictionary<string, object>();
            d["assetPath"] = ToProjectRelative(full);
            d["totalLines"] = (long)lines.Length;
            d["offset"] = (long)offset;
            d["text"] = string.Join("\n", slice);
            return d;
        }

        static Dictionary<string, object> AssetCreate(Dictionary<string, object> args)
        {
            var kind = GetString(args, "kind") ?? "folder";
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            // AA-OPT-003：path 此前直接被 Path.Combine(工程根, path) 拼成写盘目标，../ 与绝对路径都能逃逸。
            var assetPath = ResolveAssetPath(path, "path");
            var content = GetString(args, "content");
            var created = false;

            if (kind == "folder")
            {
                if (!AssetDatabase.IsValidFolder(assetPath))
                {
                    var parent = System.IO.Path.GetDirectoryName(assetPath).Replace('\\', '/');
                    var leaf = System.IO.Path.GetFileName(assetPath);
                    if (string.IsNullOrEmpty(parent)) throw new KnownError("invalid_argument", "无法创建工程根目录下的文件夹");
                    AssetDatabase.CreateFolder(parent, leaf);
                }
                created = true;
            }
            else if (kind == "script")
            {
                var name = System.IO.Path.GetFileNameWithoutExtension(assetPath);
                if (content == null) content = DefaultScript(name);
                WriteTextAsset(assetPath, content);
                created = true;
            }
            else if (kind == "shader")
            {
                if (content == null) content = DefaultShader(System.IO.Path.GetFileNameWithoutExtension(assetPath));
                WriteTextAsset(assetPath, content);
                created = true;
            }
            else if (kind == "text")
            {
                WriteTextAsset(assetPath, content ?? "");
                created = true;
            }
            else if (kind == "material")
            {
                var shaderName = GetString(args, "shader") ?? "Standard";
                var shader = Shader.Find(shaderName);
                if (shader == null) throw new KnownError("shader_not_found", "找不到 Shader: " + shaderName);
                var mat = new Material(shader);
                AssetDatabase.CreateAsset(mat, assetPath);
                created = true;
            }
            else throw new KnownError("unsupported_kind", "不支持的 kind: " + kind);

            AssetDatabase.Refresh();
            var d = new Dictionary<string, object>();
            d["created"] = created;
            d["assetPath"] = assetPath;
            d["kind"] = kind;
            return d;
        }

        static void WriteTextAsset(string assetPath, string content)
        {
            // 二次确认：即使上层漏判，这里也会再次拦下越界写入。
            var full = ResolveProjectPath(assetPath, "path");
            EnsureTextable(full, "path");
            var dir = System.IO.Path.GetDirectoryName(full);
            if (!string.IsNullOrEmpty(dir) && !System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
            System.IO.File.WriteAllText(full, content, new UTF8Encoding(false));
        }

        static string DefaultScript(string name)
        {
            return "using UnityEngine;\n\npublic class " + name + " : MonoBehaviour\n{\n    void Start()\n    {\n    }\n\n    void Update()\n    {\n    }\n}\n";
        }

        static string DefaultShader(string name)
        {
            return "Shader \"" + name + "\"\n{\n    Properties\n    {\n        _Color (\"Color\", Color) = (1,1,1,1)\n    }\n    SubShader\n    {\n        Tags { \"RenderType\"=\"Opaque\" }\n        Pass\n        {\n            CGPROGRAM\n            #pragma vertex vert\n            #pragma fragment frag\n            #include \"UnityCG.cginc\"\n            struct appdata { float4 vertex : POSITION; };\n            struct v2f { float4 pos : SV_POSITION; };\n            v2f vert (appdata v) { v2f o; o.pos = UnityObjectToClipPos(v.vertex); return o; }\n            fixed4 frag (v2f i) : SV_Target { return fixed4(1,1,1,1); }\n            ENDCG\n        }\n    }\n}\n";
        }

        static Dictionary<string, object> ImporterAccess(Dictionary<string, object> args, bool write)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            path = ResolveAssetPath(path, "path");
            var importer = AssetImporter.GetAtPath(path);
            if (importer == null) throw new KnownError("importer_not_found", "该资产没有导入器或路径无效: " + path);
            var d = new Dictionary<string, object>();
            d["importer"] = importer.GetType().Name;
            d["assetPath"] = path;

            var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
            if (write)
            {
                if (changes == null) throw new KnownError("invalid_argument", "缺少 changes");
                var flags = BindingFlags.Public | BindingFlags.Instance;
                var applied = new List<object>();
                foreach (var kv in changes)
                {
                    var prop = importer.GetType().GetProperty(kv.Key, flags);
                    if (prop == null || !prop.CanWrite) continue;
                    prop.SetValue(importer, Coerce(kv.Value, prop.PropertyType), null);
                    applied.Add(kv.Key);
                }
                importer.SaveAndReimport();
                d["applied"] = applied;
            }

            var snapshot = new Dictionary<string, object>();
            var type = importer.GetType();
            var keys = new[] { "textureType", "sRGBTexture", "mipmapEnabled", "maxTextureSize", "textureCompression", "wrapMode", "importMaterials", "animationType", "loadType", "compressionFormat" };
            foreach (var key in keys)
            {
                var prop = type.GetProperty(key, BindingFlags.Public | BindingFlags.Instance);
                if (prop != null && prop.CanRead) snapshot[key] = Describe(prop.GetValue(importer, null));
            }
            if (snapshot.Count == 0)
            {
                // 该导入器没有这些通用字段时，回退给出一份可读属性清单，便于调用方拼 changes。
                var readable = new List<object>();
                foreach (var prop in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
                {
                    if (!prop.CanRead) continue;
                    readable.Add(prop.Name + " : " + prop.PropertyType.Name);
                    if (readable.Count >= 40) break;
                }
                d["readableProperties"] = readable;
            }
            d["settings"] = snapshot;
            return d;
        }

        static Dictionary<string, object> SceneList(Dictionary<string, object> args)
        {
            var folders = GetStringList(args, "folders");
            var limit = (int)Math.Max(1, Math.Min(300, ToLong(args, "limit", 100)));
            var guids = AssetDatabase.FindAssets("t:Scene", folders.Count > 0 ? folders.ToArray() : null);
            var rows = new List<object>();
            for (var i = 0; i < guids.Length && i < limit; i++) rows.Add(AssetDatabase.GUIDToAssetPath(guids[i]));
            var d = new Dictionary<string, object>();
            d["total"] = (long)guids.Length;
            d["scenes"] = rows;
            d["active"] = UnityEngine.SceneManagement.SceneManager.GetActiveScene().path;
            return d;
        }

        static Dictionary<string, object> SceneOpen(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            if (EditorApplication.isPlaying) throw new KnownError("invalid_state", "Play Mode 下不能切换场景");
            var mode = GetString(args, "mode") ?? "single";
            var opened = UnityEditor.SceneManagement.EditorSceneManager.OpenScene(
                path, mode == "additive" ? UnityEditor.SceneManagement.OpenSceneMode.Additive : UnityEditor.SceneManagement.OpenSceneMode.Single);
            var d = new Dictionary<string, object>();
            d["opened"] = opened.path;
            d["sceneCount"] = (long)UnityEngine.SceneManagement.SceneManager.sceneCount;
            return d;
        }

        static Dictionary<string, object> SceneSave(Dictionary<string, object> args)
        {
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            if (!scene.IsValid()) throw new KnownError("invalid_state", "没有有效场景");
            var target = GetString(args, "path");
            if (string.IsNullOrEmpty(target) && string.IsNullOrEmpty(scene.path))
            {
                // 未保存过的新场景调 SaveScene 会弹出「另存为」模态框并阻塞编辑器，必须显式给 path。
                throw new KnownError("scene_not_saved", "当前场景尚未保存到磁盘；请用 path 参数指定目标路径后再保存");
            }
            var ok = string.IsNullOrEmpty(target)
                ? UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene)
                : UnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene, target);
            var d = new Dictionary<string, object>();
            d["saved"] = ok;
            d["path"] = string.IsNullOrEmpty(target) ? scene.path : target;
            return d;
        }

        static Dictionary<string, object> SelectionSet(Dictionary<string, object> args)
        {
            var path = GetString(args, "path");
            var assetPath = GetString(args, "asset");
            UnityEngine.Object target = null;
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                target = t.gameObject;
            }
            else if (!string.IsNullOrEmpty(assetPath))
            {
                target = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath);
                if (target == null) throw new KnownError("asset_not_found", "找不到资产: " + assetPath);
            }
            if (target == null) throw new KnownError("invalid_argument", "需要 path 或 asset");
            Selection.activeObject = target;
            EditorGUIUtility.PingObject(target);
            var d = new Dictionary<string, object>();
            d["selected"] = DescribeRef(target);
            return d;
        }

        // ===== P2 语义封装：场景对象 / 组件 / Prefab / 材质 / 资产 =====

        static GameObject ResolveGameObject(Dictionary<string, object> args, string key = "target")
        {
            Dictionary<string, object> inner = args;
            if (key != null && args.ContainsKey(key) && args[key] is Dictionary<string, object>)
                inner = args[key] as Dictionary<string, object>;
            var handle = GetString(inner, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                var go1 = obj as GameObject;
                if (go1 != null) return go1;
                var comp = obj as Component;
                if (comp != null) return comp.gameObject;
                throw new KnownError("invalid_handle", "句柄不是场景对象: " + handle);
            }
            var path = GetString(inner, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var t = FindTransformByPath(path);
                if (t == null) throw new KnownError("object_not_found", "场景内找不到对象: " + path);
                return t.gameObject;
            }
            throw new KnownError("invalid_argument", "需要 handle 或 path");
        }

        static Component ResolveComponent(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var typeName = GetString(args, "componentType") ?? GetString(args, "type");
            if (string.IsNullOrEmpty(typeName)) throw new KnownError("invalid_argument", "缺少 componentType");
            var type = FindType(typeName);
            if (type == null) throw new KnownError("type_not_found", "找不到组件类型: " + typeName);
            var comp = go.GetComponent(type);
            if (comp == null) throw new KnownError("component_not_found", "对象上没有组件: " + typeName);
            return comp;
        }

        static object ParseVectorLike(Type target, object raw)
        {
            if (raw == null) return null;
            var dict = raw as Dictionary<string, object>;
            var list = raw as List<object>;
            float Get(string axis, int index)
            {
                if (dict != null && dict.ContainsKey(axis)) return (float)System.Convert.ToDouble(dict[axis], CultureInfo.InvariantCulture);
                if (list != null && list.Count > index) return (float)System.Convert.ToDouble(list[index], CultureInfo.InvariantCulture);
                return 0f;
            }
            if (target == typeof(Vector2)) return new Vector2(Get("x", 0), Get("y", 1));
            if (target == typeof(Vector3)) return new Vector3(Get("x", 0), Get("y", 1), Get("z", 2));
            if (target == typeof(Vector4)) return new Vector4(Get("x", 0), Get("y", 1), Get("z", 2), Get("w", 3));
            if (target == typeof(Quaternion))
            {
                if (dict != null && dict.ContainsKey("euler"))
                {
                    var e = dict["euler"] as List<object> ?? new List<object>();
                    return Quaternion.Euler(
                        e.Count > 0 ? (float)System.Convert.ToDouble(e[0], CultureInfo.InvariantCulture) : 0f,
                        e.Count > 1 ? (float)System.Convert.ToDouble(e[1], CultureInfo.InvariantCulture) : 0f,
                        e.Count > 2 ? (float)System.Convert.ToDouble(e[2], CultureInfo.InvariantCulture) : 0f);
                }
                return new Quaternion(Get("x", 0), Get("y", 1), Get("z", 2), Get("w", 3));
            }
            if (target == typeof(Color))
            {
                var s = raw as string;
                if (!string.IsNullOrEmpty(s) && s.StartsWith("#"))
                {
                    Color parsed;
                    if (ColorUtility.TryParseHtmlString(s, out parsed)) return parsed;
                }
                return new Color(Get("r", 0), Get("g", 1), Get("b", 2), dict != null && dict.ContainsKey("a") ? Get("a", 3) : 1f);
            }
            return null;
        }

        static object CoerceValue(object raw, Type target)
        {
            if (raw == null) return DefaultOf(target);
            if (target.IsInstanceOfType(raw)) return raw;
            var vec = ParseVectorLike(target, raw);
            if (vec != null) return vec;
            // 引用：{handle} / {asset}
            var dict = raw as Dictionary<string, object>;
            if (dict != null && (dict.ContainsKey("handle") || dict.ContainsKey("asset")))
            {
                var h = GetString(dict, "handle");
                if (!string.IsNullOrEmpty(h))
                {
                    var obj = GetHandle(h);
                    if (obj != null && target.IsInstanceOfType(obj)) return obj;
                }
                var asset = GetString(dict, "asset");
                if (!string.IsNullOrEmpty(asset))
                {
                    var loaded = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(asset);
                    if (loaded != null && target.IsInstanceOfType(loaded)) return loaded;
                }
            }
            if (target.IsEnum) return Enum.Parse(target, System.Convert.ToString(raw, CultureInfo.InvariantCulture), true);
            if (target == typeof(string)) return System.Convert.ToString(raw, CultureInfo.InvariantCulture);
            return Coerce(raw, target);
        }

        static object SetMember(object target, Type type, string member, object raw, bool isStatic)
        {
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.FlattenHierarchy
                | (isStatic ? BindingFlags.Static : BindingFlags.Instance);
            var prop = type.GetProperty(member, flags);
            if (prop != null)
            {
                if (!prop.CanWrite) throw new KnownError("readonly_member", "属性不可写: " + member);
                prop.SetValue(isStatic ? null : target, CoerceValue(raw, prop.PropertyType), null);
                return prop.GetValue(isStatic ? null : target, null);
            }
            var field = type.GetField(member, flags);
            if (field != null)
            {
                field.SetValue(isStatic ? null : target, CoerceValue(raw, field.FieldType));
                return field.GetValue(isStatic ? null : target);
            }
            throw new KnownError("member_not_found", "找不到可写成员: " + type.Name + "." + member);
        }

        static Dictionary<string, object> GameObjectCreate(Dictionary<string, object> args)
        {
            var name = GetString(args, "name") ?? "GameObject";
            var primitive = GetString(args, "primitive");
            GameObject go;
            if (!string.IsNullOrEmpty(primitive))
            {
                PrimitiveType prim;
                if (!Enum.TryParse(primitive, true, out prim)) throw new KnownError("invalid_argument", "未知 primitive: " + primitive);
                go = GameObject.CreatePrimitive(prim);
                go.name = name;
            }
            else go = new GameObject(name);

            var parentPath = GetString(args, "parentPath");
            var parentHandle = GetString(args, "parentHandle");
            if (!string.IsNullOrEmpty(parentPath) || !string.IsNullOrEmpty(parentHandle))
            {
                var parentArgs = new Dictionary<string, object>();
                if (!string.IsNullOrEmpty(parentPath)) parentArgs["path"] = parentPath;
                if (!string.IsNullOrEmpty(parentHandle)) parentArgs["handle"] = parentHandle;
                var parentGo = ResolveGameObject(parentArgs);
                go.transform.SetParent(parentGo.transform, false);
            }
            foreach (var compName in GetStringList(args, "components"))
            {
                var t = FindType(compName);
                if (t != null && go.GetComponent(t) == null) go.AddComponent(t);
            }
            Undo.RegisterCreatedObjectUndo(go, "DSH Create " + name);
            EditorUtility.SetDirty(go);
            return DescribeRef(go);
        }

        static Dictionary<string, object> GameObjectDelete(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var name = go.name;
            Undo.DestroyObjectImmediate(go);
            var d = new Dictionary<string, object>();
            d["deleted"] = name;
            return d;
        }

        static Dictionary<string, object> GameObjectRename(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var name = GetString(args, "name");
            if (string.IsNullOrEmpty(name)) throw new KnownError("invalid_argument", "缺少 name");
            Undo.RecordObject(go, "DSH Rename");
            go.name = name;
            EditorUtility.SetDirty(go);
            return DescribeRef(go);
        }

        static Dictionary<string, object> GameObjectDuplicate(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var copy = UnityEngine.Object.Instantiate(go, go.transform.parent);
            copy.name = go.name + "_Copy";
            Undo.RegisterCreatedObjectUndo(copy, "DSH Duplicate");
            return DescribeRef(copy);
        }

        static Dictionary<string, object> GameObjectSetActive(Dictionary<string, object> args)
        {
            var go = ResolveGameObject(args);
            var active = ToBool(args, "active");
            Undo.RecordObject(go, "DSH SetActive");
            go.SetActive(active);
            var d = new Dictionary<string, object>();
            d["name"] = go.name;
            d["active"] = go.activeSelf;
