        /// <summary>确保 Assets/ 内的父目录存在（逐级 CreateFolder，已存在则跳过）。</summary>
        static void GraphicsEnsureAssetFolder(string assetPath)
        {
            var slash = assetPath.LastIndexOf('/');
            if (slash <= 0) return;
            var folder = assetPath.Substring(0, slash);
            if (folder == "Assets" || AssetDatabase.IsValidFolder(folder)) return;
            var parts = folder.Split('/');
            var current = parts[0];
            for (var i = 1; i < parts.Length; i++)
            {
                var next = current + "/" + parts[i];
                if (!AssetDatabase.IsValidFolder(next))
                {
                    try { AssetDatabase.CreateFolder(current, parts[i]); }
                    catch (Exception) { }
                }
                current = next;
            }
        }

        static string GraphicsSafeFileName(string name)
        {
            if (string.IsNullOrEmpty(name)) return "Volume";
            var chars = name.ToCharArray();
            var invalid = new char[] { '/', '\\', ':', '*', '?', '"', '<', '>', '|' };
            for (var i = 0; i < chars.Length; i++)
            {
                for (var j = 0; j < invalid.Length; j++)
                {
                    if (chars[i] == invalid[j]) chars[i] = '_';
                }
            }
            return new string(chars);
        }

        /// <summary>把任意参数值转成可 JSON 序列化的结构（值类型/向量/颜色/数组/对象引用）。</summary>
        static object GraphicsJsonValue(object value)
        {
            return GraphicsJsonValue(value, 0);
        }

        static object GraphicsJsonValue(object value, int depth)
        {
            if (value == null) return null;
            if (value is string) return value;
            if (value is bool) return value;
            if (value is int || value is long || value is short || value is byte)
                return (long)System.Convert.ToInt64(value, CultureInfo.InvariantCulture);
            if (value is float || value is double || value is decimal)
                return (double)System.Convert.ToDouble(value, CultureInfo.InvariantCulture);
            if (value is Enum) return value.ToString();
            if (value is Vector3) return Vector3List((Vector3)value);
            if (value is Vector4)
            {
                var v4 = (Vector4)value;
                return new List<object> { (double)v4.x, (double)v4.y, (double)v4.z, (double)v4.w };
            }
            if (value is Vector2)
            {
                var v2 = (Vector2)value;
                return new List<object> { (double)v2.x, (double)v2.y };
            }
            if (value is Color) return ColorList((Color)value);
            var unityObject = value as UnityEngine.Object;
            if (unityObject != null)
            {
                var obj = new Dictionary<string, object>();
                obj["name"] = unityObject.name;
                obj["type"] = unityObject.GetType().Name;
                var assetPath = AssetDatabase.GetAssetPath(unityObject);
                obj["assetPath"] = string.IsNullOrEmpty(assetPath) ? null : assetPath;
                return obj;
            }
            if (depth >= 2) return GraphicsShortText(value);
            var sequence = value as IEnumerable;
            if (sequence != null)
            {
                var list = new List<object>();
                foreach (var item in sequence)
                {
                    if (list.Count >= 64) break;
                    list.Add(GraphicsJsonValue(item, depth + 1));
                }
                return list;
            }
            return GraphicsShortText(value);
        }

        static string GraphicsShortText(object value)
        {
            if (value == null) return null;
            string text;
            try { text = value.ToString(); }
            catch (Exception) { return null; }
            if (text == null) return null;
            return text.Length > 200 ? text.Substring(0, 200) : text;
        }

