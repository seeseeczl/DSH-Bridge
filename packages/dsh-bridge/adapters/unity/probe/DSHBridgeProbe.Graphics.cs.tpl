        static string GraphicsKindOfAsset(UnityEngine.Object asset)
        {
            if (asset == null) return "built-in";
            var type = asset.GetType();
            var typeName = type.FullName ?? type.Name;
            if (typeName.IndexOf("UniversalRenderPipelineAsset", StringComparison.Ordinal) >= 0) return "urp";
            if (typeName.IndexOf("HDRenderPipelineAsset", StringComparison.Ordinal) >= 0) return "hdrp";
            return "custom";
        }

        static string GraphicsPipelineKind()
        {
            // 规格指定用 GraphicsSettings.currentRenderPipeline；个别版本它不会回落到质量级别的管线，
            // 因此再读一次 QualitySettings.renderPipeline（反射，旧版本没有该属性时忽略）。
            var pipeline = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;
            if (pipeline != null) return GraphicsKindOfAsset(pipeline);
            try
            {
                var prop = typeof(QualitySettings).GetProperty("renderPipeline", BindingFlags.Public | BindingFlags.Static);
                if (prop != null && prop.CanRead)
                {
                    var qualityPipeline = prop.GetValue(null, null) as UnityEngine.Object;
                    if (qualityPipeline != null) return GraphicsKindOfAsset(qualityPipeline);
                }
            }
            catch (Exception) { }
            return "built-in";
        }

        static Dictionary<string, object> GraphicsPipelineGet()
        {
            var pipeline = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;
            var d = new Dictionary<string, object>();
            d["pipeline"] = GraphicsPipelineKind();
            d["asset"] = pipeline != null ? pipeline.name : null;
            d["assetPath"] = pipeline != null ? AssetDatabase.GetAssetPath(pipeline) : null;
            d["colorSpace"] = QualitySettings.activeColorSpace.ToString();
            d["qualityLevel"] = (long)QualitySettings.GetQualityLevel();
            var supported = new List<object>();
            supported.Add("built-in");
            supported.Add("urp");
            d["supported"] = supported;
            return d;
        }

        static Dictionary<string, object> GraphicsPipelineSet(Dictionary<string, object> args)
        {
            var requested = GetString(args, "pipeline");
            if (string.IsNullOrEmpty(requested))
                throw new KnownError("invalid_argument", "set 需要 pipeline（built-in/urp/hdrp）");
            requested = requested.ToLowerInvariant();
            if (requested != "built-in" && requested != "urp" && requested != "hdrp")
                throw new KnownError("invalid_argument", "未知 pipeline: " + requested + "（built-in/urp/hdrp）");
            UnityEngine.Rendering.RenderPipelineAsset asset = null;
            string assetPath = null;
            if (requested != "built-in")
            {
                var rawPath = GetString(args, "assetPath");
                if (string.IsNullOrEmpty(rawPath))
                    throw new KnownError("invalid_argument", "设置 " + requested + " 需要 assetPath");
                assetPath = GraphicsAssetPath(rawPath, "assetPath");
                asset = AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.RenderPipelineAsset>(assetPath);
                if (asset == null)
                    throw new KnownError("not_found", "找不到 RenderPipelineAsset: " + assetPath);
                var kind = GraphicsKindOfAsset(asset);
                if (kind != requested)
                    throw new KnownError("invalid_argument", "资产类型与 pipeline 不匹配: " + kind + " != " + requested);
            }
            var prop = typeof(QualitySettings).GetProperty("renderPipeline", BindingFlags.Public | BindingFlags.Static);
            if (prop == null || !prop.CanWrite)
                throw new KnownError(
                    "capability_unavailable",
                    "当前引擎没有可写的 QualitySettings.renderPipeline",
                    "hint: Unity/Tuanjie 2021.2+ 才提供该 API；旧版本请在 Graphics Settings 面板手动指定管线");
            try { prop.SetValue(null, asset, null); }
            catch (Exception error)
            {
                throw new KnownError("pipeline_set_failed", "设置管线失败: " + error.Message, error.GetType().Name);
            }
            var d = GraphicsPipelineGet();
            d["pipeline"] = requested;
            d["assetPath"] = assetPath;
            d["applied"] = true;
            return d;
        }

