        /// <summary>
        /// 取 Volume 的 profile：共享资产（sharedProfile / m_SharedProfile）优先——它才是磁盘上的
        /// VolumeProfile 资产；再退运行时副本 profile / m_InternalProfile（避免 get 丢失 assetPath）。
        /// </summary>
        static object GraphicsVolumeProfile(object volume)
        {
            if (volume == null) return null;
            var profile = GraphicsReadMember(volume, "sharedProfile");
            if (profile != null) return profile;
            profile = GraphicsReadMember(volume, "m_SharedProfile");
            if (profile != null) return profile;
            profile = GraphicsReadMember(volume, "profile");
            if (profile != null) return profile;
            return GraphicsReadMember(volume, "m_InternalProfile");
        }

        static Dictionary<string, object> GraphicsDescribeVolume(object volume)
        {
            var d = new Dictionary<string, object>();
            var unityObject = volume as UnityEngine.Object;
            d["handle"] = PutHandle(volume);
            d["name"] = unityObject != null ? unityObject.name : null;
            d["path"] = GraphicsScenePathOf(volume);
            d["isGlobal"] = GraphicsBoolMember(volume, "isGlobal", false);
            d["priority"] = GraphicsDoubleMember(volume, "priority", 0d);
            d["weight"] = GraphicsDoubleMember(volume, "weight", 1d);
            d["blendDistance"] = GraphicsDoubleMember(volume, "blendDistance", 0d);
            var profile = GraphicsVolumeProfile(volume);
            var profileObject = profile as UnityEngine.Object;
            var profilePath = profileObject != null ? AssetDatabase.GetAssetPath(profileObject) : null;
            d["profilePath"] = string.IsNullOrEmpty(profilePath) ? null : profilePath;
            return d;
        }

        /// <summary>按 target(handle/path) 或 index 解析一个 Volume；两者都缺时报 invalid_argument。</summary>
        static object GraphicsResolveVolume(Dictionary<string, object> args, Type volumeType)
        {
            if (args.ContainsKey("index"))
            {
                var index = (int)ToLong(args, "index", -1);
                if (index < 0) throw new KnownError("invalid_argument", "index 必须 >= 0");
                var all = GraphicsFindAll(volumeType);
                if (index >= all.Count)
                    throw new KnownError("not_found", "第 " + index + " 个 Volume 不存在（共 " + all.Count + " 个）");
                return all[index];
            }
            if (!args.ContainsKey("target") || args["target"] == null)
                throw new KnownError("invalid_argument", "需要 target（handle/path）或 index");
            var spec = GraphicsTargetSpec(args["target"]);
            var handle = GetString(spec, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var direct = GetHandle(handle);
                if (direct != null)
                {
                    if (volumeType.IsInstanceOfType(direct)) return direct;
                    throw new KnownError("invalid_handle", "句柄不是 Volume: " + handle);
                }
            }
            var go = ResolveGameObject(spec);
            if (go == null) throw new KnownError("not_found", "target 对应的对象没有 GameObject");
            var component = go.GetComponent(volumeType);
            if (component == null)
                throw new KnownError("not_found", "对象上没有 Volume 组件: " + go.name);
            return component;
        }

        static List<object> GraphicsVolumeComponentRows(object profile)
        {
            var rows = new List<object>();
            var components = GraphicsMemberList(profile, "components");
            for (var i = 0; i < components.Count; i++) rows.Add(GraphicsVolumeComponentRow(components[i]));
            return rows;
        }

        static Dictionary<string, object> GraphicsVolumeComponentRow(object component)
        {
            var row = new Dictionary<string, object>();
            row["type"] = component != null ? component.GetType().Name : null;
            row["parameters"] = GraphicsVolumeParameterRows(component);
            return row;
        }

        static List<object> GraphicsVolumeParameterRows(object component)
        {
            var rows = new List<object>();
            if (component == null) return rows;
            var parameters = GraphicsMemberList(component, "parameters");
            var fields = GraphicsVolumeFields(component);
            for (var i = 0; i < parameters.Count; i++)
            {
                var parameter = parameters[i];
                var row = new Dictionary<string, object>();
                row["name"] = GraphicsVolumeParameterName(parameter, component, fields, i);
                row["type"] = GraphicsVolumeParameterTypeName(parameter);
                row["value"] = GraphicsJsonValue(GraphicsReadMember(parameter, "value"));
                row["overrideState"] = ToBoolValue(GraphicsReadMember(parameter, "overrideState"));
                rows.Add(row);
            }
            return rows;
        }

        /// <summary>Volume 组件的参数名来自 VolumeComponent 的公共字段名（真机没有稳定的 parameter.name）。</summary>
        static List<FieldInfo> GraphicsVolumeFields(object component)
        {
            var fields = new List<FieldInfo>();
            if (component == null) return fields;
            try
            {
                var found = component.GetType().GetFields(BindingFlags.Public | BindingFlags.Instance);
                for (var i = 0; i < found.Length; i++) fields.Add(found[i]);
            }
            catch (Exception) { }
            return fields;
        }

        static string GraphicsVolumeParameterName(object parameter, object component, List<FieldInfo> fields, int index)
        {
            if (parameter != null)
            {
                var direct = GraphicsReadMember(parameter, "name") as string;
                if (!string.IsNullOrEmpty(direct)) return direct;
                for (var i = 0; i < fields.Count; i++)
                {
                    try
                    {
                        if (ReferenceEquals(fields[i].GetValue(component), parameter)) return fields[i].Name;
                    }
                    catch (Exception) { }
                }
            }
            return "param" + index.ToString(CultureInfo.InvariantCulture);
        }

        static string GraphicsVolumeParameterTypeName(object parameter)
        {
            if (parameter == null) return null;
            var value = GraphicsReadMember(parameter, "value");
            if (value == null) return parameter.GetType().Name;
            return value.GetType().Name;
        }

        /// <summary>volume.set 的组件参数部分（volume.* 与 post_processing 共用）。</summary>
        static void GraphicsApplyVolumeParameterArgs(object component, List<object> parameters, List<object> applied, List<object> ignored)
        {
            if (component == null) return;
            var declared = GraphicsMemberList(component, "parameters");
            var fields = GraphicsVolumeFields(component);
            for (var i = 0; i < parameters.Count; i++)
            {
                var dict = parameters[i] as Dictionary<string, object>;
                if (dict == null) { ignored.Add("<invalid>"); continue; }
                var name = GetString(dict, "name");
                if (string.IsNullOrEmpty(name)) { ignored.Add("<unnamed>"); continue; }
                object parameter = null;
                for (var f = 0; f < fields.Count; f++)
                {
                    if (fields[f].Name != name) continue;
                    try { parameter = fields[f].GetValue(component); }
                    catch (Exception) { }
                    if (parameter != null) break;
                }
                if (parameter == null)
                {
                    for (var p = 0; p < declared.Count; p++)
                    {
                        var candidate = declared[p];
                        if (candidate == null) continue;
                        if (GraphicsVolumeParameterName(candidate, component, fields, p) == name) { parameter = candidate; break; }
                    }
                }
                if (parameter == null) { ignored.Add(name); continue; }
                var ok = true;
                if (dict.ContainsKey("value")) ok = GraphicsTryWriteMember(parameter, "value", dict["value"]) && ok;
                if (dict.ContainsKey("overrideState")) ok = GraphicsTryWriteMember(parameter, "overrideState", dict["overrideState"]) && ok;
                if (ok) applied.Add(name); else ignored.Add(name);
            }
        }

        // ===== unity.graphics.volume.list / get / set / create =====
        static Dictionary<string, object> GraphicsVolumeList(Dictionary<string, object> args)
        {
            var volumeType = GraphicsRequireType(
                "UnityEngine.Rendering.Volume",
                "需要 URP/HDRP（Unity.RenderPipelines.Core.Runtime）；安装后在场景中创建 Volume 组件");
            var limit = GraphicsLimit(args, 200, 1000);
            var includeInactive = ToBoolOr(args, "includeInactive", true);
            var found = GraphicsFindAll(volumeType);
            var rows = new List<object>();
            var truncated = false;
            for (var i = 0; i < found.Count; i++)
            {
                var item = found[i];
                if (!includeInactive)
                {
                    var component = item as Component;
                    if (component != null && component.gameObject != null && !component.gameObject.activeInHierarchy) continue;
                }
                if (rows.Count >= limit) { truncated = true; break; }
                rows.Add(GraphicsDescribeVolume(item));
            }
            var d = new Dictionary<string, object>();
            d["count"] = (long)rows.Count;
            d["truncated"] = truncated;
            d["volumes"] = rows;
            return d;
        }

        static Dictionary<string, object> GraphicsVolumeGet(Dictionary<string, object> args)
        {
            var volumeType = GraphicsRequireType(
                "UnityEngine.Rendering.Volume",
                "需要 URP/HDRP（Unity.RenderPipelines.Core.Runtime）");
            var volume = GraphicsResolveVolume(args, volumeType);
            var profile = GraphicsVolumeProfile(volume);
            var profileObject = profile as UnityEngine.Object;
            var profileInfo = new Dictionary<string, object>();
            profileInfo["name"] = profileObject != null ? profileObject.name : GraphicsReadMember(profile, "name") as string;
            var profilePath = profileObject != null ? AssetDatabase.GetAssetPath(profileObject) : null;
            profileInfo["assetPath"] = string.IsNullOrEmpty(profilePath) ? null : profilePath;
            var d = new Dictionary<string, object>();
            d["volume"] = GraphicsDescribeVolume(volume);
            d["profile"] = profileInfo;
            d["components"] = GraphicsVolumeComponentRows(profile);
            return d;
        }

        static void GraphicsApplyVolumeFields(object volume, Dictionary<string, object> changes, List<object> applied, List<object> ignored)
        {
            var known = new HashSet<string>(StringComparer.Ordinal) { "isGlobal", "priority", "weight", "blendDistance" };
            foreach (var key in changes.Keys)
            {
                if (!known.Contains(key)) { ignored.Add(key); continue; }
                if (key == "priority" || key == "weight" || key == "blendDistance")
                {
                    double number;
                    var text = System.Convert.ToString(changes[key], CultureInfo.InvariantCulture);
                    if (!double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out number))
                        throw new KnownError("invalid_argument", key + " 需要数字");
                    if (GraphicsTryWriteMember(volume, key, number)) applied.Add(key);
                    else ignored.Add(key);
                    continue;
                }
                if (GraphicsTryWriteMember(volume, key, changes[key])) applied.Add(key);
                else ignored.Add(key);
            }
        }

        static Dictionary<string, object> GraphicsVolumeSet(Dictionary<string, object> args)
        {
            var volumeType = GraphicsRequireType(
                "UnityEngine.Rendering.Volume",
                "需要 URP/HDRP（Unity.RenderPipelines.Core.Runtime）");
            var volume = GraphicsResolveVolume(args, volumeType);
            var volumeObject = volume as UnityEngine.Object;
            if (volumeObject != null) Undo.RecordObject(volumeObject, "DSH volume.set");
            var applied = new List<object>();
            var ignored = new List<object>();
            var volumeChanges = args.ContainsKey("volume") ? args["volume"] as Dictionary<string, object> : null;
            if (volumeChanges != null) GraphicsApplyVolumeFields(volume, volumeChanges, applied, ignored);
            var componentName = GetString(args, "component");
            if (!string.IsNullOrEmpty(componentName))
            {
                var profile = GraphicsVolumeProfile(volume);
                if (profile == null) throw new KnownError("not_found", "Volume 没有 profile，无法设置组件参数");
                var components = GraphicsMemberList(profile, "components");
                object component = null;
                for (var i = 0; i < components.Count; i++)
                {
                    var candidate = components[i];
                    if (candidate != null
                        && string.Equals(candidate.GetType().Name, componentName, StringComparison.OrdinalIgnoreCase))
                    {
                        component = candidate;
                        break;
                    }
                }
                if (component == null)
                    throw new KnownError("not_found", "Volume profile 没有组件: " + componentName);
                var profileObject = profile as UnityEngine.Object;
                if (profileObject != null) Undo.RecordObject(profileObject, "DSH volume.set");
                GraphicsApplyVolumeParameterArgs(component, AsObjectList(args, "parameters"), applied, ignored);
                if (profileObject != null) EditorUtility.SetDirty(profileObject);
            }
            if (volumeObject != null) EditorUtility.SetDirty(volumeObject);
            var d = new Dictionary<string, object>();
            d["applied"] = applied;
            d["ignored"] = ignored;
            return d;
        }

        static Dictionary<string, object> GraphicsVolumeCreate(Dictionary<string, object> args)
        {
            var volumeType = GraphicsRequireType(
                "UnityEngine.Rendering.Volume",
                "创建 Volume 需要 URP/HDRP（Unity.RenderPipelines.Core.Runtime）");
            var profileType = GraphicsRequireType(
                "UnityEngine.Rendering.VolumeProfile",
                "创建 Volume 需要 URP/HDRP（Unity.RenderPipelines.Core.Runtime）");
            var name = GetString(args, "name");
            var scenePath = GetString(args, "path");
            if (string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(scenePath))
            {
                var segments = scenePath.Split('/');
                name = segments[segments.Length - 1];
            }
            if (string.IsNullOrEmpty(name)) name = "DSH Volume";
            if (!string.IsNullOrEmpty(scenePath))
            {
                if (scenePath.StartsWith("/", StringComparison.Ordinal)
                    || scenePath.IndexOf("..", StringComparison.Ordinal) >= 0)
                    throw new KnownError("invalid_argument", "path 必须是场景内的相对路径: " + scenePath);
            }
            // profile 资产：已有资产直接挂载；否则按默认路径新建（路径必须落在 Assets/ 内）。
            object profile = null;
            string profilePath;
            var existingPath = GetString(args, "profilePath");
            if (!string.IsNullOrEmpty(existingPath))
            {
                profilePath = GraphicsAssetPath(existingPath, "profilePath");
                profile = AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(profilePath);
                if (profile == null)
                    throw new KnownError("not_found", "找不到 VolumeProfile 资产: " + profilePath);
                if (!profileType.IsInstanceOfType(profile))
                    throw new KnownError("invalid_argument", "资产不是 VolumeProfile: " + profilePath);
            }
            else
            {
                profilePath = GraphicsAssetPath(
                    "Assets/DSH/Volumes/" + GraphicsSafeFileName(name) + ".asset", "profilePath");
            }
            // 先建场景对象、再落资产：组件创建失败时不会留下孤儿资产。
            var go = new GameObject(name);
            try
            {
                var volumeComponent = go.AddComponent(volumeType);
                if (volumeComponent == null)
                    throw new KnownError(
                        "capability_unavailable",
                        "无法在场景对象上创建 Volume 组件",
                        "hint: 确认工程使用 URP/HDRP，且 Volume 类型已随包加载");
                if (profile == null)
                {
                    profile = GraphicsCreateAssetObject(profileType);
                    if (profile == null)
                        throw new KnownError(
                            "capability_unavailable",
                            "无法创建 VolumeProfile 实例",
                            "hint: 需要 URP/HDRP 的 VolumeProfile 类型");
                    GraphicsEnsureAssetFolder(profilePath);
                    AssetDatabase.CreateAsset((UnityEngine.Object)profile, profilePath);
                    GraphicsSaveAssets();
                }
                // 真机 Volume.profile setter 会生成运行时副本；写序列化字段/共享 profile 才是持久做法。
                if (!GraphicsTryWriteMember(volumeComponent, "m_SharedProfile", profile)
                    && !GraphicsTryWriteMember(volumeComponent, "sharedProfile", profile)
                    && !GraphicsTryWriteMember(volumeComponent, "profile", profile))
                    throw new KnownError(
                        "capability_unavailable",
                        "无法把 VolumeProfile 挂到 Volume 上",
                        "hint: 该引擎版本的 Volume 字段布局不同，请改用 volume.set 设置参数");
                if (args.ContainsKey("isGlobal")) GraphicsTryWriteMember(volumeComponent, "isGlobal", args["isGlobal"]);
                if (args.ContainsKey("priority")) GraphicsTryWriteMember(volumeComponent, "priority", args["priority"]);
                if (args.ContainsKey("weight")) GraphicsTryWriteMember(volumeComponent, "weight", args["weight"]);
                Undo.RegisterCreatedObjectUndo(go, "DSH create Volume");
                EditorUtility.SetDirty(go);
                var d = new Dictionary<string, object>();
                d["handle"] = PutHandle(volumeComponent);
                d["name"] = name;
                d["path"] = ScenePathOf(go.transform);
                d["profilePath"] = profilePath;
                return d;
            }
            catch (Exception)
            {
                try { UnityEngine.Object.DestroyImmediate(go); }
                catch (Exception) { }
                throw;
            }
        }

        // ===== unity.graphics.renderer_features：URP Renderer Data 的 Renderer Feature 管理 =====
        static IList GraphicsRendererDataListRaw(object asset)
        {
            var value = GraphicsReadMember(asset, "m_RendererDataList");
            var list = value as IList;
            if (list != null) return list;
            return GraphicsReadMember(asset, "rendererDataList") as IList;
        }

        static object GraphicsRendererDataAt(IList rendererDataList, int index)
        {
            if (rendererDataList == null)
                throw new KnownError("capability_unavailable", "RenderPipelineAsset 上没有 rendererDataList");
            if (index < 0 || index >= rendererDataList.Count)
                throw new KnownError("invalid_argument", "rendererIndex 越界: " + index + "（共 " + rendererDataList.Count + " 个）");
            return rendererDataList[index];
        }

        static Dictionary<string, object> GraphicsRendererRow(object rendererData, int index)
        {
            var row = new Dictionary<string, object>();
            row["index"] = (long)index;
            var unityObject = rendererData as UnityEngine.Object;
            row["name"] = unityObject != null ? unityObject.name : null;
            var features = new List<object>();
            var list = GraphicsMemberList(rendererData, "rendererFeatures");
            if (list.Count == 0) list = GraphicsMemberList(rendererData, "m_RendererFeatures");
            for (var i = 0; i < list.Count; i++) features.Add(GraphicsRendererFeatureRow(list[i], i));
            row["features"] = features;
            return row;
        }

        static Dictionary<string, object> GraphicsRendererFeatureRow(object feature, int index)
        {
            var row = new Dictionary<string, object>();
            row["index"] = (long)index;
            row["type"] = feature != null ? feature.GetType().Name : null;
            var enabled = GraphicsReadMember(feature, "isActive");
            if (enabled == null) enabled = GraphicsReadMember(feature, "enabled");
            row["enabled"] = ToBoolValue(enabled);
            var unityObject = feature as UnityEngine.Object;
            var assetPath = unityObject != null ? AssetDatabase.GetAssetPath(unityObject) : null;
            row["assetPath"] = string.IsNullOrEmpty(assetPath) ? null : assetPath;
            return row;
        }

        static List<object> GraphicsRendererRows(IList rendererDataList)
        {
            var rows = new List<object>();
            if (rendererDataList == null) return rows;
            for (var i = 0; i < rendererDataList.Count; i++) rows.Add(GraphicsRendererRow(rendererDataList[i], i));
            return rows;
        }

        static IList GraphicsFeatureListRaw(object rendererData)
        {
            var list = GraphicsGetListMember(rendererData, "rendererFeatures");
            if (list != null) return list;
            return GraphicsGetListMember(rendererData, "m_RendererFeatures");
        }

        static Dictionary<string, object> GraphicsRendererFeatures(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "list").ToLowerInvariant();
            if (action != "list" && action != "add" && action != "remove" && action != "set")
                throw new KnownError("invalid_argument", "未知 action: " + action + "（list/add/remove/set）");
            var typeName = GetString(args, "typeName");
            if (action == "add" && string.IsNullOrEmpty(typeName))
                throw new KnownError("invalid_argument", "add 需要 typeName（ScriptableRendererFeature 子类名）");
            var rendererIndex = (int)ToLong(args, "rendererIndex", 0);
            if (rendererIndex < 0) throw new KnownError("invalid_argument", "rendererIndex 必须 >= 0");
            var asset = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;
            if (asset == null)
                throw new KnownError(
                    "capability_unavailable",
                    "当前是 Built-in 管线，没有 Renderer Data",
                    "hint: 需要 URP，并在 Graphics/Quality 设置里指定 URP Asset");
            var rendererDataList = GraphicsRendererDataListRaw(asset);
            if (rendererDataList == null)
                throw new KnownError(
                    "capability_unavailable",
                    "该 RenderPipelineAsset 上没有 rendererDataList",
                    "hint: 仅 URP 支持该结构；HDRP 请使用自带 Renderer 资产");
            var d = new Dictionary<string, object>();
            d["renderers"] = GraphicsRendererRows(rendererDataList);
            if (action == "list") return d;
            if (action == "add")
            {
                var rendererData = GraphicsRendererDataAt(rendererDataList, rendererIndex);
                var featureType = FindType(typeName);
                if (featureType == null)
                    throw new KnownError(
                        "feature_type_not_found",
                        "找不到类型: " + typeName,
                        "hint: 传工程内 ScriptableRendererFeature 子类的全名或短名");
                var baseType = FindType("UnityEngine.Rendering.Universal.ScriptableRendererFeature")
                    ?? FindType("UnityEngine.Rendering.ScriptableRendererFeature")
                    ?? FindType("UnityEngine.Rendering.HighDefinition.ScriptableRendererFeature");
                if (baseType != null)
                {
                    if (featureType == baseType || !baseType.IsAssignableFrom(featureType))
                        throw new KnownError("feature_type_not_found", typeName + " 不是 ScriptableRendererFeature 子类");
                }
                else if (featureType.Name.IndexOf("RendererFeature", StringComparison.Ordinal) < 0)
                {
                    throw new KnownError(
                        "feature_type_not_found",
                        "找不到 ScriptableRendererFeature 基类，且 " + typeName + " 看起来不是 Renderer Feature");
                }
                var features = GraphicsFeatureListRaw(rendererData);
                if (features == null)
                    throw new KnownError("capability_unavailable", "Renderer Data 上没有 rendererFeatures 列表");
                var featureObject = GraphicsCreateAssetObject(featureType) as UnityEngine.Object;
                if (featureObject == null)
                    throw new KnownError("capability_unavailable", "无法实例化 Renderer Feature: " + typeName);
                var rendererDataObject = rendererData as UnityEngine.Object;
                if (rendererDataObject != null) Undo.RecordObject(rendererDataObject, "DSH renderer feature add");
                try
                {
                    features.Add(featureObject);
                    GraphicsAddObjectToAsset(featureObject, rendererDataObject);
                    if (rendererDataObject != null) EditorUtility.SetDirty(rendererDataObject);
                    GraphicsSaveAssets();
                }
                catch (Exception error)
                {
                    throw new KnownError(
                        "renderer_feature_add_failed", "添加 Renderer Feature 失败: " + error.Message, error.GetType().Name);
                }
                var applied = new Dictionary<string, object>();
                applied["action"] = "add";
                applied["rendererIndex"] = (long)rendererIndex;
                applied["index"] = (long)(features.Count - 1);
                applied["type"] = featureType.Name;
                d["applied"] = applied;
                d["renderers"] = GraphicsRendererRows(rendererDataList);
                return d;
            }
            if (action == "remove")
            {
                var index = (int)ToLong(args, "index", -1);
                if (index < 0) throw new KnownError("invalid_argument", "remove 需要 index（>=0）");
                var rendererData = GraphicsRendererDataAt(rendererDataList, rendererIndex);
                var features = GraphicsFeatureListRaw(rendererData);
                if (features == null)
                    throw new KnownError("capability_unavailable", "Renderer Data 上没有 rendererFeatures 列表");
                if (index >= features.Count)
                    throw new KnownError("not_found", "第 " + index + " 个 Renderer Feature 不存在（共 " + features.Count + " 个）");
                var removed = features[index] as UnityEngine.Object;
                var rendererDataObject = rendererData as UnityEngine.Object;
                if (rendererDataObject != null) Undo.RecordObject(rendererDataObject, "DSH renderer feature remove");
                features.RemoveAt(index);
                if (removed != null)
                {
                    GraphicsRemoveObjectFromAsset(removed);
                    try { UnityEngine.Object.DestroyImmediate(removed); }
                    catch (Exception) { }
                }
                if (rendererDataObject != null) EditorUtility.SetDirty(rendererDataObject);
                GraphicsSaveAssets();
                var applied = new Dictionary<string, object>();
                applied["action"] = "remove";
                applied["rendererIndex"] = (long)rendererIndex;
                applied["index"] = (long)index;
                applied["type"] = removed != null ? removed.GetType().Name : null;
                d["applied"] = applied;
                d["renderers"] = GraphicsRendererRows(rendererDataList);
                return d;
            }
            // action == "set"
            {
                if (!args.ContainsKey("enabled")) throw new KnownError("invalid_argument", "set 需要 enabled");
                var index = (int)ToLong(args, "index", -1);
                if (index < 0) throw new KnownError("invalid_argument", "set 需要 index（>=0）");
                var rendererData = GraphicsRendererDataAt(rendererDataList, rendererIndex);
                var features = GraphicsFeatureListRaw(rendererData);
                if (features == null)
                    throw new KnownError("capability_unavailable", "Renderer Data 上没有 rendererFeatures 列表");
                if (index >= features.Count)
                    throw new KnownError("not_found", "第 " + index + " 个 Renderer Feature 不存在（共 " + features.Count + " 个）");
                var feature = features[index];
                var rendererDataObject = rendererData as UnityEngine.Object;
                if (rendererDataObject != null) Undo.RecordObject(rendererDataObject, "DSH renderer feature set");
                var ok = GraphicsTryWriteMember(feature, "isActive", args["enabled"]);
                if (!ok) ok = GraphicsTryWriteMember(feature, "enabled", args["enabled"]);
                if (!ok)
                    throw new KnownError(
                        "capability_unavailable",
                        "该 Renderer Feature 没有可写的 isActive/enabled",
                        "hint: 不同 URP 版本的 Feature 开关字段不同");
                if (rendererDataObject != null) EditorUtility.SetDirty(rendererDataObject);
                GraphicsSaveAssets();
                var applied = new Dictionary<string, object>();
                applied["action"] = "set";
                applied["rendererIndex"] = (long)rendererIndex;
                applied["index"] = (long)index;
                applied["enabled"] = ToBoolValue(args["enabled"]);
                d["applied"] = applied;
                d["renderers"] = GraphicsRendererRows(rendererDataList);
                return d;
            }
        }

        // ===== unity.graphics.post_processing：URP 相机后处理开关 =====
        static Camera GraphicsResolveCamera(Dictionary<string, object> args, out GameObject go)
        {
            go = null;
            if (args.ContainsKey("camera") && args["camera"] != null)
            {
                var spec = GraphicsTargetSpec(args["camera"]);
                go = ResolveGameObject(spec);
                if (go == null) throw new KnownError("not_found", "camera 对应的对象没有 GameObject");
                var found = go.GetComponent<Camera>();
                if (found == null) throw new KnownError("not_found", "对象上没有 Camera: " + go.name);
                return found;
            }
            var main = Camera.main;
            if (main == null) throw new KnownError("not_found", "未指定 camera 且 Camera.main 为空");
            // stub/真机的 Camera 都能通过反射取到 gameObject（真机是 Component）。
            go = GraphicsReadMember(main, "gameObject") as GameObject;
            if (go == null) throw new KnownError("capability_unavailable", "无法解析 Camera.main 所在 GameObject");
            return main;
        }

        /// <summary>枚举场景 Volume 里的某类后处理组件（component, profile）对。</summary>
        static List<KeyValuePair<object, object>> GraphicsFindVolumeComponents(string componentTypeName)
        {
            var found = new List<KeyValuePair<object, object>>();
            var volumeType = GraphicsType("UnityEngine.Rendering.Volume");
            if (volumeType == null) return found;
            var volumes = GraphicsFindAll(volumeType);
            for (var i = 0; i < volumes.Count; i++)
            {
                var profile = GraphicsVolumeProfile(volumes[i]);
                var components = GraphicsMemberList(profile, "components");
                for (var c = 0; c < components.Count; c++)
                {
                    var component = components[c];
                    if (component == null) continue;
                    if (!string.Equals(component.GetType().Name, componentTypeName, StringComparison.OrdinalIgnoreCase)) continue;
                    found.Add(new KeyValuePair<object, object>(component, profile));
                }
            }
            return found;
        }

        static List<object> GraphicsPostProcessVolumeRows()
        {
            var rows = new List<object>();
            var volumeType = GraphicsType("UnityEngine.Rendering.Volume");
            if (volumeType == null) return rows;
            var volumes = GraphicsFindAll(volumeType);
            for (var i = 0; i < volumes.Count; i++)
            {
                var profile = GraphicsVolumeProfile(volumes[i]);
                var components = GraphicsMemberList(profile, "components");
                for (var c = 0; c < components.Count; c++)
                {
                    var component = components[c];
                    if (component == null) continue;
                    var row = new Dictionary<string, object>();
                    row["type"] = component.GetType().Name;
                    var active = GraphicsReadMember(component, "active");
                    row["active"] = active == null ? true : ToBoolValue(active);
                    row["volumePath"] = GraphicsScenePathOf(volumes[i]);
                    rows.Add(row);
                }
            }
            return rows;
        }

        static Dictionary<string, object> GraphicsPostProcessing(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "get").ToLowerInvariant();
            if (action != "get" && action != "set")
                throw new KnownError("invalid_argument", "未知 action: " + action + "（get/set）");
            var cameraDataType = GraphicsType("UnityEngine.Rendering.Universal.UniversalAdditionalCameraData");
            if (cameraDataType == null)
                throw new KnownError(
                    "capability_unavailable",
                    "当前工程没有 UniversalAdditionalCameraData（URP 后处理组件）",
                    "hint: 后处理能力仅 URP 支持；Built-in 请用 volume.set 或安装 Post Processing Stack 包");
            GameObject cameraObject;
            var camera = GraphicsResolveCamera(args, out cameraObject);
            var cameraData = cameraObject.GetComponent(cameraDataType);
            if (cameraData == null)
                throw new KnownError(
                    "capability_unavailable",
                    "相机上没有 UniversalAdditionalCameraData",
                    "hint: URP 在创建相机时会自动添加该组件；手动删除过请在相机 Inspector 里 Reset");
            if (action == "get") return GraphicsPostProcessingGet(camera, cameraData);
            return GraphicsPostProcessingSet(args, camera, cameraData);
        }

        static Dictionary<string, object> GraphicsPostProcessingGet(Camera camera, Component cameraData)
        {
            var cameraRow = new Dictionary<string, object>();
            cameraRow["renderPostProcessing"] = GraphicsBoolMember(cameraData, "renderPostProcessing", false);
            var antiAliasing = GraphicsReadMember(cameraData, "antialiasing");
            cameraRow["antiAliasing"] = antiAliasing != null ? antiAliasing.ToString() : null;
            var d = new Dictionary<string, object>();
            d["camera"] = cameraRow;
            d["volumeComponents"] = GraphicsPostProcessVolumeRows();
            return d;
        }

        static void GraphicsApplyPostProcessComponent(string componentTypeName, string parameterName, object raw, List<object> applied, List<object> ignored)
        {
            var matches = GraphicsFindVolumeComponents(componentTypeName);
            if (matches.Count == 0) { ignored.Add(componentTypeName); return; }
            var touched = false;
            for (var i = 0; i < matches.Count; i++)
            {
                var component = matches[i].Key;
                var profileObject = matches[i].Value as UnityEngine.Object;
                if (profileObject != null) Undo.RecordObject(profileObject, "DSH post processing set");
                var single = new List<object>();
                var spec = new Dictionary<string, object>();
                spec["name"] = parameterName;
                spec["value"] = raw;
                single.Add(spec);
                var localApplied = new List<object>();
                var localIgnored = new List<object>();
                GraphicsApplyVolumeParameterArgs(component, single, localApplied, localIgnored);
                if (localApplied.Count > 0) touched = true;
                if (profileObject != null) EditorUtility.SetDirty(profileObject);
            }
            if (touched) applied.Add(componentTypeName);
            else ignored.Add(componentTypeName);
        }

        static void GraphicsApplyPostProcessActive(string componentTypeName, bool active, List<object> applied, List<object> ignored)
        {
            var matches = GraphicsFindVolumeComponents(componentTypeName);
            if (matches.Count == 0) { ignored.Add(componentTypeName); return; }
            var touched = false;
            for (var i = 0; i < matches.Count; i++)
            {
                var component = matches[i].Key;
                var profileObject = matches[i].Value as UnityEngine.Object;
                if (profileObject != null) Undo.RecordObject(profileObject, "DSH post processing set");
                if (GraphicsTryWriteMember(component, "active", active)) touched = true;
                if (profileObject != null) EditorUtility.SetDirty(profileObject);
            }
            if (touched) applied.Add(componentTypeName);
            else ignored.Add(componentTypeName);
        }

        static Dictionary<string, object> GraphicsPostProcessingSet(Dictionary<string, object> args, Camera camera, Component cameraData)
        {
            var cameraDataObject = cameraData as UnityEngine.Object;
            if (cameraDataObject != null) Undo.RecordObject(cameraDataObject, "DSH post processing set");
            var applied = new List<object>();
            var ignored = new List<object>();
            if (args.ContainsKey("enabled"))
            {
                if (GraphicsTryWriteMember(cameraData, "renderPostProcessing", args["enabled"])) applied.Add("renderPostProcessing");
                else ignored.Add("enabled");
            }
            if (args.ContainsKey("antiAliasing"))
            {
                var type = GraphicsMemberType(cameraData, "antialiasing");
                if (type == null || !type.IsEnum) ignored.Add("antiAliasing");
                else
                {
                    try
                    {
                        GraphicsTryWriteMember(cameraData, "antialiasing", args["antiAliasing"]);
                        applied.Add("antiAliasing");
                    }
                    catch (Exception) { ignored.Add("antiAliasing"); }
                }
            }
            if (args.ContainsKey("toneMapping"))
                GraphicsApplyPostProcessComponent("Tonemapping", "mode", args["toneMapping"], applied, ignored);
            if (args.ContainsKey("bloom"))
            {
                if (args["bloom"] is bool) GraphicsApplyPostProcessActive("Bloom", (bool)args["bloom"], applied, ignored);
                else GraphicsApplyPostProcessComponent("Bloom", "intensity", args["bloom"], applied, ignored);
            }
            if (cameraDataObject != null) EditorUtility.SetDirty(cameraDataObject);
            var d = GraphicsPostProcessingGet(camera, cameraData);
            d["applied"] = applied;
            d["ignored"] = ignored;
            return d;
        }

        // ===== unity.graphics.light_probes：LightProbeGroup 位置读写 =====
        static Dictionary<string, object> GraphicsLightProbes(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "list").ToLowerInvariant();
            if (action == "list") return GraphicsLightProbesList(args);
            if (action == "get") return GraphicsLightProbesGet(args);
            if (action == "set") return GraphicsLightProbesSet(args);
            if (action == "create") return GraphicsLightProbesCreate(args);
            throw new KnownError("invalid_argument", "未知 action: " + action + "（list/get/set/create）");
        }

        static Dictionary<string, object> GraphicsLightProbeGroupRow(LightProbeGroup group)
        {
            var row = new Dictionary<string, object>();
            row["handle"] = PutHandle(group);
            row["path"] = GraphicsScenePathOf(group);
            var positions = group != null ? group.probePositions : null;
            row["count"] = (long)(positions != null ? positions.Length : 0);
            return row;
        }

        static Dictionary<string, object> GraphicsLightProbesList(Dictionary<string, object> args)
        {
            var found = UnityEngine.Object.FindObjectsOfType<LightProbeGroup>();
            var rows = new List<object>();
            var truncated = false;
            for (var i = 0; i < found.Length; i++)
            {
                if (rows.Count >= 200) { truncated = true; break; }
                rows.Add(GraphicsLightProbeGroupRow(found[i]));
            }
            var d = new Dictionary<string, object>();
            d["count"] = (long)rows.Count;
            d["truncated"] = truncated;
            d["groups"] = rows;
            d["positions"] = new List<object>();
            return d;
        }

        static LightProbeGroup GraphicsResolveLightProbeGroup(Dictionary<string, object> args)
        {
            if (!args.ContainsKey("target") || args["target"] == null)
                throw new KnownError("invalid_argument", "需要 target（handle/path）");
            var spec = GraphicsTargetSpec(args["target"]);
            var go = ResolveGameObject(spec);
            if (go == null) throw new KnownError("not_found", "target 对应的对象没有 GameObject");
            var group = go.GetComponent<LightProbeGroup>();
            if (group == null) throw new KnownError("not_found", "对象上没有 LightProbeGroup: " + go.name);
            return group;
        }

        static Dictionary<string, object> GraphicsLightProbesGet(Dictionary<string, object> args)
        {
            var group = GraphicsResolveLightProbeGroup(args);
            var positions = new List<object>();
            var source = group.probePositions;
            if (source != null)
            {
                for (var i = 0; i < source.Length; i++) positions.Add(Vector3List(source[i]));
            }
            var groups = new List<object>();
            groups.Add(GraphicsLightProbeGroupRow(group));
            var d = new Dictionary<string, object>();
            d["groups"] = groups;
            d["positions"] = positions;
            d["count"] = (long)positions.Count;
            return d;
        }

        /// <summary>[[x,y,z], ...] 或 [{x,y,z}, ...] 转 Vector3[]。</summary>
        static Vector3[] GraphicsPositions(object raw)
        {
            var list = raw as List<object>;
            if (list == null) throw new KnownError("invalid_argument", "positions 需要数组 [[x,y,z], ...]");
            if (list.Count > 4096) throw new KnownError("invalid_argument", "positions 过多（上限 4096）");
            var result = new Vector3[list.Count];
            for (var i = 0; i < list.Count; i++)
            {
                var value = CoerceValue(list[i], typeof(Vector3));
                if (!(value is Vector3)) throw new KnownError("invalid_argument", "positions[" + i + "] 不是三维坐标");
                result[i] = (Vector3)value;
            }
            return result;
        }

        static Dictionary<string, object> GraphicsLightProbesSet(Dictionary<string, object> args)
        {
            var hasPositions = args.ContainsKey("positions") && args["positions"] != null;
            var hasAdd = args.ContainsKey("addPositions") && args["addPositions"] != null;
            var hasRemove = args.ContainsKey("removeIndex") && args["removeIndex"] != null;
            if (!hasPositions && !hasAdd && !hasRemove)
                throw new KnownError("invalid_argument", "set 需要 positions / addPositions / removeIndex 之一");
            var group = GraphicsResolveLightProbeGroup(args);
            Undo.RecordObject(group, "DSH light probes set");
            Vector3[] result;
            if (hasPositions)
            {
                result = GraphicsPositions(args["positions"]);
            }
            else if (hasAdd)
            {
                var added = GraphicsPositions(args["addPositions"]);
                var current = group.probePositions ?? new Vector3[0];
                result = new Vector3[current.Length + added.Length];
                Array.Copy(current, result, current.Length);
                Array.Copy(added, 0, result, current.Length, added.Length);
            }
            else
            {
                var current = group.probePositions ?? new Vector3[0];
                var removeIndex = (int)ToLong(args, "removeIndex", -1);
                if (removeIndex < 0 || removeIndex >= current.Length)
                    throw new KnownError(
                        "invalid_argument", "removeIndex 越界: " + removeIndex + "（共 " + current.Length + " 个）");
                result = new Vector3[current.Length - 1];
                var cursor = 0;
                for (var i = 0; i < current.Length; i++)
                {
                    if (i == removeIndex) continue;
                    result[cursor] = current[i];
                    cursor += 1;
                }
            }
            if (result.Length > 4096) throw new KnownError("invalid_argument", "positions 过多（上限 4096）");
            group.probePositions = result;
            EditorUtility.SetDirty(group);
            var positions = new List<object>();
            for (var i = 0; i < result.Length; i++) positions.Add(Vector3List(result[i]));
            var groups = new List<object>();
            groups.Add(GraphicsLightProbeGroupRow(group));
            var d = new Dictionary<string, object>();
            d["groups"] = groups;
            d["positions"] = positions;
            d["count"] = (long)result.Length;
            return d;
        }

        static Dictionary<string, object> GraphicsLightProbesCreate(Dictionary<string, object> args)
        {
            var name = GetString(args, "name");
            if (string.IsNullOrEmpty(name)) name = "Light Probe Group";
            var go = new GameObject(name);
            var group = go.AddComponent(typeof(LightProbeGroup)) as LightProbeGroup;
            if (group == null)
            {
                UnityEngine.Object.DestroyImmediate(go);
                throw new KnownError(
                    "capability_unavailable",
                    "无法创建 LightProbeGroup 组件",
                    "hint: 编辑器可能处于编译/导入阻塞状态；稍后重试");
            }
            Undo.RegisterCreatedObjectUndo(go, "DSH create LightProbeGroup");
            if (args.ContainsKey("positions") && args["positions"] != null)
                group.probePositions = GraphicsPositions(args["positions"]);
            EditorUtility.SetDirty(group);
            var positions = new List<object>();
            var source = group.probePositions;
            if (source != null)
            {
                for (var i = 0; i < source.Length; i++) positions.Add(Vector3List(source[i]));
            }
            var groups = new List<object>();
            groups.Add(GraphicsLightProbeGroupRow(group));
            var d = new Dictionary<string, object>();
            d["groups"] = groups;
            d["positions"] = positions;
            d["count"] = (long)positions.Count;
            return d;
        }

        // ===== unity.graphics.reflection_probes：ReflectionProbe 属性读写 =====
        static Dictionary<string, object> GraphicsReflectionProbeRow(ReflectionProbe probe)
        {
            var row = new Dictionary<string, object>();
            row["handle"] = PutHandle(probe);
            row["path"] = GraphicsScenePathOf(probe);
            row["name"] = probe != null ? probe.name : null;
            row["mode"] = probe != null ? probe.mode.ToString() : null;
            row["size"] = probe != null ? Vector3List(probe.size) : new List<object>();
            row["center"] = probe != null ? Vector3List(probe.center) : new List<object>();
            row["resolution"] = probe != null ? (long)probe.resolution : 0L;
            row["hdr"] = probe != null && probe.hdr;
            row["intensity"] = probe != null ? (double)probe.intensity : 0d;
            row["boxProjection"] = probe != null && probe.boxProjection;
            row["clearFlags"] = probe != null ? probe.clearFlags.ToString() : null;
            row["backgroundColor"] = probe != null ? ColorList(probe.backgroundColor) : new List<object>();
            row["cullingMask"] = probe != null ? (long)probe.cullingMask : 0L;
            row["importance"] = probe != null ? (long)probe.importance : 0L;
            return row;
        }

        static ReflectionProbe GraphicsResolveReflectionProbe(Dictionary<string, object> args)
        {
            if (!args.ContainsKey("target") || args["target"] == null)
                throw new KnownError("invalid_argument", "需要 target（handle/path）");
            var spec = GraphicsTargetSpec(args["target"]);
            var handle = GetString(spec, "handle");
            if (!string.IsNullOrEmpty(handle))
            {
                var direct = GetHandle(handle);
                if (direct != null)
                {
                    var probe = direct as ReflectionProbe;
                    if (probe == null) throw new KnownError("invalid_handle", "句柄不是 ReflectionProbe: " + handle);
                    return probe;
                }
            }
            var go = ResolveGameObject(spec);
            if (go == null) throw new KnownError("not_found", "target 对应的对象没有 GameObject");
            var component = go.GetComponent<ReflectionProbe>();
            if (component == null) throw new KnownError("not_found", "对象上没有 ReflectionProbe: " + go.name);
            return component;
        }

        static Dictionary<string, object> GraphicsReflectionProbes(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "list").ToLowerInvariant();
            if (action == "list")
            {
                var found = UnityEngine.Object.FindObjectsOfType<ReflectionProbe>();
                var rows = new List<object>();
                var truncated = false;
                for (var i = 0; i < found.Length; i++)
                {
                    if (rows.Count >= 200) { truncated = true; break; }
                    rows.Add(GraphicsReflectionProbeRow(found[i]));
                }
                var listResult = new Dictionary<string, object>();
                listResult["count"] = (long)rows.Count;
                listResult["truncated"] = truncated;
                listResult["probes"] = rows;
                return listResult;
            }
            if (action == "get")
            {
                var probe = GraphicsResolveReflectionProbe(args);
                var probes = new List<object>();
                probes.Add(GraphicsReflectionProbeRow(probe));
                var d = new Dictionary<string, object>();
                d["probes"] = probes;
                return d;
            }
            if (action == "set")
            {
                var probe = GraphicsResolveReflectionProbe(args);
                var changes = args.ContainsKey("changes") ? args["changes"] as Dictionary<string, object> : null;
                if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes 对象");
                Undo.RecordObject(probe, "DSH reflection probe set");
                var applied = new List<object>();
                var ignored = new List<object>();
                var known = new HashSet<string>(StringComparer.Ordinal)
                {
                    "mode", "size", "center", "resolution", "hdr", "intensity",
                    "boxProjection", "clearFlags", "backgroundColor", "cullingMask", "importance"
                };
                foreach (var key in changes.Keys)
                {
                    if (!known.Contains(key)) { ignored.Add(key); continue; }
                    try
                    {
                        SetMember(probe, typeof(ReflectionProbe), key, changes[key], false);
                        applied.Add(key);
                    }
                    catch (KnownError error)
                    {
                        // 引擎版本差异导致的“成员不存在”按容错处理；类型/枚举错误仍然上抛。
                        if (error.Code == "member_not_found") { ignored.Add(key); continue; }
                        throw;
                    }
                }
                EditorUtility.SetDirty(probe);
                var probes = new List<object>();
                probes.Add(GraphicsReflectionProbeRow(probe));
                var d = new Dictionary<string, object>();
                d["probes"] = probes;
                d["applied"] = applied;
                d["ignored"] = ignored;
                return d;
            }
            throw new KnownError("invalid_argument", "未知 action: " + action + "（list/get/set）");
        }

        // ===== unity.bake.light_probes / unity.bake.reflection_probes =====
        static string GraphicsLightProbeBakeHint()
        {
            return "Unity 没有只烘 LightProbe 的公开 API：start 等价于 Lightmapping.BakeAsync()，"
                + "会烘焙当前场景的全部光照数据（含 LightProbe）；只想要 LightProbe 请在 Lighting 面板手动关闭其它项。";
        }

        static string GraphicsReflectionBakeHint()
        {
            return "ReflectionProbe.RenderProbe() 在 Edit Mode 下可能被引擎忽略；失败项请用 Build（Player）"
                + "或在 Lighting 面板手动 Bake。";
        }

        static string GraphicsLightingDataAssetPath()
        {
            try
            {
                var prop = typeof(Lightmapping).GetProperty("lightingDataAsset", BindingFlags.Public | BindingFlags.Static);
                if (prop == null) return null;
                var asset = prop.GetValue(null, null) as UnityEngine.Object;
                if (asset == null) return null;
                var path = AssetDatabase.GetAssetPath(asset);
                return string.IsNullOrEmpty(path) ? null : path;
            }
            catch (Exception) { return null; }
        }

        static Dictionary<string, object> GraphicsBakeLightProbes(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "status").ToLowerInvariant();
            if (action == "start")
            {
                bool started;
                try { started = Lightmapping.BakeAsync(); }
                catch (Exception error)
                {
                    throw new KnownError("bake_failed", "启动光照烘焙失败: " + error.Message, error.GetType().Name);
                }
                var d = new Dictionary<string, object>();
                d["started"] = started;
                d["isRunning"] = Lightmapping.isRunning;
                d["jobId"] = "bake-light-probes-" + DateTime.UtcNow.Ticks.ToString(CultureInfo.InvariantCulture);
                d["hint"] = GraphicsLightProbeBakeHint();
                return d;
            }
            if (action == "status")
            {
                var isRunning = false;
                try { isRunning = Lightmapping.isRunning; }
                catch (Exception) { }
                var d = new Dictionary<string, object>();
                d["started"] = isRunning;
                d["isRunning"] = isRunning;
                var lightingDataAsset = GraphicsLightingDataAssetPath();
                if (lightingDataAsset != null) d["lightingDataAsset"] = lightingDataAsset;
                d["hint"] = GraphicsLightProbeBakeHint();
                return d;
            }
            if (action == "cancel")
            {
                try { Lightmapping.Cancel(); }
                catch (Exception error)
                {
                    throw new KnownError("bake_cancel_failed", "取消光照烘焙失败: " + error.Message, error.GetType().Name);
                }
                var d = new Dictionary<string, object>();
                d["started"] = false;
                d["isRunning"] = Lightmapping.isRunning;
                d["cancelled"] = true;
                d["hint"] = GraphicsLightProbeBakeHint();
                return d;
            }
            throw new KnownError("invalid_argument", "未知 action: " + action + "（start/status/cancel）");
        }

        /// <summary>
        /// 调用 ReflectionProbe.RenderProbe()（无参重载）。真机签名随版本可能是 bool/void，
        /// 因此用反射调用并只把明确的 false 视为失败。
        /// </summary>
        static bool GraphicsRenderProbe(ReflectionProbe probe)
        {
            if (probe == null) throw new KnownError("invalid_argument", "probe 为空");
            var method = typeof(ReflectionProbe).GetMethod(
                "RenderProbe", BindingFlags.Public | BindingFlags.Instance, null, Type.EmptyTypes, null);
            if (method == null)
                throw new KnownError(
                    "capability_unavailable",
                    "当前引擎的 ReflectionProbe 没有 RenderProbe()",
                    "hint: " + GraphicsReflectionBakeHint());
            var result = method.Invoke(probe, null);
            if (result is bool) return (bool)result;
            return true;
        }

        static void GraphicsBakeOneReflectionProbe(ReflectionProbe probe, List<object> baked, List<object> failed)
        {
            var row = new Dictionary<string, object>();
            row["path"] = GraphicsScenePathOf(probe);
            row["name"] = probe != null ? probe.name : null;
            try
            {
                if (GraphicsRenderProbe(probe)) baked.Add(row);
                else
                {
                    row["reason"] = "RenderProbe 返回 false（Edit Mode 或当前平台不支持）";
                    failed.Add(row);
                }
            }
            catch (KnownError error)
            {
                if (error.Code == "capability_unavailable") throw;
                row["reason"] = error.Message;
                failed.Add(row);
            }
            catch (Exception error)
            {
                row["reason"] = error.Message;
                failed.Add(row);
            }
        }

        static Dictionary<string, object> GraphicsBakeReflectionProbes(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "list").ToLowerInvariant();
            if (action == "list")
            {
                var found = UnityEngine.Object.FindObjectsOfType<ReflectionProbe>();
                var rows = new List<object>();
                var truncated = false;
                for (var i = 0; i < found.Length; i++)
                {
                    if (rows.Count >= 200) { truncated = true; break; }
                    rows.Add(GraphicsReflectionProbeRow(found[i]));
                }
                var d = new Dictionary<string, object>();
                d["count"] = (long)rows.Count;
                d["truncated"] = truncated;
                d["probes"] = rows;
                d["hint"] = GraphicsReflectionBakeHint();
                return d;
            }
            if (action == "bake")
            {
                var baked = new List<object>();
                var failed = new List<object>();
                if (args.ContainsKey("target") && args["target"] != null)
                {
                    GraphicsBakeOneReflectionProbe(GraphicsResolveReflectionProbe(args), baked, failed);
                }
                else
                {
                    var found = UnityEngine.Object.FindObjectsOfType<ReflectionProbe>();
                    for (var i = 0; i < found.Length; i++) GraphicsBakeOneReflectionProbe(found[i], baked, failed);
                }
                var d = new Dictionary<string, object>();
                d["baked"] = baked;
                d["failed"] = failed;
                d["hint"] = GraphicsReflectionBakeHint();
                return d;
            }
            throw new KnownError("invalid_argument", "未知 action: " + action + "（bake/list）");
        }
    }
