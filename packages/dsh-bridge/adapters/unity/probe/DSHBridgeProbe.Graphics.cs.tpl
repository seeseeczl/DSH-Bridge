        // ===== unity.graphics.pipeline：当前渲染管线检测与切换 =====
        static Dictionary<string, object> GraphicsPipeline(Dictionary<string, object> args)
        {
            var action = (GetString(args, "action") ?? "get").ToLowerInvariant();
            if (action == "get") return GraphicsPipelineGet();
            if (action == "set") return GraphicsPipelineSet(args);
            throw new KnownError("invalid_argument", "未知 action: " + action + "（get/set）");
