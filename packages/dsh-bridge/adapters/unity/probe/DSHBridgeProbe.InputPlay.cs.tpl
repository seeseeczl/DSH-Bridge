                        var field = stateType.GetField(names[i], flags);
                        if (field == null) return false;
                        var buttonState = Activator.CreateInstance(field.FieldType);
                        if (!InputPlayTrySetBoolMember(buttonState, "isPressed", ((buttonMask >> i) & 1) != 0)) return false;
                        field.SetValue(state, buttonState);
                    }
                }
                else
                {
                    var buttonsField = stateType.GetField("buttons", flags);
                    if (buttonsField == null) return false;
                    var raw = InputPlayConvertNumber(buttonMask, buttonsField.FieldType);
                    if (raw == null) return false;
                    buttonsField.SetValue(state, raw);
                }
                // clickCount 字段只在按下帧补 1（部分版本用于点击计数）。
                if (buttonMask != 0)
                {
                    var clickCountField = stateType.GetField("clickCount", flags);
                    if (clickCountField != null)
                    {
                        var count = InputPlayConvertNumber(1, clickCountField.FieldType);
                        if (count != null) clickCountField.SetValue(state, count);
                    }
                }
            }
            catch (Exception) { return false; }
            return InputPlayTryQueueStateEvent(backend, mouse, stateType, state);
        }

        /// <summary>探针注入中按下的键（Key 枚举 int 值）；完整状态事件会据此重建按键位图。</summary>
        static readonly HashSet<int> InputPlayHeldKeys = new HashSet<int>();

        static bool InputPlayKeyboardEventPathAvailable(InputPlayBackend backend)
        {
            return backend != null && backend.KeyboardState != null && backend.QueueStateEvent != null
                && backend.KeyboardStateSet != null && backend.Key != null;
        }

        /// <summary>构造完整 KeyboardState 并排队状态事件；失败返回 false（调用方回退控件写入）。</summary>
        static bool InputPlayApplyKeyboardState(InputPlayBackend backend, object keyboard)
        {
            var stateType = backend == null ? null : backend.KeyboardState;
            if (!InputPlayKeyboardEventPathAvailable(backend)) return false;
            object state;
            try { state = Activator.CreateInstance(stateType); }
            catch (Exception) { return false; }
            try
            {
                foreach (var keyValue in InputPlayHeldKeys)
                {
                    backend.KeyboardStateSet.Invoke(state, new[] { Enum.ToObject(backend.Key, keyValue), (object)true });
                }
            }
            catch (Exception) { return false; }
            return InputPlayTryQueueStateEvent(backend, keyboard, stateType, state);
        }

        static string InputPlayDeviceLabel(object device, string fallback)
        {
            var name = InputPlayToStringValue(InputPlayMemberValue(device, "displayName"));
            if (string.IsNullOrEmpty(name)) name = InputPlayToStringValue(InputPlayMemberValue(device, "layout"));
            if (string.IsNullOrEmpty(name)) name = InputPlayToStringValue(InputPlayMemberValue(device, "name"));
            return string.IsNullOrEmpty(name) ? fallback : name;
        }

        static Dictionary<string, object> InputPlayDescribeDevice(object device)
        {
            var describe = new Dictionary<string, object>();
            describe["deviceId"] = InputPlayToLongValue(InputPlayMemberValue(device, "deviceId"));
            describe["layout"] = InputPlayToStringValue(InputPlayMemberValue(device, "layout"));
            describe["displayName"] = InputPlayToStringValue(InputPlayMemberValue(device, "displayName"));
            describe["enabled"] = InputPlayToBoolValue(InputPlayMemberValue(device, "enabled"));
            return describe;
        }

        // ---------------------------------------------------------------
        // 参数解析小工具（全部在探测后端之前执行：参数错优先报 invalid_argument）
        // ---------------------------------------------------------------

        static bool InputPlayTryNumber(object raw, out double value)
        {
            value = 0d;
            if (raw == null) return false;
            if (raw is double) { value = (double)raw; return true; }
            if (raw is float) { value = (float)raw; return true; }
            if (raw is long) { value = (long)raw; return true; }
            if (raw is int) { value = (int)raw; return true; }
            var text = raw as string;
            if (text != null)
                return double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
            try
            {
                value = System.Convert.ToDouble(raw, CultureInfo.InvariantCulture);
                return true;
            }
            catch (Exception) { return false; }
        }

        static long InputPlayReadLong(Dictionary<string, object> args, string key, long fallback, long min, long max, string capability)
        {
            object raw;
            if (args == null || !args.TryGetValue(key, out raw) || raw == null) return fallback;
            double number;
            if (!InputPlayTryNumber(raw, out number) || number != Math.Floor(number))
                throw new KnownError("invalid_argument", capability + " 的 " + key + " 必须是整数");
            var value = (long)number;
            if (value < min || value > max)
                throw new KnownError("invalid_argument",
                    capability + " 的 " + key + " 必须在 " + min + ".." + max + " 之间（实际 " + value + "）");
            return value;
        }

        /// <summary>读 [x, y] 数组（兼容 {x, y} 对象）；present=false 表示未提供。</summary>
        static void InputPlayReadVectorArg(Dictionary<string, object> args, string key, string capability,
            out double x, out double y, out bool present)
        {
            x = 0d;
            y = 0d;
            present = false;
            object raw;
            if (args == null || !args.TryGetValue(key, out raw) || raw == null) return;
            var list = raw as List<object>;
            if (list != null)
            {
                if (list.Count != 2)
                    throw new KnownError("invalid_argument", capability + " 的 " + key + " 必须是 [x, y] 两个数字",
                        "hint: 例如 \"position\": [100, 200]");
                double vx, vy;
                if (!InputPlayTryNumber(list[0], out vx) || !InputPlayTryNumber(list[1], out vy))
                    throw new KnownError("invalid_argument", capability + " 的 " + key + " 含非数字元素");
                if (double.IsNaN(vx) || double.IsInfinity(vx) || double.IsNaN(vy) || double.IsInfinity(vy))
                    throw new KnownError("invalid_argument", capability + " 的 " + key + " 必须是有限数字");
                x = vx;
                y = vy;
                present = true;
                return;
            }
            var dict = raw as Dictionary<string, object>;
            if (dict != null)
            {
                object rawX, rawY;
                if (!dict.TryGetValue("x", out rawX) || !dict.TryGetValue("y", out rawY))
                    throw new KnownError("invalid_argument", capability + " 的 " + key + " 对象需要 x/y 字段");
                double vx, vy;
                if (!InputPlayTryNumber(rawX, out vx) || !InputPlayTryNumber(rawY, out vy))
                    throw new KnownError("invalid_argument", capability + " 的 " + key + " 含非数字元素");
                x = vx;
                y = vy;
                present = true;
                return;
            }
            throw new KnownError("invalid_argument", capability + " 的 " + key + " 必须是 [x, y] 数组或 {x, y} 对象");
        }

        static int InputPlayParseButton(Dictionary<string, object> args)
        {
            var name = (GetString(args, "button") ?? "left").Trim().ToLowerInvariant();
            if (name == "left") return 0;
            if (name == "right") return 1;
            if (name == "middle") return 2;
            throw new KnownError("invalid_argument", "未知 button: " + name + "（left/right/middle）");
        }

        static long InputPlayReadDeviceId(Dictionary<string, object> args)
        {
            return InputPlayReadLong(args, "deviceId", 0L, 0L, long.MaxValue, "unity.input.device");
        }

        // ---------------------------------------------------------------
        // unity.input.mouse
        // ---------------------------------------------------------------

        sealed class InputPlayMousePlan
        {
            public string Action;
            public bool HasPosition;
            public double X;
            public double Y;
            public bool HasDelta;
            public double DeltaX;
            public double DeltaY;
            public int Button;
            public long Steps;
            public long StepDelayMs;
        }

        static InputPlayMousePlan InputPlayParseMouse(Dictionary<string, object> args, string capability)
        {
            var plan = new InputPlayMousePlan();
            var action = (GetString(args, "action") ?? "click").Trim().ToLowerInvariant();
            if (action != "move" && action != "down" && action != "up" && action != "click" && action != "scroll" && action != "drag")
                throw new KnownError("invalid_argument",
                    InputPlayCapabilityPrefix(capability) + " 未知 mouse action: " + action + "（move/down/up/click/scroll/drag）");
            plan.Action = action;
            InputPlayReadVectorArg(args, "position", capability, out plan.X, out plan.Y, out plan.HasPosition);
            InputPlayReadVectorArg(args, "delta", capability, out plan.DeltaX, out plan.DeltaY, out plan.HasDelta);
            plan.Button = InputPlayParseButton(args);
            plan.Steps = InputPlayReadLong(args, "steps", 1L, 1L, InputPlayMaxMouseSteps, capability);
            plan.StepDelayMs = InputPlayReadLong(args, "stepDelayMs", 0L, 0L, InputPlayMaxWaitMs, capability);
            if (action == "move" && !plan.HasPosition && !plan.HasDelta)
                throw new KnownError("invalid_argument", InputPlayCapabilityPrefix(capability) + " move 需要 position 或 delta");
            if (action == "scroll" && !plan.HasDelta)
                throw new KnownError("invalid_argument", InputPlayCapabilityPrefix(capability) + " scroll 需要 delta（滚动量，[x, y]）");
            if (action == "drag" && !plan.HasPosition && !plan.HasDelta)
                throw new KnownError("invalid_argument", InputPlayCapabilityPrefix(capability) + " drag 需要 position（终点）或 delta");
            return plan;
        }

        /// <summary>错误信息里的能力名前缀；capability 为空时退化为域名。</summary>
        static string InputPlayCapabilityPrefix(string capability)
        {
            return string.IsNullOrEmpty(capability) ? "unity.input.mouse" : capability;
        }

        static Dictionary<string, object> InputPlayMouse(Dictionary<string, object> args)
        {
            InputPlayRequirePlayMode();
            var plan = InputPlayParseMouse(args, "unity.input.mouse");
            var backend = InputPlayRequireMouseBackend();
            return InputPlayExecuteMouse(backend, plan);
        }

        static string InputPlayMouseButtonName(int button)
        {
            return button == 0 ? "leftButton" : button == 1 ? "rightButton" : "middleButton";
        }

        /// <summary>
        /// 鼠标注入：优先 InputSystem.QueueStateEvent&lt;MouseState&gt;（官方「像硬件一样」的注入面），
        /// 结构/方法不匹配时回退 InputControl.WriteValueAsObject，并在返回 hint 里标注降级风险。
        /// </summary>
        static Dictionary<string, object> InputPlayExecuteMouse(InputPlayBackend backend, InputPlayMousePlan plan)
        {
            var mouse = InputPlayStaticValue(backend.MouseCurrent);
            if (mouse == null)
                throw new KnownError("capability_unavailable", "未检测到鼠标设备（Mouse.current == null）",
                    InputPlayUnavailableHint("确保输入系统在 Play Mode 下已激活"));
            var hints = new List<string>();
            var eventPath = backend.MouseState != null && backend.QueueStateEvent != null;
            var buttonBit = InputPlayMouseButtonBit(plan.Button);
            var mask = InputPlayReadMouseButtonMask(mouse);
            double deviceX = 0d, deviceY = 0d;
            var hasDevicePosition = InputPlayTryReadVector2(InputPlayMemberValue(mouse, "position"), out deviceX, out deviceY);
            var startX = plan.HasPosition ? plan.X : (hasDevicePosition ? deviceX : 0d);
            var startY = plan.HasPosition ? plan.Y : (hasDevicePosition ? deviceY : 0d);
            var eventApplied = false;

            switch (plan.Action)
            {
                case "move":
                {
                    if (plan.HasPosition && plan.Steps > 1 && hasDevicePosition)
                    {
                        var allApplied = eventPath;
                        for (var i = 1; i <= plan.Steps && allApplied; i++)
                        {
                            var t = (double)i / (double)plan.Steps;
                            allApplied = InputPlayApplyMouseEvent(backend, mouse, mask, true,
                                deviceX + (plan.X - deviceX) * t, deviceY + (plan.Y - deviceY) * t,
                                plan.HasDelta, plan.DeltaX, plan.DeltaY, false, 0d, 0d);
                        }
                        eventApplied = allApplied;
                    }
                    else
                    {
                        eventApplied = eventPath && InputPlayApplyMouseEvent(backend, mouse, mask, true, startX, startY,
                            plan.HasDelta, plan.DeltaX, plan.DeltaY, false, 0d, 0d);
                    }
                    if (!eventApplied)
                    {
                        var positionControl = InputPlayMemberValue(mouse, "position");
                        var deltaControl = InputPlayMemberValue(mouse, "delta");
                        if (plan.HasPosition)
                        {
                            if (plan.Steps > 1 && hasDevicePosition)
                            {
                                for (var i = 1; i <= plan.Steps; i++)
                                {
                                    var t = (double)i / (double)plan.Steps;
                                    InputPlayWriteControl(positionControl,
                                        InputPlayVec2(deviceX + (plan.X - deviceX) * t, deviceY + (plan.Y - deviceY) * t), "position");
                                    InputPlayUpdateSystem(backend);
                                }
                            }
                            else
                            {
                                InputPlayWriteControl(positionControl, InputPlayVec2(plan.X, plan.Y), "position");
                            }
                        }
                        if (plan.HasDelta) InputPlayWriteControl(deltaControl, InputPlayVec2(plan.DeltaX, plan.DeltaY), "delta");
                    }
                    break;
                }
                case "down":
                {
                    eventApplied = eventPath && InputPlayApplyMouseEvent(backend, mouse, mask | buttonBit, true, startX, startY,
                        false, 0d, 0d, false, 0d, 0d);
                    if (!eventApplied)
                    {
                        if (plan.HasPosition)
                            InputPlayWriteControl(InputPlayMemberValue(mouse, "position"), InputPlayVec2(plan.X, plan.Y), "position");
                        InputPlayWriteControl(InputPlayMemberValue(mouse, InputPlayMouseButtonName(plan.Button)), true, "button");
                        InputPlayUpdateSystem(backend);
                    }
                    break;
                }
                case "up":
                {
                    eventApplied = eventPath && InputPlayApplyMouseEvent(backend, mouse, mask & ~buttonBit, true, startX, startY,
                        false, 0d, 0d, false, 0d, 0d);
                    if (!eventApplied)
                    {
                        if (plan.HasPosition)
                            InputPlayWriteControl(InputPlayMemberValue(mouse, "position"), InputPlayVec2(plan.X, plan.Y), "position");
                        InputPlayWriteControl(InputPlayMemberValue(mouse, InputPlayMouseButtonName(plan.Button)), false, "button");
                        InputPlayUpdateSystem(backend);
                    }
                    break;
                }
                case "click":
                {
                    var pressedMask = mask | buttonBit;
                    var releasedMask = mask & ~buttonBit;
                    eventApplied = eventPath
                        && InputPlayApplyMouseEvent(backend, mouse, pressedMask, true, startX, startY, false, 0d, 0d, false, 0d, 0d)
                        && InputPlayApplyMouseEvent(backend, mouse, releasedMask, true, startX, startY, false, 0d, 0d, false, 0d, 0d);
                    if (!eventApplied)
                    {
                        var positionControl = InputPlayMemberValue(mouse, "position");
                        var buttonControl = InputPlayMemberValue(mouse, InputPlayMouseButtonName(plan.Button));
                        if (plan.HasPosition) InputPlayWriteControl(positionControl, InputPlayVec2(plan.X, plan.Y), "position");
                        InputPlayWriteControl(buttonControl, true, "button");
                        InputPlayUpdateSystem(backend);
                        InputPlayWriteControl(buttonControl, false, "button");
                        InputPlayUpdateSystem(backend);
                    }
                    break;
                }
                case "scroll":
                {
                    eventApplied = eventPath && InputPlayApplyMouseEvent(backend, mouse, mask, true, startX, startY,
                        false, 0d, 0d, true, plan.DeltaX, plan.DeltaY);
                    if (!eventApplied)
                    {
                        if (plan.HasPosition)
                            InputPlayWriteControl(InputPlayMemberValue(mouse, "position"), InputPlayVec2(plan.X, plan.Y), "position");
                        InputPlayWriteControl(InputPlayMemberValue(mouse, "scroll"), InputPlayVec2(plan.DeltaX, plan.DeltaY), "scroll");
                        InputPlayUpdateSystem(backend);
                    }
                    break;
                }
                case "drag":
                {
                    double endX, endY;
                    if (plan.HasPosition) { endX = plan.X; endY = plan.Y; }
                    else
                    {
                        endX = startX + plan.DeltaX;
                        endY = startY + plan.DeltaY;
                    }
                    var pressedMask = mask | buttonBit;
                    var releasedMask = mask & ~buttonBit;
                    eventApplied = eventPath
                        && InputPlayApplyMouseEvent(backend, mouse, pressedMask, true, startX, startY, false, 0d, 0d, false, 0d, 0d);
                    if (eventApplied)
                    {
                        if (plan.Steps > 1 && (startX != endX || startY != endY))
                        {
                            for (var i = 1; i <= plan.Steps && eventApplied; i++)
                            {
                                var t = (double)i / (double)plan.Steps;
                                eventApplied = InputPlayApplyMouseEvent(backend, mouse, pressedMask, true,
                                    startX + (endX - startX) * t, startY + (endY - startY) * t,
                                    false, 0d, 0d, false, 0d, 0d);
                            }
                        }
                        else
                        {
                            eventApplied = InputPlayApplyMouseEvent(backend, mouse, pressedMask, true, endX, endY,
                                false, 0d, 0d, false, 0d, 0d);
                        }
                        eventApplied = eventApplied
                            && InputPlayApplyMouseEvent(backend, mouse, releasedMask, true, endX, endY, false, 0d, 0d, false, 0d, 0d);
                    }
                    if (!eventApplied)
                    {
                        var positionControl = InputPlayMemberValue(mouse, "position");
                        var buttonControl = InputPlayMemberValue(mouse, InputPlayMouseButtonName(plan.Button));
                        InputPlayWriteControl(buttonControl, true, "button");
                        InputPlayUpdateSystem(backend);
                        double dragStartX, dragStartY;
                        if (!InputPlayTryReadVector2(positionControl, out dragStartX, out dragStartY)) { dragStartX = endX; dragStartY = endY; }
                        if (plan.Steps > 1 && (dragStartX != endX || dragStartY != endY))
                        {
                            for (var i = 1; i <= plan.Steps; i++)
                            {
                                var t = (double)i / (double)plan.Steps;
                                InputPlayWriteControl(positionControl,
                                    InputPlayVec2(dragStartX + (endX - dragStartX) * t, dragStartY + (endY - dragStartY) * t), "position");
                                InputPlayUpdateSystem(backend);
                            }
                        }
                        else
                        {
                            InputPlayWriteControl(positionControl, InputPlayVec2(endX, endY), "position");
                        }
                        InputPlayUpdateSystem(backend);
                        InputPlayWriteControl(buttonControl, false, "button");
                        InputPlayUpdateSystem(backend);
                    }
                    break;
                }
                default:
                    throw new KnownError("invalid_argument", "未知 mouse action: " + plan.Action);
            }
            if (plan.Action == "move" && plan.HasDelta && plan.Steps > 1)
                hints.Add("steps 只对 position 分段生效，delta 一次性写入");
            if (plan.Action == "move" && plan.HasPosition && plan.Steps > 1 && !hasDevicePosition)
                hints.Add("读取当前鼠标位置失败，steps 分段退化为一次性移动");
            if (!eventApplied)
                hints.Add("QueueStateEvent 注入不可用，已降级为 InputControl.WriteValueAsObject；该降级在部分 Input System 版本可能不触发输入事件");

            var result = new Dictionary<string, object>();
            result["delivered"] = true;
            result["action"] = plan.Action;
            result["device"] = InputPlayDeviceLabel(mouse, "Mouse");
            result["deliveredVia"] = eventApplied ? "state_event" : "control_write";
            if (plan.StepDelayMs > 0)
                hints.Add("stepDelayMs 在同步能力中不会阻塞主线程，已忽略；需要时序请用 unity.input.sequence 的 wait 步骤");
            if (hints.Count > 0) result["hint"] = string.Join("；", hints.ToArray());
            return result;
        }

        // ---------------------------------------------------------------
        // unity.input.keyboard
        // ---------------------------------------------------------------

        sealed class InputPlayKeyboardPlan
        {
            public string Action;
            public List<string> Keys;
            public long HoldMs;
        }

        static InputPlayKeyboardPlan InputPlayParseKeyboard(Dictionary<string, object> args, string capability)
        {
            var plan = new InputPlayKeyboardPlan();
            var action = (GetString(args, "action") ?? "press").Trim().ToLowerInvariant();
            if (action != "down" && action != "up" && action != "press")
                throw new KnownError("invalid_argument",
                    capability + " 的 key action 必须是 down/up/press（实际 " + action + "）");
            plan.Action = action;

            var candidates = new List<string>();
            var primary = GetString(args, "key");
            if (!string.IsNullOrEmpty(primary)) candidates.Add(primary);
            var rawKeys = AsObjectList(args, "keys");
            for (var i = 0; i < rawKeys.Count; i++)
            {
                var text = rawKeys[i] as string;
                if (text == null || text.Trim().Length == 0)
                    throw new KnownError("invalid_argument", capability + " 的 keys[" + i + "] 必须是非空字符串");
                candidates.Add(text);
            }
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var unique = new List<string>();
            for (var i = 0; i < candidates.Count; i++)
            {
                var name = candidates[i].Trim();
                if (seen.Add(name)) unique.Add(name);
            }
            if (unique.Count == 0)
                throw new KnownError("invalid_argument", capability + " 需要 key 或 keys（至少一个键名）");
            if (unique.Count > InputPlayMaxKeys)
                throw new KnownError("invalid_argument", capability + " 单次最多 " + InputPlayMaxKeys + " 个键（实际 " + unique.Count + "）");
            plan.Keys = unique;
            plan.HoldMs = InputPlayReadLong(args, "holdMs", 0L, 0L, InputPlayMaxHoldMs, capability);
            return plan;
        }

        /// <summary>把用户键名规范成 Input System Key 枚举名；无法识别返回 null。</summary>
        static string InputPlayCanonicalKeyName(string raw)
        {
            if (string.IsNullOrEmpty(raw)) return null;
            var name = raw.Trim();
            if (name.Length == 0) return null;
            switch (name.ToLowerInvariant())
            {
                case "arrowup": case "up": case "uparrow": return "UpArrow";
                case "arrowdown": case "down": case "downarrow": return "DownArrow";
                case "arrowleft": case "left": case "leftarrow": return "LeftArrow";
                case "arrowright": case "right": case "rightarrow": return "RightArrow";
                case "enter": case "return": return "Enter";
                case "escape": case "esc": return "Escape";
                case "space": case "spacebar": return "Space";
                case "backspace": return "Backspace";
                case "delete": case "del": return "Delete";
                case "tab": return "Tab";
                case "shift": case "leftshift": return "LeftShift";
                case "rightshift": return "RightShift";
                case "ctrl": case "control": case "leftctrl": return "LeftCtrl";
                case "rightctrl": return "RightCtrl";
                case "alt": case "option": case "leftalt": return "LeftAlt";
                case "rightalt": return "RightAlt";
                case "cmd": case "command": case "meta": case "leftmeta": return "LeftMeta";
                case "rightmeta": return "RightMeta";
                case "capslock": return "CapsLock";
                case "pagedown": return "PageDown";
                case "pageup": return "PageUp";
                case "home": return "Home";
                case "end": return "End";
                case "insert": return "Insert";
                case "contextmenu": return "ContextMenu";
                case "printscreen": return "PrintScreen";
                case "scrolllock": return "ScrollLock";
                case "pause": return "Pause";
                case "numlock": return "NumLock";
            }
            if (name.Length == 1)
            {
                var c = name[0];
                if (c >= 'a' && c <= 'z') return char.ToUpperInvariant(c).ToString();
                if (c >= 'A' && c <= 'Z') return c.ToString();
                if (c >= '0' && c <= '9') return "Digit" + c;
                switch (c)
                {
                    case ' ': return "Space";
                    case '\n': case '\r': return "Enter";
                    case '\t': return "Tab";
                    case ',': return "Comma";
                    case '.': return "Period";
                    case '-': return "Minus";
                    case '=': return "Equals";
                    case '/': return "Slash";
                    case ';': return "Semicolon";
                    case '\'': return "Quote";
                    case '[': return "LeftBracket";
                    case ']': return "RightBracket";
                    case '\\': return "Backslash";
                    case '`': return "Backquote";
                }
            }
            // 多字符串（如 f1 / numpad0）交给 Enum.Parse 大小写不敏感验证。
            return name;
        }

        static object InputPlayKeyboardDevice(InputPlayBackend backend)
        {
            var keyboard = InputPlayStaticValue(backend.KeyboardCurrent);
            if (keyboard == null)
                throw new KnownError("capability_unavailable", "未检测到键盘设备（Keyboard.current == null）",
                    InputPlayUnavailableHint("确保输入系统在 Play Mode 下已激活"));
            return keyboard;
        }

        static object InputPlayKeyboardKeyControl(InputPlayBackend backend, object keyboard, object keyValue, string label)
        {
            if (backend.Key == null)
                throw new KnownError("capability_unavailable", "Input System 缺少 Key 枚举", InputPlayUnavailableHint(null));
            try
            {
                var type = keyboard.GetType();
                var method = type.GetMethod("get_Item", BindingFlags.Public | BindingFlags.Instance, null, new[] { backend.Key }, null);
                if (method != null) return method.Invoke(keyboard, new[] { keyValue });
                var prop = type.GetProperty("Item", BindingFlags.Public | BindingFlags.Instance, null, null, new[] { backend.Key }, null);
                if (prop != null) return prop.GetValue(keyboard, new[] { keyValue });
            }
            catch (Exception) { }
            throw new KnownError("capability_unavailable", "Input System Keyboard 缺少按键索引器（无法定位 " + label + "）",
                InputPlayUnavailableHint("建议升级 Input System 到 1.4+"));
        }

        static Dictionary<string, object> InputPlayKeyboard(Dictionary<string, object> args)
        {
            InputPlayRequirePlayMode();
            var plan = InputPlayParseKeyboard(args, "unity.input.keyboard");
            var backend = InputPlayRequireKeyboardBackend();
            return InputPlayExecuteKeyboard(backend, plan);
        }

        /// <summary>
        /// 键盘注入：优先 QueueStateEvent&lt;KeyboardState&gt;（用 KeyboardState.Set 重建按下位图），
        /// 结构/方法不匹配时回退 InputControl.WriteValueAsObject，并在 hint 里标注降级风险。
        /// </summary>
        static Dictionary<string, object> InputPlayExecuteKeyboard(InputPlayBackend backend, InputPlayKeyboardPlan plan)
        {
            var keyboard = InputPlayKeyboardDevice(backend);
            var keyValues = new List<int>();
            var controls = new List<object>();
            var names = new List<object>();
            for (var i = 0; i < plan.Keys.Count; i++)
            {
                var rawName = plan.Keys[i];
                var canonical = InputPlayCanonicalKeyName(rawName);
                if (canonical == null)
                    throw new KnownError("invalid_argument", "未知按键: " + rawName,
                        "hint: 键名按 Input System Key 枚举，大小写不敏感（如 space / leftShift / arrowUp / a / 1）");
                object keyValue;
                try { keyValue = Enum.Parse(backend.Key, canonical, true); }
                catch (Exception)
                {
                    throw new KnownError("invalid_argument", "未知按键: " + rawName,
                        "hint: Input System Key 枚举中没有 " + canonical);
                }
                var numeric = System.Convert.ToInt32(keyValue, CultureInfo.InvariantCulture);
                if (numeric == 0)
                    throw new KnownError("invalid_argument", "未知按键: " + rawName, "hint: Key.None 不能注入");
                keyValues.Add(numeric);
                controls.Add(InputPlayKeyboardKeyControl(backend, keyboard, keyValue, canonical));
                names.Add(canonical);
            }

            var hints = new List<string>();
            var eventPath = InputPlayKeyboardEventPathAvailable(backend);
            var eventApplied = false;
            if (plan.Action == "down")
            {
                for (var i = 0; i < keyValues.Count; i++) InputPlayHeldKeys.Add(keyValues[i]);
                eventApplied = eventPath && InputPlayApplyKeyboardState(backend, keyboard);
                if (!eventApplied)
                {
                    for (var i = 0; i < controls.Count; i++) InputPlayWriteControl(controls[i], true, "key");
                    InputPlayUpdateSystem(backend);
                }
            }
            else if (plan.Action == "up")
            {
                for (var i = 0; i < keyValues.Count; i++) InputPlayHeldKeys.Remove(keyValues[i]);
                eventApplied = eventPath && InputPlayApplyKeyboardState(backend, keyboard);
                if (!eventApplied)
                {
                    for (var i = 0; i < controls.Count; i++) InputPlayWriteControl(controls[i], false, "key");
                    InputPlayUpdateSystem(backend);
                }
            }
            else
            {
                for (var i = 0; i < keyValues.Count; i++) InputPlayHeldKeys.Add(keyValues[i]);
                var pressed = eventPath && InputPlayApplyKeyboardState(backend, keyboard);
                if (!pressed)
                {
                    for (var i = 0; i < controls.Count; i++) InputPlayWriteControl(controls[i], true, "key");
                    InputPlayUpdateSystem(backend);
                }
                if (plan.HoldMs > 0)
                {
                    Thread.Sleep((int)plan.HoldMs);
                    hints.Add("holdMs 在探针主线程同步等待，可能造成编辑器短暂卡顿；长按建议用 unity.input.sequence");
                }
                for (var i = 0; i < keyValues.Count; i++) InputPlayHeldKeys.Remove(keyValues[i]);
                var released = eventPath && InputPlayApplyKeyboardState(backend, keyboard);
                if (!released)
                {
                    for (var i = 0; i < controls.Count; i++) InputPlayWriteControl(controls[i], false, "key");
                    InputPlayUpdateSystem(backend);
                }
                eventApplied = pressed && released;
            }
            if (!eventApplied)
                hints.Add("QueueStateEvent 注入不可用，已降级为 InputControl.WriteValueAsObject；该降级在部分 Input System 版本可能不触发输入事件");

            var result = new Dictionary<string, object>();
            result["delivered"] = true;
            result["keys"] = names;
            result["deliveredVia"] = eventApplied ? "state_event" : "control_write";
            if (hints.Count > 0) result["hint"] = string.Join("；", hints.ToArray());
            return result;
        }

        // ---------------------------------------------------------------
        // unity.input.type_text
        // ---------------------------------------------------------------

        /// <summary>字符 → Key 枚举名 + 是否需要 Shift。不支持的字符返回 false（调用方计入 unsupported）。</summary>
        static bool InputPlayCharacterToKey(string character, out string keyName, out bool needsShift)
        {
            keyName = null;
            needsShift = false;
            if (string.IsNullOrEmpty(character) || character.Length != 1) return false;
            var c = character[0];
            if (c >= 'a' && c <= 'z') { keyName = char.ToUpperInvariant(c).ToString(); return true; }
            if (c >= 'A' && c <= 'Z') { keyName = c.ToString(); needsShift = true; return true; }
            if (c >= '0' && c <= '9') { keyName = "Digit" + c; return true; }
            switch (c)
            {
                case ' ': keyName = "Space"; return true;
                case '\n': case '\r': keyName = "Enter"; return true;
                case '\t': keyName = "Tab"; return true;
                case ',': keyName = "Comma"; return true;
                case '.': keyName = "Period"; return true;
                case '-': keyName = "Minus"; return true;
                case '=': keyName = "Equals"; return true;
                case '/': keyName = "Slash"; return true;
                case ';': keyName = "Semicolon"; return true;
                case '\'': keyName = "Quote"; return true;
                case '[': keyName = "LeftBracket"; return true;
                case ']': keyName = "RightBracket"; return true;
                case '\\': keyName = "Backslash"; return true;
                case '`': keyName = "Backquote"; return true;
                case '!': keyName = "Digit1"; needsShift = true; return true;
                case '@': keyName = "Digit2"; needsShift = true; return true;
                case '#': keyName = "Digit3"; needsShift = true; return true;
                case '$': keyName = "Digit4"; needsShift = true; return true;
                case '%': keyName = "Digit5"; needsShift = true; return true;
                case '^': keyName = "Digit6"; needsShift = true; return true;
                case '&': keyName = "Digit7"; needsShift = true; return true;
                case '*': keyName = "Digit8"; needsShift = true; return true;
                case '(': keyName = "Digit9"; needsShift = true; return true;
                case ')': keyName = "Digit0"; needsShift = true; return true;
                case '_': keyName = "Minus"; needsShift = true; return true;
                case '+': keyName = "Equals"; needsShift = true; return true;
                case '{': keyName = "LeftBracket"; needsShift = true; return true;
                case '}': keyName = "RightBracket"; needsShift = true; return true;
                case '|': keyName = "Backslash"; needsShift = true; return true;
                case ':': keyName = "Semicolon"; needsShift = true; return true;
                case '"': keyName = "Quote"; needsShift = true; return true;
                case '<': keyName = "Comma"; needsShift = true; return true;
                case '>': keyName = "Period"; needsShift = true; return true;
                case '?': keyName = "Slash"; needsShift = true; return true;
                case '~': keyName = "Backquote"; needsShift = true; return true;
            }
            return false;
        }

        static Dictionary<string, object> InputPlayTypeText(Dictionary<string, object> args)
        {
            InputPlayRequirePlayMode();
            var text = GetString(args, "text");
            if (string.IsNullOrEmpty(text))
                throw new KnownError("invalid_argument", "unity.input.type_text 需要非空 text");
            if (text.Length > InputPlayMaxTextChars)
                throw new KnownError("invalid_argument",
                    "text 超过 " + InputPlayMaxTextChars + " 字符上限（实际 " + text.Length + "）");
            var charDelay = InputPlayReadLong(args, "charDelayMs", 10L, 0L, InputPlayMaxWaitMs, "unity.input.type_text");
            var backend = InputPlayRequireKeyboardBackend();
            return InputPlayExecuteTypeText(backend, text, charDelay);
        }

        static Dictionary<string, object> InputPlayExecuteTypeText(InputPlayBackend backend, string text, long charDelayMs)
        {
            var keyboard = InputPlayKeyboardDevice(backend);
            var delivered = new List<object>();
            var unsupported = new List<object>();
            var seenUnsupported = new HashSet<string>(StringComparer.Ordinal);
            var hints = new List<string>();
            var eventPath = InputPlayKeyboardEventPathAvailable(backend);
            var fallbackUsed = false;
            object shiftControl = null;
            var shiftKeyValue = -1;
            var shiftHeld = false;

            // 逐字符按下-松开：优先 QueueStateEvent<KeyboardState>，失败则回退控件写入。
            // 需要 Shift 的字符（大写字母 / 组合符号）跨字符保持 Shift 按下状态。
            for (var i = 0; i < text.Length; i++)
            {
                string character;
                if (char.IsHighSurrogate(text[i]) && i + 1 < text.Length && char.IsLowSurrogate(text[i + 1]))
                {
                    character = text.Substring(i, 2);
                    i++;
                }
                else
                {
                    character = text[i].ToString();
                }
                string keyName;
                bool needsShift;
                if (!InputPlayCharacterToKey(character, out keyName, out needsShift))
                {
                    if (seenUnsupported.Add(character)) unsupported.Add(character);
                    continue;
                }
                object keyValue;
                try { keyValue = Enum.Parse(backend.Key, keyName, true); }
                catch (Exception)
                {
                    if (seenUnsupported.Add(character)) unsupported.Add(character);
                    continue;
                }
                var keyNumeric = System.Convert.ToInt32(keyValue, CultureInfo.InvariantCulture);
                if (keyNumeric == 0)
                {
                    if (seenUnsupported.Add(character)) unsupported.Add(character);
                    continue;
                }
                object control = null;
                if (needsShift && !shiftHeld)
                {
                    if (shiftControl == null)
                    {
                        var shiftValue = Enum.Parse(backend.Key, "LeftShift", true);
                        shiftKeyValue = System.Convert.ToInt32(shiftValue, CultureInfo.InvariantCulture);
                        shiftControl = InputPlayKeyboardKeyControl(backend, keyboard, shiftValue, "LeftShift");
                    }
                    InputPlayHeldKeys.Add(shiftKeyValue);
                    if (!(eventPath && InputPlayApplyKeyboardState(backend, keyboard)))
                    {
                        InputPlayWriteControl(shiftControl, true, "LeftShift");
                        InputPlayUpdateSystem(backend);
                        fallbackUsed = true;
                    }
                    shiftHeld = true;
                }
                else if (!needsShift && shiftHeld)
                {
                    InputPlayHeldKeys.Remove(shiftKeyValue);
                    if (!(eventPath && InputPlayApplyKeyboardState(backend, keyboard)))
                    {
                        InputPlayWriteControl(shiftControl, false, "LeftShift");
                        InputPlayUpdateSystem(backend);
                        fallbackUsed = true;
                    }
                    shiftHeld = false;
                }
                InputPlayHeldKeys.Add(keyNumeric);
                if (!(eventPath && InputPlayApplyKeyboardState(backend, keyboard)))
                {
                    if (control == null) control = InputPlayKeyboardKeyControl(backend, keyboard, keyValue, keyName);
                    InputPlayWriteControl(control, true, keyName);
                    InputPlayUpdateSystem(backend);
                    fallbackUsed = true;
                }
                InputPlayHeldKeys.Remove(keyNumeric);
                if (!(eventPath && InputPlayApplyKeyboardState(backend, keyboard)))
                {
                    if (control == null) control = InputPlayKeyboardKeyControl(backend, keyboard, keyValue, keyName);
                    InputPlayWriteControl(control, false, keyName);
                    InputPlayUpdateSystem(backend);
                    fallbackUsed = true;
                }
                delivered.Add(character);
            }
            if (shiftHeld)
            {
                InputPlayHeldKeys.Remove(shiftKeyValue);
                if (!(eventPath && InputPlayApplyKeyboardState(backend, keyboard)))
                {
                    InputPlayWriteControl(shiftControl, false, "LeftShift");
                    InputPlayUpdateSystem(backend);
                    fallbackUsed = true;
                }
                shiftHeld = false;
            }

            var result = new Dictionary<string, object>();
            result["delivered"] = (long)delivered.Count;
            result["chars"] = delivered;
            result["unsupported"] = unsupported;
            result["deliveredVia"] = !eventPath || fallbackUsed ? "control_write" : "state_event";
            if (!eventPath || fallbackUsed)
                hints.Add("QueueStateEvent 注入不可用，已降级为 InputControl.WriteValueAsObject；该降级在部分 Input System 版本可能不触发输入事件");
            if (charDelayMs > 0)
                hints.Add("charDelayMs 在同步能力中不会阻塞主线程，已忽略；逐字节奏请用 unity.input.sequence 的 text 步 + wait");
            if (unsupported.Count > 0) hints.Add("不支持的字符未注入，已列入 unsupported");
            if (hints.Count > 0) result["hint"] = string.Join("；", hints.ToArray());
            return result;
        }

        // ---------------------------------------------------------------
        // unity.input.device
        // ---------------------------------------------------------------

        static Dictionary<string, object> InputPlayDevice(Dictionary<string, object> args)
        {
            InputPlayRequirePlayMode();
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action))
                throw new KnownError("invalid_argument", "unity.input.device 需要 action（list/add/remove/controls/set）");
            action = action.Trim().ToLowerInvariant();
            if (action != "list" && action != "add" && action != "remove" && action != "controls" && action != "set")
                throw new KnownError("invalid_argument",
                    "未知 device action: " + action + "（list/add/remove/controls/set）");

            // 参数校验放在探测后端之前：无包时参数错依旧报 invalid_argument。
            if (action == "add")
            {
                var layout = GetString(args, "layout");
                if (string.IsNullOrEmpty(layout))
                    throw new KnownError("invalid_argument", "device add 需要 layout（Input System 布局名，如 Keyboard/Gamepad）");
            }
            else if (action == "remove" || action == "controls" || action == "set")
            {
                var deviceId = InputPlayReadDeviceId(args);
                if (deviceId <= 0 && string.IsNullOrEmpty(GetString(args, "name")))
                    throw new KnownError("invalid_argument", "device " + action + " 需要 deviceId 或 name",
                        "hint: 先用 action=list 查看 devices");
                if (action == "set")
                {
                    if (string.IsNullOrEmpty(GetString(args, "controlPath")))
                        throw new KnownError("invalid_argument", "device set 需要 controlPath（如 \"leftButton\"）");
                    if (!args.ContainsKey("value") || args["value"] == null)
                        throw new KnownError("invalid_argument", "device set 需要非 null 的 value");
                }
            }

            var backend = InputPlayRequireDeviceBackend(action);
            switch (action)
            {
                case "add": return InputPlayDeviceAdd(backend, args);
                case "remove": return InputPlayDeviceRemove(backend, args);
                case "controls": return InputPlayDeviceControls(backend, args);
                case "set": return InputPlayDeviceSet(backend, args);
                default: return InputPlayDeviceList(backend);
            }
        }

        static List<object> InputPlayEnumerateDevices(InputPlayBackend backend, out bool truncated)
        {
            truncated = false;
            var result = new List<object>();
            if (backend.Devices == null)
                throw new KnownError("capability_unavailable", "Input System 缺少 devices 属性",
                    InputPlayUnavailableHint(null));
            object raw = null;
            try { raw = backend.Devices.GetValue(null, null); }
            catch (Exception error)
            {
                throw new KnownError("capability_unavailable", "读取 InputSystem.devices 失败（" + error.Message + "）",
                    InputPlayUnavailableHint(null));
            }
            var enumerable = raw as IEnumerable;
            if (enumerable == null)
                throw new KnownError("capability_unavailable", "InputSystem.devices 不可枚举（版本不兼容）",
                    InputPlayUnavailableHint(null));
            foreach (var device in enumerable)
            {
                if (device == null) continue;
                result.Add(device);
                if (result.Count >= InputPlayMaxDevices) { truncated = true; break; }
            }
            return result;
        }

        static object InputPlayFindDevice(InputPlayBackend backend, Dictionary<string, object> args, out Dictionary<string, object> describe)
        {
            describe = null;
            var deviceId = InputPlayReadDeviceId(args);
            var name = GetString(args, "name");
            bool truncated;
            var devices = InputPlayEnumerateDevices(backend, out truncated);
            for (var i = 0; i < devices.Count; i++)
            {
                var device = devices[i];
                var currentId = InputPlayToLongValue(InputPlayMemberValue(device, "deviceId"));
                if (deviceId > 0 && currentId == deviceId)
                {
                    describe = InputPlayDescribeDevice(device);
                    return device;
                }
                if (!string.IsNullOrEmpty(name))
                {
                    var displayName = InputPlayToStringValue(InputPlayMemberValue(device, "displayName"));
                    var layout = InputPlayToStringValue(InputPlayMemberValue(device, "layout"));
                    if (string.Equals(displayName, name, StringComparison.OrdinalIgnoreCase)
                        || string.Equals(layout, name, StringComparison.OrdinalIgnoreCase))
                    {
                        describe = InputPlayDescribeDevice(device);
                        return device;
                    }
                }
            }
            return null;
        }

        static Dictionary<string, object> InputPlayDeviceList(InputPlayBackend backend)
        {
            bool truncated;
            var devices = InputPlayEnumerateDevices(backend, out truncated);
            var list = new List<object>();
            for (var i = 0; i < devices.Count; i++) list.Add(InputPlayDescribeDevice(devices[i]));
            var result = new Dictionary<string, object>();
            result["devices"] = list;
            result["count"] = (long)list.Count;
            result["truncated"] = truncated;
            return result;
        }

        static Dictionary<string, object> InputPlayDeviceAdd(InputPlayBackend backend, Dictionary<string, object> args)
        {
            var layout = GetString(args, "layout");
            var name = GetString(args, "name");
            var deviceName = string.IsNullOrEmpty(name) ? layout : name;
            object added = null;
            try
            {
                var parameters = backend.AddDevice.GetParameters();
                var payload = parameters.Length >= 2
                    ? new object[] { layout, deviceName }
                    : new object[] { layout };
                added = backend.AddDevice.Invoke(null, payload);
            }
            catch (TargetInvocationException error)
            {
                var inner = error.InnerException ?? error;
                throw new KnownError("invalid_argument", "添加 Input System 设备失败: " + inner.Message,
                    "hint: 检查 layout 是否为已注册的 Input System 布局（如 Keyboard/Gamepad/Mouse）");
            }
            catch (Exception error)
            {
                throw new KnownError("unsupported", "反射调用 InputSystem.AddDevice 失败（" + error.Message + "）",
                    InputPlayUnavailableHint(null));
            }
            if (added == null)
                throw new KnownError("unsupported", "InputSystem.AddDevice 返回 null（layout 可能未知）",
                    "hint: 先用 action=list 查看现有设备，或检查 layout 名称");
            var result = new Dictionary<string, object>();
            result["added"] = InputPlayDescribeDevice(added);
            return result;
        }

        static Dictionary<string, object> InputPlayDeviceRemove(InputPlayBackend backend, Dictionary<string, object> args)
        {
            Dictionary<string, object> describe;
            var device = InputPlayFindDevice(backend, args, out describe);
            if (device == null)
                throw new KnownError("not_found", "找不到要移除的输入设备",
                    "hint: 先用 action=list 查看 deviceId / displayName");
            try { backend.RemoveDevice.Invoke(null, new object[] { device }); }
            catch (TargetInvocationException error)
            {
                var inner = error.InnerException ?? error;
                throw new KnownError("unsupported", "移除设备失败（" + inner.Message + "）",
                    "hint: 设备可能是系统内置设备，无法移除");
            }
            var result = new Dictionary<string, object>();
            result["removed"] = true;
            result["device"] = describe;
            return result;
        }

        static Dictionary<string, object> InputPlayDeviceControls(InputPlayBackend backend, Dictionary<string, object> args)
        {
            Dictionary<string, object> describe;
            var device = InputPlayFindDevice(backend, args, out describe);
            if (device == null)
                throw new KnownError("not_found", "找不到输入设备",
                    "hint: 先用 action=list 查看 deviceId / displayName");
            object raw = InputPlayMemberValue(device, "controls");
            var enumerable = raw as IEnumerable;
            if (enumerable == null)
                throw new KnownError("capability_unavailable", "设备没有可枚举的 controls（版本不兼容）",
                    InputPlayUnavailableHint(null));
            var controls = new List<object>();
            var truncated = false;
            foreach (var control in enumerable)
            {
                if (control == null) continue;
                var row = new Dictionary<string, object>();
                row["name"] = InputPlayToStringValue(InputPlayMemberValue(control, "name"));
                row["path"] = InputPlayToStringValue(InputPlayMemberValue(control, "path"));
                row["layout"] = InputPlayToStringValue(InputPlayMemberValue(control, "layout"));
                row["type"] = control.GetType().Name;
                var valueType = InputPlayMemberValue(control, "valueType") as Type;
                row["valueType"] = valueType != null ? valueType.FullName : null;
                controls.Add(row);
                if (controls.Count >= InputPlayMaxControls) { truncated = true; break; }
            }
            var result = new Dictionary<string, object>();
            result["device"] = describe;
            result["controls"] = controls;
            result["count"] = (long)controls.Count;
            result["truncated"] = truncated;
            return result;
        }

        static object InputPlayDeviceControl(object device, string path)
        {
            try
            {
                var type = device.GetType();
                var indexer = type.GetProperty("Item", BindingFlags.Public | BindingFlags.Instance, null, null,
                    new[] { typeof(string) }, null);
                if (indexer != null) return indexer.GetValue(device, new object[] { path });
                var method = type.GetMethod("get_Item", BindingFlags.Public | BindingFlags.Instance, null,
                    new[] { typeof(string) }, null);
                if (method != null) return method.Invoke(device, new object[] { path });
                var getControl = type.GetMethod("GetControl", BindingFlags.Public | BindingFlags.Instance, null,
                    new[] { typeof(string) }, null);
                if (getControl != null) return getControl.Invoke(device, new object[] { path });
            }
            catch (Exception) { }
            return null;
        }

        static Dictionary<string, object> InputPlayDeviceSet(InputPlayBackend backend, Dictionary<string, object> args)
        {
            Dictionary<string, object> describe;
            var device = InputPlayFindDevice(backend, args, out describe);
            if (device == null)
                throw new KnownError("not_found", "找不到输入设备",
                    "hint: 先用 action=list 查看 deviceId / displayName");
            var path = GetString(args, "controlPath");
            var control = InputPlayDeviceControl(device, path);
            if (control == null)
                throw new KnownError("not_found", "设备上找不到控件: " + path,
                    "hint: 先用 action=controls 查看该设备可用的 controlPath");
            var valueType = InputPlayMemberValue(control, "valueType") as Type;
            if (valueType == null)
                throw new KnownError("unsupported", "控件未暴露 valueType，无法安全换算值: " + path,
                    "hint: 用 action=controls 查看控件类型");
            object coerced;
            try { coerced = CoerceValue(args["value"], valueType); }
            catch (Exception error)
            {
                throw new KnownError("invalid_argument", "value 无法转换为 " + valueType.Name + "（" + error.Message + "）",
                    "hint: 布尔控件传 true/false，轴控件传数字或 [x, y]");
            }
            if (coerced == null)
                throw new KnownError("invalid_argument", "value 无法转换为 " + valueType.Name,
                    "hint: 布尔控件传 true/false，轴控件传数字或 [x, y]");
            InputPlayWriteControl(control, coerced, path);
            InputPlayUpdateSystem(backend);
            var controlInfo = new Dictionary<string, object>();
            controlInfo["name"] = InputPlayToStringValue(InputPlayMemberValue(control, "name"));
            controlInfo["path"] = InputPlayToStringValue(InputPlayMemberValue(control, "path"));
            controlInfo["valueType"] = valueType.FullName;
            var result = new Dictionary<string, object>();
            result["set"] = true;
            result["device"] = describe;
            result["control"] = controlInfo;
            result["value"] = args["value"];
            return result;
        }

        // ---------------------------------------------------------------
        // unity.input.sequence：EditorApplication.update 驱动的异步序列
        // ---------------------------------------------------------------

        sealed class InputPlaySequenceState
        {
            public string SeqId;
            public List<Dictionary<string, object>> Steps = new List<Dictionary<string, object>>();
            public int Index;
            public bool Done;
            public Dictionary<string, object> Error;
            public DateTime WaitUntil;
            public long StepGapMs;
        }

        static Dictionary<string, object> InputPlaySequence(Dictionary<string, object> args)
        {
            InputPlayRequirePlayMode();
            var action = (GetString(args, "action") ?? "run").Trim().ToLowerInvariant();
            if (action == "status") return InputPlaySequenceStatus(args);
            if (action != "run")
                throw new KnownError("invalid_argument", "未知 sequence action: " + action + "（run/status）");
            return InputPlaySequenceRun(args);
        }

        static bool InputPlayValidSeqId(string seqId)
        {
            for (var i = 0; i < seqId.Length; i++)
            {
                var c = seqId[i];
                var ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
                    || c == '.' || c == '_' || c == '-';
                if (!ok) return false;
            }
            return true;
        }

        static Dictionary<string, object> InputPlaySequenceRun(Dictionary<string, object> args)
        {
            var rawSteps = AsObjectList(args, "steps");
            if (rawSteps.Count == 0)
                throw new KnownError("invalid_argument", "sequence 需要非空 steps");
            if (rawSteps.Count > InputPlayMaxSteps)
                throw new KnownError("invalid_argument",
                    "sequence 步数上限 " + InputPlayMaxSteps + "（实际 " + rawSteps.Count + "）");
            var stepGapMs = InputPlayReadLong(args, "waitMs", 0L, 0L, InputPlayMaxWaitMs, "unity.input.sequence");
            var seqId = GetString(args, "seqId");
            if (!string.IsNullOrEmpty(seqId))
            {
                if (seqId.Length > 64 || !InputPlayValidSeqId(seqId))
                    throw new KnownError("invalid_argument", "seqId 只允许 1-64 个 [A-Za-z0-9._-] 字符");
            }

            var steps = new List<Dictionary<string, object>>();
            var needsKeyboard = false;
            var needsMouse = false;
            for (var i = 0; i < rawSteps.Count; i++)
            {
                var raw = rawSteps[i] as Dictionary<string, object>;
                if (raw == null)
                    throw new KnownError("invalid_argument", "steps[" + i + "] 必须是对象");
                var op = (GetString(raw, "op") ?? "").Trim().ToLowerInvariant();
                if (op == "wait")
                {
                    var waitMs = InputPlayReadLong(raw, "waitMs", 0L, 0L, InputPlayMaxWaitMs,
                        "unity.input.sequence steps[" + i + "]");
                    var waitStep = new Dictionary<string, object>();
                    waitStep["op"] = "wait";
                    waitStep["waitMs"] = waitMs;
                    steps.Add(waitStep);
                    continue;
                }
                if (op != "key" && op != "mouse" && op != "text")
                    throw new KnownError("invalid_argument",
                        "steps[" + i + "] 的 op 必须是 key/mouse/text/wait（实际 " + op + "）");
                if (op == "key")
                {
                    needsKeyboard = true;
                    var plan = InputPlayParseKeyboard(raw, "unity.input.sequence steps[" + i + "]");
                    var keyStep = new Dictionary<string, object>();
                    keyStep["op"] = "key";
                    keyStep["action"] = plan.Action;
                    // 序列步骤在内存里保留，tick 时按 JSON 入参形态重新解析：统一用 List<object>。
                    var keyNames = new List<object>();
                    for (var k = 0; k < plan.Keys.Count; k++) keyNames.Add(plan.Keys[k]);
                    keyStep["keys"] = keyNames;
                    keyStep["holdMs"] = plan.HoldMs;
                    steps.Add(keyStep);
                }
                else if (op == "mouse")
                {
                    needsMouse = true;
                    var plan = InputPlayParseMouse(raw, "unity.input.sequence steps[" + i + "]");
                    var mouseStep = new Dictionary<string, object>();
                    mouseStep["op"] = "mouse";
                    mouseStep["action"] = plan.Action;
                    mouseStep["position"] = plan.HasPosition ? (object)new List<object> { plan.X, plan.Y } : null;
                    mouseStep["delta"] = plan.HasDelta ? (object)new List<object> { plan.DeltaX, plan.DeltaY } : null;
                    mouseStep["button"] = plan.Button == 0 ? "left" : plan.Button == 1 ? "right" : "middle";
                    mouseStep["steps"] = plan.Steps;
                    mouseStep["stepDelayMs"] = plan.StepDelayMs;
                    steps.Add(mouseStep);
                }
                else
                {
                    needsKeyboard = true;
                    var text = GetString(raw, "text");
                    if (string.IsNullOrEmpty(text))
                        throw new KnownError("invalid_argument", "steps[" + i + "] 是 text 步但没有非空 text");
                    if (text.Length > InputPlayMaxTextChars)
                        throw new KnownError("invalid_argument",
                            "steps[" + i + "] 的 text 超过 " + InputPlayMaxTextChars + " 字符上限（实际 " + text.Length + "）");
                    var textStep = new Dictionary<string, object>();
                    textStep["op"] = "text";
                    textStep["text"] = text;
                    steps.Add(textStep);
                }
            }

            // 纯 wait 序列不依赖 Input System（可用来验证调度）；其余步骤在 run 时就检查具体后端，
            // 缺包立即 capability_unavailable（不把失败留到异步 tick 里）。
            if (needsKeyboard) InputPlayRequireKeyboardBackend();
            if (needsMouse) InputPlayRequireMouseBackend();

            if (string.IsNullOrEmpty(seqId)) seqId = "seq_" + Guid.NewGuid().ToString("N").Substring(0, 8);
            InputPlayPruneSequences();
            InputPlaySequenceState existing;
            if (InputPlaySequences.TryGetValue(seqId, out existing) && !existing.Done)
                throw new KnownError("invalid_argument", "seqId 正在运行: " + seqId,
                    "hint: 换一个 seqId，或先 action=status 查询进度");

            var sequence = new InputPlaySequenceState();
            sequence.SeqId = seqId;
            sequence.Steps = steps;
            sequence.StepGapMs = stepGapMs;
            sequence.WaitUntil = DateTime.UtcNow;
            InputPlayEnsureSequenceHook();
            InputPlaySequences[seqId] = sequence;

            var result = new Dictionary<string, object>();
            result["accepted"] = true;
            result["seqId"] = seqId;
            result["steps"] = (long)steps.Count;
            result["status"] = InputPlaySequenceStateOf(sequence);
            return result;
        }

        static Dictionary<string, object> InputPlaySequenceStatus(Dictionary<string, object> args)
        {
            var seqId = GetString(args, "seqId");
            if (string.IsNullOrEmpty(seqId))
                throw new KnownError("invalid_argument", "sequence status 需要 seqId");
            InputPlaySequenceState sequence;
            if (!InputPlaySequences.TryGetValue(seqId, out sequence))
                throw new KnownError("sequence_lost", "序列状态已丢失: " + seqId,
                    "hint: 序列只保存在探针内存，域重载/编辑器重启后丢失；请重新 run");
            var result = new Dictionary<string, object>();
            result["accepted"] = true;
            result["seqId"] = sequence.SeqId;
            result["steps"] = (long)sequence.Steps.Count;
            result["status"] = InputPlaySequenceStateOf(sequence);
            return result;
        }

        static Dictionary<string, object> InputPlaySequenceStateOf(InputPlaySequenceState sequence)
        {
            var state = new Dictionary<string, object>();
            state["done"] = sequence.Done;
            state["index"] = (long)sequence.Index;
            state["error"] = sequence.Error;
            return state;
        }

        static void InputPlayPruneSequences()
        {
            if (InputPlaySequences.Count < InputPlayMaxSequences) return;
            var finished = new List<string>();
            foreach (var pair in InputPlaySequences)
            {
                if (pair.Value.Done) finished.Add(pair.Key);
            }
            for (var i = 0; i < finished.Count && InputPlaySequences.Count >= InputPlayMaxSequences; i++)
                InputPlaySequences.Remove(finished[i]);
            if (InputPlaySequences.Count >= InputPlayMaxSequences)
                throw new KnownError("invalid_argument",
                    "内存中保留的序列已达上限 " + InputPlayMaxSequences + "（含运行中序列）",
                    "hint: 等运行中的序列完成，或重启探针域以清空内存序列");
        }

        static void InputPlayEnsureSequenceHook()
        {
            if (InputPlaySequenceHooked) return;
            EditorApplication.update += InputPlaySequenceTick;
            InputPlaySequenceHooked = true;
        }

        /// <summary>EditorApplication.update 回调：每个未完成序列每次 update 最多推进一步。</summary>
        static void InputPlaySequenceTick()
        {
            if (InputPlaySequences.Count == 0) return;
            var ids = new List<string>(InputPlaySequences.Keys);
            for (var i = 0; i < ids.Count; i++)
            {
                InputPlaySequenceState sequence;
                if (!InputPlaySequences.TryGetValue(ids[i], out sequence)) continue;
                if (sequence.Done) continue;
                try { InputPlayAdvanceSequence(sequence); }
                catch (Exception error) { InputPlayFailSequence(sequence, error); }
            }
        }

        static void InputPlayAdvanceSequence(InputPlaySequenceState sequence)
        {
            if (!EditorApplication.isPlaying)
            {
                InputPlayFailSequence(sequence, new KnownError("not_playing", "Play Mode 已退出，序列中止"));
                return;
            }
            if (DateTime.UtcNow < sequence.WaitUntil) return;
            if (sequence.Index >= sequence.Steps.Count)
            {
                sequence.Done = true;
                return;
            }
            var step = sequence.Steps[sequence.Index];
            var op = GetString(step, "op");
            if (op == "wait")
            {
                var waitMs = ToLong(step, "waitMs", 0L);
                sequence.WaitUntil = DateTime.UtcNow.AddMilliseconds(waitMs);
                sequence.Index++;
                return;
            }
            if (op == "key")
            {
                var plan = InputPlayParseKeyboard(step, "unity.input.sequence");
                var backend = InputPlayRequireKeyboardBackend();
                InputPlayExecuteKeyboard(backend, plan);
            }
            else if (op == "mouse")
            {
                var plan = InputPlayParseMouse(step, "unity.input.sequence");
                var backend = InputPlayRequireMouseBackend();
                InputPlayExecuteMouse(backend, plan);
            }
            else if (op == "text")
            {
                var text = GetString(step, "text");
                var backend = InputPlayRequireKeyboardBackend();
                InputPlayExecuteTypeText(backend, text, 0L);
            }
            else
            {
                throw new KnownError("invalid_argument", "未知序列步骤 op: " + op);
            }
            sequence.Index++;
            if (sequence.Index >= sequence.Steps.Count) sequence.Done = true;
            else if (sequence.StepGapMs > 0) sequence.WaitUntil = DateTime.UtcNow.AddMilliseconds(sequence.StepGapMs);
        }

        static void InputPlayFailSequence(InputPlaySequenceState sequence, Exception error)
        {
            var known = error as KnownError;
            var info = new Dictionary<string, object>();
            info["code"] = known != null ? known.Code : error.GetType().Name;
            info["message"] = error.Message;
            sequence.Error = info;
            sequence.Done = true;
        }
    }
}
#endif
