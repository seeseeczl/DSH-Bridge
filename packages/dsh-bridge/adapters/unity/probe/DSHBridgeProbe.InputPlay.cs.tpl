        /// <summary>
        /// 用 InputSystem.QueueStateEvent&lt;TState&gt; 把完整设备状态排进事件队列，然后 InputSystem.Update()。
        /// 官方文档明确这是「像来自硬件一样注入输入」的标准方式；失败返回 false，
        /// 由调用方回退 InputControl.WriteValueAsObject 并在返回里标注降级风险（不静默伪成功）。
        /// </summary>
        static bool InputPlayTryQueueStateEvent(InputPlayBackend backend, object device, Type stateType, object state)
        {
            if (backend == null || backend.QueueStateEvent == null || stateType == null || state == null) return false;
            try
            {
                var method = backend.QueueStateEvent.MakeGenericMethod(stateType);
                var parameters = method.GetParameters();
                object[] payload;
                if (parameters.Length == 3)
                {
                    if (parameters[2].ParameterType == typeof(double)) payload = new object[] { device, state, -1d };
                    else if (parameters[2].ParameterType == typeof(float)) payload = new object[] { device, state, -1f };
                    else return false;
                }
                else if (parameters.Length == 2) payload = new object[] { device, state };
                else return false;
                method.Invoke(null, payload);
                InputPlayUpdateSystem(backend);
                return true;
            }
            catch (Exception) { return false; }
        }

