        {
            var mask = 0;
            if (InputPlayTryReadBool(InputPlayMemberValue(mouse, "leftButton"))) mask |= 1;
            if (InputPlayTryReadBool(InputPlayMemberValue(mouse, "rightButton"))) mask |= 2;
