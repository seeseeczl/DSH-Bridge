        static readonly Regex UiToolkitAttributePattern = new Regex(
            @"([A-Za-z_][A-Za-z0-9_.:-]*)\s*=\s*(?:""([^""]*)""|'([^']*)')",
            RegexOptions.Compiled);
        static readonly Regex UiToolkitCommentPattern = new Regex("<!--.*?-->", RegexOptions.Singleline | RegexOptions.Compiled);

        static Dictionary<string, object> TryUiToolkit(string cap, Dictionary<string, object> args)
        {
            if (cap == "unity.uitk.uxml") return UiToolkitUxml(args);
            if (cap == "unity.uitk.uss") return UiToolkitUss(args);
            if (cap == "unity.uitk.panel_settings") return UiToolkitPanelSettings(args);
            if (cap == "unity.uitk.document") return UiToolkitDocument(args);
            return null;
        }

