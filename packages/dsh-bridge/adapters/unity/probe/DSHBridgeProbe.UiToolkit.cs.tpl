        /// <summary>UXML/USS 的 create / read / write / validate（UXML 另有 query）。</summary>
        static Dictionary<string, object> UiToolkitTextAsset(Dictionary<string, object> args, string extension, bool querySupported)
        {
            var action = UiToolkitRequireAction(args);
            var isUxml = extension == ".uxml";
            if (action == "create" || action == "write")
            {
                var assetPath = UiToolkitAssetPath(args, extension);
                var content = GetString(args, "content");
                var full = ResolveProjectPath(assetPath, "path");
                var exists = File.Exists(full);
                if (action == "create")
                {
                    if (exists)
                        throw new KnownError("already_exists", "目标 " + extension + " 资产已存在；如需覆盖请用 write: " + assetPath);
                    if (content == null) content = isUxml ? UiToolkitDefaultUxml : UiToolkitDefaultUss;
                }
                else
                {
                    if (content == null) throw new KnownError("invalid_argument", "write 需要 content");
                    var expectedSha = GetString(args, "sha256");
                    if (!string.IsNullOrEmpty(expectedSha))
                    {
                        // sha256 是「乐观并发」哨兵：调用方先 read 拿到旧内容哈希，写回时若文件已被别人改过则拒绝覆盖。
                        if (!exists)
                            throw new KnownError("sha_mismatch", "写前置校验失败：目标文件不存在，无法匹配 sha256", "path=" + assetPath);
                        var currentSha = UiToolkitSha256(UiToolkitReadTextFile(full));
                        if (!string.Equals(currentSha, expectedSha.Trim(), StringComparison.OrdinalIgnoreCase))
                            throw new KnownError("sha_mismatch", "写前置校验失败：目标内容已被修改（sha256 不匹配）",
                                "expected=" + expectedSha + " actual=" + currentSha);
                    }
                }
                UiToolkitWriteTextAsset(assetPath, content);
                var imported = UiToolkitImportAsset(assetPath);
                // 写操作纪律：导入若已产出资产对象，补 SetDirty + SaveAssets（离线 stub 加载为 null 时跳过）。
                UiToolkitMarkTextAssetDirty(assetPath, isUxml);
                var created = new Dictionary<string, object>();
                created["path"] = assetPath;
                created["created"] = !exists;
                created["overwritten"] = exists;
                created["sha256"] = UiToolkitSha256(content);
                created["imported"] = imported;
                return created;
            }
            if (action == "read" || action == "validate" || (querySupported && action == "query"))
            {
                var assetPath = UiToolkitAssetPath(args, extension);
                var full = ResolveProjectPath(assetPath, "path");
                if (!File.Exists(full)) throw new KnownError("not_found", "UI Toolkit 资产不存在: " + assetPath);
                var content = UiToolkitReadTextFile(full);
                var sha = UiToolkitSha256(content);
                var expected = GetString(args, "sha256");
                var shaMatches = string.IsNullOrEmpty(expected)
                    || string.Equals(sha, expected.Trim(), StringComparison.OrdinalIgnoreCase);
                if (action == "read")
                {
                    var d = new Dictionary<string, object>();
                    d["path"] = assetPath;
                    d["content"] = content;
                    d["sha256"] = sha;
                    d["size"] = (long)Encoding.UTF8.GetByteCount(content);
                    if (!string.IsNullOrEmpty(expected)) d["sha256Matches"] = shaMatches;
                    return d;
                }
                if (action == "validate")
                {
                    var errors = new List<object>();
                    if (!string.IsNullOrEmpty(expected) && !shaMatches)
                        errors.Add("sha256 不匹配：期望 " + expected + "，实际 " + sha);
                    bool valid;
                    if (isUxml)
                    {
                        // 规格：validate 以资产库能否加载出 VisualTreeAsset 为准。
                        var asset = AssetDatabase.LoadAssetAtPath<VisualTreeAsset>(assetPath);
                        valid = asset != null;
                        if (!valid) errors.Add("AssetDatabase 未能加载 VisualTreeAsset（导入失败、导入时序未就绪或 UXML 语法错误）");
                        if (string.IsNullOrEmpty(UiToolkitStripComments(content).Trim())) errors.Add("UXML 内容为空，没有任何元素");
                    }
                    else
                    {
                        // 规格：validate 以资产库能否加载出 StyleSheet 为准。
                        var asset = AssetDatabase.LoadAssetAtPath<StyleSheet>(assetPath);
                        valid = asset != null;
                        if (!valid) errors.Add("AssetDatabase 未能加载 StyleSheet（导入失败或 USS 语法错误）");
                        if (string.IsNullOrEmpty(UiToolkitStripComments(content).Trim())) errors.Add("USS 内容为空");
                    }
                    var d = new Dictionary<string, object>();
                    d["path"] = assetPath;
                    d["valid"] = valid && shaMatches;
                    d["sha256"] = sha;
                    d["errors"] = errors;
                    return d;
                }
                // query：正则提取元素（不引入 XML 解析库，见规格）。
                var limit = (int)Math.Max(1, Math.Min(UiToolkitQueryLimitMax, ToLong(args, "limit", UiToolkitQueryLimitDefault)));
                bool truncated;
                var elements = UiToolkitParseUxmlElements(content, limit, out truncated);
                var q = new Dictionary<string, object>();
                q["path"] = assetPath;
                q["elements"] = elements;
                q["count"] = (long)elements.Count;
                q["truncated"] = truncated;
                q["sha256"] = sha;
                if (!shaMatches) q["sha256Matches"] = false;
                return q;
            }
            throw new KnownError("invalid_argument",
                "不支持的 action: " + action + "（" + extension + " 支持 create/read/write/validate" + (querySupported ? "/query" : "") + "）");
        }

        static string UiToolkitRequireAction(Dictionary<string, object> args)
        {
            var action = GetString(args, "action");
            if (string.IsNullOrEmpty(action)) throw new KnownError("invalid_argument", "缺少 action");
            return action.Trim().ToLowerInvariant();
        }

        /// <summary>
        /// 工程内 UI Toolkit 资产路径校验：拒绝绝对路径 / `..` / Assets 之外；写操作再走
        /// EnsureWritableAssetPath（禁止改写探针自身源码目录，防止一次安装被提权成任意代码执行）。
        /// </summary>
        static string UiToolkitAssetPath(Dictionary<string, object> args, string extension)
        {
            var raw = GetString(args, "path");
            if (string.IsNullOrEmpty(raw)) throw new KnownError("invalid_argument", "缺少 path");
            return UiToolkitNormalizeAssetPath(raw, extension);
        }

        static string UiToolkitNormalizeAssetPath(string raw, string extension)
        {
            if (string.IsNullOrEmpty(raw)) throw new KnownError("invalid_argument", "缺少 path");
            if (raw.IndexOf('\0') >= 0) throw new KnownError("path_escape", "path 含非法字符");
            var trimmed = raw.Trim();
            var slashed = trimmed.Replace('\\', '/');
            // 绝对路径一律拒绝（POSIX / Windows 盘符 / UNC），即使它恰好落在工程目录内也不受理。
            if (slashed.StartsWith("/", StringComparison.Ordinal)
                || slashed.StartsWith("//", StringComparison.Ordinal)
                || (slashed.Length > 1 && char.IsLetter(slashed[0]) && slashed[1] == ':'))
                throw new KnownError("path_escape", "拒绝绝对路径，只接受工程内相对路径: " + raw);
            try
            {
                if (Path.IsPathRooted(trimmed)) throw new KnownError("path_escape", "拒绝绝对路径，只接受工程内相对路径: " + raw);
            }
            catch (ArgumentException)
            {
                throw new KnownError("path_escape", "path 无法解析: " + raw);
            }
            var segments = slashed.Split('/');
            for (var i = 0; i < segments.Length; i++)
            {
                if (segments[i] == "..") throw new KnownError("path_escape", "拒绝路径穿越（..）: " + raw);
            }
            if (!slashed.StartsWith("Assets/", StringComparison.OrdinalIgnoreCase))
                throw new KnownError("path_escape", "只允许 Assets/ 目录内的 UI Toolkit 资产: " + raw);
            if (!string.IsNullOrEmpty(extension) && !slashed.EndsWith(extension, StringComparison.OrdinalIgnoreCase))
                throw new KnownError("invalid_argument", "路径扩展名必须是 " + extension + ": " + raw);
            // 归一化并校验工程边界；越界在进入文件系统/AssetDatabase 之前就被拒绝。
            var resolved = ResolveAssetPath(slashed, "path");
            if (string.Equals(resolved.TrimEnd('/'), "Assets", StringComparison.OrdinalIgnoreCase))
                throw new KnownError("invalid_argument", "path 必须是位于 Assets/ 下的文件: " + raw);
            if (!resolved.StartsWith("Assets/", StringComparison.Ordinal))
            {
                if (!resolved.StartsWith("Assets/", StringComparison.OrdinalIgnoreCase))
                    throw new KnownError("path_escape", "只允许 Assets/ 目录内的 UI Toolkit 资产: " + raw);
                resolved = "Assets/" + resolved.Substring("Assets/".Length);
            }
            EnsureWritableAssetPath(resolved, "path");
            if (!string.IsNullOrEmpty(extension)) EnsureTextable(ResolveProjectPath(resolved, "path"), "path");
            return resolved;
        }

        static string UiToolkitReadTextFile(string full)
        {
            try
            {
                // 整读入参是工程内文件，但仍给上限，避免异常大的 UXML/USS 把编辑器主线程内存打满。
                var info = new FileInfo(full);
                if (info.Length > 8L * 1024 * 1024)
                    throw new KnownError("invalid_argument", "文件过大（>8MB），拒绝整读: " + full);
                return File.ReadAllText(full, new UTF8Encoding(false));
            }
            catch (KnownError) { throw; }
            catch (Exception e) { throw new KnownError("io_error", "读取失败: " + e.Message); }
        }

        static void UiToolkitWriteTextAsset(string assetPath, string content)
        {
            // 复用 Capabilities 域的写盘 helper：内部会再次做工程边界与探针源码目录校验。
            try { WriteTextAsset(assetPath, content); }
            catch (KnownError) { throw; }
            catch (Exception e) { throw new KnownError("io_error", "写入失败: " + e.Message); }
        }

        /// <summary>导入文本资产；ForceSynchronousImport 让同一帧的 validate 尽早就绪（仍不保证 100% 同步）。</summary>
        static bool UiToolkitImportAsset(string assetPath)
        {
            try
            {
                AssetDatabase.ImportAsset(assetPath, ImportAssetOptions.ForceSynchronousImport);
                return true;
            }
            catch (Exception) { }
            try
            {
                AssetDatabase.ImportAsset(assetPath);
                return true;
            }
            catch (Exception) { return false; }
        }

        /// <summary>写入后若资产已可加载，补 SetDirty + SaveAssets，保持 Unity 的脏标记语义。</summary>
        static void UiToolkitMarkTextAssetDirty(string assetPath, bool isUxml)
        {
            try
            {
                UnityEngine.Object asset = isUxml
                    ? (UnityEngine.Object)AssetDatabase.LoadAssetAtPath<VisualTreeAsset>(assetPath)
                    : (UnityEngine.Object)AssetDatabase.LoadAssetAtPath<StyleSheet>(assetPath);
                if (asset == null) return;
                EditorUtility.SetDirty(asset);
                UiToolkitSaveAssets();
            }
            catch (Exception) { }
        }

        static string UiToolkitSha256(string text)
        {
            using (var sha = System.Security.Cryptography.SHA256.Create())
            {
                var bytes = sha.ComputeHash(Encoding.UTF8.GetBytes(text ?? string.Empty));
                var sb = new StringBuilder(bytes.Length * 2);
                for (var i = 0; i < bytes.Length; i++) sb.Append(bytes[i].ToString("x2", CultureInfo.InvariantCulture));
                return sb.ToString();
            }
        }

        static string UiToolkitStripComments(string content)
        {
            return UiToolkitCommentPattern.Replace(content ?? string.Empty, string.Empty);
        }

        /// <summary>用正则提取 UXML 元素（tag/type/name/class/attributes），limit 截断并回传 truncated。</summary>
        static List<object> UiToolkitParseUxmlElements(string content, int limit, out bool truncated)
        {
            truncated = false;
            var elements = new List<object>();
            var matches = UiToolkitElementPattern.Matches(UiToolkitStripComments(content));
            for (var i = 0; i < matches.Count; i++)
            {
                if (elements.Count >= limit) { truncated = true; break; }
                var match = matches[i];
                var prefix = match.Groups[1].Value;
                var local = match.Groups[2].Value;
                var element = new Dictionary<string, object>();
                element["tag"] = prefix + local;
                element["type"] = local;
                var attributes = new Dictionary<string, object>();
                var attributeMatches = UiToolkitAttributePattern.Matches(match.Groups[3].Value);
                for (var a = 0; a < attributeMatches.Count; a++)
                {
                    var name = attributeMatches[a].Groups[1].Value;
                    var value = attributeMatches[a].Groups[2].Success
                        ? attributeMatches[a].Groups[2].Value
                        : attributeMatches[a].Groups[3].Value;
                    attributes[name] = value;
                }
                if (attributes.ContainsKey("name")) element["name"] = attributes["name"];
                var classes = new List<object>();
                if (attributes.ContainsKey("class"))
                {
                    var parts = Convert.ToString(attributes["class"], CultureInfo.InvariantCulture)
                        .Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
                    for (var c = 0; c < parts.Length; c++) classes.Add(parts[c]);
                }
                element["classes"] = classes;
                if (attributes.Count > 0) element["attributes"] = attributes;
                elements.Add(element);
            }
            return elements;
        }

        // ---------- PanelSettings（反射；按规格不把 UIElements 包类型写进探针签名）----------

        static Type UiToolkitPanelSettingsType()
        {
            var type = FindType("UnityEngine.UIElements.PanelSettings");
            if (type == null) type = Type.GetType("UnityEngine.UIElements.PanelSettings, UnityEngine.UIElementsModule");
            return type;
        }

        static Type UiToolkitRequirePanelSettingsType()
        {
            var type = UiToolkitPanelSettingsType();
            if (type == null)
                throw new KnownError("capability_unavailable",
                    "当前引擎找不到 UnityEngine.UIElements.PanelSettings（UI Toolkit 模块不可用）",
                    "hint: 确认引擎版本 >= 2020 且未裁剪 UIElements 模块");
            return type;
        }

        static Dictionary<string, object> UiToolkitPanelSettings(Dictionary<string, object> args)
        {
            var action = UiToolkitRequireAction(args);
            // 先校验 action：未知 action 必须直接报 invalid_argument，不能先被路径/资产错误掩埋。
            if (action != "list" && action != "get" && action != "create" && action != "set")
                throw new KnownError("invalid_argument", "不支持的 action: " + action + "（panel_settings 支持 list/get/create/set）");
            var type = UiToolkitRequirePanelSettingsType();
            if (action == "list") return UiToolkitPanelSettingsList(type, args);
            if (action == "create")
            {
                var assetPath = UiToolkitAssetPath(args, ".asset");
                if (File.Exists(ResolveProjectPath(assetPath, "path"))
                    || AssetDatabase.LoadAssetAtPath<UnityEngine.Object>(assetPath) != null)
                    throw new KnownError("already_exists", "目标 PanelSettings 资产已存在: " + assetPath);
                var instance = UiToolkitCreateScriptableObject(type);
                var panelObject = instance as UnityEngine.Object;
                if (panelObject == null)
                    throw new KnownError("capability_unavailable", "无法实例化 PanelSettings（类型不是 UnityEngine.Object 或模块不可用）");
                var applied = new List<object>();
                var ignored = new List<object>();
                var changes = UiToolkitChanges(args);
                if (changes != null) UiToolkitApplyPanelChanges(instance, type, changes, applied, ignored);
                var full = ResolveProjectPath(assetPath, "path");
                var folder = Path.GetDirectoryName(full);
                if (!string.IsNullOrEmpty(folder)) UiToolkitEnsureFolder(ToProjectRelative(folder));
                try
                {
                    AssetDatabase.CreateAsset(panelObject, assetPath);
                }
                catch (Exception e)
                {
                    UnityEngine.Object.DestroyImmediate(panelObject);
                    throw new KnownError("io_error", "创建 PanelSettings 失败: " + e.Message);
                }
                EditorUtility.SetDirty(panelObject);
                UiToolkitSaveAssets();
                var d = new Dictionary<string, object>();
                d["path"] = assetPath;
                d["created"] = true;
                d["panel"] = UiToolkitDescribePanel(instance, type, assetPath);
                d["applied"] = applied;
                d["ignored"] = ignored;
                return d;
            }
            // get / set 需要定位已存在资产。
            var panelPath = UiToolkitAssetPath(args, ".asset");
            var loaded = UiToolkitLoadAsset(type, panelPath);
            if (loaded == null)
                throw new KnownError("not_found", "找不到 PanelSettings 资产（未导入或路径无效）: " + panelPath);
            if (action == "get")
            {
                var d = new Dictionary<string, object>();
                d["path"] = panelPath;
                d["panel"] = UiToolkitDescribePanel(loaded, type, panelPath);
                return d;
            }
            if (action == "set")
            {
                var changes = UiToolkitChanges(args);
                if (changes == null) throw new KnownError("invalid_argument", "set 需要 changes");
                var loadedObject = loaded as UnityEngine.Object;
                if (loadedObject == null)
                    throw new KnownError("capability_unavailable", "PanelSettings 不是 UnityEngine.Object，无法写入");
                // 资产写操作纪律：Undo 记录 + SetDirty + SaveAssets。
                Undo.RecordObject(loadedObject, "DSH UI Toolkit PanelSettings");
                var applied = new List<object>();
                var ignored = new List<object>();
                UiToolkitApplyPanelChanges(loaded, type, changes, applied, ignored);
                EditorUtility.SetDirty(loadedObject);
                UiToolkitSaveAssets();
                var d = new Dictionary<string, object>();
                d["path"] = panelPath;
                d["panel"] = UiToolkitDescribePanel(loaded, type, panelPath);
                d["applied"] = applied;
                d["ignored"] = ignored;
                return d;
            }
            throw new KnownError("invalid_argument", "不支持的 action: " + action + "（panel_settings 支持 list/get/create/set）");
        }

        static Dictionary<string, object> UiToolkitPanelSettingsList(Type type, Dictionary<string, object> args)
        {
            var limit = (int)Math.Max(1, Math.Min(UiToolkitListLimitMax, ToLong(args, "limit", UiToolkitListLimitDefault)));
            string[] guids;
            try { guids = AssetDatabase.FindAssets("t:PanelSettings"); }
            catch (Exception e) { throw new KnownError("capability_unavailable", "无法查询 PanelSettings 资产: " + e.Message); }
            var paths = new List<string>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            for (var i = 0; i < guids.Length; i++)
            {
                var path = AssetDatabase.GUIDToAssetPath(guids[i]);
                if (string.IsNullOrEmpty(path) || !seen.Add(path)) continue;
                paths.Add(path);
            }
            paths.Sort(StringComparer.OrdinalIgnoreCase);
            var assets = new List<object>();
            for (var i = 0; i < paths.Count && assets.Count < limit; i++)
            {
                var assetPath = paths[i];
                var asset = UiToolkitLoadAsset(type, assetPath);
                var row = new Dictionary<string, object>();
                row["path"] = assetPath;
                var uo = asset as UnityEngine.Object;
                if (uo == null)
                {
                    // 离线 stub 或导入未就绪：只回路径，不编造字段。
                    row["loaded"] = false;
                }
                else
                {
                    row["loaded"] = true;
                    row["name"] = uo.name;
                }
                assets.Add(row);
            }
            var d = new Dictionary<string, object>();
            d["assets"] = assets;
            d["count"] = (long)assets.Count;
            d["total"] = (long)paths.Count;
            d["truncated"] = paths.Count > assets.Count;
            d["type"] = type.FullName;
            return d;
        }

        /// <summary>反射调用 AssetDatabase.LoadAssetAtPath&lt;T&gt;：避免把 UIElements 包类型写进探针签名。</summary>
        static object UiToolkitLoadAsset(Type assetType, string assetPath)
        {
            if (assetType == null || string.IsNullOrEmpty(assetPath)) return null;
            var methods = typeof(AssetDatabase).GetMethods(BindingFlags.Public | BindingFlags.Static);
            for (var i = 0; i < methods.Length; i++)
            {
                var method = methods[i];
                if (method.Name != "LoadAssetAtPath" || !method.IsGenericMethodDefinition) continue;
                var parameters = method.GetParameters();
                if (parameters.Length != 1 || parameters[0].ParameterType != typeof(string)) continue;
                try { return method.MakeGenericMethod(assetType).Invoke(null, new object[] { assetPath }); }
                catch (Exception) { return null; }
            }
            return null;
        }

        /// <summary>
        /// 反射创建 ScriptableObject。真实 Unity 走 ScriptableObject.CreateInstance(Type)；
        /// 离线 stub 没有该方法时退回 Activator（仅离线语义测试会走到，真机永远走第一条路径）。
        /// </summary>
        static object UiToolkitCreateScriptableObject(Type type)
        {
            try
            {
                var create = typeof(ScriptableObject).GetMethod(
                    "CreateInstance",
                    BindingFlags.Public | BindingFlags.Static,
                    null,
                    new[] { typeof(Type) },
                    null);
                if (create != null)
                {
                    var created = create.Invoke(null, new object[] { type });
                    if (created != null) return created;
                }
            }
            catch (Exception) { }
            try { return Activator.CreateInstance(type); }
            catch (Exception) { return null; }
        }

        static Dictionary<string, object> UiToolkitChanges(Dictionary<string, object> args)
        {
            if (args == null || !args.ContainsKey("changes") || args["changes"] == null) return null;
            var changes = args["changes"] as Dictionary<string, object>;
            if (changes == null) throw new KnownError("invalid_argument", "changes 必须是对象");
            return changes;
        }

        static void UiToolkitApplyPanelChanges(object panel, Type type, Dictionary<string, object> changes,
            List<object> applied, List<object> ignored)
        {
            foreach (var kv in changes)
            {
                var key = kv.Key;
                if (string.IsNullOrEmpty(key)) continue;
                try
                {
                    if (UiToolkitSetUiMember(panel, type, key, kv.Value)) applied.Add(key);
                    else ignored.Add(key); // 版本差异：成员不存在 → ignored，不报错也不编造
                }
                catch (KnownError) { throw; }
                catch (Exception) { ignored.Add(key); }
            }
        }

        /// <summary>按成员名反射写值；成员不存在返回 false（调用方记为 ignored）。</summary>
        static bool UiToolkitSetUiMember(object target, Type type, string member, object raw)
        {
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.FlattenHierarchy;
            var property = type.GetProperty(member, flags);
            var field = property == null ? type.GetField(member, flags) : null;
            if (property == null && field == null) return false;
            if (property != null && !property.CanWrite) return false;
            var memberType = property != null ? property.PropertyType : field.FieldType;
            object value;
            if (!UiToolkitTryCoerceUiValue(raw, memberType, member, out value))
                throw new KnownError("invalid_argument", "changes." + member + " 的值无法转换为 " + memberType.Name);
            if (property != null) property.SetValue(target, value, null);
            else field.SetValue(target, value);
            return true;
        }

        /// <summary>把 JSON 入参强制转换成 UIElements 成员类型（枚举 / Vector2Int / 资产引用 / 标量）。</summary>
        static bool UiToolkitTryCoerceUiValue(object raw, Type memberType, string member, out object value)
        {
            value = null;
            if (memberType == null) return false;
            if (raw == null)
            {
                value = memberType.IsValueType ? Activator.CreateInstance(memberType) : null;
                return true;
            }
            if (memberType.IsInstanceOfType(raw)) { value = raw; return true; }
            if (memberType.IsEnum)
            {
                // 只接受枚举名（大小写不敏感）或数字；非法名字明确报错，避免静默写成默认值。
                var text = raw as string ?? Convert.ToString(raw, CultureInfo.InvariantCulture);
                if (string.IsNullOrEmpty(text)) return false;
                var names = Enum.GetNames(memberType);
                for (var i = 0; i < names.Length; i++)
                {
                    if (!string.Equals(names[i], text, StringComparison.OrdinalIgnoreCase)) continue;
                    value = Enum.Parse(memberType, names[i], true);
                    return true;
                }
                long numeric;
                if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out numeric))
                {
                    value = Enum.ToObject(memberType, numeric);
                    return true;
                }
                return false;
            }
            if (memberType.FullName == "UnityEngine.Vector2Int")
            {
                int x;
                int y;
                if (!UiToolkitTryReadXy(raw, out x, out y)) return false;
                try { value = Activator.CreateInstance(memberType, new object[] { x, y }); }
                catch (Exception)
                {
                    // 兜底：构造签名不一致时先建默认实例再写 x/y。
                    value = Activator.CreateInstance(memberType);
                    UiToolkitSetUiMember(value, memberType, "x", x);
                    UiToolkitSetUiMember(value, memberType, "y", y);
                }
                return true;
            }
            if (typeof(UnityEngine.Object).IsAssignableFrom(memberType))
            {
                // 资产引用：接受字符串路径，或 { asset } / { path } 对象。
                var assetPath = UiToolkitAssetPathFromRaw(raw);
                if (string.IsNullOrEmpty(assetPath)) return false;
                var resolved = UiToolkitNormalizeAssetPath(assetPath, null);
                var loaded = UiToolkitLoadAsset(memberType, resolved);
                if (loaded == null) throw new KnownError("not_found", "找不到资产: " + resolved);
                value = loaded;
                return true;
            }
            if (memberType == typeof(string) || memberType == typeof(bool)
                || memberType == typeof(int) || memberType == typeof(long) || memberType == typeof(short)
                || memberType == typeof(float) || memberType == typeof(double) || memberType == typeof(decimal))
            {
                try { value = Coerce(raw, memberType); return true; }
                catch (Exception) { return false; }
            }
            return false;
        }

        static bool UiToolkitTryReadXy(object raw, out int x, out int y)
        {
            x = 0;
            y = 0;
            if (raw == null) return false;
            var dict = raw as Dictionary<string, object>;
            if (dict != null)
            {
                if (!dict.ContainsKey("x") || !dict.ContainsKey("y")) return false;
                try
                {
                    x = (int)Convert.ToInt64(dict["x"], CultureInfo.InvariantCulture);
                    y = (int)Convert.ToInt64(dict["y"], CultureInfo.InvariantCulture);
                    return true;
                }
                catch (Exception) { return false; }
            }
            var list = raw as List<object>;
            if (list != null && list.Count >= 2)
            {
                try
                {
                    x = (int)Convert.ToInt64(list[0], CultureInfo.InvariantCulture);
                    y = (int)Convert.ToInt64(list[1], CultureInfo.InvariantCulture);
                    return true;
                }
                catch (Exception) { return false; }
            }
            var text = raw as string;
            if (!string.IsNullOrEmpty(text))
            {
                var parts = text.ToLowerInvariant().Split('x');
                if (parts.Length == 2
                    && int.TryParse(parts[0].Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out x)
                    && int.TryParse(parts[1].Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out y))
                    return true;
            }
            var valueType = raw.GetType();
            if (valueType.FullName == "UnityEngine.Vector2Int")
            {
                object vx;
                object vy;
                if (!UiToolkitTryReadMember(raw, valueType, "x", out vx)) return false;
                if (!UiToolkitTryReadMember(raw, valueType, "y", out vy)) return false;
                try
                {
                    x = (int)Convert.ToInt64(vx, CultureInfo.InvariantCulture);
                    y = (int)Convert.ToInt64(vy, CultureInfo.InvariantCulture);
                    return true;
                }
                catch (Exception) { return false; }
            }
            return false;
        }

        static string UiToolkitAssetPathFromRaw(object raw)
        {
            var text = raw as string;
            if (!string.IsNullOrEmpty(text)) return text;
            var dict = raw as Dictionary<string, object>;
            if (dict == null) return null;
            var asset = GetString(dict, "asset");
            if (!string.IsNullOrEmpty(asset)) return asset;
            return GetString(dict, "path");
        }

        static Dictionary<string, object> UiToolkitDescribePanel(object panel, Type type, string assetPath)
        {
            var d = new Dictionary<string, object>();
            d["path"] = assetPath;
            var uo = panel as UnityEngine.Object;
            if (uo != null && !string.IsNullOrEmpty(uo.name)) d["name"] = uo.name;
            // 版本差异：取不到的字段直接省略（规格要求，不编造）。
            var keys = new[] { "themeStyleSheet", "referenceResolution", "scaleMode", "screenMatchMode", "match", "sortOrder", "targetTexture" };
            for (var i = 0; i < keys.Length; i++)
            {
                object value;
                if (!UiToolkitTryReadMember(panel, type, keys[i], out value)) continue;
                var described = UiToolkitDescribeUiValue(value);
                if (described != null) d[keys[i]] = described;
            }
            return d;
        }

        static bool UiToolkitTryReadMember(object target, Type type, string member, out object value)
        {
            value = null;
            if (target == null || type == null || string.IsNullOrEmpty(member)) return false;
            var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.FlattenHierarchy;
            try
            {
                var property = type.GetProperty(member, flags);
                if (property != null && property.CanRead)
                {
                    value = property.GetValue(target, null);
                    return true;
                }
                var field = type.GetField(member, flags);
                if (field != null)
                {
                    value = field.GetValue(target);
                    return true;
                }
            }
            catch (Exception) { }
            return false;
        }

        static object UiToolkitDescribeUiValue(object value)
        {
            if (value == null) return null;
            var uo = value as UnityEngine.Object;
            if (uo != null)
            {
                var asset = new Dictionary<string, object>();
                asset["name"] = uo.name;
                asset["path"] = AssetDatabase.GetAssetPath(uo);
                asset["type"] = uo.GetType().Name;
                return asset;
            }
            if (value is string || value is bool || value is int || value is long || value is short) return value;
            if (value is float) return (double)(float)value;
            if (value is double) return value;
            var valueType = value.GetType();
            if (valueType.IsEnum) return value.ToString();
            if (valueType.FullName == "UnityEngine.Vector2Int")
            {
                int x;
                int y;
                UiToolkitTryReadXy(value, out x, out y);
                var xy = new Dictionary<string, object>();
                xy["x"] = (long)x;
                xy["y"] = (long)y;
                return xy;
            }
            return Convert.ToString(value, CultureInfo.InvariantCulture);
        }

        /// <summary>确保资产目录存在；不同版本 CreateFolder 的可见性有差异，失败留给 CreateAsset 暴露。</summary>
        static void UiToolkitEnsureFolder(string folder)
        {
            if (string.IsNullOrEmpty(folder) || folder == "Assets" || AssetDatabase.IsValidFolder(folder)) return;
            var parts = folder.Split('/');
            var current = parts[0];
            for (var i = 1; i < parts.Length; i++)
            {
                if (string.IsNullOrEmpty(parts[i])) continue;
                var next = current + "/" + parts[i];
                if (!AssetDatabase.IsValidFolder(next))
                {
                    try { AssetDatabase.CreateFolder(current, parts[i]); }
                    catch (Exception) { return; }
                }
                current = next;
            }
        }

        /// <summary>SaveAssets 在部分版本/离线 stub 中缺失：反射调用，缺失时静默跳过（CreateAsset/SetDirty 已生效）。</summary>
        static void UiToolkitSaveAssets()
        {
            try
            {
                var method = typeof(AssetDatabase).GetMethod(
                    "SaveAssets",
                    BindingFlags.Public | BindingFlags.Static,
                    null,
                    Type.EmptyTypes,
                    null);
                if (method != null) method.Invoke(null, null);
            }
            catch (Exception) { }
        }

        // ---------- UIDocument（2022.3 内置，直接引用；视觉树遍历用反射）----------

        static Dictionary<string, object> UiToolkitDocument(Dictionary<string, object> args)
        {
            var action = UiToolkitRequireAction(args);
            // 先校验 action：未知 action 不应先被 target 解析错误掩埋。
            if (action != "list" && action != "get" && action != "create" && action != "set" && action != "tree")
                throw new KnownError("invalid_argument", "不支持的 action: " + action + "（document 支持 list/get/create/set/tree）");
            if (action == "list") return UiToolkitDocumentList(args);
            var gameObject = UiToolkitDocumentTarget(args);
            if (action == "get")
            {
                var document = UiToolkitRequireDocument(gameObject);
                var description = UiToolkitDescribeDocument(document);
                var d = new Dictionary<string, object>();
                d["document"] = description;
                d["documents"] = new List<object> { description };
                d["count"] = 1L;
                return d;
            }
            if (action == "tree") return UiToolkitDocumentTree(UiToolkitRequireDocument(gameObject), args);
            if (action == "create")
            {
                if (gameObject.GetComponent<UIDocument>() != null)
                    throw new KnownError("already_exists", "目标对象上已有 UIDocument 组件: " + gameObject.name);
                var added = gameObject.AddComponent(typeof(UIDocument)) as UIDocument;
                if (added == null)
                    throw new KnownError("unsupported", "当前环境无法添加 UIDocument 组件（离线 stub 或引擎缺少 UI Toolkit 运行时）");
                Undo.RegisterCreatedObjectUndo(added, "DSH UI Toolkit UIDocument");
                var applied = new List<object>();
                var ignored = new List<object>();
                UiToolkitApplyDocumentChanges(added, args, applied, ignored);
                EditorUtility.SetDirty(added);
                var d = new Dictionary<string, object>();
                d["created"] = true;
                d["document"] = UiToolkitDescribeDocument(added);
                d["applied"] = applied;
                d["ignored"] = ignored;
                return d;
            }
            if (action == "set")
            {
                var document = UiToolkitRequireDocument(gameObject);
                Undo.RecordObject(document, "DSH UI Toolkit UIDocument");
                var applied = new List<object>();
                var ignored = new List<object>();
                UiToolkitApplyDocumentChanges(document, args, applied, ignored);
                EditorUtility.SetDirty(document);
                var d = new Dictionary<string, object>();
                d["document"] = UiToolkitDescribeDocument(document);
                d["applied"] = applied;
                d["ignored"] = ignored;
                return d;
            }
            throw new KnownError("invalid_argument", "不支持的 action: " + action + "（document 支持 list/get/create/set/tree）");
        }

        static Dictionary<string, object> UiToolkitDocumentList(Dictionary<string, object> args)
        {
            var limit = (int)Math.Max(1, Math.Min(UiToolkitListLimitMax, ToLong(args, "limit", UiToolkitListLimitDefault)));
            var documents = new List<object>();
            long total = 0;
            // 场景根遍历（含 inactive）：FindObjectsOfType 会漏掉未激活对象上的 UIDocument。
            var sceneObjects = AllSceneObjects(true);
            for (var i = 0; i < sceneObjects.Count; i++)
            {
                UIDocument[] components;
                try { components = sceneObjects[i].GetComponents<UIDocument>(); }
                catch (Exception) { continue; }
                if (components == null) continue;
                for (var c = 0; c < components.Length; c++)
                {
                    if (components[c] == null) continue;
                    total++;
                    if (documents.Count < limit) documents.Add(UiToolkitDescribeDocument(components[c]));
                }
            }
            var d = new Dictionary<string, object>();
            d["documents"] = documents;
            d["count"] = (long)documents.Count;
            d["total"] = total;
            d["truncated"] = total > (long)documents.Count;
            return d;
        }

        /// <summary>target 支持 {handle}/{path} 对象、handle 字符串或场景路径；也兼容顶层 path。</summary>
        static GameObject UiToolkitDocumentTarget(Dictionary<string, object> args)
        {
            object rawTarget;
            if (args != null && args.TryGetValue("target", out rawTarget) && rawTarget is Dictionary<string, object>)
                return UiToolkitRequireGameObject(args, "target");
            var handle = GetString(args, "target");
            if (!string.IsNullOrEmpty(handle))
            {
                var obj = GetHandle(handle);
                var go = obj as GameObject;
                if (go != null) return go;
                var component = obj as Component;
                if (component != null && component.gameObject != null) return component.gameObject;
                throw new KnownError("not_found", "句柄不是场景对象: " + handle);
            }
            var path = GetString(args, "path");
            if (!string.IsNullOrEmpty(path))
            {
                var transform = FindTransformByPath(path);
                if (transform == null) throw new KnownError("not_found", "场景内找不到对象: " + path);
                return transform.gameObject;
            }
            throw new KnownError("invalid_argument", "需要 target（handle 或场景路径）或 path");
        }

        /// <summary>复用 Scene 域的 ResolveGameObject，但把既有错误码收敛到规格的 not_found。</summary>
        static GameObject UiToolkitRequireGameObject(Dictionary<string, object> args, string key)
        {
            try { return ResolveGameObject(args, key); }
            catch (KnownError e)
            {
                if (e.Code == "object_not_found" || e.Code == "invalid_handle" || e.Code == "handle_not_found")
                    throw new KnownError("not_found", e.Message, e.Detail);
                throw;
            }
        }

        static UIDocument UiToolkitRequireDocument(GameObject gameObject)
        {
            if (gameObject == null) throw new KnownError("not_found", "目标对象不存在");
            UIDocument document;
            try { document = gameObject.GetComponent<UIDocument>(); }
            catch (Exception e) { throw new KnownError("not_found", "读取 UIDocument 组件失败: " + e.Message); }
            if (document == null) throw new KnownError("not_found", "对象上没有 UIDocument 组件: " + gameObject.name);
            return document;
        }

        static Dictionary<string, object> UiToolkitDescribeDocument(UIDocument document)
        {
            var d = new Dictionary<string, object>();
            d["handle"] = PutHandle(document);
            try { d["name"] = document.name; }
            catch (Exception) { }
            try
            {
                var transform = document.transform;
                if (transform != null) d["path"] = ScenePathOf(transform);
            }
            catch (Exception) { }
            try { d["enabled"] = document.enabled; }
            catch (Exception) { }
            var type = typeof(UIDocument);
            object panel;
            if (UiToolkitTryReadMember(document, type, "panelSettings", out panel))
                d["panelSettings"] = UiToolkitDescribeUiValue(panel);
            object source;
            // 参数名用规格里的 sourceAsset；底层属性是 visualTreeAsset（2022.3），旧版本回退 sourceAsset。
            if (UiToolkitTryReadMember(document, type, "visualTreeAsset", out source)
                || UiToolkitTryReadMember(document, type, "sourceAsset", out source))
                d["sourceAsset"] = UiToolkitDescribeUiValue(source);
            object sortingOrder;
            if (UiToolkitTryReadMember(document, type, "sortingOrder", out sortingOrder))
                d["sortingOrder"] = UiToolkitDescribeUiValue(sortingOrder);
            return d;
        }

        static void UiToolkitApplyDocumentChanges(UIDocument document, Dictionary<string, object> args,
            List<object> applied, List<object> ignored)
        {
            var type = typeof(UIDocument);
            var panelPath = GetString(args, "panelSettings");
            if (!string.IsNullOrEmpty(panelPath))
            {
                var panelType = UiToolkitRequirePanelSettingsType();
                var resolved = UiToolkitNormalizeAssetPath(panelPath, ".asset");
                var panel = UiToolkitLoadAsset(panelType, resolved);
                if (panel == null) throw new KnownError("not_found", "找不到 PanelSettings: " + resolved);
                UiToolkitSetDocumentMember(document, type, "panelSettings", panel, "panelSettings", applied, ignored);
            }
            var sourcePath = GetString(args, "sourceAsset");
            if (!string.IsNullOrEmpty(sourcePath))
            {
                var resolved = UiToolkitNormalizeAssetPath(sourcePath, ".uxml");
                var source = AssetDatabase.LoadAssetAtPath<VisualTreeAsset>(resolved);
                if (source == null) throw new KnownError("not_found", "找不到 UXML 源资产: " + resolved);
                UiToolkitSetDocumentMember(document, type, "visualTreeAsset", source, "sourceAsset", applied, ignored);
            }
            if (args.ContainsKey("sortingOrder") && args["sortingOrder"] != null)
            {
                var property = type.GetProperty("sortingOrder", BindingFlags.Public | BindingFlags.Instance);
                if (property == null || !property.CanWrite) { ignored.Add("sortingOrder"); return; }
                object value;
                if (!UiToolkitTryCoerceUiValue(args["sortingOrder"], property.PropertyType, "sortingOrder", out value))
                    throw new KnownError("invalid_argument", "sortingOrder 必须是数值");
                property.SetValue(document, value, null);
                applied.Add("sortingOrder");
            }
        }

        static void UiToolkitSetDocumentMember(UIDocument document, Type type, string member, object value,
            string label, List<object> applied, List<object> ignored)
        {
            object existing;
            if (!UiToolkitTryReadMember(document, type, member, out existing))
            {
                ignored.Add(label); // 版本差异：属性不存在
                return;
            }
            try
            {
                UiToolkitSetUiMember(document, type, member, value);
                applied.Add(label);
            }
            catch (KnownError) { throw; }
            catch (Exception) { ignored.Add(label); }
        }

        static Dictionary<string, object> UiToolkitDocumentTree(UIDocument document, Dictionary<string, object> args)
        {
            // 有界遍历：depth ≤ 6、节点 ≤ 300（规格硬上限）。
            var depthLimit = (int)Math.Max(1, Math.Min(6, ToLong(args, "depth", 6)));
            var nodeLimit = (int)Math.Max(1, Math.Min(300, ToLong(args, "limit", 300)));
            var d = new Dictionary<string, object>();
            try
            {
                var transform = document.transform;
                if (transform != null) d["path"] = ScenePathOf(transform);
            }
            catch (Exception) { }
            object root;
            if (!UiToolkitTryReadMember(document, typeof(UIDocument), "rootVisualElement", out root) || root == null)
            {
                d["empty"] = true;
                d["count"] = 0L;
                d["hint"] = "Edit Mode 下 UIDocument 可能尚未实例化视觉树；请先进入 Play Mode，或确认 panelSettings/源资产已设置后重试";
                return d;
            }
            var budget = new UiToolkitTreeBudget();
            budget.Remaining = nodeLimit;
            d["tree"] = UiToolkitTreeOf(root, 0, depthLimit, budget);
            d["empty"] = false;
            d["count"] = (long)(nodeLimit - budget.Remaining);
            d["truncated"] = budget.Truncated;
            d["depth"] = (long)depthLimit;
            d["hint"] = "Edit Mode 下列表可能不完整（部分元素由运行时生成）；仅遍历 depth ≤ " + depthLimit + "、节点 ≤ " + nodeLimit;
            return d;
        }

        class UiToolkitTreeBudget
        {
            public int Remaining;
            public bool Truncated;
        }

        static Dictionary<string, object> UiToolkitTreeOf(object element, int depth, int depthLimit, UiToolkitTreeBudget budget)
        {
            if (budget.Remaining <= 0) { budget.Truncated = true; return null; }
            budget.Remaining--;
            var node = new Dictionary<string, object>();
            object name;
            node["name"] = UiToolkitTryReadMember(element, element.GetType(), "name", out name) && name != null
                ? Convert.ToString(name, CultureInfo.InvariantCulture)
                : null;
            node["type"] = element.GetType().Name;
            node["classes"] = UiToolkitElementClasses(element);
            var children = new List<object>();
            var candidates = UiToolkitElementChildren(element);
            if (depth >= depthLimit)
            {
                if (candidates.Count > 0) budget.Truncated = true;
            }
            else
            {
                for (var i = 0; i < candidates.Count; i++)
                {
                    if (budget.Remaining <= 0) { budget.Truncated = true; break; }
                    var child = UiToolkitTreeOf(candidates[i], depth + 1, depthLimit, budget);
                    if (child != null) children.Add(child);
                }
            }
            node["children"] = children;
            return node;
        }

        static List<object> UiToolkitElementClasses(object element)
        {
            var classes = new List<object>();
            if (element == null) return classes;
            try
            {
                var method = element.GetType().GetMethod(
                    "GetClasses", BindingFlags.Public | BindingFlags.Instance, null, Type.EmptyTypes, null);
                if (method != null)
                {
                    var raw = method.Invoke(element, null) as IEnumerable;
                    if (raw != null)
                    {
                        foreach (var item in raw)
                        {
                            if (item != null) classes.Add(item.ToString());
                        }
                    }
                }
            }
            catch (Exception) { }
            return classes;
        }

        static List<object> UiToolkitElementChildren(object element)
        {
            var children = new List<object>();
            if (element == null) return children;
            var type = element.GetType();
            try
            {
                var method = type.GetMethod("Children", BindingFlags.Public | BindingFlags.Instance, null, Type.EmptyTypes, null);
                if (method != null)
                {
                    var raw = method.Invoke(element, null) as IEnumerable;
                    if (raw != null)
                    {
                        foreach (var item in raw)
                        {
                            if (item != null) children.Add(item);
                        }
                        return children;
                    }
                }
            }
            catch (Exception) { }
            try
            {
                // 兜底：childCount + ElementAt(i)（不同版本 VisualElement 的公开面不同）。
                var countProperty = type.GetProperty("childCount", BindingFlags.Public | BindingFlags.Instance);
                var elementAt = type.GetMethod("ElementAt", BindingFlags.Public | BindingFlags.Instance, null, new[] { typeof(int) }, null);
                if (countProperty != null && elementAt != null)
                {
                    var count = Convert.ToInt32(countProperty.GetValue(element, null), CultureInfo.InvariantCulture);
                    for (var i = 0; i < count; i++)
                    {
                        var child = elementAt.Invoke(element, new object[] { i });
                        if (child != null) children.Add(child);
                    }
                }
            }
            catch (Exception) { }
            return children;
        }
    }
}
