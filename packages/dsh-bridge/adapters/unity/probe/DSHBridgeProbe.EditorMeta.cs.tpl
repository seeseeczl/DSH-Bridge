        // ===== 编辑器元数据域（v27 能力补齐）：tag / layer 的 list-ensure-remove 与 set_active_tool =====
        // 域分发约定：cap 不匹配返回 null；匹配时返回 Dictionary<string, object> 或抛 KnownError。
        // tag/layer 是工程全局设置（ProjectSettings/TagManager.asset）：
        //   - ensure 幂等：已存在返回 created=false，不存在才写，必须 Undo 并保存设置。
        //   - remove 是破坏性操作（引用方会变成 Undefined/未命名层），DSH 侧默认关闭。
        // `ensure` 支持 applyTo（对象路径/句柄）把 tag/layer 赋给场景对象，省掉两步调用。
        // 域内 helper 必须带 EditorMeta 前缀。

        /// <summary>TagManager 固定落在工程设置目录；不通过 AssetDatabase.CreateAsset 创建。</summary>
        const string EditorMetaTagManagerPath = "ProjectSettings/TagManager.asset";
        const int EditorMetaLayerCount = 32;
        const int EditorMetaFirstUserLayer = 8;
        const int EditorMetaLastUserLayer = EditorMetaLayerCount - 1;

        /// <summary>ProjectSettings 的 Undo 实情：部分版本不完整，调用方需要自己承担回滚风险。</summary>
        const string EditorMetaUndoNote =
            "ProjectSettings 的 Undo 在部分 Unity 版本不完整：回滚依赖资源已保存状态，建议将 TagManager.asset 纳入版本控制";

        /// <summary>Unity 内置 tag，不能删除；ensure 时按「已存在」幂等处理。</summary>
        static readonly string[] EditorMetaBuiltinTags = new string[] {
            "Untagged", "Respawn", "Finish", "EditorOnly", "MainCamera", "Player", "GameController"
        };

        static Dictionary<string, object> TryEditorMeta(string cap, Dictionary<string, object> args)
        {
            if (args == null) args = new Dictionary<string, object>();
            if (cap == "unity.tag.list") return EditorMetaTagList(args);
            if (cap == "unity.tag.ensure") return EditorMetaTagEnsure(args);
            if (cap == "unity.tag.remove") return EditorMetaTagRemove(args);
            if (cap == "unity.layer.list") return EditorMetaLayerList(args);
            if (cap == "unity.layer.ensure") return EditorMetaLayerEnsure(args);
            if (cap == "unity.layer.remove") return EditorMetaLayerRemove(args);
            if (cap == "unity.editor.set_active_tool") return EditorMetaSetActiveTool(args);
            return null;
        }

        // ---------- unity.tag.list ----------
        static Dictionary<string, object> EditorMetaTagList(Dictionary<string, object> args)
        {
            var rows = new List<object>();
            var source = "internal";
            string[] current = null;
            try { current = InternalEditorUtility.tags; }
            catch (Exception) { current = null; }
            if (current != null)
            {
                foreach (var tag in current) rows.Add(tag ?? "");
            }
            else
            {
                // InternalEditorUtility 不可用时退回 TagManager 序列化视图：与写入共用同一权威来源。
                source = "serialized";
                var so = EditorMetaOpenTagManager();
                var tags = EditorMetaRequiredArray(so, "tags");
                for (var i = 0; i < tags.arraySize; i++) rows.Add(EditorMetaArrayStringAt(tags, i));
            }
            var d = new Dictionary<string, object>();
            d["tags"] = rows;
            d["count"] = (long)rows.Count;
            d["source"] = source;
            return d;
        }

        // ---------- unity.tag.ensure ----------
        static Dictionary<string, object> EditorMetaTagEnsure(Dictionary<string, object> args)
        {
            var name = EditorMetaRequireName(args, "tag");
            // applyTo 必须在写 ProjectSettings 之前解析：目标不存在时不要留下「设置已改、对象没赋上」的半完成状态。
            var applyTo = EditorMetaResolveApplyTo(args);
            var so = EditorMetaOpenTagManager();
            var tags = EditorMetaRequiredArray(so, "tags");
            var created = false;
            var undoAvailable = false;
            if (EditorMetaArrayIndexOf(tags, name) < 0)
            {
                undoAvailable = EditorMetaRegisterUndo(so.targetObject, "DSH Ensure Tag " + name);
                var index = tags.arraySize;
                tags.InsertArrayElementAtIndex(index);
                tags.GetArrayElementAtIndex(index).stringValue = name;
                so.ApplyModifiedProperties();
                EditorMetaSaveProjectSettings();
                created = true;
            }
            var d = new Dictionary<string, object>();
            d["tag"] = name;
            d["created"] = created;
            d["undoAvailable"] = undoAvailable;
            if (created) d["undoNote"] = EditorMetaUndoNote;
            if (applyTo != null)
            {
                EditorMetaAssignTag(applyTo, name);
                d["appliedTo"] = EditorMetaDescribeApplied(applyTo);
            }
            return d;
        }

        // ---------- unity.tag.remove（DSH 侧默认关闭的危险能力） ----------
        static Dictionary<string, object> EditorMetaTagRemove(Dictionary<string, object> args)
        {
            var name = EditorMetaRequireName(args, "tag");
            if (EditorMetaIsBuiltinTag(name))
                throw new KnownError("builtin_tag", "内置 tag 不能删除: " + name,
                    "内置 tag: " + string.Join(", ", EditorMetaBuiltinTags));
            var so = EditorMetaOpenTagManager();
            var tags = EditorMetaRequiredArray(so, "tags");
            var index = EditorMetaArrayIndexOf(tags, name);
            if (index < 0) throw new KnownError("not_found", "tag 不存在: " + name,
                "用 unity.tag.list 查看当前 tag；新增请用 unity.tag.ensure");
            var undoAvailable = EditorMetaRegisterUndo(so.targetObject, "DSH Remove Tag " + name);
            tags.DeleteArrayElementAtIndex(index);
            so.ApplyModifiedProperties();
            EditorMetaSaveProjectSettings();
            var d = new Dictionary<string, object>();
            d["removed"] = true;
            d["tag"] = name;
            d["undoAvailable"] = undoAvailable;
            d["undoNote"] = EditorMetaUndoNote;
            return d;
        }

        // ---------- unity.layer.list ----------
        static Dictionary<string, object> EditorMetaLayerList(Dictionary<string, object> args)
        {
            var so = EditorMetaOpenTagManager();
            var layers = EditorMetaRequiredArray(so, "layers");
            var rows = new List<object>();
            for (var i = 0; i < EditorMetaLayerCount; i++)
            {
                var row = new Dictionary<string, object>();
                row["index"] = (long)i;
                // 空名保持 null 之外的空串：客户端可据此判断空槽。
                row["name"] = EditorMetaArrayStringAt(layers, i);
                rows.Add(row);
            }
            var d = new Dictionary<string, object>();
            d["layers"] = rows;
            d["count"] = (long)rows.Count;
            return d;
        }

        // ---------- unity.layer.ensure ----------
        static Dictionary<string, object> EditorMetaLayerEnsure(Dictionary<string, object> args)
        {
            var name = EditorMetaRequireName(args, "layer");
            var hasIndex = args.ContainsKey("index") && args["index"] != null;
            var requested = hasIndex ? ToLong(args, "index", -1) : -1L;
            // 参数错误优先于任何工程设置访问：内置层/越界必须在不产生副作用前拒绝。
            if (hasIndex) EditorMetaValidateUserLayerIndex(requested);
            var applyTo = EditorMetaResolveApplyTo(args);
            var so = EditorMetaOpenTagManager();
            var layers = EditorMetaRequiredArray(so, "layers");

            var existing = EditorMetaArrayIndexOf(layers, name);
            if (existing >= 0)
            {
                // 幂等：名称已存在时不动 TagManager，返回它实际所在的索引。
                var row = EditorMetaLayerResult(name, existing, false, false);
                if (applyTo != null)
                {
                    EditorMetaAssignLayer(applyTo, existing);
                    row["appliedTo"] = EditorMetaDescribeApplied(applyTo);
                }
                return row;
            }

            var slot = -1L;
            if (hasIndex)
            {
                var occupant = EditorMetaArrayStringAt(layers, (int)requested);
                if (!string.IsNullOrEmpty(occupant))
                    throw new KnownError("invalid_argument", "layer 槽位 " + requested + " 已被占用: " + occupant,
                        "先用 unity.layer.remove 清空该槽位，或换一个 index");
                slot = requested;
            }
            else
            {
                for (var i = EditorMetaFirstUserLayer; i <= EditorMetaLastUserLayer; i++)
                {
                    if (string.IsNullOrEmpty(EditorMetaArrayStringAt(layers, i))) { slot = i; break; }
                }
                if (slot < 0)
                    throw new KnownError("invalid_argument", "8-31 已没有空闲层槽位，无法新增层: " + name,
                        "先用 unity.layer.remove 清空一个自定义层，或显式指定 index");
            }

            var undoAvailable = EditorMetaRegisterUndo(so.targetObject, "DSH Ensure Layer " + name);
            layers.GetArrayElementAtIndex((int)slot).stringValue = name;
            so.ApplyModifiedProperties();
            EditorMetaSaveProjectSettings();

            var result = EditorMetaLayerResult(name, (int)slot, true, undoAvailable);
            if (applyTo != null)
            {
                EditorMetaAssignLayer(applyTo, (int)slot);
                result["appliedTo"] = EditorMetaDescribeApplied(applyTo);
            }
            return result;
        }

        static Dictionary<string, object> EditorMetaLayerResult(string name, int index, bool created, bool undoAvailable)
        {
            var d = new Dictionary<string, object>();
            d["layer"] = name;
            d["index"] = (long)index;
            d["created"] = created;
            d["undoAvailable"] = undoAvailable;
            if (created) d["undoNote"] = EditorMetaUndoNote;
            return d;
        }

        // ---------- unity.layer.remove（DSH 侧默认关闭的危险能力） ----------
        static Dictionary<string, object> EditorMetaLayerRemove(Dictionary<string, object> args)
        {
            var name = GetString(args, "name");
            var hasName = !string.IsNullOrEmpty(name);
            var hasIndex = args.ContainsKey("index") && args["index"] != null;
            if (!hasName && !hasIndex)
                throw new KnownError("invalid_argument", "需要 index 或 name：删除层必须显式指定目标");
            if (!hasName) name = null;

            var index = -1L;
            if (hasIndex)
            {
                index = ToLong(args, "index", -1);
                EditorMetaValidateUserLayerIndex(index);
            }

            var so = EditorMetaOpenTagManager();
            var layers = EditorMetaRequiredArray(so, "layers");
            if (!hasIndex)
            {
                index = EditorMetaArrayIndexOf(layers, name);
                if (index < 0) throw new KnownError("not_found", "layer 不存在: " + name,
                    "用 unity.layer.list 查看当前层；新增请用 unity.layer.ensure");
                // 内置层名（如 Default）也会在这里命中，必须拒绝。
                if (index < EditorMetaFirstUserLayer)
                    throw new KnownError("builtin_layer", "内置层不能删除: " + name + "（index " + index + "）",
                        "只能删除 8-31 的自定义层");
            }

            var current = EditorMetaArrayStringAt(layers, (int)index);
            if (hasName && !string.Equals(current, name, StringComparison.Ordinal))
                throw new KnownError("invalid_argument",
                    "index 与 name 不一致：index " + index + " 当前是 \"" + current + "\"，name 是 \"" + name + "\"");
            if (string.IsNullOrEmpty(current))
                throw new KnownError("not_found", "层槽位为空，没有可删除的层: index " + index,
                    "用 unity.layer.list 查看当前层名");

            var undoAvailable = EditorMetaRegisterUndo(so.targetObject, "DSH Remove Layer " + index);
            layers.GetArrayElementAtIndex((int)index).stringValue = "";
            so.ApplyModifiedProperties();
            EditorMetaSaveProjectSettings();
            var d = new Dictionary<string, object>();
            d["removed"] = true;
            d["index"] = index;
            d["layer"] = current;
            d["undoAvailable"] = undoAvailable;
            d["undoNote"] = EditorMetaUndoNote;
            return d;
        }

        // ---------- unity.editor.set_active_tool ----------
        static Dictionary<string, object> EditorMetaSetActiveTool(Dictionary<string, object> args)
        {
            var raw = GetString(args, "tool");
            if (string.IsNullOrEmpty(raw))
                throw new KnownError("invalid_argument", "缺少 tool（可选: none/view/move/rotate/scale/rect/transform）");
            var lowered = raw.Trim().ToLowerInvariant();
            Tool requested;
            if (lowered == "none") requested = Tool.None;
            else if (lowered == "view") requested = Tool.View;
            else if (lowered == "move") requested = Tool.Move;
            else if (lowered == "rotate") requested = Tool.Rotate;
            else if (lowered == "scale") requested = Tool.Scale;
            else if (lowered == "rect") requested = Tool.Rect;
            else if (lowered == "transform") requested = Tool.Transform;
            else
                throw new KnownError("invalid_argument", "未知 tool: " + raw,
                    "可选: none/view/move/rotate/scale/rect/transform");

            var before = Tools.current;
            Tools.current = requested;
            var after = Tools.current;
            var d = new Dictionary<string, object>();
            d["before"] = EditorMetaToolName(before);
            d["after"] = EditorMetaToolName(after);
            // 返回的是实际值：部分版本可能不接受 None，不能让调用方误以为切换成功。
            if (after != requested)
                d["hint"] = "当前编辑器不接受 tool=" + lowered + "，实际工具见 after";
            return d;
        }

        static string EditorMetaToolName(Tool tool)
        {
            if (tool == Tool.None) return "none";
            return tool.ToString().ToLowerInvariant();
        }

        // ---------- 域内辅助 ----------

        static string EditorMetaRequireName(Dictionary<string, object> args, string kind)
        {
            var name = GetString(args, "name");
            if (string.IsNullOrEmpty(name))
                throw new KnownError("invalid_argument", "缺少 name（" + kind + " 名称）");
            if (name.Trim().Length == 0)
                throw new KnownError("invalid_argument", "name 不能只包含空白字符");
            if (!string.Equals(name, name.Trim(), StringComparison.Ordinal))
                throw new KnownError("invalid_argument", "name 不能以空白开头或结尾: \"" + name + "\"");
            return name;
        }

        static bool EditorMetaIsBuiltinTag(string name)
        {
            for (var i = 0; i < EditorMetaBuiltinTags.Length; i++)
            {
                if (string.Equals(EditorMetaBuiltinTags[i], name, StringComparison.Ordinal)) return true;
            }
            return false;
        }

        /// <summary>0-7 是 Unity 内置层，不允许 ensure/remove 触碰（返回 builtin_layer）。</summary>
        static void EditorMetaValidateUserLayerIndex(long index)
        {
            if (index >= 0 && index < EditorMetaFirstUserLayer)
                throw new KnownError("builtin_layer", "0-7 是 Unity 内置层，不允许修改: index " + index,
                    "可写层索引范围: 8-31");
            if (index < EditorMetaFirstUserLayer || index > EditorMetaLastUserLayer)
                throw new KnownError("invalid_argument", "layer index 必须在 8-31 之间，实际: " + index,
                    "可写层索引范围: 8-31");
        }

        /// <summary>取 TagManager 资产；取不到返回 null，由 EditorMetaOpenTagManager 统一报 not_found。</summary>
        static UnityEngine.Object EditorMetaTagManagerAsset()
        {
            UnityEngine.Object[] assets;
            try { assets = AssetDatabase.LoadAllAssetsAtPath(EditorMetaTagManagerPath); }
            catch (Exception e)
            {
                throw new KnownError("not_found", "读取 " + EditorMetaTagManagerPath + " 失败：" + e.Message);
            }
            if (assets == null || assets.Length == 0) return null;
            return assets[0];
        }

        /// <summary>
        /// 打开 TagManager 的序列化视图（tag / layer 的唯一写入口，也是 layer 列表的唯一读入口）。
        /// 序列化层抽成域内私有方法：真机走 UnityEditor.SerializedObject + TagManager.asset；
        /// 离线语义测试里由 tests/unity-probe/stubs/editormeta.cs 提供同名受控替身（可控内存 TagManager），
        /// 因此探针不需要为测试留任何开关。资产缺失时真机构造会抛异常，这里统一映射为 not_found。
        /// </summary>
        static SerializedObject EditorMetaOpenTagManager()
        {
            var asset = EditorMetaTagManagerAsset();
            try { return new SerializedObject(asset); }
            catch (Exception e)
            {
                throw new KnownError("not_found", "打开 " + EditorMetaTagManagerPath + " 失败：" + e.Message,
                    "工程 ProjectSettings 可能被裁剪；可在 Unity 的 Project Settings > Tags and Layers 里确认");
            }
        }

        /// <summary>
        /// 取 TagManager 的数组序列化属性（tags / layers）。
        /// 属性缺失说明该 Unity 版本的 TagManager 结构不同；必须显式报错，不能返回空列表冒充成功。
        /// </summary>
        static SerializedProperty EditorMetaRequiredArray(SerializedObject so, string propertyName)
        {
            try
            {
                var property = so.FindProperty(propertyName);
                if (property != null) return property;
            }
            catch (Exception e)
            {
                throw new KnownError("unsupported", "读取 TagManager." + propertyName + " 失败：" + e.Message,
                    "当前 Unity 版本的 TagManager 序列化结构可能不同");
            }
            throw new KnownError("unsupported", "TagManager 没有序列化属性 " + propertyName,
                "当前 Unity 版本的 TagManager 结构可能不同（tag/layer 由 ProjectSettings 承载）");
        }

        static int EditorMetaArrayIndexOf(SerializedProperty array, string value)
        {
            if (array == null || value == null) return -1;
            for (var i = 0; i < array.arraySize; i++)
            {
                if (string.Equals(EditorMetaArrayStringAt(array, i), value, StringComparison.Ordinal)) return i;
            }
            return -1;
        }

        static string EditorMetaArrayStringAt(SerializedProperty array, int index)
        {
            if (array == null || index < 0 || index >= array.arraySize) return "";
            var item = array.GetArrayElementAtIndex(index);
            if (item == null) return "";
            return item.stringValue ?? "";
        }

        /// <summary>
        /// ProjectSettings 资产的 Undo 登记：优先 RegisterCompleteObjectUndo；旧版本/部分版本缺失
        /// 或对 ProjectSettings 不完整时退回 Undo.RecordObject。返回值 = 本次写是否成功登记。
        /// </summary>
        static bool EditorMetaRegisterUndo(UnityEngine.Object asset, string label)
        {
            try
            {
                var method = typeof(Undo).GetMethod(
                    "RegisterCompleteObjectUndo",
                    BindingFlags.Public | BindingFlags.Static,
                    null,
                    new Type[] { typeof(UnityEngine.Object), typeof(string) },
                    null);
                if (method != null)
                {
                    method.Invoke(null, new object[] { asset, label });
                    return true;
                }
            }
            catch (Exception) { }
            try
            {
                Undo.RecordObject(asset, label);
                return true;
            }
            catch (Exception) { return false; }
        }

        /// <summary>
        /// 保存工程设置。真机必须落盘（否则改动只存在内存里、重启即丢）；离线 stub 的 AssetDatabase
        /// 只覆盖最小面（没有 SaveAssets），因此用反射调用：两套编译环境都能通过，真机一定执行。
        /// </summary>
        static void EditorMetaSaveProjectSettings()
        {
            try
            {
                var method = typeof(AssetDatabase).GetMethod(
                    "SaveAssets",
                    BindingFlags.Public | BindingFlags.Static,
                    null,
                    Type.EmptyTypes,
                    null);
                if (method == null) return;
                method.Invoke(null, null);
            }
            catch (Exception e)
            {
                throw new KnownError("unsupported", "保存 ProjectSettings 失败：" + e.Message,
                    "TagManager 的改动可能只存在内存里；请检查 Console 是否有导入错误后重试");
            }
        }

        /// <summary>
        /// 解析 applyTo：支持字符串对象路径（USAGE 约定）、句柄字符串，或 { handle/path } 对象。
        /// 目标不存在时抛 object_not_found（沿用场景域既有错误码）；调用方必须在写 ProjectSettings 之前调用。
        /// </summary>
        static GameObject EditorMetaResolveApplyTo(Dictionary<string, object> args)
        {
            object raw;
            if (args == null || !args.TryGetValue("applyTo", out raw) || raw == null) return null;
            var inner = new Dictionary<string, object>();
            var dict = raw as Dictionary<string, object>;
            if (dict != null)
            {
                foreach (var pair in dict) inner[pair.Key] = pair.Value;
            }
            else
            {
                var path = raw as string;
                if (string.IsNullOrEmpty(path))
                    throw new KnownError("invalid_argument", "applyTo 需要场景对象路径（字符串）或 { handle/path } 对象");
                if (GetHandle(path) != null) inner["handle"] = path;
                else inner["path"] = path;
            }
            if (!inner.ContainsKey("handle") && !inner.ContainsKey("path"))
                throw new KnownError("invalid_argument", "applyTo 需要 handle 或 path");
            return ResolveGameObject(inner);
        }

        static void EditorMetaAssignTag(GameObject go, string tag)
        {
            if (go == null) throw new KnownError("object_not_found", "applyTo 目标不存在或已销毁");
            // 与探针其它成员写入共用 SetMember/CoerceValue；等价于 go.tag = tag，但避免离线 stub 缺该属性时无法编译。
            Undo.RecordObject(go, "DSH Apply Tag " + tag);
            SetMember(go, typeof(GameObject), "tag", tag, false);
            EditorUtility.SetDirty(go);
        }

        static void EditorMetaAssignLayer(GameObject go, int layer)
        {
            if (go == null) throw new KnownError("object_not_found", "applyTo 目标不存在或已销毁");
            Undo.RecordObject(go, "DSH Apply Layer " + layer);
            SetMember(go, typeof(GameObject), "layer", (long)layer, false);
            EditorUtility.SetDirty(go);
        }

        static Dictionary<string, object> EditorMetaDescribeApplied(GameObject go)
        {
            var d = new Dictionary<string, object>();
            d["handle"] = PutHandle(go);
            d["name"] = go.name;
            d["path"] = ScenePathOf(go.transform);
            return d;
        }
    }
