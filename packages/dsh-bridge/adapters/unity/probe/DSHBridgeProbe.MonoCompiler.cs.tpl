        static void AddDiagnostic(string text)
        {
            if (string.IsNullOrEmpty(text)) return;
            if (_scriptingDiagnostics.Count >= MaxScriptingDiagnostics) _scriptingDiagnostics.RemoveAt(0);
            _scriptingDiagnostics.Add(text);
