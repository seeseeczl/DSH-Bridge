        static Dictionary<string, object> ConsoleRead(Dictionary<string, object> args)
        {
            var limit = (int)Math.Max(1, Math.Min(400, ToLong(args, "limit", 100)));
            var level = GetString(args, "level");
            List<Dictionary<string, object>> snapshot;
            lock (_log) { snapshot = _log.ToList(); }
            var filtered = snapshot.Where(e => level == null || level == "all" || GetString(e, "level") == level).ToList();
            var tail = filtered.Skip(Math.Max(0, filtered.Count - limit)).ToList();
            var d = new Dictionary<string, object>();
            d["total"] = (long)filtered.Count;
            d["entries"] = tail.Cast<object>().ToList();
            return d;
        }

        static Dictionary<string, object> HierarchyList(Dictionary<string, object> args)
        {
            var scene = SceneManager.GetActiveScene();
            var roots = scene.GetRootGameObjects();
            var list = new List<object>();
            foreach (var go in roots) list.Add(SummarizeTransform(go.transform, 0));
            var d = new Dictionary<string, object>();
            d["scene"] = scene.name;
            d["roots"] = list;
            return d;
        }

        static Dictionary<string, object> SummarizeTransform(Transform t, int depth)
        {
            var d = new Dictionary<string, object>();
            d["name"] = t.name;
            d["depth"] = (long)depth;
            d["active"] = t.gameObject.activeSelf;
            d["childCount"] = (long)t.childCount;
            if (depth < 2)
            {
                var children = new List<object>();
                for (var i = 0; i < t.childCount && i < 64; i++) children.Add(SummarizeTransform(t.GetChild(i), depth + 1));
                d["children"] = children;
            }
            return d;
        }

        static Dictionary<string, object> AssetFind(Dictionary<string, object> args)
        {
            var filter = GetString(args, "filter");
            if (string.IsNullOrEmpty(filter)) filter = "";
            var folders = GetStringList(args, "folders");
            var limit = (int)Math.Max(1, Math.Min(500, ToLong(args, "limit", 50)));
            var guids = AssetDatabase.FindAssets(filter, folders.Count > 0 ? folders.ToArray() : null);
            var paths = new List<object>();
            for (var i = 0; i < guids.Length && i < limit; i++) paths.Add(AssetDatabase.GUIDToAssetPath(guids[i]));
            var d = new Dictionary<string, object>();
            d["total"] = (long)guids.Length;
            d["assets"] = paths;
            return d;
        }

        static Dictionary<string, object> MenuExecute(Dictionary<string, object> args)
        {
            // 危险能力：DSH 侧默认拒绝（DEFAULT_DANGEROUS），显式 allowDangerous 后才下发。
            // 探针侧不再永久封禁（用户决策 2026-11-18：能力优先，风险由调用方/用户承担）。
            var path = GetString(args, "path");
            if (string.IsNullOrEmpty(path)) throw new KnownError("invalid_argument", "缺少 path");
            var ok = EditorApplication.ExecuteMenuItem(path);
            if (!ok) throw new KnownError("menu_not_found", "菜单不存在或不可执行: " + path);
            var d = new Dictionary<string, object>();
            d["executed"] = path;
            d["path"] = path;
            return d;
        }
    }
}
